\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\usepackage{LuaCJKfntef}
\setCJKmainfont{LXGWNeoZhiSong.ttf}[ItalicFont=LXGWWenKaiGBLite-Regular.ttf]
\showboxbreadth = 100
\showboxdepth = 100

\begin{document}

\START

\TEST{the box takes the requested width}{
  \setbox0=\hbox{%
    \begin{CJKfilltwosides}{5em}
      中\\文
    \end{CJKfilltwosides}
  }
  \TYPE{width: \the\wd0}
}

\TEST{the default position centres the box like a parbox}{
  \setbox0=\hbox{%
    \begin{CJKfilltwosides}{5em}
      中\\文
    \end{CJKfilltwosides}
  }
  \setbox2=\vbox{\parbox[c]{5em}{中\\文}}
  \TYPE{height: \the\ht0, parbox: \the\ht2}
  \TYPE{depth: \the\dp0, parbox: \the\dp2}
}

\TEST{the t position puts the first line on the surrounding baseline}{
  \setbox0=\hbox{%
    \begin{CJKfilltwosides}[t]{5em}
      中\\文
    \end{CJKfilltwosides}
  }
  \setbox2=\vbox{\parbox[t]{5em}{中\\文}}
  \TYPE{height: \the\ht0, parbox: \the\ht2}
  \TYPE{depth: \the\dp0, parbox: \the\dp2}
}

\TEST{the b position puts the last line on the surrounding baseline}{
  \setbox0=\hbox{%
    \begin{CJKfilltwosides}[b]{5em}
      中\\文
    \end{CJKfilltwosides}
  }
  \setbox2=\vbox{\parbox[b]{5em}{中\\文}}
  \TYPE{height: \the\ht0, parbox: \the\ht2}
  \TYPE{depth: \the\dp0, parbox: \the\dp2}
}

\TEST{a zero width keeps the surrounding line width}{
  \setbox0=\hbox{%
    \begin{CJKfilltwosides*}{0pt}
      中\\文
    \end{CJKfilltwosides*}
  }
  \TYPE{width: \the\wd0}
}

\TEST{each line is filled to the width}{
  \setbox0=\hbox{%
    \begin{CJKfilltwosides}{5em}
      中文\\字字
    \end{CJKfilltwosides}
  }
  \TYPE{width: \the\wd0}
  \TYPE{depth: \the\dp0}
  \directlua{
    local env = tex.box[0].head
    local n   = env and env.head
    local i   = 0
    while n do
      if n.id == node.id("hlist") then
        i = i + 1
        local out = {}
        local j = 0
        local g = n.head
        while g do
          if g.id == node.id("glyph") then
            j = j + 1
            out[j] = "glyph"
          elseif g.id == node.id("glue") then
            j = j + 1
            out[j] = "glue[" .. g.stretch_order .. "]"
          end
          g = g.next
        end
        texio.write_nl("term and log",
          "line " .. i .. ": " .. table.concat(out, " "))
      end
      n = n.next
    end
  }
}

\TEST{the environment works in a table cell}{
  \setbox0=\hbox{
    \begin{tabular}{|l|l|}
      \hline
      联系人 & {\begin{CJKfilltwosides}{4em}张三\\李四\end{CJKfilltwosides}} \\
      \hline
      联系电话 & 020-12345678 \\
      \hline
    \end{tabular}
  }
  \TYPE{width: \the\wd0}
  \TYPE{height: \the\ht0, depth: \the\dp0}
}

\TEST{the text after the environment joins the box on its line}{
  \setbox0=\vbox{
    \begin{CJKfilltwosides}{4em}
      作者
    \end{CJKfilltwosides}：张三
  }
  \TYPE{height: \the\ht0, depth: \the\dp0}
  \directlua{
    local ids = {}
    local i = 0
    local n = tex.box[0].head
    while n do
      i = i + 1
      ids[i] = node.type(n.id)
      n = n.next
    end
    texio.write_nl("term and log", "items: " .. table.concat(ids, " "))
    local inner = {}
    i = 0
    n = tex.box[0].head.head
    while n do
      i = i + 1
      inner[i] = node.type(n.id)
      n = n.next
    end
    texio.write_nl("term and log", "line: " .. table.concat(inner, " "))
  }
}

\TEST{a space after the environment is ignored}{
  \setbox0=\hbox{前\begin{CJKfilltwosides}{4em}作者\end{CJKfilltwosides}：张三}
  \setbox2=\hbox{前\begin{CJKfilltwosides}{4em}作者\end{CJKfilltwosides} ：张三}
  \TYPE{width: \the\wd0, spaced: \the\wd2}
}

\TEST{a paragraph after a paragraph break starts at the box's left edge}{
  \setbox0=\hbox{%
    \begin{CJKfilltwosides}{5em}
      中文\par 字字
    \end{CJKfilltwosides}
  }
  \TYPE{width: \the\wd0}
  \directlua{
    local n = tex.box[0].head.head
    local i = 0
    while n do
      if n.id == node.id("hlist") then
        i = i + 1
        local g = n.head
        while g and g.id == node.id("local_par") do g = g.next end
        local lead = "none"
        if g then
          lead = node.type(g.id)
          if g.id == node.id("hlist") then
            lead = lead .. " " .. (g.width / 65536) .. "pt"
          end
        end
        texio.write_nl("term and log", "line " .. i .. " lead: " .. lead)
      end
      n = n.next
    end
  }
}

\TEST{a footnote is set at the bottom of the box}{
  \setbox0=\hbox{%
    \begin{CJKfilltwosides}{6em}
      张三\footnote{注}
    \end{CJKfilltwosides}
  }
  \TYPE{width: \the\wd0, height: \the\ht0}
  \directlua{
    local items = {}
    local i = 0
    local n = tex.box[0].head.head
    while n do
      i = i + 1
      items[i] = node.type(n.id)
      n = n.next
    end
    texio.write_nl("term and log", "box: " .. table.concat(items, " "))
  }
}

\END

\end{document}

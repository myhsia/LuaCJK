\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\LuaCJKDeclareSubCJKBlock{Kana}{"3040 -> "30FF}
\LuaCJKDeclareSubCJKBlock{Steps}{"2460 -> "2473}
\setCJKmainfont{LXGWNeoZhiSong.ttf}
  [Kana = LXGWWenKaiGBLite-Regular.ttf,
   Steps = LXGWWenKaiGBLite-Regular.ttf]

\def\psnames{%
  \directlua{
    local n = tex.box[0].head
    local out = {}
    while n do
      if n.id == node.id("glyph") then
        local f = font.getfont(n.font)
        table.insert(out, tostring(f and f.psname))
      end
      n = n.next
    end
    texio.write_nl("term and log", "PS " .. table.concat(out, " "))
  }%
}

\begin{document}

\START

\TEST{a character in the block uses the block font}{
  \setbox0=\hbox{中あ}
  \psnames
}

\TEST{CancelSubCJKBlock turns the block off}{
  \LuaCJKCancelSubCJKBlock{Kana}
  \setbox0=\hbox{中あ}
  \psnames
}

\TEST{RestoreSubCJKBlock turns it on again}{
  \LuaCJKRestoreSubCJKBlock{Kana}
  \setbox0=\hbox{中あ}
  \psnames
}

\TEST{CancelSubCJKBlock ends with the group}{
  \begingroup
    \LuaCJKCancelSubCJKBlock{Kana}
    \setbox0=\hbox{中あ}
    \psnames
  \endgroup
  \setbox0=\hbox{中あ}
  \psnames
}

\TEST{a block outside the CJK ranges is CJK and takes its font}{
  \setbox0=\hbox{中①}
  \psnames
}

\TEST{CancelSubCJKBlock keeps the class and the main font}{
  \LuaCJKCancelSubCJKBlock{Steps}
  \setbox0=\hbox{中①}
  \psnames
  \LuaCJKRestoreSubCJKBlock{Steps}
}

\TEST{an explicit class declaration wins over the block}{
  \LuaCJKDeclareCharClass{Default}{"2460 -> "2473}
  \setbox0=\hbox{中①}
  \psnames
}

\TEST{ResetCharClass brings the block class back}{
  \LuaCJKResetCharClass
  \setbox0=\hbox{中①}
  \psnames
}

\TEST{a family without the option keeps the main font}{
  \setCJKfamilyfont{plain}{LXGWNeoZhiSong.ttf}
  \setbox0=\hbox{\CJKfamily{plain}中あ}
  \psnames
}

\END

\end{document}

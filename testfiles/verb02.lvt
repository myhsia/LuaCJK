\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\setCJKmainfont{FandolSong-Regular.otf}
\LuaCJKsetup{CJKglue = 10pt, CJKecglue = 5pt}

% The three nodes that follow every punctuation mark of a horizontal box.
\directlua{
  function reportbox (n)
    local cur = tex.box[n].head
    local res, count = {}, 0
    while cur do
      if cur.id == node.id("glyph") and LuaCJK.punct_class(cur.char) then
        local s, k = {}, 0
        local m = cur.next
        for _ = 1, 3 do
          if not m then break end
          local d
          if m.id == node.id("glyph") then
            d = "glyph " .. utf8.char(m.char)
          elseif m.id == node.id("glue") then
            d = "glue " .. m.width .. "/" .. m.stretch .. "/" .. m.shrink
          elseif m.id == node.id("kern") then
            d = "kern " .. m.kern
          elseif m.id == node.id("penalty") then
            d = "penalty " .. m.penalty
          else
            d = "node " .. m.id
          end
          k = k + 1
          s[k] = d
          m = m.next
        end
        count = count + 1
        res[count] = table.concat(s, ", ")
      end
      cur = cur.next
    end
    texio.write_nl("term and log", "AFTER-MARK: " .. table.concat(res, " || "))
  end
}

% The last glyph of the first line of a vertical box.
\directlua{
  function lastglyphof (n)
    local line = tex.box[n].head
    while line and line.id ~= node.id("hlist") do
      line = line.next
    end
    local cur = line and line.head
    local last
    while cur do
      if cur.id == node.id("glyph") then
        last = cur.char
      end
      cur = cur.next
    end
    texio.write_nl("term and log", "LAST-GLYPH: " ..
      (last and utf8.char(last) or "none"))
  end
}

\def\aftermark#1{\directlua{reportbox(#1)}}
\def\lastglyph#1{\directlua{lastglyphof(#1)}}

% \verb cannot appear inside a macro argument, so every box is built at the
% top level and the tests only report it.
\setbox0=\hbox{中、\verb|ab|}
\setbox2=\hbox{中（\verb|ab|}
\setbox4=\hbox{中\verb|、ab|}
\setbox6=\vbox{\hsize=80pt \noindent \LuaCJKnobreak{中中中中}、\verb|abcd|}

\begingroup
  \LuaCJKsetup{Verb = false}
  \global\setbox8=\hbox{中、\verb|ab|}
\endgroup

\begin{document}

\START

\TEST{a mark keeps its break glue before suspended text}{
  \aftermark{0}
  \TYPE{width: \the\wd0}
}

\TEST{the break glue adds no width}{
  \TYPE{suspended: \the\wd0}
  \TYPE{adjusted: \the\wd8}
}

\TEST{an opening mark stays without a break opportunity}{
  \aftermark{2}
}

\TEST{a mark inside suspended text stays without one}{
  \aftermark{4}
}

\TEST{a line ends at the mark before suspended text}{
  \lastglyph{6}
}

\END

\end{document}

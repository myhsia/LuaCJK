\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\setCJKmainfont{FandolSong-Regular.otf}
\LuaCJKsetup{CJKglue = 10pt, CJKecglue = 5pt}

% The three nodes that follow every punctuation mark of a horizontal box.
\directlua{
  function reportbox (n)
    local cur = tex.box[n].head
    local res, count = {}, 0
    while cur do
      if cur.id == node.id("glyph") and LuaCJK.punct_class(cur.char) then
        local s, k = {}, 0
        local m = cur.next
        for _ = 1, 3 do
          if not m then break end
          local d
          if m.id == node.id("glyph") then
            d = "glyph " .. utf8.char(m.char)
          elseif m.id == node.id("glue") then
            d = "glue " .. m.width .. "/" .. m.stretch .. "/" .. m.shrink
          elseif m.id == node.id("kern") then
            d = "kern " .. m.kern
          elseif m.id == node.id("penalty") then
            d = "penalty " .. m.penalty
          else
            d = "node " .. m.id
          end
          k = k + 1
          s[k] = d
          m = m.next
        end
        count = count + 1
        res[count] = table.concat(s, ", ")
      end
      cur = cur.next
    end
    texio.write_nl("term and log", "AFTER-MARK: " .. table.concat(res, " || "))
  end
}

% The nodes of a horizontal box, one token each.
\directlua{
  function reportlist (n)
    local cur = tex.box[n].head
    local out, k = {}, 0
    while cur do
      local d
      if cur.id == node.id("glyph") then
        d = "g" .. utf8.char(cur.char)
      elseif cur.id == node.id("glue") then
        d = "glue " .. cur.width .. "/" .. cur.stretch .. "/" ..
            cur.shrink .. "/" .. cur.subtype
      elseif cur.id == node.id("kern") then
        d = "kern " .. cur.kern
      elseif cur.id == node.id("penalty") then
        d = "pen " .. cur.penalty
      elseif cur.id == node.id("hlist") or cur.id == node.id("vlist") then
        d = "box " .. cur.width
      else
        d = "id" .. cur.id
      end
      k = k + 1
      out[k] = d
      cur = cur.next
    end
    texio.write_nl("term and log", "LIST: " .. table.concat(out, " "))
  end
}

% The last glyph of the first line of a vertical box.
\directlua{
  function lastglyphof (n)
    local line = tex.box[n].head
    while line and line.id ~= node.id("hlist") do
      line = line.next
    end
    local cur = line and line.head
    local last
    while cur do
      if cur.id == node.id("glyph") then
        last = cur.char
      end
      cur = cur.next
    end
    texio.write_nl("term and log", "LAST-GLYPH: " ..
      (last and utf8.char(last) or "none"))
  end
}

\def\aftermark#1{\directlua{reportbox(#1)}}
\def\lastglyph#1{\directlua{lastglyphof(#1)}}
\def\reportlist#1{\directlua{reportlist(#1)}}

% \verb cannot appear inside a macro argument, so every box is built at the
% top level and the tests only report it.
\setbox0=\hbox{中、\verb|ab|}
\setbox2=\hbox{中（\verb|ab|}
\setbox4=\hbox{中\verb|、ab|}
\setbox6=\vbox{\hsize=80pt \noindent \LuaCJKnobreak{中中中中}、\verb|abcd|}

\begingroup
  \LuaCJKsetup{Verb = false}
  \global\setbox8=\hbox{中、\verb|ab|}
\endgroup

\newbox\verbrighthbox
\newbox\verbleftbox
\newbox\verbclosebox
\newbox\verblinebox
\setbox\verbrighthbox=\hbox{\verb|ab|键}
\setbox\verbleftbox=\hbox{键\verb|ab|}
\setbox\verbclosebox=\hbox{\verb|ab|。}
\setbox\verblinebox=\vbox{\hsize=52pt \raggedright \noindent\verb|Backspace|键}

\begin{document}

\START

\TEST{a mark keeps its break glue before suspended text}{
  \aftermark{0}
  \TYPE{width: \the\wd0}
}

\TEST{the break glue adds no width}{
  \TYPE{suspended: \the\wd0}
  \TYPE{adjusted: \the\wd8}
}

\TEST{an opening mark stays without a break opportunity}{
  \aftermark{2}
}

\TEST{a mark inside suspended text stays without one}{
  \aftermark{4}
}

\TEST{a line ends at the mark before suspended text}{
  \lastglyph{6}
}

\TEST{a suspended run keeps the break opportunity on its right}{
  \reportlist{\number\verbrighthbox}
}

\TEST{a suspended run keeps the break opportunity on its left}{
  \reportlist{\number\verbleftbox}
}

\TEST{no break opportunity before a closing mark}{
  \reportlist{\number\verbclosebox}
}

\TEST{a line ends at the right of suspended text}{
  \lastglyph{\number\verblinebox}
}

\END

\end{document}

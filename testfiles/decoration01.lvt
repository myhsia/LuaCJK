\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\usepackage{LuaCJKfntef}
\setCJKmainfont{LXGWNeoZhiSong.ttf}
\showboxbreadth = 100
\showboxdepth = 100

\def\nodes{%
  \directlua{
    local n = tex.box[0].head
    local out = {}
    local i = 0
    while n do
      if n.id == node.id("glue") then
        i = i + 1
        local s = n.subtype
        out[i] = (s == 100 and "leaders:" or s == 101 and "cleaders:"
          or s == 102 and "xleaders:" or "glue:") .. n.width
      elseif n.id == node.id("kern") then
        i = i + 1
        out[i] = "kern:" .. n.kern
      elseif n.id == node.id("glyph") then
        i = i + 1
        out[i] = "glyph"
      end
      n = n.next
    end
    texio.write_nl("term and log", "NODES " .. table.concat(out, " "))
  }%
}

\def\dimensions{%
  \directlua{
    local n = tex.box[0].head
    local w, st, sh = 0, 0, 0
    while n do
      if n.id == node.id("glue") then
        w, st, sh = w + n.width, st + (n.stretch or 0), sh + (n.shrink or 0)
      elseif n.id == node.id("kern") then
        w = w + n.kern
      else
        w = w + (n.width or 0)
      end
      n = n.next
    end
    texio.write_nl("term and log", "DIM w=" .. w .. " st=" .. st .. " sh=" .. sh)
  }%
}

\def\ink{%
  \directlua{
    local gl, ru = 0, 0
    local function walk (list)
      while list do
        if list.id == node.id("glyph") then
          gl = gl + 1
        elseif list.id == node.id("rule") and (list.width or 0) ~= 0 then
          ru = ru + 1
        elseif list.id == node.id("hlist") or list.id == node.id("vlist") then
          walk(list.head)
        end
        list = list.next
      end
    end
    walk(tex.box[0].head)
    texio.write_nl("term and log", "INK glyph " .. gl .. " rule " .. ru)
  }%
}

\begin{document}

\START

\TEST{the plain underline covers the whole span}{
  \setbox0=\hbox{\CJKunderline{中文}}
  \TYPE{width: \the\wd0}
  \showbox0
}

\TEST{subtract insets both ends by half an em}{
  \setbox0=\hbox{\CJKunderline[subtract]{中文}}
  \TYPE{width: \the\wd0}
  \showbox0
}

\TEST{subtract takes a length}{
  \setbox0=\hbox{\CJKunderline[subtract = 2pt]{中文}}
  \showbox0
}

\TEST{a fully inset span draws no rule}{
  \setbox0=\hbox{\CJKunderline[subtract = 1em]{中文}}
  \showbox0
}

\TEST{skip leaves out the punctuation}{
  \setbox0=\hbox{\CJKunderline[skip]{中，文}}
  \TYPE{width: \the\wd0}
  \showbox0
}

\TEST{skip and subtract can be combined}{
  \setbox0=\hbox{\CJKunderline[skip, subtract = 2pt]{中，文}}
  \showbox0
}

\TEST{the next command starts from the defaults}{
  \setbox0=\hbox{\CJKunderline{中文}}
  \showbox0
}

\TEST{underdblline takes subtract}{
  \setbox0=\hbox{\CJKunderdblline[subtract]{中文}}
  \TYPE{width: \the\wd0}
  \nodes
}

\TEST{underwave takes subtract and skip}{
  \setbox0=\hbox{\CJKunderwave[subtract, skip]{中，文}}
  \TYPE{width: \the\wd0}
  \nodes
}

\TEST{xout takes subtract}{
  \setbox0=\hbox{\CJKxout[subtract]{中文}}
  \TYPE{width: \the\wd0}
  \nodes
}

\TEST{underdot takes subtract}{
  \setbox0=\hbox{\CJKunderdot[subtract]{中文}}
  \TYPE{width: \the\wd0}
  \nodes
}

\TEST{underdot without options keeps the whole span}{
  \setbox0=\hbox{\CJKunderdot{中文}}
  \nodes
}

\TEST{hidden keeps the dimensions and drops the text}{
  \setbox0=\hbox{\CJKunderline[hidden]{中文}}
  \TYPE{width: \the\wd0, height: \the\ht0, depth: \the\dp0}
  \nodes
}

\TEST{hidden takes the ink of a formula out and keeps its dimensions}{
  \setbox0=\hbox{\CJKunderline[hidden]{$\frac{1}{2}$}}
  \TYPE{width: \the\wd0, height: \the\ht0, depth: \the\dp0}
  \ink
  \setbox0=\hbox{\CJKunderline{$\frac{1}{2}$}}
  \TYPE{width: \the\wd0, height: \the\ht0, depth: \the\dp0}
  \ink
}

\TEST{drawn decorations do not add height or depth}{
  \setbox2=\hbox{中文}
  \TYPE{plain: \the\ht2, \the\dp2}
  \setbox0=\hbox{\CJKunderdot{中文}}
  \TYPE{dots: \the\ht0, \the\dp0}
  \setbox0=\hbox{\CJKunderwave{中文}}
  \TYPE{wave: \the\ht0, \the\dp0}
  \setbox0=\hbox{\CJKxout{中文}}
  \TYPE{slash: \the\ht0, \the\dp0}
}

\TEST{each decoration keeps its own settings}{
  \setbox0=\hbox{\CJKunderline[subtract]{中中}x\CJKunderline{文}}
  \nodes
}

\TEST{a decoration ends at the last character it covers}{
  \setbox2=\hbox{ABC}
  \TYPE{argument: \the\wd2}
  \setbox0=\hbox{中\CJKunderline{ABC}文}
  \nodes
}

\TEST{the boundary inside a decoration keeps it whole}{
  \setbox2=\hbox{中A文}
  \TYPE{argument: \the\wd2}
  \setbox0=\hbox{中\CJKunderline{中A文}文}
  \nodes
}

\TEST{a wave ends at the last character it covers}{
  \setbox2=\hbox{ABC}
  \TYPE{argument: \the\wd2}
  \setbox0=\hbox{中\CJKunderwave{ABC}文}
  \nodes
}

\TEST{settings do not leak to another decoration}{
  \setbox0=\hbox{\CJKunderline[subtract]{中}}
  \setbox2=\hbox{\CJKunderanyline{0.3em}{\rule{1pt}{0.4pt}}{中文}}
  \TYPE{span: \the\wd2}
  \directlua{
    local n = tex.box[2].head
    while n do
      if n.id == node.id("glue") and n.subtype == 100 then
        texio.write_nl("term and log", "LEADERS " .. tostring(n.width))
      end
      n = n.next
    end
  }
}

\TEST{a decoration keeps the width, stretch, and shrink of its text}{
  \begingroup
  \LuaCJKsetup{CJKglue = 0pt plus 1fil}
  \setbox0=\hbox{甲乙，丙丁}
  \dimensions
  \setbox0=\hbox{\CJKunderline{甲乙，丙丁}}
  \dimensions
  \setbox0=\hbox{\CJKunderline[skip]{甲乙，丙丁}}
  \dimensions
  \setbox0=\hbox{\CJKunderline[subtract]{甲乙，丙丁}}
  \dimensions
  \setbox0=\hbox{\CJKunderwave[skip]{甲乙，丙丁}}
  \dimensions
  \endgroup
}

\TEST{a kern inside the text moves the cut of skip}{
  \setbox0=\hbox{\CJKunderline[skip]{甲\kern1em，乙}}
  \nodes
  \setbox0=\hbox{\CJKunderline[skip]{甲\hspace{1em}，乙}}
  \nodes
}

\TEST{a pattern built from em units is rebuilt per font size}{
  \setbox0=\hbox{\CJKunderanyline{.2em}{\rule{.5em}{.1em}}{中}}
  \showbox0
  \setbox0=\hbox{\Large\CJKunderanyline{.2em}{\rule{.5em}{.1em}}{中}}
  \showbox0
  \setbox0=\hbox{\CJKunderanyline{.2em}{\rule{.5em}{.1em}}{中}}
  \showbox0
}

\TEST{a rule sized in em keeps its thickness when the size changes}{
  \setbox0=\hbox{\CJKsout{中}}
  \showbox0
  \setbox0=\hbox{\Large\CJKsout{中}}
  \showbox0
}

\TEST{a drawn pattern is repeated with leaders}{
  \setbox0=\hbox{\CJKunderwave{中文测试}}
  \showbox0
  \setbox0=\hbox{\CJKxout{中文}}
  \showbox0
}

\TEST{a decoration is divided into whole patterns when its width is final}{
  \setbox0=\vbox{\hsize=41pt \parindent=0pt \parfillskip=0pt
    \CJKunderwave{中文测试}\par}
  \showbox0
}

\TEST{the copies of a drawn pattern start where its span starts}{
  \setbox0=\vbox{\hsize=103pt \parindent=0pt
    中中\CJKunderwave{中中中中中中中中}%
    中中中中中中中中中中中中中中中中中中\par}
  \directlua{
    local line = tex.box[0].head
    local function x (n)
      return node.dimensions(line.glue_set, line.glue_sign,
        line.glue_order, line.head, n)
    end
    local copies, width, first, last, n = 0, 0, nil, nil, line.head
    while n do
      if n.id == node.id("hlist") and n.head
         and n.head.id == node.id("whatsit") then
        copies = copies + 1
        width  = n.width
        first  = first or x(n)
        last   = n
      end
      n = n.next
    end
    local text = last.next
    while text and text.id ~= node.id("glyph") do text = text.next end
    texio.write_nl("term and log",
      "copies " .. copies .. ", width " .. tostring(width))
    texio.write_nl("term and log",
      "the span starts " .. tostring(x(text) - first)
      .. " sp from the first copy")
  }
}

\TEST{the copies of a symbol start where its span starts}{
  \setbox0=\vbox{\hsize=120pt \parindent=0pt
    x\CJKunderanysymbol{0pt}{*}{字字}%
    \CJKunderdot[symbol = \textbullet]{字}\par}
  \directlua{
    local line = tex.box[0].head
    local function x (n)
      return node.dimensions(line.glue_set, line.glue_sign,
        line.glue_order, line.head, n)
    end
    local function ink (l)
      while l do
        if l.id == node.id("glyph") then
          return true
        end
        if l.id == node.id("hlist") and ink(l.head) then
          return true
        end
        l = l.next
      end
      return false
    end
    local copies, width, first, n = 0, 0, nil, line.head
    while n do
      if n.id == node.id("hlist") and ink(n.head) then
        copies = copies + 1
        width  = n.width
        first  = first or x(n)
      end
      n = n.next
    end
    local text = line.head
    while text and not (text.id == node.id("glyph") and text.char > 127) do
      text = text.next
    end
    texio.write_nl("term and log",
      "copies " .. copies .. ", width " .. tostring(width))
    local start = first and (x(text) - first) or "no"
    texio.write_nl("term and log",
      "the span starts " .. tostring(start) .. " sp from the first copy")
  }
}

\END

\end{document}

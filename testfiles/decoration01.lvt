\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\usepackage{LuaCJKfntef}
\setCJKmainfont{FandolSong-Regular.otf}
\showboxbreadth = 100
\showboxdepth = 100

\def\nodes{%
  \directlua{
    local n = tex.box[0].head
    local out = {}
    local i = 0
    while n do
      if n.id == node.id("glue") then
        i = i + 1
        out[i] = (n.subtype == 100 and "leaders:" or "glue:") .. n.width
      elseif n.id == node.id("kern") then
        i = i + 1
        out[i] = "kern:" .. n.kern
      elseif n.id == node.id("glyph") then
        i = i + 1
        out[i] = "glyph"
      end
      n = n.next
    end
    texio.write_nl("term and log", "NODES " .. table.concat(out, " "))
  }%
}

\begin{document}

\START

\TEST{the plain underline covers the whole span}{
  \setbox0=\hbox{\CJKunderline{中文}}
  \TYPE{width: \the\wd0}
  \showbox0
}

\TEST{subtract insets both ends by half an em}{
  \setbox0=\hbox{\CJKunderline[subtract]{中文}}
  \TYPE{width: \the\wd0}
  \showbox0
}

\TEST{subtract takes a length}{
  \setbox0=\hbox{\CJKunderline[subtract = 2pt]{中文}}
  \showbox0
}

\TEST{a fully inset span draws no rule}{
  \setbox0=\hbox{\CJKunderline[subtract = 1em]{中文}}
  \showbox0
}

\TEST{skip leaves out the punctuation}{
  \setbox0=\hbox{\CJKunderline[skip]{中，文}}
  \TYPE{width: \the\wd0}
  \showbox0
}

\TEST{skip and subtract can be combined}{
  \setbox0=\hbox{\CJKunderline[skip, subtract = 2pt]{中，文}}
  \showbox0
}

\TEST{the next command starts from the defaults}{
  \setbox0=\hbox{\CJKunderline{中文}}
  \showbox0
}

\TEST{underdblline takes subtract}{
  \setbox0=\hbox{\CJKunderdblline[subtract]{中文}}
  \TYPE{width: \the\wd0}
  \nodes
}

\TEST{underwave takes subtract and skip}{
  \setbox0=\hbox{\CJKunderwave[subtract, skip]{中，文}}
  \TYPE{width: \the\wd0}
  \nodes
}

\TEST{xout takes subtract}{
  \setbox0=\hbox{\CJKxout[subtract]{中文}}
  \TYPE{width: \the\wd0}
  \nodes
}

\TEST{underdot takes subtract}{
  \setbox0=\hbox{\CJKunderdot[subtract]{中文}}
  \TYPE{width: \the\wd0}
  \nodes
}

\TEST{underdot without options keeps the whole span}{
  \setbox0=\hbox{\CJKunderdot{中文}}
  \nodes
}

\TEST{hidden keeps the dimensions and drops the text}{
  \setbox0=\hbox{\CJKunderline[hidden]{中文}}
  \TYPE{width: \the\wd0, height: \the\ht0, depth: \the\dp0}
  \nodes
}

\TEST{drawn decorations do not add height or depth}{
  \setbox2=\hbox{中文}
  \TYPE{plain: \the\ht2, \the\dp2}
  \setbox0=\hbox{\CJKunderdot{中文}}
  \TYPE{dots: \the\ht0, \the\dp0}
  \setbox0=\hbox{\CJKunderwave{中文}}
  \TYPE{wave: \the\ht0, \the\dp0}
  \setbox0=\hbox{\CJKxout{中文}}
  \TYPE{slash: \the\ht0, \the\dp0}
}

\TEST{each decoration keeps its own settings}{
  \setbox0=\hbox{\CJKunderline[subtract]{中}x\CJKunderline{文}}
  \nodes
}

\TEST{settings do not leak to another decoration}{
  \setbox0=\hbox{\CJKunderline[subtract]{中}}
  \setbox2=\hbox{\CJKunderanyline{0.3em}{\rule{1pt}{0.4pt}}{中文}}
  \TYPE{span: \the\wd2}
  \directlua{
    local n = tex.box[2].head
    while n do
      if n.id == node.id("rule") then
        texio.write_nl("term and log", "RULE " .. tostring(n.width))
      end
      n = n.next
    end
  }
}

\END

\end{document}

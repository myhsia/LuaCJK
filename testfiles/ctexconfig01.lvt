\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}

\begin{document}

\START

% The redirect only touches the variable that ctex itself defines, so the
% test defines it first, exactly as ctex would have done.
\ExplSyntaxOn
\cs_new_protected:Npn \testsetupengine
  { \cs_set_nopar:Npn \c__ctex_engine_file_str { other-engine.def } }
% ctex reads the redirect from a package that \cs{ProvidesExplPackage} has
% put under \cs{ExplSyntaxOn}, so the file is read with the underscore and the
% colon as letters.
\cs_new_protected:Npn \testreadengine
  {
    \group_begin:
      \ExplSyntaxOn
      \input { ctexcfg / ctexopts.cfg }
      \ExplSyntaxOff
      \cs_show:N \c__ctex_engine_file_str
    \group_end:
  }
% The generated file goes into a subdirectory, so that the redirect in
% testsupport/ stays where it is and the other tests keep using it.
\lua_now:e { lfs.mkdir ( "ctexcfg" ) }
\LuaCJKwriteCtexConfig*[ctexcfg]
\file_if_exist:nTF { ctexcfg / ctexopts.cfg }
  { \iow_term:x { FILE~ctexcfg/ctexopts.cfg~exists } }
  { \iow_term:x { FILE~ctexcfg/ctexopts.cfg~MISSING } }
\ExplSyntaxOff

% The whole file: ctex reads every byte of the redirect, so the golden file
% records the four lines it writes.
\newread\ctexcfgfile
\openin\ctexcfgfile=ctexcfg/ctexopts.cfg
\TEST{the written file}{
  \read\ctexcfgfile to \ctexcfgline
  \typeout{LINE-1: \detokenize\expandafter{\ctexcfgline}}
  \read\ctexcfgfile to \ctexcfgline
  \typeout{LINE-2: \detokenize\expandafter{\ctexcfgline}}
  \read\ctexcfgfile to \ctexcfgline
  \typeout{LINE-3: \detokenize\expandafter{\ctexcfgline}}
  \read\ctexcfgfile to \ctexcfgline
  \typeout{LINE-4: \detokenize\expandafter{\ctexcfgline}}
}
\closein\ctexcfgfile

\TEST{the file redirects ctex}{
  \testsetupengine
  \testreadengine
}

\TEST{a second call without the star leaves the file alone}{
  \LuaCJKwriteCtexConfig[ctexcfg]
}

\TEST{the star overwrites it}{
  \LuaCJKwriteCtexConfig*[ctexcfg]
  \testsetupengine
  \testreadengine
}

\END

\end{document}

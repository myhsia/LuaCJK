\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\setCJKmainfont{FandolSong-Regular.otf}
\parindent=0pt

% Report every line of box 0 as its nodes: a glyph by code point, a rule (R),
% a kern (k), and a glue (g) by width/stretch/shrink, in scaled points.
% A rule of negative width is the blank that a mark leaves in the margin.
\def\showlines{%
  \directlua{
    local digits = "0123456789ABCDEF"
    local function hex (n)
      local out, count = {}, 0
      repeat
        count = count + 1
        local d = math.fmod(n, 16) + 1
        out[count] = digits:sub(d, d)
        n = math.floor(n / 16)
      until n == 0
      local s = ""
      for i = count, 1, -1 do s = s .. out[i] end
      while string.len(s) < 4 do s = "0" .. s end
      return s
    end
    local function nodes (head)
      local parts, count = {}, 0
      local n = head
      while n do
        local item = nil
        if n.id == node.id("glyph") then
          item = hex(n.char)
        elseif n.id == node.id("rule") then
          item = "R" .. tostring(n.width)
        elseif n.id == node.id("kern") then
          item = "k" .. tostring(n.kern)
        elseif n.id == node.id("glue") then
          item = "g" .. tostring(n.width) .. "/"
            .. tostring(n.stretch) .. "/" .. tostring(n.shrink)
        elseif n.id == node.id("penalty") then
          item = "p" .. tostring(n.penalty)
        elseif n.id == node.id("hlist") then
          item = "B" .. nodes(n.head)
        end
        if item then
          count = count + 1
          parts[count] = item
        end
        n = n.next
      end
      return table.concat(parts, " ", 1, count)
    end
    local lines, nlines = {}, 0
    local line = tex.box[0].head
    while line do
      if line.id == node.id("hlist") then
        nlines = nlines + 1
        lines[nlines] = tostring(line.width) .. " " .. nodes(line.head)
      end
      line = line.next
    end
    texio.write_nl("term and log",
      "LINES " .. table.concat(lines, " | ", 1, nlines))
  }%
}

\begin{document}

\START

\TEST{a mark inside a line keeps a pair that cancels}{
  \setbox0=\vbox{\hsize=20em 中。文\par}
  \showlines
}

\TEST{the hang lets the mark end the first line}{
  \begingroup
    \LuaCJKsetup{AllowBreakBetweenPuncts = true}
    \setbox0=\vbox{\hsize=92pt 这句话“引用完毕。”他说\par}
    \showlines
  \endgroup
}

\TEST{a line-initial opening mark leaves its blank in the margin}{
  \setbox0=\vbox{\hsize=4em 中文中文（中文\par}
  \showlines
}

\TEST{a bound width also decides what fits}{
  \begingroup
    \LuaCJKsetup{PunctBoundWidth = 0.3em, AllowBreakBetweenPuncts = true}
    \setbox0=\vbox{\hsize=92pt 这句话“引用完毕。”他说\par}
    \showlines
  \endgroup
}

\TEST{the plain style does not hang}{
  \begingroup
    \LuaCJKsetup{PunctStyle = plain}
    \setbox0=\vbox{\hsize=2em 中。文\par}
    \showlines
  \endgroup
}

\TEST{a compressed mark hangs by its own advance}{
  \begingroup
    \LuaCJKsetup{PunctStyle = banjiao}
    \setbox0=\vbox{\hsize=1.25em 中。文\par}
    \showlines
  \endgroup
}

\END

\end{document}

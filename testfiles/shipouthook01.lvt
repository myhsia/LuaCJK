\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\setCJKmainfont{FandolSong-Regular.otf}

\begin{document}

\START

\TEST{the hook adds code to shipout/before}{
  \LuaCJKShipoutHook { \typeout { SHIPOUT HOOK RAN } }
  \ShowHook { shipout/before }
}

\TEST{the hook can take more than one chunk}{
  \LuaCJKShipoutHook { \typeout { SECOND } }
  \ShowHook { shipout/before }
}

\END

\end{document}

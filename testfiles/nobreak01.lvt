\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\setCJKmainfont{LXGWNeoZhiSong.ttf}

\def\countpenalties{%
  \directlua{
    local n = tex.box[0].head
    local c = 0
    while n do
      if n.id == node.id("penalty") and n.penalty >= 10000 then
        c = c + 1
      end
      n = n.next
    end
    texio.write_nl("term and log", "PENALTIES " .. tostring(c))
  }%
}

\def\chars{%
  \directlua{
    local out = {}
    local function walk(n)
      while n do
        if n.id == node.id("glyph") then
          table.insert(out, n.char)
        elseif n.id == node.id("hlist") or n.id == node.id("vlist") then
          walk(n.head)
        end
        n = n.next
      end
    end
    walk(tex.box[0].head)
    texio.write_nl("term and log", "CHARS " .. table.concat(out, ","))
  }%
}

\begin{document}

\START

\TEST{three CJK characters have two break points}{
  \setbox0=\hbox{中中中}
  \countpenalties
}

\TEST{LuaCJKnobreak forbids them}{
  \setbox0=\hbox{\LuaCJKnobreak{中中中}}
  \countpenalties
}

\TEST{a CJK and a Latin letter have two break points}{
  \setbox0=\hbox{中x中}
  \countpenalties
}

\TEST{LuaCJKnobreak forbids those as well}{
  \setbox0=\hbox{\LuaCJKnobreak{中x中}}
  \countpenalties
}

\TEST{the marking is local to the group}{
  \begingroup
    \LuaCJKnobreak{中}
    \setbox0=\hbox{中中中}
    \countpenalties
  \endgroup
  \TYPE{survived}
}

\TEST{a quad is a break opportunity of its own}{
  \setbox0=\hbox{中\quad 中}
  \countpenalties
}

\TEST{LuaCJKnobreak forbids the break at it}{
  \setbox0=\hbox{\LuaCJKnobreak{中\quad 中}}
  \countpenalties
}

\TEST{the prohibition covers the inside and not the two edges}{
  \setbox0=\hbox{中\LuaCJKnobreak{中中}中}
  \countpenalties
}

\TEST{the break in front of the argument is free as well}{
  \setbox0=\hbox{中中\LuaCJKnobreak{中}}
  \countpenalties
}

\TEST{a digit that begins the argument stays in the text}{
  \setbox0=\hbox{\LuaCJKnobreak{34中中中}}
  \chars
}

\END

\end{document}

\documentclass{article}
\usepackage{LuaCJK}
\usepackage{listings}
\setCJKmainfont{LXGWNeoZhiSong.ttf}
\lstset{basicstyle=\ttfamily, columns=fixed}

\makeatletter
\def\listingorder#1{%
  \directlua{
    local function walk (n, out)
      while n do
        if n.id == node.id("glyph") then
          table.insert(out, n.char)
        elseif n.id == node.id("hlist") or n.id == node.id("vlist") then
          walk(n.head, out)
        end
        n = n.next
      end
      return out
    end
    local out = {}
    walk(tex.box[#1].head, out)
    texio.write_nl("term and log", "ORDER " .. table.concat(out, ","))
  }%
}
\def\listingcontent#1{%
  \directlua{
    local function hasglyph (n)
      while n do
        if n.id == node.id("glyph") then
          return true
        elseif n.id == node.id("hlist") or n.id == node.id("vlist") then
          if hasglyph(n.head) then
            return true
          end
        end
        n = n.next
      end
      return false
    end
    local line = tex.box[#1].head
    while line and line.id ~= node.id("hlist") do
      line = line.next
    end
    local total = 0
    local n = line and line.head
    while n do
      if (n.id == node.id("hlist") or n.id == node.id("vlist"))
         and hasglyph(n.head) then
        total = total + n.width
      end
      n = n.next
    end
    texio.write_nl("term and log", "CONTENT " .. tostring(total))
  }%
}
\def\listinglines#1{%
  \directlua{
    local function walk (n, out)
      while n do
        if n.id == node.id("glyph") then
          out = out .. "," .. n.char
        elseif n.id == node.id("hlist") or n.id == node.id("vlist") then
          out = walk(n.head, out)
        end
        n = n.next
      end
      return out
    end
    local line = tex.box[#1].head
    local index = 0
    while line do
      if line.id == node.id("hlist") then
        local chars = walk(line.head, "")
        if chars ~= "" then
          index = index + 1
          texio.write_nl("term and log", "LINE " .. index .. chars)
        end
      end
      line = line.next
    end
  }%
}
\makeatother

\begin{document}

\setbox0=\vbox{\begin{lstlisting}
printf("中文");
\end{lstlisting}}

\setbox2=\vbox{\begin{lstlisting}
a中b
\end{lstlisting}}

\setbox4=\vbox{\begin{lstlisting}
aaab
\end{lstlisting}}

\setbox6=\vbox{\begin{lstlisting}
中“文”
\end{lstlisting}}

\setbox8=\vbox{\begin{lstlisting}
中！文
\end{lstlisting}}

\newbox\breakbox
\setbox\breakbox=\vbox{\begin{lstlisting}[breaklines,linewidth=8em]
# 检查用户输入的数据
\end{lstlisting}}

\newbox\flexbox
\setbox\flexbox=\vbox{\begin{lstlisting}[columns=fullflexible]
x1 = 12
\end{lstlisting}}

\START

\TEST{LuaCJK-listings is loaded together with listings}{
  \csname ver@LuaCJK-listings.sty\endcsname
  \TYPE{loaded}
}

\TEST{a block listing keeps the CJK characters in place}{
  \listingorder{0}
}

\TEST{a CJK character takes two columns}{
  \listingcontent{2}
  \listingcontent{4}
}

\TEST{a mark the CJK class shares with Latin keeps its place}{
  \listingorder{6}
  \listingcontent{6}
}

\TEST{a CJK range includes its first code point}{
  \listingorder{8}
  \listingcontent{8}
}

\TEST{a run of CJK characters breaks between characters with breaklines}{
  \listinglines{\number\breakbox}
}

\TEST{a word block keeps the number that follows it with fullflexible}{
  \listingorder{\number\flexbox}
}

\TEST{lstinline is left alone}{
  \setbox0=\hbox{\lstinline|int 数 = 2;|}
  \TYPE{survived}
}

\END

\end{document}

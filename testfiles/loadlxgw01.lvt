\input{regression-test}

\documentclass{article}
\usepackage[LoadLXGW = true]{LuaCJK}

\def\psname#1{%
  \directlua{
    local n = tex.box[#1].head
    while n do
      if n.id == node.id("glyph") then
        local f = font.getfont(n.font)
        texio.write_nl("term and log", "PSNAME " .. tostring(f and f.psname))
        break
      end
      n = n.next
    end
  }%
}

\begin{document}

\START

\TEST{the main CJK font is LXGW Neo ZhiSong}{
  \setbox0=\hbox{中}
  \psname{0}
}

\TEST{the bold shape is faked in Neo ZhiSong}{
  \setbox0=\hbox{\bfseries 中}
  \psname{0}
}

\TEST{the heiti shortcut is LXGW Neo XiHei}{
  \setbox2=\hbox{\heiti 中}
  \psname{2}
}

\TEST{the kaiti shortcut is LXGW WenKai}{
  \setbox4=\hbox{\kaishu 中}
  \psname{4}
}

\TEST{the fangsong shortcut is Zhuque Fangsong}{
  \setbox6=\hbox{\fangsong 中}
  \psname{6}
}

\TEST{the italic shape is LXGW WenKai}{
  \setbox8=\hbox{\itshape 中}
  \psname{8}
}

\TEST{emph sets the CJK text in LXGW WenKai}{
  \setbox10=\hbox{\emph{中}}
  \psname{10}
}

\TEST{the songti shortcut keeps the italic face}{
  \setbox12=\hbox{\songti\itshape 中}
  \psname{12}
}

\TEST{the bold italic shape is ZhenKai Slab}{
  \setbox16=\hbox{\songti\bfseries\itshape 中}
  \psname{16}
}

\TEST{the heiti family takes fake slant}{
  \setbox14=\hbox{\heiti\itshape 中}
  \psname{14}
}

\END

\end{document}

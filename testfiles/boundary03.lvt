\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\usepackage{xcolor}
\setCJKmainfont[BoldFont = LXGWZhenKaiSlabGB-Regular.ttf]{LXGWNeoZhiSong.ttf}
\LuaCJKsetup{CJKglue = 10pt, CJKecglue = 5pt, CJKspace = false}

% The nodes of a horizontal box, one token each.
\directlua{
  function reportlist (n)
    local cur = tex.box[n].head
    local out, k = {}, 0
    while cur do
      local d
      if cur.id == node.id("glyph") then
        d = "g" .. utf8.char(cur.char)
      elseif cur.id == node.id("glue") then
        d = "glue " .. cur.width .. "/" .. cur.stretch .. "/" ..
            cur.shrink .. "/" .. cur.subtype
      elseif cur.id == node.id("kern") then
        d = "kern " .. cur.kern
      elseif cur.id == node.id("penalty") then
        d = "pen " .. cur.penalty
      elseif cur.id == node.id("hlist") or cur.id == node.id("vlist") then
        d = "box " .. cur.width
      else
        d = "id" .. cur.id
      end
      k = k + 1
      out[k] = d
      cur = cur.next
    end
    texio.write_nl("term and log", "LIST: " .. table.concat(out, " "))
  end
}

% The last glyph of the first line of a vertical box.
\directlua{
  function lastglyphof (n)
    local line = tex.box[n].head
    while line and line.id ~= node.id("hlist") do
      line = line.next
    end
    local cur = line and line.head
    local last
    while cur do
      if cur.id == node.id("glyph") then
        last = cur.char
      end
      cur = cur.next
    end
    texio.write_nl("term and log", "LAST-GLYPH: " ..
      (last and utf8.char(last) or "none"))
  end
}

\def\report#1{\directlua{reportlist(#1)}}
\def\lastglyph#1{\directlua{lastglyphof(#1)}}

\setbox0=\hbox{中 中}
\setbox2=\hbox{中中}
\setbox4=\hbox{中。
文}

\setbox6=\vbox{\hsize=90pt \noindent 中中中中。
文}

% A box of no advance is not a boundary of its own: the space in front of it
% belongs to the boundary of the two characters it stands between.  The boxes
% are declared before the block that keeps the source spaces, because a
% register that is not allocated takes the next number.
\newbox\keptspacebox
\newbox\nospacebox
\newbox\leftspacebox
\newbox\rightspacebox
\newbox\twospacesbox
\newbox\boxlatinbox
\newbox\plainlatinbox

\begingroup
  \LuaCJKsetup{CJKspace = true}
  \global\setbox8=\hbox{中 中}
  \global\setbox\keptspacebox=\hbox{中 \mbox{} 文}
\endgroup

% Allocated rather than numbered: box 10 is \tn{voidb@x}, and \tn{nobreakspace}
% expands to \tn{leavevmode}, which unpacks that register into the list.
\newbox\movedspacebox
\setbox\movedspacebox=\hbox{中 \textbf{中}}

\newbox\explicitspacebox
\newbox\nobreakspacebox
\newbox\latinspacebox
\setbox\explicitspacebox=\hbox{中\ 中}
\setbox\nobreakspacebox=\hbox{中~中}
\setbox\latinspacebox=\hbox{a\ b}

% The color change puts a whatsit between the space and the character.
\newbox\tildelatinbox
\newbox\colortildelatinbox
\newbox\colorsourcebox
\setbox\tildelatinbox=\hbox{中~A}
\setbox\colortildelatinbox=\hbox{中~\textcolor{red}{A}}
\setbox\colorsourcebox=\hbox{中 \textcolor{red}{中}}
\setbox\nospacebox=\hbox{中\mbox{}文}
\setbox\leftspacebox=\hbox{中 \mbox{}文}
\setbox\rightspacebox=\hbox{中\mbox{} 文}
\setbox\twospacesbox=\hbox{中 \mbox{} 文}
\setbox\boxlatinbox=\hbox{中 \mbox{}A}
\setbox\plainlatinbox=\hbox{中 A}

\begin{document}

\START

\TEST{a source space between CJK characters becomes the inter-character glue}{
  \report{0}
  \TYPE{with space: \the\wd0}
  \TYPE{without space: \the\wd2}
}

\TEST{a source space after a mark is the same boundary}{
  \report{4}
}

\TEST{the inter-character glue carries the break opportunity}{
  \lastglyph{6}
}

\TEST{CJKspace keeps the space instead of the glue}{
  \report{8}
  \TYPE{with space: \the\wd8}
}

\TEST{a moved space is still the inter-character glue}{
  \report{\number\movedspacebox}
  \TYPE{with space: \the\wd\movedspacebox}
}

\TEST{an explicit space between CJK characters keeps its advance}{
  \report{\number\explicitspacebox}
  \TYPE{explicit: \the\wd\explicitspacebox}
  \report{\number\nobreakspacebox}
  \TYPE{nobreakspace: \the\wd\nobreakspacebox}
}

\TEST{an explicit space between Latin characters is unchanged}{
  \report{\number\latinspacebox}
  \TYPE{latin: \the\wd\latinspacebox}
}

\TEST{a color change does not hide an explicit space}{
  \report{\number\colortildelatinbox}
  \TYPE{plain:   \the\wd\tildelatinbox}
  \TYPE{colored: \the\wd\colortildelatinbox}
}

\TEST{a color change does not hide a source space}{
  \report{\number\colorsourcebox}
  \TYPE{plain:   \the\wd0}
  \TYPE{colored: \the\wd\colorsourcebox}
}

\TEST{an empty box does not separate the two sides of a boundary}{
  \report{\number\nospacebox}
  \report{\number\leftspacebox}
  \report{\number\rightspacebox}
  \report{\number\twospacesbox}
  \TYPE{none:   \the\wd\nospacebox}
  \TYPE{left:   \the\wd\leftspacebox}
  \TYPE{right:  \the\wd\rightspacebox}
  \TYPE{both:   \the\wd\twospacesbox}
  \TYPE{direct: \the\wd0}
  \report{\number\keptspacebox}
  \TYPE{kept:   \the\wd\keptspacebox}
}

\TEST{an empty box in front of Latin text keeps the source space}{
  \report{\number\boxlatinbox}
  \report{\number\plainlatinbox}
  \TYPE{with box: \the\wd\boxlatinbox}
  \TYPE{direct:   \the\wd\plainlatinbox}
}

\END

\end{document}

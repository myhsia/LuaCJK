\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\setCJKmainfont{FandolSong-Regular.otf}
\LuaCJKsetup{CJKglue = 0pt, CJKecglue = 0pt}

\def\countpenalties{%
  \directlua{
    local n = tex.box[0].head
    local c = 0
    while n do
      if n.id == node.id("penalty") and n.penalty >= 10000 then
        c = c + 1
      end
      n = n.next
    end
    texio.write_nl("term and log", "PENALTIES " .. tostring(c))
  }%
}

\begin{document}

\START

\TEST{two commas are compressed by default}{
  \setbox0=\hbox{字，，字}
  \TYPE{width: \the\wd0}
}

\TEST{LongPunct+ exempts a mark from compression}{
  \LuaCJKsetup{LongPunct+ = {"FF0C}}
  \setbox0=\hbox{字，，字}
  \TYPE{width: \the\wd0}
}

\TEST{two long marks are not broken between}{
  \setbox0=\hbox{字——字}
  \countpenalties
}

\TEST{NoBreakLongPunct can empty that set}{
  \begingroup
    \LuaCJKsetup{NoBreakLongPunct = {}}
    \setbox0=\hbox{字——字}
    \countpenalties
  \endgroup
}

\TEST{kaiming keeps the full stop at full width}{
  \begingroup
    \LuaCJKsetup{PunctStyle = kaiming}
    \setbox0=\hbox{字。字}
    \TYPE{width: \the\wd0}
  \endgroup
}

\TEST{KaiMingPunct- removes a mark from that set}{
  \begingroup
    \LuaCJKsetup{PunctStyle = kaiming, KaiMingPunct- = {"3002}}
    \setbox0=\hbox{字。字}
    \TYPE{width: \the\wd0}
  \endgroup
}

\TEST{MiddlePunct makes a mark unable to start a line}{
  \begingroup
    \LuaCJKsetup{MiddlePunct = {"FF0C}}
    \setbox0=\hbox{字，字}
    \countpenalties
  \endgroup
}

\END

\end{document}

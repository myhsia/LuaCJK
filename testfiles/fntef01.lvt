\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\usepackage{LuaCJKfntef}
\setCJKmainfont{FandolSong-Regular.otf}

\begin{document}

\START

\TEST{underline keeps the text width}{
  \setbox0=\hbox{\CJKunderline{中文 test 中文}}
  \setbox2=\hbox{中文 test 中文}
  \TYPE{underlined: \the\wd0}
  \TYPE{plain: \the\wd2}
  \TYPE{depth difference: \the\dimexpr\dp0-\dp2\relax}
}

\TEST{underline accepts the star and the dash}{
  \setbox0=\hbox{\CJKunderline*{中文}}
  \setbox2=\hbox{\CJKunderline-{中文}}
  \TYPE{star: \the\wd0}
  \TYPE{dash: \the\wd2}
}

\TEST{strike-through keeps the text width}{
  \setbox0=\hbox{\CJKsout{中文 test}}
  \setbox2=\hbox{中文 test}
  \TYPE{struck: \the\wd0}
  \TYPE{plain: \the\wd2}
}

\TEST{emphasis dots keep the text width}{
  \setbox0=\hbox{\CJKunderdot{中文 test}}
  \setbox2=\hbox{中文 test}
  \TYPE{dotted: \the\wd0}
  \TYPE{plain: \the\wd2}
  \TYPE{depth difference: \the\dimexpr\dp0-\dp2\relax}
}

\TEST{nested effects}{
  \setbox0=\hbox{\CJKunderline{\CJKunderdot{中文}}}
  \setbox2=\hbox{中文}
  \TYPE{nested: \the\wd0}
  \TYPE{plain: \the\wd2}
}

\TEST{effects in a paragraph}{
  \setbox0=\vbox{\hsize=4em \CJKunderline{中文中文中文中文}\par}
  \directlua{
    local n = tex.box[0].head
    local c = 0
    while n do
      if node.type(n.id) == "hlist" then
        c = c + 1
      end
      n = n.next
    end
    texio.write_nl("term and log", "LINES " .. tostring(c))
  }
}

\TEST{each effect uses one continuous leader run}{
  \setbox0=\hbox{\CJKunderline{中文 test 中文}}
  \setbox2=\hbox{\CJKunderdot{中文 test 中文}}
  \setbox4=\hbox{\CJKsout{中文 test 中文}}
  \setbox6=\hbox{\CJKunderdot{中文，中文}}
  \directlua{
    local function leaders (box)
      local n = tex.box[box].head
      local c = 0
      while n do
        if n.id == node.id("glue") and n.subtype == 100 then
          c = c + 1
        end
        n = n.next
      end
      return c
    end
    texio.write_nl("term and log", "RUNS underline " .. tostring(leaders(0)))
    texio.write_nl("term and log", "RUNS dots " .. tostring(leaders(2)))
    texio.write_nl("term and log", "RUNS strike " .. tostring(leaders(4)))
    texio.write_nl("term and log", "RUNS dots-punct " .. tostring(leaders(6)))
  }
}

\TEST{double underline, wave, and xout keep the text width}{
  \setbox0=\hbox{中\CJKunderdblline{文 test 文}中}
  \setbox2=\hbox{中文 test 文中}
  \TYPE{double: \the\wd0}
  \TYPE{plain: \the\wd2}
}

\TEST{each new effect uses continuous leaders}{
  \setbox0=\hbox{\CJKunderdblline{中文 test 中文}}
  \setbox2=\hbox{\CJKunderwave{中文 test 中文}}
  \setbox4=\hbox{\CJKxout{中文 test 中文}}
  \directlua{
    local function leaders (box)
      local n = tex.box[box].head
      local c = 0
      while n do
        if n.id == node.id("glue") and n.subtype == 100 then
          c = c + 1
        end
        n = n.next
      end
      return c
    end
    texio.write_nl("term and log", "RUNS double " .. tostring(leaders(0)))
    texio.write_nl("term and log", "RUNS wave " .. tostring(leaders(2)))
    texio.write_nl("term and log", "RUNS xout " .. tostring(leaders(4)))
  }
}

\TEST{anyline and anysymbol keep the text width}{
  \setbox0=\hbox{中\CJKunderanyline{0.5ex}{\rule{1.5pt}{2.5ex}}{文 test 文}中}
  \setbox2=\hbox{中\CJKunderanysymbol{0.2em}{\tiny$\triangle$}{文 test 文}中}
  \setbox4=\hbox{中文 test 文中}
  \TYPE{anyline: \the\wd0}
  \TYPE{anysymbol: \the\wd2}
  \TYPE{plain: \the\wd4}
}

\TEST{anyline fills the span with one rule}{
  \setbox0=\hbox{\CJKunderanyline{0.5ex}{\rule{1.5pt}{2.5ex}}{中文 test 中文}}
  \setbox2=\hbox{\CJKunderanysymbol{0.2em}{\tiny$\triangle$}{中文 test 中文}}
  \TYPE{span: \the\wd0}
  \directlua{
    local n = tex.box[0].head
    local rules = 0
    while n do
      if n.id == node.id("rule") then
        rules = rules + 1
        texio.write_nl("term and log", "RULE " .. tostring(n.width))
      end
      n = n.next
    end
    local g = tex.box[2].head
    local leaders = 0
    while g do
      if g.id == node.id("glue") and g.subtype == 100 then
        leaders = leaders + 1
      end
      g = g.next
    end
    texio.write_nl("term and log", "RULES anyline " .. tostring(rules))
    texio.write_nl("term and log", "RUNS anysymbol " .. tostring(leaders))
  }
}

\def\reporule#1{
  \directlua{
    local n = tex.box[#1].head
    while n do
      if n.id == node.id("glue") and n.subtype == 100 and n.leader then
        local l = n.leader
        texio.write_nl("term and log",
          "LEADER width=" .. tostring(l.width) ..
          " height=" .. tostring(l.height) ..
          " depth=" .. tostring(l.depth))
      end
      n = n.next
    end
  }
}

\TEST{wave period is half an em and closes the gap}{
  \setbox0=\hbox{\CJKunderwave{中文}}
  \reporule{0}
}

\TEST{wave scales with the font size}{
  \begingroup
    \fontsize{20}{24}\selectfont
    \setbox0=\hbox{\CJKunderwave{中文}}
    \reporule{0}
  \endgroup
}

\TEST{emphasis dots scale with the font size}{
  \setbox0=\hbox{\CJKunderdot{中文}}
  \reporule{0}
  \begingroup
    \fontsize{20}{24}\selectfont
    \setbox2=\hbox{\CJKunderdot{中文}}
    \reporule{2}
  \endgroup
}

\TEST{xout slash scales with the font size}{
  \setbox0=\hbox{\CJKxout{中文}}
  \reporule{0}
  \begingroup
    \fontsize{20}{24}\selectfont
    \setbox2=\hbox{\CJKxout{中文}}
    \reporule{2}
  \endgroup
}

\TEST{strike-through crosses the middle of a CJK glyph}{
  \setbox0=\hbox{\CJKsout{中文}}
  \reporule{0}
  \setbox2=\hbox{\CJKsout[height = .5ex]{中文}}
  \reporule{2}
}

\END

\end{document}

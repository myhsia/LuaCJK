\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\setCJKmainfont{FandolSong-Regular.otf}
\LuaCJKsetup{CJKglue=0pt, CJKecglue=0pt}

\begin{document}

\START

\TEST{quanjiao adjacent punctuation}{
  \setbox0=\hbox{字，，字}
  \TYPE{width: \the\wd0}
}

\TEST{quanjiao single punctuation}{
  \setbox0=\hbox{字。字}
  \TYPE{width: \the\wd0}
}

\TEST{quanjiao open-close pair keeps natural blank}{
  \setbox0=\hbox{字「」字}
  \TYPE{width: \the\wd0}
}

% A compression takes the blank the mark carries on its right and no more: the
% fullwidth percent sign is all ink on its right, so the pair keeps its width.
\TEST{quanjiao compression stops at the ink}{
  \setbox0=\hbox{％。}
  \setbox2=\hbox{。。}
  \TYPE{percent: \the\wd0}
  \TYPE{period: \the\wd2}
}

% A newline in the source is a space; between two marks it is retimed to the
% inter-character glue, and the blank of the pair rides in that glue.
\TEST{a space in the source keeps the compression of two marks}{
  \setbox0=\hbox{字，，字}
  \setbox2=\hbox{字，，
字}
  \TYPE{joined: \the\wd0}
  \TYPE{space: \the\wd2}
}

\TEST{a space in the source keeps the blank of a user kern}{
  \LuaCJKsetkern{。}{。}{1em}
  \setbox0=\hbox{字。。字}
  \setbox2=\hbox{字。。
字}
  \TYPE{joined: \the\wd0}
  \TYPE{space: \the\wd2}
}

\TEST{quanjiao long punctuation keeps natural width}{
  \setbox0=\hbox{字——字}
  \setbox2=\hbox{字……字}
  \TYPE{dash: \the\wd0}
  \TYPE{ellipsis: \the\wd2}
}

\TEST{plain disables punctuation compression}{
  \begingroup
    \LuaCJKsetup{PunctStyle=plain}
    \setbox0=\hbox{字，，字}
    \TYPE{width: \the\wd0}
  \endgroup
}

\TEST{custom punctuation style}{
  \LuaCJKDeclarePunctStyle{mine}{adjacent-ratio=0.2}
  \begingroup
    \LuaCJKsetup{PunctStyle=mine}
    \setbox0=\hbox{字，，字}
    \TYPE{width: \the\wd0}
  \endgroup
}

\TEST{unimplemented punctuation style falls back}{
  \LuaCJKsetup{PunctStyle=unknownstyle}
  \setbox0=\hbox{字，，字}
  \TYPE{width: \the\wd0}
}

\TEST{banjiao halves punctuation width}{
  \begingroup
    \LuaCJKsetup{PunctStyle=banjiao}
    \setbox0=\hbox{字，字}
    \setbox2=\hbox{字}
    \TYPE{comma: \the\wd0}
    \TYPE{hanzi: \the\wd2}
  \endgroup
}

% The percent sign's ink nearly fills its advance, so a ratio style has no
% blank to take and the mark keeps its full width.
\TEST{banjiao leaves a mark whose ink fills its advance alone}{
  \begingroup
    \LuaCJKsetup{PunctStyle=banjiao}
    \setbox0=\hbox{％}
    \setbox2=\hbox{字}
    \TYPE{percent: \the\wd0}
    \TYPE{hanzi: \the\wd2}
  \endgroup
}

\TEST{banjiao gives a mark its advance once in a nested box}{
  \begingroup
    \LuaCJKsetup{PunctStyle=banjiao}
    \setbox0=\hbox{\hbox{字，字}}
    \setbox2=\hbox{字，字}
    \TYPE{nested: \the\wd0}
    \TYPE{flat: \the\wd2}
    \directlua{
      local n, kerns = tex.box[0].head.head, 0
      while n do
        if n.id == node.id("kern") then kerns = kerns + 1 end
        n = n.next
      end
      texio.write_nl("term and log", "KERNS " .. tostring(kerns))
    }
  \endgroup
}

\TEST{kaiming keeps final punctuation full width}{
  \begingroup
    \LuaCJKsetup{PunctStyle=kaiming}
    \setbox0=\hbox{字，字}
    \setbox2=\hbox{字。字}
    \TYPE{comma: \the\wd0}
    \TYPE{period: \the\wd2}
  \endgroup
}

\TEST{CCT narrows punctuation}{
  \begingroup
    \LuaCJKsetup{PunctStyle=CCT}
    \setbox0=\hbox{字，字}
    \TYPE{comma: \the\wd0}
  \endgroup
}

\TEST{fixed width style reports no warning}{
  \begingroup
    \LuaCJKsetup{PunctStyle=banjiao}
  \endgroup
}

\def\xoffsetof{%
  \directlua{
    local n = tex.box[0].head
    while n do
      if n.id == node.id("glyph") then
        texio.write_nl("term and log", "XOFFSET " .. tostring(n.xoffset))
      end
      n = n.next
    end
  }%
}

\TEST{hangmobanjiao hangs the line-final mark in the measure}{
  \begingroup
    \LuaCJKsetup{PunctStyle=hangmobanjiao,
      CJKglue=0pt plus 0.08\baselineskip}
    \parindent=0pt
    \setbox0=\vbox{\hsize=2.4em 字字。字字\par}
    \directlua{
      local n = tex.box[0].head
      while n do
        if node.type(n.id) == "hlist" then
          local m = n.head
          local last, hang = nil, 0
          while m do
            if m.id == node.id("glyph") then
              last = m
            elseif m.id == node.id("rule") and m.width < 0 then
              hang = hang - m.width
            end
            m = m.next
          end
          if last then
            texio.write_nl("term and log",
              "LINE " .. tostring(last.char) .. " xoff "
              .. tostring(last.xoffset) .. " hang " .. tostring(hang))
          end
        end
        n = n.next
      end
    }
  \endgroup
}

\TEST{quanjiao does not hang punctuation}{
  \setbox0=\hbox{字。}
  \xoffsetof
}

\TEST{quanjiao restored after group}{
  \begingroup
    \LuaCJKsetup{PunctStyle=plain}
    \setbox0=\hbox{字，，字}
    \TYPE{plain: \the\wd0}
  \endgroup
  \setbox2=\hbox{字，，字}
  \TYPE{quanjiao: \the\wd2}
}

\END

\end{document}

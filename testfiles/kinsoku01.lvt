\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
% The base font joins a pair of em dashes into U+2E3A; these tests read the
% pair as two marks, so the ligature is off.
\setCJKmainfont[RawFeature = -ccmp]{LXGWNeoZhiSong.ttf}
% Neo ZhiSong holds the halfwidth punctuation of the last two tests;
% the probe reads the node list, never the ink.
\LuaCJKsetup{CJKglue=0pt, CJKecglue=0pt}

\def\probe{%
  \directlua{
    local n = tex.box[0].head
    local out = {}
    while n do
      if n.id == node.id("penalty") then
        table.insert(out, "P" .. tostring(n.penalty))
      elseif n.id == node.id("hlist") then
        table.insert(out, "B")
      elseif n.id == node.id("glue") then
        table.insert(out, "g")
      elseif n.id == node.id("kern") then
        table.insert(out, "k")
      elseif n.id == node.id("glyph") then
        table.insert(out, "G")
      end
      n = n.next
    end
    texio.write_nl("term and log", "PROBE " .. table.concat(out, " "))
  }%
}

\def\linefirsts#1{%
  \directlua{
    local function firstchar(n)
      local m = n.head
      while m do
        if m.id == node.id("glyph") then return m.char end
        m = m.next
      end
    end
    local function lastchar(n)
      local m = n.head
      local last
      while m do
        if m.id == node.id("glyph") then last = m.char end
        m = m.next
      end
      return last
    end
    local out = {}
    local n = tex.box[#1].head
    while n do
      if node.type(n.id) == "hlist" then
        table.insert(out, tostring(firstchar(n)))
      end
      n = n.next
    end
    local last = {}
    n = tex.box[#1].head
    while n do
      if node.type(n.id) == "hlist" then
        table.insert(last, tostring(lastchar(n)))
      end
      n = n.next
    end
    texio.write_nl("term and log",
      "LINES " .. table.concat(out, " ") ..
      " / LAST " .. table.concat(last, " "))
  }%
}

\begin{document}

\START

\TEST{closing punctuation cannot start a line}{
  \setbox0=\hbox{字」。}
  \probe
}

\TEST{opening punctuation cannot end a line}{
  \setbox0=\hbox{「字}
  \probe
}

\TEST{long punctuation is one unit}{
  \setbox0=\hbox{字——字}
  \probe
}

\TEST{no line starts with an ellipsis}{
  \begingroup
    \parindent=0pt \raggedright
    \setbox0=\vbox{\hsize=4em 未完待续……\par}
    \linefirsts{0}
  \endgroup
}

\TEST{no line starts with a dash}{
  \begingroup
    \parindent=0pt \raggedright
    \setbox0=\vbox{\hsize=4em 字字字字——\par}
    \linefirsts{0}
  \endgroup
}

\TEST{the break in front of a long run is forbidden}{
  \setbox0=\hbox{字——字}
  \probe
  \setbox0=\hbox{字……字}
  \probe
}

\TEST{AllowBreakBetweenPuncts does not start a line with an ellipsis}{
  \begingroup
    \LuaCJKsetup{AllowBreakBetweenPuncts=true}
    \setbox0=\hbox{字，……字}
    \probe
  \endgroup
}

\TEST{PunctKinsoku=false lets an ellipsis start a line}{
  \begingroup
    \LuaCJKsetup{PunctKinsoku=false}
    \setbox0=\hbox{字……字}
    \probe
  \endgroup
}

\TEST{single comma boundary}{
  \setbox0=\hbox{字，字}
  \probe
}

\TEST{plain style keeps kinsoku}{
  \begingroup
    \LuaCJKsetup{PunctStyle=plain}
    \setbox0=\hbox{字」。}
    \probe
  \endgroup
}

\TEST{PunctKinsoku=false disables penalties}{
  \begingroup
    \LuaCJKsetup{PunctKinsoku=false}
    \setbox0=\hbox{字」。}
    \probe
  \endgroup
}

\TEST{PunctKinsoku restored after group}{
  \begingroup
    \LuaCJKsetup{PunctKinsoku=false}
  \endgroup
  \setbox0=\hbox{字」。}
  \probe
}

\TEST{AllowBreakBetweenPuncts keeps a closing mark out of the line start}{
  \begingroup
    \LuaCJKsetup{AllowBreakBetweenPuncts=true}
    \setbox0=\hbox{字」。}
    \probe
  \endgroup
}

\TEST{a box takes the class of the mark at its edge}{
  \setbox0=\hbox{字（\mbox{字}字）}
  \probe
}

\TEST{latin boundary is not affected}{
  \setbox0=\hbox{字A字}
  \probe
}

\TEST{no line starts with a full stop}{
  \setbox0=\vbox{\hsize=3em 字字字字字字字。\par}
  \linefirsts{0}
}

\TEST{no line ends with an opening bracket}{
  \setbox0=\vbox{\hsize=3em 字字字字字字字「字\par}
  \linefirsts{0}
}

\TEST{no line ends with an opening bracket before a box}{
  \setbox0=\vbox{\hsize=60pt \raggedright 中文中文（\mbox{中文}中文中文）\par}
  \linefirsts{0}
}

\TEST{the percent sign cannot start a line}{
  \setbox0=\hbox{99％}
  \probe
}

\TEST{a percent sign stays with the number it follows}{
  \begingroup
    \parindent=0pt \raggedright
    \setbox0=\vbox{\hsize=4.5em 合格率99％\par}
    \linefirsts{0}
  \endgroup
}

\TEST{a currency prefix cannot end a line}{
  \setbox0=\hbox{字＄9}
  \probe
  \setbox0=\hbox{字￥9}
  \probe
}

\TEST{a currency postfix cannot start a line}{
  \setbox0=\hbox{99￠}
  \probe
}

\TEST{a compatibility mark takes the group of its side}{
  \setbox0=\hbox{字︾}
  \probe
  \setbox0=\hbox{﹁字}
  \probe
}

\TEST{a tilde is a dash}{
  \setbox0=\hbox{字～字}
  \probe
  \setbox0=\hbox{字～～字}
  \probe
}

\TEST{a halfwidth closing mark cannot start a line}{
  \setbox0=\hbox{字｡}
  \probe
  \setbox0=\hbox{字､}
  \probe
  \setbox0=\hbox{字｣}
  \probe
}

\TEST{a halfwidth opening mark cannot end a line}{
  \setbox0=\hbox{｢字}
  \probe
}

\TEST{a word space between two marks offers a break}{
  \setbox0=\hbox{字. (字}
  \probe
}

\TEST{a CJK boundary keeps its prohibition through a space}{
  \setbox0=\hbox{字。（字}
  \probe
  \setbox0=\hbox{字。  （字}
  \probe
}

\TEST{a paragraph may break after a full stop}{
  \begingroup
    \parindent=0pt \raggedright
    \setbox0=\vbox{\hsize=5em Try again. (Why?)\par}
    \linefirsts{0}
  \endgroup
}

\END

\end{document}

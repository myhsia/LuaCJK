\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\usepackage{xcolor,hyperref}
\setCJKmainfont{LXGWNeoZhiSong.ttf}[
  BoldFont   = LXGWZhenKaiSlabGB-Regular.ttf,
  ItalicFont = LXGWWenKaiGBLite-Regular.ttf
]
\LuaCJKsetup{CJKglue=10pt, CJKecglue=5pt}
\makeatletter
\setlength\@tempdima{3em}
\makeatother

\def\countfill#1{%
  \directlua{
    local n = tex.box[#1].head
    local c = 0
    while n do
      if n.id == node.id("glue") and n.stretch_order == 3 then
        c = c + 1
      end
      n = n.next
    end
    texio.write_nl("term and log", "FILL=" .. tostring(c))
  }%
}

% The kinds of the nodes of a box, one letter each.
\directlua{
  function reportkinds (n)
    local kinds = {}
    kinds[node.id("glyph")]   = "g"
    kinds[node.id("glue")]    = "u"
    kinds[node.id("kern")]    = "k"
    kinds[node.id("penalty")] = "p"
    kinds[node.id("disc")]    = "d"
    kinds[node.id("hlist")]   = "b"
    kinds[node.id("vlist")]   = "b"
    local cur, out, i = tex.box[n].head, {}, 0
    while cur do
      local kind = kinds[cur.id]
      if kind then
        i = i + 1
        out[i] = kind
      end
      cur = cur.next
    end
    texio.write_nl("term and log", "LIST: " .. table.concat(out, " "))
  end
}
\def\report#1{\directlua{reportkinds(\number#1)}}

% Allocated rather than numbered: box 10 is \tn{voidb@x}, and \tn{leavevmode}
% unpacks that register into the list.
\newbox\hfillboldbox
\newbox\overlapbox
\newbox\plainbox

\begin{document}

\START

\TEST{adjacent CJK}{
  \setbox0=\hbox{中中}
  \TYPE{width: \the\wd0}
}

\TEST{outer box boundary}{
  \setbox0=\hbox{中\mbox{中}}
  \setbox2=\hbox{中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{nested box boundary}{
  \setbox0=\hbox{\mbox{中}\mbox{中}}
  \setbox2=\hbox{中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{font-switch box boundary}{
  \setbox0=\hbox{中\textbf{中}中}
  \setbox2=\hbox{中中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{color boundary}{
  \setbox0=\hbox{中\textcolor{red}{中}中}
  \setbox2=\hbox{中中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{link boundary}{
  \setbox0=\hbox{中\href{https://example.com}{中}中}
  \setbox2=\hbox{中中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{null boundary}{
  \setbox0=\hbox{中\null 中}
  \setbox2=\hbox{中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{math boundary with CJKecglue}{
  \setbox0=\hbox{中$x$中}
  \begingroup
    \LuaCJKsetup{CJKecglue=0pt}
    \global\setbox2=\hbox{中$x$中}
  \endgroup
  \TYPE{with: \the\wd0}
  \TYPE{without: \the\wd2}
}

\TEST{explicit hskip preserved}{
  \setbox0=\hbox{中\hskip 5pt 中}
  \TYPE{width: \the\wd0}
}

\TEST{explicit hfill preserved}{
  \setbox0=\hbox to 50pt{中\hfill 中}
  \countfill{0}
  \TYPE{width: \the\wd0}
}

\TEST{explicit hfill after a text font command}{
  \setbox\hfillboldbox=\hbox to 50pt{\textbf{中}\hfill 中}
  \countfill{\number\hfillboldbox}
  \TYPE{width: \the\wd\hfillboldbox}
}

\TEST{box last edge reads the text past spacing}{
  \setbox0=\hbox{A\hbox{1}中}
  \setbox2=\hbox{A\hbox{1\kern0pt}中}
  \setbox4=\hbox{A\hbox{1\kern1em}中}
  \setbox6=\hbox{A\hbox{1\hskip1em}中}
  \setbox8=\hbox{A\hbox{1}I}
  \TYPE{glyph edge: \the\wd0}
  \TYPE{zero kern: \the\wd2}
  \TYPE{trailing kern: \the\wd4}
  \TYPE{trailing hskip: \the\wd6}
  \TYPE{glyph edge Latin: \the\wd8}
}

\TEST{a filling glue ends the text at the edge}{
  \setbox0=\hbox{A\hbox{1\hfil}中}
  \setbox2=\hbox{中\mbox{1\hfil}文}
  \setbox4=\hbox{中\mbox{1\hfil}}
  \TYPE{trailing fill: \the\wd0}
  \TYPE{boxed fill: \the\wd2}
  \TYPE{boxed fill alone: \the\wd4}
}

\TEST{an italic correction does not hide the last letter}{
  \setbox0=\hbox{\mbox{\textit{Fig. 1}}中}
  \setbox2=\hbox{\mbox{\textit{Fig. 1}}}
  \TYPE{with CJK: \the\wd0}
  \TYPE{box alone: \the\wd2}
  \TYPE{glue: \the\dimexpr\wd0-\wd2-1em\relax}
}

\TEST{a box that holds no text is Latin}{
  \setbox0=\hbox{中\mbox{\vrule width 2pt height 4pt}文}
  \setbox2=\hbox{\mbox{\vrule width 2pt height 4pt}}
  \TYPE{with CJK: \the\wd0}
  \TYPE{box alone: \the\wd2}
  \TYPE{glue: \the\dimexpr\wd0-\wd2-2em\relax}
}

\TEST{a numberline filling glue takes no glue}{
  \setbox0=\hbox{\numberline{1}中}
  \setbox2=\hbox{\numberline{1}}
  \TYPE{with CJK: \the\wd0}
  \TYPE{box alone: \the\wd2}
  \TYPE{difference: \the\dimexpr\wd0-\wd2\relax}
}

\TEST{box first edge without text}{
  \setbox0=\hbox{中\hbox{1}}
  \setbox2=\hbox{中\hbox{\hfil1}}
  \setbox4=\hbox{中I}
  \setbox6=\hbox{中\hbox{\kern1em 1}}
  \TYPE{glyph edge: \the\wd0}
  \TYPE{leading fill: \the\wd2}
  \TYPE{Latin: \the\wd4}
  \TYPE{leading kern: \the\wd6}
}

\TEST{zero-advance box boundary}{
  \setbox\plainbox=\hbox{中中}
  \setbox\overlapbox=\hbox{中\rlap{A}中}
  \TYPE{rlap: \the\wd\overlapbox}
  \setbox\overlapbox=\hbox{中\llap{A}中}
  \TYPE{llap: \the\wd\overlapbox}
  \TYPE{direct: \the\wd\plainbox}
}

\TEST{parbox last edge}{
  \setbox0=\hbox{A\parbox{1em}{1}中}
  \setbox2=\hbox{A\parbox{1em}{1}I}
  \TYPE{CJK: \the\wd0}
  \TYPE{Latin: \the\wd2}
}

\TEST{an underline takes the glue on both sides}{
  \setbox0=\hbox{中\underline{ABC}文}
  \setbox2=\hbox{\underline{ABC}}
  \setbox4=\hbox{中ABC文}
  \TYPE{underline: \the\wd0}
  \TYPE{box alone: \the\wd2}
  \TYPE{direct: \the\wd4}
}

\TEST{an underline of CJK text keeps the inter-character glue}{
  \setbox0=\hbox{中\underline{中文}文}
  \setbox2=\hbox{\underline{中文}}
  \TYPE{underline: \the\wd0}
  \TYPE{box alone: \the\wd2}
}

\TEST{a vertical box that holds no text is Latin}{
  \setbox0=\hbox{中\vbox{\hrule width 2pt height 4pt}文}
  \setbox2=\hbox{\vbox{\hrule width 2pt height 4pt}}
  \TYPE{with CJK: \the\wd0}
  \TYPE{box alone: \the\wd2}
}

\TEST{sbox measurement}{
  \sbox0{中\mbox{中}}
  \sbox2{中中}
  \TYPE{sbox: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{punctuation takes no CJK--Latin glue}{
  \setbox0=\hbox{A中}
  \setbox2=\hbox{A。}
  \setbox4=\hbox{。A}
  \setbox6=\hbox{A「}
  \TYPE{Latin-CJK: \the\wd0}
  \TYPE{Latin-close: \the\wd2}
  \TYPE{close-Latin: \the\wd4}
  \TYPE{Latin-open: \the\wd6}
}

\TEST{LatinPunct characters keep the glue}{
  \begingroup
    \LuaCJKsetup{LatinPunct}
    \global\setbox0=\hbox{中“}
  \endgroup
  \TYPE{CJK-quote: \the\wd0}
}

\TEST{punctuation inside a box takes no glue}{
  \setbox0=\hbox{A。}
  \setbox2=\hbox{A\mbox{。}}
  \setbox4=\hbox{\mbox{。}A}
  \TYPE{direct: \the\wd0}
  \TYPE{boxed-last: \the\wd2}
  \TYPE{boxed-first: \the\wd4}
}

\TEST{a formula that is one delimiter is that bracket}{
  \setbox0=\hbox{中$\langle$中$\rangle$中}
  \setbox2=\hbox{中$\langle$中}
  \setbox4=\hbox{中$\rangle$中}
  \TYPE{pair: \the\wd0}
  \TYPE{open: \the\wd2}
  \TYPE{close: \the\wd4}
}

\TEST{a formula that is not one delimiter keeps its glue}{
  \setbox0=\hbox{中$\langle x\rangle$中}
  \setbox2=\hbox{中$x$中}
  \setbox4=\hbox{中$+$中}
  \TYPE{two atoms: \the\wd0}
  \TYPE{control: \the\wd2}
  \TYPE{binary: \the\wd4}
}

\TEST{a framed box takes the glue on both sides}{
  \setbox0=\hbox{中\fbox{$x$}}
  \setbox2=\hbox{\fbox{$x$}}
  \setbox4=\hbox{中}
  \TYPE{fbox first: \the\dimexpr\wd0-\wd2-\wd4\relax}
  \setbox0=\hbox{\fbox{$x$}文}
  \setbox4=\hbox{文}
  \TYPE{fbox last: \the\dimexpr\wd0-\wd2-\wd4\relax}
  \setbox0=\hbox{中\framebox{$x$}}
  \setbox2=\hbox{\framebox{$x$}}
  \setbox4=\hbox{中}
  \TYPE{framebox first: \the\dimexpr\wd0-\wd2-\wd4\relax}
  \setbox0=\hbox{\framebox{$x$}文}
  \setbox4=\hbox{文}
  \TYPE{framebox last: \the\dimexpr\wd0-\wd2-\wd4\relax}
}

\TEST{a colour box takes the glue on both sides}{
  \setbox0=\hbox{中\colorbox{yellow}{$x$}}
  \setbox2=\hbox{\colorbox{yellow}{$x$}}
  \setbox4=\hbox{中}
  \TYPE{colorbox first: \the\dimexpr\wd0-\wd2-\wd4\relax}
  \setbox0=\hbox{\colorbox{yellow}{$x$}文}
  \setbox4=\hbox{文}
  \TYPE{colorbox last: \the\dimexpr\wd0-\wd2-\wd4\relax}
  \setbox0=\hbox{中\fcolorbox{red}{yellow}{$x$}}
  \setbox2=\hbox{\fcolorbox{red}{yellow}{$x$}}
  \setbox4=\hbox{中}
  \TYPE{fcolorbox first: \the\dimexpr\wd0-\wd2-\wd4\relax}
  \setbox0=\hbox{\fcolorbox{red}{yellow}{$x$}文}
  \setbox4=\hbox{文}
  \TYPE{fcolorbox last: \the\dimexpr\wd0-\wd2-\wd4\relax}
}

\TEST{a parbox reads the edge its text reaches}{
  \setbox0=\hbox{中\parbox{2em}{abc}}
  \setbox2=\hbox{\parbox{2em}{abc}}
  \setbox4=\hbox{中}
  \TYPE{first: \the\dimexpr\wd0-\wd2-\wd4\relax}
  \setbox0=\hbox{\parbox{2em}{abc}文}
  \setbox4=\hbox{文}
  \TYPE{last: \the\dimexpr\wd0-\wd2-\wd4\relax}
}

\TEST{a colour box keeps its background out of the glue}{
  \setbox0=\hbox{中\colorbox{yellow}{$x$}}
  \report0
  \setbox0=\hbox{中\rlap{*}A}
  \report0
}

\END

\end{document}

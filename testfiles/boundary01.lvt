\input{regression-test}

\documentclass{article}
\usepackage{LuaCJK}
\usepackage{xcolor,hyperref}
\setCJKmainfont{FandolSong-Regular.otf}[
  BoldFont   = FandolSong-Bold.otf,
  ItalicFont = FandolKai-Regular.otf
]
\LuaCJKsetup{CJKglue=10pt, CJKecglue=5pt}

\def\countfill#1{%
  \directlua{
    local n = tex.box[#1].head
    local c = 0
    while n do
      if n.id == node.id("glue") and n.stretch_order == 3 then
        c = c + 1
      end
      n = n.next
    end
    texio.write_nl("term and log", "FILL=" .. tostring(c))
  }%
}

\begin{document}

\START

\TEST{adjacent CJK}{
  \setbox0=\hbox{中中}
  \TYPE{width: \the\wd0}
}

\TEST{outer box boundary}{
  \setbox0=\hbox{中\mbox{中}}
  \setbox2=\hbox{中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{nested box boundary}{
  \setbox0=\hbox{\mbox{中}\mbox{中}}
  \setbox2=\hbox{中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{font-switch box boundary}{
  \setbox0=\hbox{中\textbf{中}中}
  \setbox2=\hbox{中中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{color boundary}{
  \setbox0=\hbox{中\textcolor{red}{中}中}
  \setbox2=\hbox{中中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{link boundary}{
  \setbox0=\hbox{中\href{https://example.com}{中}中}
  \setbox2=\hbox{中中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{null boundary}{
  \setbox0=\hbox{中\null 中}
  \setbox2=\hbox{中中}
  \TYPE{box: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{math boundary with CJKecglue}{
  \setbox0=\hbox{中$x$中}
  \begingroup
    \LuaCJKsetup{CJKecglue=0pt}
    \global\setbox2=\hbox{中$x$中}
  \endgroup
  \TYPE{with: \the\wd0}
  \TYPE{without: \the\wd2}
}

\TEST{explicit hskip preserved}{
  \setbox0=\hbox{中\hskip 5pt 中}
  \TYPE{width: \the\wd0}
}

\TEST{explicit hfill preserved}{
  \setbox0=\hbox to 50pt{中\hfill 中}
  \countfill{0}
  \TYPE{width: \the\wd0}
}

\TEST{box last edge without text}{
  \setbox0=\hbox{A\hbox{1}中}
  \setbox2=\hbox{A\hbox{1\hfil}中}
  \setbox4=\hbox{A\hbox{1\kern1em}中}
  \setbox6=\hbox{A\hbox{1}I}
  \TYPE{glyph edge: \the\wd0}
  \TYPE{trailing fill: \the\wd2}
  \TYPE{trailing kern: \the\wd4}
  \TYPE{glyph edge Latin: \the\wd6}
}

\TEST{box first edge without text}{
  \setbox0=\hbox{中\hbox{1}}
  \setbox2=\hbox{中\hbox{\hfil1}}
  \setbox4=\hbox{中I}
  \TYPE{glyph edge: \the\wd0}
  \TYPE{leading fill: \the\wd2}
  \TYPE{Latin: \the\wd4}
}

\TEST{parbox last edge}{
  \setbox0=\hbox{A\parbox{1em}{1}中}
  \setbox2=\hbox{A\parbox{1em}{1}I}
  \TYPE{CJK: \the\wd0}
  \TYPE{Latin: \the\wd2}
}

\TEST{sbox measurement}{
  \sbox0{中\mbox{中}}
  \sbox2{中中}
  \TYPE{sbox: \the\wd0}
  \TYPE{direct: \the\wd2}
}

\TEST{punctuation takes no CJK--Latin glue}{
  \setbox0=\hbox{A中}
  \setbox2=\hbox{A。}
  \setbox4=\hbox{。A}
  \setbox6=\hbox{A「}
  \TYPE{Latin-CJK: \the\wd0}
  \TYPE{Latin-close: \the\wd2}
  \TYPE{close-Latin: \the\wd4}
  \TYPE{Latin-open: \the\wd6}
}

\TEST{LatinPunct characters keep the glue}{
  \begingroup
    \LuaCJKsetup{LatinPunct}
    \global\setbox0=\hbox{中“}
  \endgroup
  \TYPE{CJK-quote: \the\wd0}
}

\TEST{punctuation inside a box takes no glue}{
  \setbox0=\hbox{A。}
  \setbox2=\hbox{A\mbox{。}}
  \setbox4=\hbox{\mbox{。}A}
  \TYPE{direct: \the\wd0}
  \TYPE{boxed-last: \the\wd2}
  \TYPE{boxed-first: \the\wd4}
}

\END

\end{document}

\input{regression-test}

\documentclass{article}
\usepackage[LoadLXGW]{LuaCJK}
\renewcommand{\familydefault}{\sfdefault}

\def\psname#1{%
  \directlua{
    local n = tex.box[#1].head
    while n do
      if n.id == node.id("glyph") then
        local f = font.getfont(n.font)
        texio.write_nl("term and log", "PSNAME " .. tostring(f and (f.psname or f.name)))
        break
      end
      n = n.next
    end
  }%
}

\begin{document}

\START

\TEST{a redefined familydefault sets the main text in its CJK family}{
  \setbox0=\hbox{中}
  \psname{0}
}

\TEST{a normalfont keeps that family}{
  {\normalfont
   \setbox0=\hbox{中}
   \psname{0}}
}

\TEST{the roman family keeps the roman CJK family}{
  \setbox0=\hbox{\textrm{中}}
  \psname{0}
}

\END

\end{document}

%    \end{macrocode}
%
%    \begin{macrocode}
%</package>
%    \end{macrocode}
%
% The package ships two Lua modules. \file{LuaCJK.lua} only loads the core
% module; all node processing lives in \file{LuaCJK-core.lua}.
% \begin{variable}[int]{LuaCJK}
% The table shared by the two modules.
% The core module adds its functions and constants to it.
%    \begin{macrocode}
%<*lua>
LuaCJK = LuaCJK or {}

require("LuaCJK-core")
%</lua>
%    \end{macrocode}
% \end{variable}
%
% The core module starts by creating the shared table and caching the node
% identifiers.
% The callbacks run on every list, so these lookups happen once.
%    \begin{macrocode}
%<*lua-core>
LuaCJK = LuaCJK or {}

%    \end{macrocode}
%
% \begin{variable}[int]
%   {
%     M,          GLYPH,         GLUE,
%     HLIST,      VLIST,         KERN,
%     LIGATURE,   PENALTY,       MATH,
%     DISC,       WHATSIT,       MARK,
%     INS,        ADJUST,        LOCAL_PAR,
%     SPACESKIP,  ITALICCORR,    new_node,
%     free_node,  has_attribute, set_attribute
%   }
% Short names for the module table, the node types,
% and the node functions.
%    \begin{macrocode}
local M               = LuaCJK
local GLYPH           = node.id("glyph")
local GLUE            = node.id("glue")
local HLIST           = node.id("hlist")
local VLIST           = node.id("vlist")
local KERN            = node.id("kern")
local LIGATURE        = node.id("ligature")
local PENALTY         = node.id("penalty")
local MATH            = node.id("math")
local DISC            = node.id("disc")
local WHATSIT         = node.id("whatsit")
local MARK            = node.id("mark")
local INS             = node.id("ins")
local ADJUST          = node.id("adjust")
local LOCAL_PAR       = node.id("local_par")
local SPACESKIP       = node.subtype("spaceskip") or 13
local ITALICCORR      = node.subtype("italiccorrection") or 3
local new_node        = node.new
local free_node       = node.free
local has_attribute   = node.has_attribute
local set_attribute   = node.set_attribute
local unset_attribute = node.unset_attribute

%    \end{macrocode}
% \end{variable}
%
% \begin{variable}[int]
%   {
%     LuaCJK.attr_font,     LuaCJK.attr_cjk_space, LuaCJK.attr_xecglue,
%     LuaCJK.attr_inserted, LuaCJK.attr_math_font
%   }
% The attribute numbers.
% The \TeX\ side fills them in after loading the module.
%    \begin{macrocode}
for _, field in ipairs {
  "font",      "cjk_space",  "xecglue", "inserted",
  "math_font", "punct_font", "nobreak", "settings",
} do
  local key = "attr_" .. field
  M[key] = M[key] or nil
end

%    \end{macrocode}
% \end{variable}
%
% \subsection{Settings and data}
%
% Most options describe how text is set, not how the document is configured,
% so they have to travel with the characters.
% A snapshot of the current options is registered once and its number is
% stored in an attribute on the glyphs created afterwards; a group that ends
% before the paragraph does therefore still decides how its own text is set.
%
% \begin{variable}[int]
%   {LuaCJK.settings, LuaCJK.settings_by_signature, LuaCJK.attr_settings}
% The snapshots, an index from a signature to a snapshot so that
% repeated font selections reuse one entry, and the attribute number.
%    \begin{macrocode}
local DEFAULT_SETTINGS = {
  ccglue        = { width = 0, stretch = 0, shrink = 0 },
  ecglue        = { width = 0, stretch = 0, shrink = 0 },
  punct_style   = "quanjiao",
  kinsoku       = true,
  cj_strict     = false,
  latin_punct   = false,
  cjk_math      = false,
  punct_width   = 0,
  bound_width   = 0,
  check_single  = false,
  widow_penalty = 10000,
  allow_break   = false,
  auto_fallback = false,
  blocks_off    = {},
}

M.settings              = { DEFAULT_SETTINGS }
M.settings_by_signature = {}

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{LuaCJK.new_settings}
% Read the current glue registers, build a snapshot, and select it.
% The glue has to be read here rather than passed in, because that is the only
% place where the registers still hold the values of the moment.
% The stretch and shrink orders travel with the value, so a register such as
% |0pt plus 1filll| can still fill a line after the node has been built.
%    \begin{macrocode}
local function glue_spec (name)
  local skip = name and tex.skip[name]
  if skip then
    return { width         = skip.width,
             stretch       = skip.stretch,
             shrink        = skip.shrink,
             stretch_order = skip.stretch_order,
             shrink_order  = skip.shrink_order }
  end
  return { width = 0, stretch = 0, shrink = 0 }
end

function M.new_settings (style, kinsoku, cj_strict, latin_punct, cjk_math,
                         punct_width, bound_width, check_single, widow_penalty,
                         allow_break, auto_fallback, off_list)
  local off = {}
  for name in string.gmatch(off_list or "", "[^,]+") do
    local trimmed = string.match(name, "^%s*(.-)%s*$")
    if trimmed ~= "" then
      off[trimmed] = true
    end
  end
  local entry = {
    ccglue        = glue_spec(M.name_ccglue),
    ecglue        = glue_spec(M.name_ecglue),
    punct_style   = style,
    kinsoku       = kinsoku,
    cj_strict     = cj_strict,
    latin_punct   = latin_punct,
    cjk_math      = cjk_math,
    punct_width   = punct_width,
    bound_width   = bound_width,
    check_single  = check_single,
    widow_penalty = widow_penalty,
    allow_break   = allow_break,
    auto_fallback = auto_fallback,
    blocks_off    = off,
  }
  local signature = table.concat({
    entry.ccglue.width, entry.ccglue.stretch, entry.ccglue.shrink,
    entry.ccglue.stretch_order, entry.ccglue.shrink_order,
    entry.ecglue.width, entry.ecglue.stretch, entry.ecglue.shrink,
    entry.ecglue.stretch_order, entry.ecglue.shrink_order,
    style, tostring(kinsoku), tostring(cj_strict), tostring(latin_punct),
    tostring(cjk_math),
    punct_width, bound_width, tostring(check_single), widow_penalty,
    tostring(allow_break), tostring(auto_fallback), off_list,
  }, "|")
  local id = M.settings_by_signature[signature]
  if not id then
    id                                 = #M.settings + 1
    M.settings[id]                     = entry
    M.settings_by_signature[signature] = id
  end
  if M.attr_settings then
    tex.setattribute(M.attr_settings, id)
  end
  return id
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{settings_of}
% The snapshot of a node, or the defaults when it carries none.
%    \begin{macrocode}
local function settings_of (n)
  if M.attr_settings and n then
    local id = has_attribute(n, M.attr_settings)
    if id and id > 0 and M.settings[id] then
      return M.settings[id]
    end
  end
  return M.settings[1]
end

M.settings_of = settings_of

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{LuaCJK.cj, LuaCJK.cj_count, LuaCJK.cj_loaded}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{CJLineBreak}, which forbids a
%   line break before the characters whose Unicode \texttt{Line\_Break}
%   property is \texttt{CJ}.}
% The characters whose \texttt{Line\_Break} property is \texttt{CJ}
% (the Japanese small kana and the like), how many there are, and whether
% the file has been read.
% The set is read from \file{LineBreak.txt} of the \pkg{unicode-data} bundle
% only when \keys{CJLineBreak} asks for \texttt{strict}, so a document that
% keeps the default never pays for the file.
%    \begin{macrocode}
M.cj        = {}
M.cj_count  = 0
M.cj_loaded = false

local function read_cj (data)
  local set, count = {}, 0
  for first, last, class in data:gmatch("(%x+)%.%.(%x+)%s*;%s*(%a+)") do
    if class == "CJ" then
      for code = tonumber(first, 16), tonumber(last, 16) do
        set[code] = true
      end
      count = count + 1
    end
  end
  for code, class in data:gmatch("(%x+)%s*;%s*(%a+)") do
    if class == "CJ" then
      set[tonumber(code, 16)] = true
      count = count + 1
    end
  end
  return set, count
end

function M.load_cj ()
  if M.cj_loaded then
    return M.cj_count
  end
  M.cj_loaded = true
  local path = kpse and kpse.find_file and kpse.find_file("LineBreak.txt")
  local file = path and io.open(path)
  if not file then
    texio.write_nl("term and log",
      "Package LuaCJK Warning: LineBreak.txt not found; "
      .. "CJLineBreak = strict has no effect.")
    return 0
  end
  local data = file:read("*a")
  file:close()
  M.cj, M.cj_count = read_cj(data)
  return M.cj_count
end

%    \end{macrocode}
% \end{variable}
%
% The quotation marks, the middle dot, and the ellipses are shared with Latin
% scripts. With \keys{LatinPunct} on, they use the Latin font and are not
% compressed; the em dash is not in the table, because it stays CJK.
%
% \begin{macro}[int]{LuaCJK.is_cjk}
% Test whether a character is treated as CJK.
% The table is the set of code points this package sets with the CJK class.
% It is a policy rather than a Unicode property: the punctuation that CJK
% text shares with Latin (U+2014, the quotation marks, U+2026) is listed
% here even though its script is Common, and the combining Bopomofo tone
% marks U+02EA and U+02EB are left out on purpose, because they attach to the
% preceding letter and a glue between the two would break the attachment.
% The script \file{scripts/check-charclass.lua} compares the table with
% \file{Scripts.txt} and reports a code point whose script is Han, Hiragana,
% Katakana, Bopomofo, or Hangul but which the table does not list.
%    \begin{macrocode}
M.class_override = {}
M.punct_override = {}

local CJK_RANGES = {
  { 0x1100,  0x11FF },  -- Hangul Jamo
  { 0x2014,  0x2014 },  -- em dash, shared with Latin
  { 0x2018,  0x2019 },  -- single quotation marks
  { 0x201C,  0x201D },  -- double quotation marks
  { 0x2026,  0x2026 },  -- horizontal ellipsis, shared with Latin
  { 0x2E80,  0x9FFF },  -- radicals, punctuation, kana, ideographs
  { 0xA960,  0xA97C },  -- Hangul Jamo Extended-A
  { 0xAC00,  0xD7C6 },  -- Hangul syllables and Jamo Extended-B
  { 0xD7CB,  0xD7FB },  -- Hangul Jamo Extended-B
  { 0xF900,  0xFAFF },  -- compatibility ideographs
  { 0xFE30,  0xFE4F },  -- compatibility forms
  { 0xFF00,  0xFFEF },  -- fullwidth forms
  { 0x16FE2, 0x16FE3 }, -- Old Chinese hook and iteration marks
  { 0x16FF0, 0x16FF6 }, -- Han, Vietnamese alternate reading marks
  { 0x1AFF0, 0x1AFF3 }, -- Kana Extended-B
  { 0x1AFF5, 0x1AFFB },
  { 0x1AFFD, 0x1AFFE },
  { 0x1B000, 0x1B128 }, -- Kana Supplement and Kana Extended-A
  { 0x1B132, 0x1B132 },
  { 0x1B150, 0x1B152 },
  { 0x1B155, 0x1B155 },
  { 0x1B164, 0x1B168 },
  { 0x1F200, 0x1F200 }, -- square hiragana hoka
  { 0x20000, 0x3FFFF }, -- ideographic planes
}

local function in_ranges (c, ranges)
  for i = 1, #ranges do
    if c >= ranges[i][1] and c <= ranges[i][2] then
      return true
    end
  end
  return false
end

local LATIN_PUNCT = {
  [0x00B7] = true, [0x2018] = true, [0x2019] = true,
  [0x201C] = true, [0x201D] = true, [0x2025] = true,
  [0x2026] = true, [0x2027] = true,
}

local function is_cjk (c, s)
  local override = M.class_override[c]
  if override ~= nil then
    return override
  end
  if s and s.latin_punct and LATIN_PUNCT[c] then
    return false
  end
  return in_ranges(c, CJK_RANGES)
end

M.is_cjk = is_cjk

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{PUNCT_CLASS}
% The punctuation LuaCJK knows about, grouped as opening, closing,
% middle, dash, and ellipsis.
% The group decides compression, line-breaking prohibitions, and hanging.
%    \begin{macrocode}
local PUNCT_CLASS = {
  [0x2018] = "open",     [0x201C] = "open",
  [0x3008] = "open",     [0x300A] = "open",
  [0x300C] = "open",     [0x300E] = "open",
  [0x3010] = "open",     [0x3014] = "open",
  [0x3016] = "open",     [0x3018] = "open",
  [0x301A] = "open",     [0xFF08] = "open",
  [0xFF3B] = "open",     [0xFF5B] = "open",
  [0x2019] = "close",    [0x201D] = "close",
  [0x3001] = "close",    [0x3002] = "close",
  [0x3009] = "close",    [0x300B] = "close",
  [0x300D] = "close",    [0x300F] = "close",
  [0x3011] = "close",    [0x3015] = "close",
  [0x3017] = "close",    [0x3019] = "close",
  [0x301B] = "close",    [0xFF01] = "close",
  [0xFF09] = "close",    [0xFF0C] = "close",
  [0xFF0E] = "close",    [0xFF1A] = "close",
  [0xFF1B] = "close",    [0xFF1F] = "close",
  [0xFF3D] = "close",    [0xFF5D] = "close",
  [0x00B7] = "middle",   [0x2027] = "middle",
  [0x30FB] = "middle",
  [0x2013] = "dash",     [0x2014] = "dash",
  [0x2015] = "dash",     [0xFF0D] = "dash",
  [0x2026] = "ellipsis", [0x22EF] = "ellipsis",
}

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{punct_class}
% Look up the group of a character.
%    \begin{macrocode}
local function punct_class (c, s)
  local override = M.punct_override[c]
  if override ~= nil then
    return override or nil
  end
  if s and s.latin_punct and LATIN_PUNCT[c] then
    return nil
  end
  if M.charsets.middle[c] then
    return "middle"
  end
  return PUNCT_CLASS[c]
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.declare_ranges}
% Fill a table with \meta{value} over a list of code-point ranges,
% each given as \texttt{\{first, last\}}.
%    \begin{macrocode}
local function fill_ranges (target, value, ranges)
  for _, range in ipairs(ranges) do
    local first = range[1]
    local last  = range[2] or first
    for code = first, last do
      target[code] = value
    end
  end
end

function M.declare_class (ranges, cjk)
  fill_ranges(M.class_override, cjk, ranges)
end

function M.declare_punct (ranges, group)
  fill_ranges(M.punct_override, group, ranges)
end

function M.reset_classes ()
  M.class_override = {}
  M.punct_override = {}
  M.normal_spaced  = {}
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{M.charsets}
% The four character sets that the punctuation options can replace.
% \texttt{kaiming} holds the marks that keep a full
% em width in the \texttt{kaiming} style; \texttt{middle}
% and \texttt{long} are filled from the punctuation groups below,
% and \texttt{nobreak} starts as a copy of \texttt{long}.
%    \begin{macrocode}
M.charsets = {
  kaiming = {
    [0xFF0E] = true,  -- ．
    [0x3002] = true,  -- 。
    [0xFF1F] = true,  -- ？
    [0xFF01] = true,  -- ！
  },
  middle  = {},
  long    = {},
  nobreak = {},
}

for code, group in pairs(PUNCT_CLASS) do
  if group == "middle" then
    M.charsets.middle[code] = true
    PUNCT_CLASS[code]       = nil
  elseif group == "dash" or group == "ellipsis" then
    M.charsets.long[code] = true
  end
end

for code in pairs(M.charsets.long) do
  M.charsets.nobreak[code] = true
end

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{LuaCJK.set_charset}
% Replace, extend, or reduce one of the sets above.
% The ranges arrive from \TeX\ as a list of \texttt{\{first, last\}} pairs.
%    \begin{macrocode}
function M.set_charset (kind, mode, ranges)
  local target = M.charsets[kind]
  if not target then
    return
  end
  if mode == "set" then
    target           = {}
    M.charsets[kind] = target
  end
  for _, range in ipairs(ranges) do
    local first = range[1]
    local last  = range[2] or first
    for code = first, last do
      if mode == "remove" then
        target[code] = nil
      else
        target[code] = true
      end
    end
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{LuaCJK.punct_styles}
% The built-in styles. Each entry holds the compression switch,
% the compression ratio, the opening and closing exemption,
% whether the line-end hanging applies, and the optional fixed width.
%    \begin{macrocode}
M.punct_class = function (c, s)
  return punct_class(c, s or M.settings[1])
end

M.punct_styles = {
  quanjiao = { compress_adjacent = true,  ratio = 0.5,
               keep_open_close = true, hang = true },
  plain    = { compress_adjacent = false, ratio = 0.0,
               keep_open_close = true },
  banjiao  = { compress_adjacent = false, ratio = 0.0, keep_open_close = true,
               fixed_ratio = 0.5, hang = true },
  kaiming  = { compress_adjacent = false, ratio = 0.0, keep_open_close = true,
               fixed_ratio = 0.5, fixed_full = true, hang = true },
  CCT      = { compress_adjacent = false, ratio = 0.0, keep_open_close = true,
               fixed_ratio = 0.7, hang = true },
  hangmobanjiao = { compress_adjacent = false, ratio = 0.0,
                    keep_open_close = true, hang = true },
}

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{LuaCJK.define_punct_style}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{KaiMingPunct},
%   \keys{MiddlePunct}, \keys{LongPunct}, and \keys{NoBreakLongPunct}, each
%   with \texttt{+} and \texttt{-} forms, to edit the punctuation character
%   sets.}
% Register a style declared by \cs{LuaCJKDeclarePunctStyle}.
%    \begin{macrocode}
function M.define_punct_style (name, compress, ratio, keep)
  M.punct_styles[name] = {
    compress_adjacent = compress,
    ratio             = ratio,
    keep_open_close   = keep,
  }
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{punct_style}
% Read the style name from the \TeX\ token list and return the matching
% table, falling back to \texttt{plain}.
%    \begin{macrocode}
M.punct_width = {}
M.punct_kern  = {}

local function first_code (s)
  for _, code in utf8.codes(s) do
    return code
  end
end

function M.set_punct_width (chars, sp)
  for _, code in utf8.codes(chars) do
    M.punct_width[code] = sp
  end
end

function M.add_normal_spaced (ranges)
  for _, range in ipairs(ranges) do
    local first = range[1]
    local last  = range[2] or first
    for code = first, last do
      M.normal_spaced[code] = true
    end
  end
end

function M.set_punct_kern (before, after, sp)
  local a, b = first_code(before), first_code(after)
  if a and b then
    M.punct_kern[a]    = M.punct_kern[a] or {}
    M.punct_kern[a][b] = sp
  end
end

local function user_width (char)
  return M.punct_width[char]
end

local function user_kern (before, after)
  local row = M.punct_kern[before]
  return row and row[after]
end

function M.edit_punct_style (name, compress, ratio, keep)
  local style = M.punct_styles[name]
  if not style then
    return
  end
  if compress ~= nil then
    style.compress_adjacent = compress
  end
  if ratio ~= nil then
    style.ratio = ratio
  end
  if keep ~= nil then
    style.keep_open_close = keep
  end
end

local function style_of (settings)
  local name = settings and settings.punct_style
  return M.punct_styles[name] or M.punct_styles.plain
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{LuaCJK.attr_disabled}
% The attribute number of the suspension switch.
%    \begin{macrocode}
M.attr_disabled = M.attr_disabled or nil

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{disabled}
% Test the suspension attribute on a node.
%    \begin{macrocode}
local function disabled (n)
  if not (M.attr_disabled and n) then
    return false
  end
  local v = has_attribute(n, M.attr_disabled)
  return v ~= nil and v ~= 0
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{Node rewriting}
%
% A CJK glyph carries the identifier of the family that applies
% to it in an attribute. The pass below replaces it by a copy in that font,
% and takes a sub-block font or a fallback font instead when one applies.
%
% \begin{variable}[int]{M.blocks, M.block_order, M.block_fonts}
% The declared sub-blocks in declaration order,
% and the font identifier of each block for each family.
% The order decides which block wins when two ranges overlap.
%    \begin{macrocode}
M.blocks      = {}
M.block_order = {}
M.block_fonts = {}

function M.declare_block (name, ranges)
  if not M.blocks[name] then
    table.insert(M.block_order, name)
  end
  M.blocks[name] = { ranges = ranges }
end

function M.set_block_font (main, name, fid)
  local row = M.block_fonts[main]
  if not row then
    row                 = {}
    M.block_fonts[main] = row
  end
  if fid and fid > 0 then
    row[name] = fid
  else
    row[name] = nil
  end
end

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{block_font}
% The font of the first block of \meta{main} that contains \meta{char}
% and is not canceled in \meta{settings}.
%    \begin{macrocode}
local function block_font (main, char, settings)
  local row = M.block_fonts[main]
  if not row then
    return nil
  end
  local off = settings and settings.blocks_off or {}
  for _, name in ipairs(M.block_order) do
    local block = M.blocks[name]
    if block and not off[name] and row[name] then
      for _, range in ipairs(block.ranges) do
        if char >= range[1] and char <= (range[2] or range[1]) then
          return row[name]
        end
      end
    end
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{M.fallback}
% The fallback fonts of each family, as identifiers,
% in the order in which they were declared.
%    \begin{macrocode}
M.fallback = {}

function M.set_fallback (main, list)
  M.fallback[main] = list
end

%    \end{macrocode}
% \end{variable}
%
% \begin{variable}[int]{M.yoffset}
% The vertical offset of each font, in scaled points, positive upwards.
% The \keys{Baseline} key of a font declaration fills it,
% and \texttt{copy_glyph} applies it, so the offset belongs to the font
% a glyph is taken from and not to the text that asks for it.
%    \begin{macrocode}
M.yoffset = {}

function M.set_yoffset (fid, sp)
  M.yoffset[fid] = sp
end

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{has_char}
% Whether \meta{fid} has a glyph for \meta{char}. The answer is cached
% per font and code point, because the pass asks it once per glyph.
% \begin{variable}[int]{has_char_cache}
% The cache, keyed by the font identifier and the code point packed into
% one number.
%    \begin{macrocode}
local has_char_cache = {}

local function has_char (fid, char)
  local key    = fid * 0x200000 + char
  local cached = has_char_cache[key]
  if cached ~= nil then
    return cached
  end
  local f             = font.getfont(fid)
  local ok            = f and f.characters and f.characters[char] ~= nil
  has_char_cache[key] = ok
  return ok
end

%    \end{macrocode}
% \end{variable}
% \end{macro}
%
% \begin{macro}[int]{fallback_font}
% The first fallback font of \meta{fid} that has \meta{char}, or nothing
% when the feature is off or no fallback covers the character.
%    \begin{macrocode}
local function fallback_font (fid, char, settings)
  if not (settings and settings.auto_fallback) then
    return nil
  end
  local list = M.fallback[fid]
  if not list then
    return nil
  end
  for _, candidate in ipairs(list) do
    if has_char(candidate, char) then
      return candidate
    end
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{copy_glyph}
% \changes{v0.0.1}{2026/11/11}{A character the font lacks leaves no
%   placeholder: the \texttt{.notdef} or private-use glyph a font substitutes
%   for it is removed.}
% Copy a glyph node, changing only its font.
%    \begin{macrocode}
local function copy_glyph (n, fid)
  local g = new_node("glyph")
  g.font = fid
  for _, field in ipairs {
    "char",     "attr",    "lang",
    "left",     "right",   "uchyph",
    "xoffset",  "yoffset", "expansion_factor",
    "data",     "subtype",
  } do
    g[field] = n[field]
  end
  local shift = M.yoffset[fid]
  if shift then
    g.yoffset = (g.yoffset or 0) + shift
  end
  return g
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{rewrite_fonts}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{LatinPunct}, which keeps the
%   shared quotation marks, the middle dot, and the ellipses in the Latin font
%   instead of the CJK font.}
% Replace each CJK glyph by a copy in the font its attribute names,
% after giving way to a sub-block font or to a fallback font.
% A glyph that the old font did not have may sit next to the placeholder
% \pkg{luaotfload} emitted for it; the placeholder is freed at the same
% time, because it would otherwise add an advance of its own.
%    \begin{macrocode}
local function rewrite_fonts (head)
  local prev = nil
  local cur  = head
  while cur do
    local nxt = cur.next
    if cur.id == GLYPH and is_cjk(cur.char, settings_of(cur))
       and M.attr_font then
      local target = has_attribute(cur, M.attr_font)
      if target and target > 0 then
        local block = block_font(target, cur.char, settings_of(cur))
        if block then
          target = block
        end
      end
      if target and M.attr_punct_font and punct_class(cur.char) then
        local punct = has_attribute(cur, M.attr_punct_font)
        if punct and punct > 0 then
          target = punct
        end
      end
      if target and target > 0 and not has_char(target, cur.char) then
        target = fallback_font(target, cur.char, settings_of(cur)) or target
      end
      if target and target > 0 and target ~= cur.font then
        if nxt and nxt.id == GLYPH and nxt.font == cur.font
           and (nxt.char == 0
             or (nxt.char >= 0xF0000 and nxt.char <= 0x10FFFD)) then
          local after = nxt.next
          free_node(nxt)
          nxt = after
        end
        local g = copy_glyph(cur, target)
        g.next  = nxt
        if prev then
          prev.next = g
        else
          head = g
        end
        free_node(cur)
        cur = g
      end
    end
    prev = cur
    cur  = nxt
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{class_of_char}
% Map a character to \texttt{CJK} or \texttt{LATIN}.
%    \begin{macrocode}
local function class_of_char (c, s)
  if is_cjk(c, s) then
    return "CJK"
  end
  return "LATIN"
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{class_of_node}
% Return the class at both edges of a node. A box carries the class of the
% node at its edge, so filling glue or a kern between the last character and
% the edge leaves the box with no class there; a box of no size is
% transparent, and formulas count as Latin.
% \begin{macro}[int]{transparent_node}
% Whether a node carries neither text nor advance, so that the text reaches
% the edge past it.
%    \begin{macrocode}
local function transparent_node (n)
  return n.id == WHATSIT or n.id == MARK or n.id == INS
      or n.id == ADJUST or n.id == PENALTY
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{box_visible}
% Whether a box carries material of its own. A box of no size is passed over,
% so the boundary rules read the text on both sides of it as one run.
%    \begin{macrocode}
local function box_visible (n)
  return n.width ~= 0 or n.height ~= 0 or n.depth ~= 0
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{first_visible_class}
% The class of the text at the start of a list: a glyph, a formula, or a box
% inspected at its own edge. Glue, a kern, a rule, and a discretionary are not
% text, so a list that starts with one has no class at that point, and a box
% whose first edge has no class ends the search instead of yielding to a
% character after it.
%    \begin{macrocode}
local function first_visible_class (list)
  local n = list
  while n do
    if n.id == GLYPH then
      return class_of_char(n.char, settings_of(n))
    elseif n.id == HLIST or n.id == VLIST then
      return first_visible_class(n.head)
    elseif n.id == MATH then
      return "LATIN"
    elseif not transparent_node(n) then
      return nil
    end
    n = n.next
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{last_visible_class}
% The class of the text at the end of a list, read the same way: a node that
% is not text ends the text, so the class is nothing when something follows
% the last character.
%    \begin{macrocode}
local function last_visible_class (list)
  local n    = list
  local last = nil
  while n do
    if n.id == GLYPH then
      last = class_of_char(n.char, settings_of(n))
    elseif n.id == HLIST or n.id == VLIST then
      last = last_visible_class(n.head)
    elseif n.id == MATH then
      last = "LATIN"
    elseif not transparent_node(n) then
      last = nil
    end
    n = n.next
  end
  return last
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{first_punct}
% The punctuation group of the first visible character of a list, the
% character itself, and whether a character was found at all, so that a box
% with no text can be skipped.  A formula counts as material with no mark.
%    \begin{macrocode}
local function first_punct (list)
  local n = list
  while n do
    if n.id == GLYPH then
      return punct_class(n.char, settings_of(n)), n, true
    elseif n.id == HLIST or n.id == VLIST then
      local p, g, found = first_punct(n.head)
      if found then
        return p, g, true
      end
    elseif n.id == MATH then
      return nil, nil, true
    end
    n = n.next
  end
  return nil, nil, false
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{last_punct}
% The same for the last visible character of a list.
%    \begin{macrocode}
local function last_punct (list)
  local n     = list
  local punct = nil
  local glyph = nil
  local found = false
  while n do
    if n.id == GLYPH then
      punct = punct_class(n.char, settings_of(n))
      glyph = n
      found = true
    elseif n.id == HLIST or n.id == VLIST then
      local p, g, deep = last_punct(n.head)
      if deep then
        punct = p
        glyph = g
        found = true
      end
    elseif n.id == MATH then
      punct = nil
      glyph = nil
      found = true
    end
    n = n.next
  end
  return punct, glyph, found
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function class_of_node (n)
  if n.id == GLYPH then
    local c = class_of_char(n.char, settings_of(n))
    return c, c
  elseif n.id == HLIST or n.id == VLIST then
    return first_visible_class(n.head), last_visible_class(n.head)
  elseif n.id == MATH then
    return "LATIN", "LATIN"
  end
  return nil, nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{is_inserted}
% Test whether a node was inserted by LuaCJK.
%    \begin{macrocode}
local function is_inserted (n)
  return M.attr_inserted
    and has_attribute(n, M.attr_inserted) ~= nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{inherit_attributes}
% \changes{v0.0.1}{2026/11/11}{Glue, kerns, and penalties inserted by the
%   package carry the attributes of the neighbouring node, so a decoration
%   such as \cs{CJKunderdot} covers CJK/CJK and CJK/Latin boundaries without a
%   gap.}
% Give a new node the attribute list of the node it is spliced next to.
% LuaCJK creates glue, kerns, and penalties after \TeX\ has attached
% the surrounding attributes to the text, so a package that
% marks spans with attributes, such as \pkg{lua-ul}, would otherwise read
% the new node as the end of its span and start a new one. Assigning
% to the \meta{attr} field is reference counted, and later per-attribute
% changes are copy-on-write, so the source node is never modified.
%    \begin{macrocode}
local function inherit_attributes (new, source)
  if source and source.attr then
    new.attr = source.attr
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{make_glue}
% Create a glue node from a skip register, inherit the attributes
% of \meta{source}, and mark the node as inserted.
% The node keeps the stretch and shrink orders of the register.
%    \begin{macrocode}
local function make_glue (spec, source)
  if not spec then
    return nil
  end
  local s = spec
  local g = new_node("glue")
  inherit_attributes(g, source)
  g.width         = s.width
  g.stretch       = s.stretch
  g.shrink        = s.shrink
  g.stretch_order = s.stretch_order or 0
  g.shrink_order  = s.shrink_order  or 0
  if M.attr_inserted then
    set_attribute(g, M.attr_inserted, 1)
  end
  return g
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{set_glue}
% Give an existing glue node the dimensions of a skip register,
% including its stretch and shrink orders.
%    \begin{macrocode}
local function set_glue (g, spec)
  if not spec then
    return false
  end
  local s   = spec
  g.width   = s.width
  g.stretch = s.stretch
  g.shrink  = s.shrink
  g.stretch_order = s.stretch_order or 0
  g.shrink_order  = s.shrink_order  or 0
  if M.attr_inserted then
    set_attribute(g, M.attr_inserted, 1)
  end
  return true
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{make_kern}
% Create a kern node, inherit the attributes of \meta{source},
% and mark the node as inserted.
%    \begin{macrocode}
local function make_kern (width, source)
  local k = new_node("kern")
  inherit_attributes(k, source)
  k.kern = width
  if M.attr_inserted then
    set_attribute(k, M.attr_inserted, 1)
  end
  return k
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{The passes}
%
% \begin{macro}[int]{spacing}
% \changes{v0.0.1}{2026/11/11}{Provide CJK/CJK and CJK/Latin spacing with
%   \keys{CJKglue}, \keys{CJKecglue}, \keys{CJKspace}, and \keys{xCJKecglue};
%   a value keeps its stretch and shrink orders. A source space between two
%   CJK characters becomes the inter-character glue, so the boundary keeps its
%   break opportunity and its stretch, and no glue is inserted between two
%   long punctuation marks.}
% Walk a list and insert the glue between CJK and Latin material.
% The walk tracks the last visible node and the class at its end,
% so that a formula acts as one Latin atom at its left edge;
% inside the formula the boundary rules are not applied.
% A box is an atom as well, and the class at its edge is the class of the
% node at that edge: filling glue or a kern means the box has no text there,
% so no glue is added beside it. A box of no size is passed over, so an
% empty box inside CJK text does not break the run.
% \begin{macro}[int]{handle_boundary}
% \changes{v0.0.1}{2026/11/11}{A mark keeps its break opportunity beside
%   suspended text: the boundary glue at a mark has no width.}
% Decide what to do at the boundary between two visible nodes.
% Only source-generated glue is a candidate for replacement;
% other glue and penalties are left alone, a penalty being an explicit
% barrier and a discretionary opaque, so neither is bridged.
% A boundary that touches a suspended run is bridged by nothing, except that a
% mark keeps its break opportunity: \keys{Verb} suspends the spacing, and the
% glue at a mark has no width, so restoring it there moves no ink. An opening
% mark is excluded, because a break after it is prohibited and the kinsoku pass
% cannot see the prohibition across a suspended node.
% \begin{macro}[int]{insert_boundary_glue}
% Insert the CJK--CJK or CJK--Latin glue,
% or the compression kern for two adjacent punctuation marks.
% A run of dashes or ellipses is one unit: the marks are joined without glue,
% so that justification cannot pull a two-em dash apart, and the absence of a
% break opportunity replaces the explicit prohibition.
% A punctuation mark takes no CJK--Latin advance on either side: the advance
% of the mark already carries its spacing, and the glue would add a third of
% an em that the typography does not ask for.
% The boundary keeps a glue of zero width, so that it stays a break
% opportunity and the kinsoku penalty can forbid the break.
%    \begin{macrocode}
M.normal_spaced = {}

function M.set_normal_spaced_chars (chars)
  local set = {}
  for _, code in utf8.codes(chars) do
    set[code] = true
  end
  M.normal_spaced = set
end

local function normal_spaced (n)
  return n and n.id == GLYPH and M.normal_spaced[n.char] == true
end

local function long_punct (n)
  return n and n.id == GLYPH and M.charsets.long[n.char] == true
end

local PUNCT_BOUNDARY_GLUE = { width = 0, stretch = 0, shrink = 0 }

local function insert_boundary_glue (head, prev, prev_visible, prev_end,
                                    cur, cur_start, settings)
  if not prev_end or not cur_start then
    return head
  end
  if long_punct(prev) and long_punct(cur) then
    return head
  end
  local style = style_of(settings)
  local prev_punct = nil
  if prev_visible then
    if prev_visible.id == GLYPH then
      prev_punct = punct_class(prev_visible.char, settings)
    elseif prev_visible.id == HLIST or prev_visible.id == VLIST then
      prev_punct = last_punct(prev_visible.head)
    end
  end
  local cur_punct = nil
  if cur then
    if cur.id == GLYPH then
      cur_punct = punct_class(cur.char, settings)
    elseif cur.id == HLIST or cur.id == VLIST then
      cur_punct = first_punct(cur.head)
    end
  end
  local prev_mark = prev_punct and prev.id == GLYPH
  local cur_mark  = cur_punct and cur.id == GLYPH
  local spec = nil
  if prev_end == "CJK" and cur_start == "CJK" then
    spec = settings.ccglue
  elseif prev_end ~= cur_start
     and not normal_spaced(prev) and not normal_spaced(cur) then
    if prev_punct or cur_punct then
      spec = PUNCT_BOUNDARY_GLUE
    else
      spec = settings.ecglue
    end
  end

  if prev_mark and cur_mark then
    local explicit = user_kern(prev.char, cur.char)
    if explicit then
      local k = make_kern(explicit, prev)
      k.next  = cur
      if prev then
        prev.next = k
      else
        head = k
      end
      return head
    end
  end
  if prev_mark and cur_mark and style.compress_adjacent then
    local exempt = (style.keep_open_close
        and prev_punct == "open" and cur_punct == "close")
      or (M.charsets.long[prev.char] and M.charsets.long[cur.char])
    if not exempt and prev.width and prev.width > 0 then
      local k = make_kern(-math.floor(style.ratio * prev.width + 0.5), prev)
      local g = spec and make_glue(spec, prev) or nil
      k.next  = g or cur
      if g then
        g.next = cur
      end
      if prev then
        prev.next = k
      else
        head = k
      end
      return head
    end
  end

  if not spec then
    return head
  end
  local g = make_glue(spec, prev or cur)
  if not g then
    return head
  end
  g.next = cur
  if prev then
    prev.next = g
  else
    head = g
  end
  return head
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{restore_source_spaces}
% \changes{v0.0.2}{2026/11/20}{The space in front of \cs{textbf} and its
%   siblings is still the inter-character glue: \LaTeX\ moves a space across
%   the italic correction of a text font command, and the move leaves the glue
%   with the subtype of a skip the document wrote.}
% Give a source space that a text font command moved across the italic
% correction its subtype back.
% \cs{textbf} and the other text font commands save the skip in front of them,
% remove it, apply the italic correction, and put it back with \tn{hskip}, so
% the glue keeps the dimensions of the space but not its subtype.
% The move is the only way a normal glue comes to follow an italic-correction
% kern, and the subtype is the one thing the spacing pass reads, so putting the
% subtype back is enough; a typeface whose interword space is rigid therefore
% needs no special case, at the price of retiming a skip that the document
% wrote in that very place.
%    \begin{macrocode}
local function restore_source_spaces (head)
  local prev = nil
  local cur  = head
  while cur do
    if cur.id == GLUE and cur.subtype ~= SPACESKIP
       and prev and prev.id == KERN and prev.subtype == ITALICCORR then
      cur.subtype = SPACESKIP
    end
    prev = cur
    cur  = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{handle_source_space}
% Remove or retime a space typed in the source.
% Only a space that came from the source is a candidate; an explicit
% \tn{hskip} or \tn{hfill} has a different subtype and is left alone, and the
% space that a text font command moved across the italic correction has had
% its subtype put back above.
% A space between two CJK characters is not kept when \keys{CJKspace} is off,
% but dropping it must not drop the boundary with it: the space becomes the
% inter-character glue of \keys{CJKglue}. Freeing it instead would leave the
% two characters adjacent with no glue, and the pass that would add the glue
% runs after line breaking, so the break opportunity would be lost.
%    \begin{macrocode}
local function handle_source_space (head, glue, prev_end, cur,
                                    cur_start, settings)
  if glue.subtype ~= SPACESKIP then
    return head
  end
  local prev_cjk = prev_end == "CJK"
  local cur_cjk  = cur_start == "CJK"
  if prev_cjk and cur_cjk then
    local cjk_space = M.attr_cjk_space
      and (has_attribute(glue, M.attr_cjk_space) or 0) ~= 0
    if not cjk_space then
      set_glue(glue, settings.ccglue)
      if M.attr_inserted then
        set_attribute(glue, M.attr_inserted, 1)
      end
    end
  elseif prev_cjk or cur_cjk then
    local xecglue = M.attr_xecglue
      and (has_attribute(glue, M.attr_xecglue) or 0) ~= 0
    if xecglue then
      set_glue(glue, settings.ecglue)
    end
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function handle_boundary (head, prev, prev_visible, prev_end,
                                cur, start_class, settings)
  if not prev_visible or not start_class then
    return head
  end
  if disabled(prev_visible) or disabled(cur) then
    local occupied = prev
      and (prev.id == GLUE or prev.id == KERN
           or prev.id == PENALTY or prev.id == DISC)
    if disabled(cur) and not disabled(prev_visible)
       and not occupied then
      local mark = prev_visible.id == GLYPH
        and punct_class(prev_visible.char, settings)
      if mark and mark ~= "open" then
        local g = make_glue(PUNCT_BOUNDARY_GLUE, prev_visible)
        if g then
          g.next = cur
          if prev then
            prev.next = g
          else
            head = g
          end
        end
      end
    end
    return head
  end
  if prev and prev.id == GLUE then
    if not is_inserted(prev) then
      return handle_source_space(
        head, prev, prev_end, cur, start_class, settings)
    end
  elseif prev and prev.id == PENALTY then
  elseif prev and prev.id == DISC then
  else
    return insert_boundary_glue(
      head, prev, prev_visible, prev_end, cur, start_class, settings)
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function spacing (head)
  head = restore_source_spaces(head)
  local prev         = nil
  local prev_visible = nil
  local prev_end     = nil
  local math_level   = 0
  local cur          = head
  while cur do
    local nxt = cur.next
    if cur.id == MATH then
      if cur.subtype == 0 then
        if math_level == 0 then
          head = handle_boundary(
            head, prev, prev_visible, prev_end, cur, "LATIN",
            settings_of(prev_visible or cur))
        end
        math_level   = math_level + 1
        prev_visible = nil
        prev_end     = nil
      else
        if math_level > 0 then
          math_level = math_level - 1
        end
        if math_level == 0 then
          prev_visible = cur
          prev_end     = "LATIN"
        end
      end
    elseif math_level > 0 then
    else
      local start_class, end_class = class_of_node(cur)
      local visible
      if cur.id == HLIST or cur.id == VLIST then
        visible = box_visible(cur)
      else
        visible = start_class ~= nil
      end
      if visible then
        head = handle_boundary(
          head, prev, prev_visible, prev_end, cur, start_class,
          settings_of(prev_visible))
        prev_visible = cur
        prev_end     = end_class
      elseif cur.id == PENALTY or cur.id == DISC then
        prev_visible = nil
        prev_end     = nil
      end
    end
    prev = cur
    cur  = nxt
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \TeX\ may break at glue, at kern, and at a discretionary. The first two are
% places where LuaCJK inserts its own nodes, so after building the list a
% second pass puts a penalty 10000 in front of every break opportunity that
% must not be used.
% A discretionary states the value of its own break, so there the pass sets
% the node's penalty field rather than inserting a penalty.
% The hyphens of a word are not in the list yet when the pass runs: \TeX\
% inserts them during line breaking, so a \texttt{hyphenate} callback forbids
% those as well.
%
% \begin{macro}[int]{apply_kinsoku}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{PunctKinsoku} line-breaking
%   prohibitions: closing punctuation cannot start a line and opening
%   punctuation cannot end a line.}
% \changes{v0.0.2}{2026/11/20}{\keys{AllowBreakBetweenPuncts} no longer lets a
%   closing mark start a line or an opening mark end one, and a mark inside a
%   box takes part in the prohibitions.}
% Add the prohibitions where the settings of the text ask for them.
% A node marked by \cs{LuaCJKnobreak} or by the verbatim addon
% is prohibited regardless, because the mark itself is the prohibition.
% A box is read at the edge that faces the break, the way the spacing pass
% reads it, so that a mark at the edge of the box is neither a line start nor
% a line end.
%    \begin{macrocode}
%    \end{macrocode}
% \begin{macro}[int]{no_break_mark}
% Whether a node carries the attribute of \cs{LuaCJKnobreak}.
%    \begin{macrocode}
local function no_break_mark (n)
  if not (M.attr_nobreak and n) then
    return false
  end
  local value = has_attribute(n, M.attr_nobreak)
  return value ~= nil and value ~= 0
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{next_glyph}
% The glyph a discretionary is followed by: the letters of a word are
% separated from it by a kern or a ligature at most, and a glue, a penalty,
% another discretionary or a formula ends the word.
%    \begin{macrocode}
local function next_glyph (n)
  while n and (n.id == KERN or n.id == LIGATURE) do
    n = n.next
  end
  if n and n.id == GLYPH then
    return n
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{forbid_marked_disc}
% Forbid the break at a discretionary that involves a marked node.
% The break lies between the letters on either side of the discretionary, so
% it is prohibited when either of them is marked, the way the break at a glue
% is.
% \TeX\ gives a discretionary the attributes of the character in front of it,
% which is why the node itself is read as well as its neighbours.
%    \begin{macrocode}
local function forbid_marked_disc (disc, left)
  if no_break_mark(disc) or no_break_mark(left)
     or no_break_mark(next_glyph(disc.next)) then
    disc.penalty = 10000
  end
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{adjacent_marks}
% Whether two marks are neighbours that stay together: a dash or an ellipsis
% is left out, because a run of them is one unit of its own, governed by the
% \texttt{nobreak} character set.
%    \begin{macrocode}
local function adjacent_marks (prev_mark, next_mark)
  return prev_mark and next_mark
     and prev_mark ~= "dash" and prev_mark ~= "ellipsis"
     and next_mark ~= "dash" and next_mark ~= "ellipsis"
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{forbids_break}
% The rules: closing and middle punctuation must not start a line,
% opening punctuation must not end one,
% a run of dashes or ellipses stays together,
% and two adjacent marks are not separated.
% \keys{AllowBreakBetweenPuncts} lifts the last rule alone: a mark that may
% not begin or end a line is a rule of the script, so the option cannot
% permit one.
%    \begin{macrocode}
local function forbids_break (prev_mark, prev_char, next_mark, next_char,
                              settings)
  if next_mark == "close" or next_mark == "middle" then
    return true
  end
  if prev_mark == "open" then
    return true
  end
  if M.charsets.nobreak[prev_char] and M.charsets.nobreak[next_char] then
    return true
  end
  if adjacent_marks(prev_mark, next_mark)
     and not (settings and settings.allow_break) then
    return true
  end
  return false
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{edge_mark}
% The punctuation group and the character at one edge of a visible node:
% a glyph is its own edge, and a box is read at the edge that faces the
% break, so a mark inside a box takes part in the rules.  A formula carries
% no mark.
%    \begin{macrocode}
local function edge_mark (n, at_end)
  if n.id == GLYPH then
    return punct_class(n.char, settings_of(n)), n.char, n
  elseif n.id == HLIST or n.id == VLIST then
    local mark, g = nil, nil
    if at_end then
      mark, g = last_punct(n.head)
    else
      mark, g = first_punct(n.head)
    end
    if g then
      return mark, g.char, g
    end
    return nil, nil, nil
  end
  return nil, nil, nil
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{next_visible}
% The next node that carries text: a glyph, a formula, or a box.  A box of
% no size is passed over, and an explicit break barrier ends the search.
%    \begin{macrocode}
local function next_visible (n)
  while n do
    if n.id == GLYPH or n.id == MATH then
      return n
    elseif n.id == HLIST or n.id == VLIST then
      if box_visible(n) then
        return n
      end
    elseif n.id == PENALTY or n.id == DISC then
      return nil
    end
    n = n.next
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{is_break_point}
% Glue and kerns are break opportunities;
% only the ones LuaCJK inserted and the source spaces are considered.
%    \begin{macrocode}
local function is_break_point (n)
  if n.id == GLUE then
    return is_inserted(n) or n.subtype == SPACESKIP
  elseif n.id == KERN then
    return is_inserted(n)
  end
  return false
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function apply_kinsoku (head)
  local prev = nil
  local last = nil
  local cur  = head
  while cur do
    if cur.id == GLYPH
       or ((cur.id == HLIST or cur.id == VLIST) and box_visible(cur)) then
      last = cur
    elseif cur.id == DISC then
      forbid_marked_disc(cur, last)
    elseif is_break_point(cur) and last then
      local nxt                  = next_visible(cur.next)
      local settings             = settings_of(last)
      local prev_mark, prev_char = edge_mark(last, true)
      local next_mark, next_char = nil, nil
      if nxt then
        next_mark, next_char = edge_mark(nxt, false)
      end
      local cj = settings.cj_strict and next_char and M.cj[next_char]
      if nxt and (no_break_mark(last) or no_break_mark(nxt)
                  or cj
                  or (settings.kinsoku
                      and not disabled(last) and not disabled(nxt)
                      and forbids_break(prev_mark, prev_char,
                                        next_mark, next_char, settings)))
      then
        if not (prev and prev.id == PENALTY and prev.penalty >= 10000) then
          local p = new_node("penalty")
          inherit_attributes(p, last)
          p.penalty = 10000
          if M.attr_inserted then
            set_attribute(p, M.attr_inserted, 1)
          end
          p.next = cur
          if prev then
            prev.next = p
          else
            head = p
          end
          cur = p
        end
      end
    end
    prev = cur
    cur  = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{apply_fixed_widths}
% Styles such as \texttt{banjiao} give every punctuation mark a fixed
% advance. The glyph advance cannot be changed, so a compensating kern
% goes right after the glyph. A penalty in front of that kern keeps \TeX\
% from treating it as an extra break opportunity.
% The kern alone is only right for a mark whose ink sits at the left of its
% advance, which is what a closing mark does. An opening mark keeps its ink
% at the right, so the ink is moved left by the same amount; a middle mark is
% centered, so it moves by half. A dash or an ellipsis is not shortened by the
% style: its advance is the length of the stroke, and halving it would let the
% two halves of a two-em dash overlap.
%    \begin{macrocode}
local function ink_shift (class, delta)
  if class == "open" then
    return delta
  elseif class == "middle" then
    return math.floor(delta / 2 + 0.5)
  end
  return 0
end

local function fixed_width (cur, settings, style)
  local target = user_width(cur.char)
  if not target and settings.punct_width > 0 then
    target = settings.punct_width
  end
  if target then
    return target
  end
  local ratio = style.fixed_ratio
  if not ratio or M.charsets.long[cur.char] then
    return nil
  end
  local full = style.fixed_full and M.charsets.kaiming
  if full and full[cur.char] then
    return nil
  end
  local f    = font.getfont(cur.font)
  local size = f and f.size or 0
  if size > 0 then
    return math.floor(ratio * size + 0.5)
  end
  return nil
end

local function apply_fixed_widths (head)
  local cur = head
  while cur do
    local settings = settings_of(cur)
    local style    = style_of(settings)
    if cur.id == GLYPH and punct_class(cur.char, settings)
       and not disabled(cur) then
      local target = fixed_width(cur, settings, style)
      if target then
        local delta = target - cur.width
        if delta ~= 0 then
          local shift = ink_shift(punct_class(cur.char, settings), delta)
          local p = new_node("penalty")
          inherit_attributes(p, cur)
          p.penalty = 10000
          local k   = make_kern(delta, cur)
          p.next    = k
          k.next    = cur.next
          cur.next  = p
          if shift ~= 0 then
            cur.xoffset = cur.xoffset + shift
          end
        end
      end
    end
    cur = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% A CJK character in math mode reaches the math list as a \texttt{math_char}
% noad. Its family points at the math font, which usually has no CJK glyph,
% so LuaCJK replaces the nucleus by a \texttt{sub_box} holding the character
% in the CJK font.
%
% \begin{variable}[int]{MATH_CHAR, MATH_TEXT_CHAR}
% The node types of the two kinds of math character noad.
%    \begin{macrocode}
local MATH_CHAR      = node.id("math_char")
local MATH_TEXT_CHAR = node.id("math_text_char")

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{any_cjk_math_enabled}
% Whether any noad of the list asks for CJK in math mode. The switch
% is part of the settings of the text, so the answer is per list.
%    \begin{macrocode}
local function any_cjk_math_enabled (head)
  local cur = head
  while cur do
    if settings_of(cur).cjk_math then
      return true
    end
    cur = cur.next
  end
  return false
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{SUB_MLIST}
% The node type of a nested math list.
%    \begin{macrocode}
local SUB_MLIST = node.id("sub_mlist")

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{rewrite_math}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{CJKmath} and \cs{setCJKmathfont}
%   for CJK characters in math mode, including nested math lists such as
%   fractions. The family is registered as a math family, so a character in a
%   script or a fraction keeps the size of that math style; with
%   \keys{CJKmath} off, a CJK character in math mode warns once.}
% Rewrite the CJK noads of a math list,
% or warn once when the feature is off.
% \begin{macro}[int]{rewrite_math_list}
% Walk a math list, recursing into sub lists (fractions, braces,
% scripts) so that nested CJK characters are rewritten too.
% The declaration is split from the definition because of that recursion.
%    \begin{macrocode}
local rewrite_math_list

%    \end{macrocode}
% \begin{macro}[int]{rewrite_noad}
% Point the nucleus of one noad at the math family of its CJK family, and
% recurse into the sub lists of its numerator, denominator, superscript, and
% subscript.
% The family number comes from the attribute \TeX\ set for the current group,
% which is why \cs{setCJKmathfont} keeps its meaning inside a group: the
% family of the node changes, not a global font.
%    \begin{macrocode}
local function point_at_family (char, family)
  char.fam = family
  if M.attr_font then
    unset_attribute(char, M.attr_font)
  end
end

local function rewrite_field (s, noad, on, family)
  if not s then
    return
  end
  if s.id == MATH_CHAR or s.id == MATH_TEXT_CHAR then
    if is_cjk(s.char, settings_of(noad)) then
      point_at_family(s, family)
    end
  elseif s.id == SUB_MLIST then
    rewrite_math_list(s.head, on, family)
  end
end

local function rewrite_noad (noad, enabled, family)
  if disabled(noad) then
    return
  end
  local on = enabled or settings_of(noad).cjk_math
  if not on or not family then
    return
  end
  rewrite_field(noad.nucleus, noad, on, family)
  for _, field in ipairs({ "num", "denom", "sup", "sub" }) do
    rewrite_field(noad[field], noad, on, family)
  end
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
rewrite_math_list = function (head, enabled, family)
  local cur = head
  while cur do
    rewrite_noad(cur, enabled, family)
    cur = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{LuaCJK.warned_cjk_math}
% Whether the one-time warning has been shown.
%    \begin{macrocode}
M.warned_cjk_math = M.warned_cjk_math or false

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{warn_disabled_cjk_math}
% Warn once when a CJK character appears in math mode while the feature
% is off.
% \begin{macro}[int]{find_cjk_math}
% Search a math list, including its sub lists, for a CJK character.
%    \begin{macrocode}
local function find_cjk_math (head)
  local cur = head
  while cur do
    local nuc = cur.nucleus
    if nuc then
      if (nuc.id == MATH_CHAR or nuc.id == MATH_TEXT_CHAR)
         and is_cjk(nuc.char, settings_of(cur)) then
        return true
      elseif nuc.id == SUB_MLIST and find_cjk_math(nuc.head) then
        return true
      end
    end
    for _, field in ipairs({ "num", "denom", "sup", "sub" }) do
      local sub = cur[field]
      if sub and sub.id == SUB_MLIST and find_cjk_math(sub.head) then
        return true
      end
    end
    cur = cur.next
  end
  return false
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function warn_disabled_cjk_math (head)
  if M.warned_cjk_math then
    return
  end
  if find_cjk_math(head) then
    M.warned_cjk_math = true
    texio.write_nl("term and log",
      "Package LuaCJK Warning: CJK character in math mode, "
      .. "but CJKmath is not enabled.")
    texio.write_nl("term and log",
      "(LuaCJK)                Use \\LuaCJKsetup{CJKmath = true} " ..
      "to typeset it with the CJK font.")
  end
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function math_family_of (head)
  local cur = head
  while cur do
    if M.attr_math_font then
      local family = has_attribute(cur, M.attr_math_font)
      if family and family > 0 then
        return family
      end
      local nuc = cur.nucleus
      if nuc then
        family = has_attribute(nuc, M.attr_math_font)
        if family and family > 0 then
          return family
        end
      end
    end
    cur = cur.next
  end
  return nil
end

local function rewrite_math (head)
  if not any_cjk_math_enabled(head) then
    warn_disabled_cjk_math(head)
    return head
  end
  return rewrite_math_list(head, true, math_family_of(head))
end

%    \end{macrocode}
% \end{macro}
%
% A line that ends at a closing or middle mark, or that starts with an opening
% mark, measures the mark's advance short of its ink: the blank half stands in
% the margin. A line that never counted that blank refuses the mark it could
% have held, and is set loose instead. The hang therefore has to be known while
% the line is broken, and by then only the node list is left, so it is
% expressed as a zero-size rule of negative width beside the break: a closing
% mark that ends a line is followed by such a rule and the break glue carries
% the same width, so the two cancel while the line is set and the rule alone
% shortens the line when the break is taken; a glue and a rule in the same
% order let an opening mark begin a line.
% A kern would not do, because a kern that follows a character is a break
% opportunity of its own and would take a kinsoku penalty, while \TeX\ never
% discards a rule at a line break.
%
% Character protrusion is no help either, because it does not move the ink at
% the end of a line: \tn{protrudechars} together with \tn{rpcode} makes
% \tn{rightmarginkern} report the amount while the glyph keeps its position,
% measured at 10pt with a right code of 1000 in a short line, an overfull line,
% and a line whose width is the natural width. Only \tn{lpcode} moves the line,
% which is what the visible effect of \pkg{microtype}'s protrusion on a Latin
% line consists of.
%
% \begin{macro}[int]{bound_width}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{PunctBoundWidth}, which leaves
%   only the given advance of a mark inside the line and hangs the rest into
%   the margin, at the end of a line, at its start, and when the mark ends a
%   box such as \tn{mbox}.}
% The advance that a mark keeps inside the line when it ends one,
% or nothing when the option is off.
% Without it the hang is the blank the font carries, or half of the advance
% when the file has no outline to read.
%    \begin{macrocode}
local function bound_width (settings)
  local value = settings and settings.bound_width or 0
  if value > 0 then
    return value
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
%
% The hang of a mark is the blank its glyph carries, so the ink of a
% line-final or line-initial mark stands on the measure instead of a half em
% inside it. \pkg{xeCJK} reads that blank from the font with the \XeTeX\
% primitive \tn{XeTeXglyphbounds}; LuaTeX has no such query, so the outline is
% read from the font file, once per file and once per glyph.
%
% Only the tables a measurement needs are parsed, and the bytes of a glyph are
% read when it is first asked for, so a sixteen-megabyte CJK face does not sit
% in memory a second time. The box is the one the control points span, which is
% what \XeTeX\ reports as well.
%
% \begin{variable}[int]{font_files}
% One entry per font file, holding its directory, its character map, and the
% boxes already measured.
%    \begin{macrocode}
local font_files = {}

%    \end{macrocode}
% \end{variable}
% \begin{macro}[int]{u16, i16, u32}
% The big-endian integers of the file format.
%    \begin{macrocode}
local function u16 (s, o) return s:byte(o + 1) * 256 + s:byte(o + 2) end

local function i16 (s, o)
  local v = u16(s, o)
  if v >= 32768 then v = v - 65536 end
  return v
end

local function u32 (s, o) return u16(s, o) * 65536 + u16(s, o + 2) end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{font_file}
% The parsed directory of one font file, or nothing when it cannot be read.
% The handle stays open, because one file serves every mark of the document.
%    \begin{macrocode}
local function font_file (filename)
  local f = font_files[filename]
  if f ~= nil then
    return f or nil
  end
  local fh = io.open(filename, "rb")
  if not fh then
    font_files[filename] = false
    return nil
  end
  local function read (off, len)
    fh:seek("set", off)
    return fh:read(len) or ""
  end
  local head = read(0, 12)
  if #head < 12 then
    font_files[filename] = false
    return nil
  end
  local count = u16(head, 4)
  local dir = read(12, count * 16)
  local tables = {}
  for i = 0, count - 1 do
    local rec = i * 16
    local tag = dir:sub(rec + 1, rec + 4)
    tables[tag] = { offset = u32(dir, rec + 8), length = u32(dir, rec + 12) }
  end
  local t = { fh = fh, read = read, tables = tables, boxes = {} }
  if tables.head then
    t.upem = u16(read(tables.head.offset + 18, 2), 0)
  end
  if not (t.upem and t.upem > 0) then
    fh:close()
    font_files[filename] = false
    return nil
  end
  font_files[filename] = t
  return t
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{font_cmap}
% The character map, preferring a Unicode subtable: a format 12 table for
% the third platform, then a format 4 one, then whichever remains.
%    \begin{macrocode}
local function font_cmap (f)
  local off = f.tables.cmap and f.tables.cmap.offset
  if not off then return end
  local head = f.read(off, 4)
  local n = u16(head, 2)
  local recs = f.read(off + 4, n * 8)
  local choice
  for i = 0, n - 1 do
    local p = i * 8
    local pid, eid = u16(recs, p), u16(recs, p + 2)
    local sub = off + u32(recs, p + 4)
    local fmt = u16(f.read(sub, 2), 0)
    local rank
    if fmt == 12 and pid == 3 and eid == 10 then rank = 3
    elseif fmt == 12 then rank = 2
    elseif fmt == 4 and pid == 3 and eid == 1 then rank = 2
    elseif fmt == 4 then rank = 1 end
    if rank and (not choice or rank > choice.rank) then
      choice = { rank = rank, sub = sub, format = fmt }
    end
  end
  if not choice then return end
  if choice.format == 4 then
    local head4 = f.read(choice.sub, 14)
    local segX2 = u16(head4, 6)
    local seg = segX2 // 2
    f.cmap = {
      format = 4, data = f.read(choice.sub, u16(head4, 2)), segments = seg,
      end_of = 14, start_of = 14 + segX2 + 2,
      delta_of = 14 + segX2 + 2 + segX2,
      range_of = 14 + segX2 + 2 + segX2 + segX2,
    }
  else
    local head12 = f.read(choice.sub, 16)
    f.cmap = { format = 12, data = f.read(choice.sub, u32(head12, 4)) }
  end
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{font_glyph}
% The glyph index of a character, or zero.
%    \begin{macrocode}
local function font_glyph (f, code)
  if f.cmap then
    local c = f.cmap
    if c.format == 4 then
      local end_of, start_of, delta_of, range_of = c.end_of, c.start_of, c.delta_of, c.range_of
      for i = 0, c.segments - 1 do
        if code <= u16(c.data, end_of + i * 2) then
          local start = u16(c.data, start_of + i * 2)
          if code < start then return 0 end
          local delta = i16(c.data, delta_of + i * 2)
          local ro = u16(c.data, range_of + i * 2)
          if ro == 0 then return (code + delta) % 65536 end
          local addr = range_of + i * 2 + ro + (code - start) * 2
          local g = u16(c.data, addr)
          if g == 0 then return 0 end
          return (g + delta) % 65536
        end
      end
      return 0
    elseif c.format == 12 then
      local p = 16
      while p + 12 <= #c.data do
        local s, e, g = u32(c.data, p), u32(c.data, p + 4), u32(c.data, p + 8)
        if code >= s and code <= e then return g + (code - s) end
        p = p + 12
      end
      return 0
    end
    return 0
  end
  return 0
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{font_advance}
% The advance of a glyph from \texttt{hmtx}; a glyph past the last entry takes
% the last advance, as the format says.
%    \begin{macrocode}
local function font_advance (f, gid)
  if f.advances then
    return f.advances[gid] or f.last_advance or 0
  end
  local hhea = f.tables.hhea and f.tables.hhea.offset
  local hmtx = f.tables.hmtx and f.tables.hmtx.offset
  if not (hhea and hmtx) then return f.upem end
  local nhm = u16(f.read(hhea + 34, 2), 0)
  if nhm == 0 then return f.upem end
  local data = f.read(hmtx, nhm * 4)
  local advances, last = {}, 0
  for i = 0, nhm - 1 do
    last = u16(data, i * 4)
    advances[i] = last
  end
  f.advances, f.last_advance = advances, last
  return advances[math.min(gid, nhm - 1)] or last
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{cff_index}
% A \texttt{CFF} index: where its data starts and the offset of each item,
% which is one-based from that start.
%    \begin{macrocode}
local function cff_index (f, p)
  local head = f.read(p, 3)
  local count = u16(head, 0)
  if count == 0 then return { count = 0, next = p + 2, data = p + 2 } end
  local off_size = head:byte(3)
  local offs = f.read(p + 3, (count + 1) * off_size)
  local function off (i)
    local v = 0
    local base = (i - 1) * off_size
    for k = 1, off_size do v = v * 256 + offs:byte(base + k) end
    return v
  end
  local data = p + 3 + (count + 1) * off_size
  return { count = count, data = data, off = off, next = data + off(count + 1) - 1 }
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{cff_string}
% One item of a \texttt{CFF} index, which is a charstring or a dictionary.
%    \begin{macrocode}
local function cff_string (f, idx, i)
  local a, b = idx.off(i), idx.off(i + 1)
  return f.read(idx.data + a - 1, b - a)
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{cff_dict}
% A \texttt{CFF} dictionary as its operators and operands. Only the two
% operators that point at the charstrings and the private dictionary are read,
% so a real number is skipped rather than converted.
%    \begin{macrocode}
local function cff_dict (s)
  local out, stack = {}, {}
  local i, n = 1, #s
  while i <= n do
    local b = s:byte(i)
    if b <= 21 then
      i = i + 1
      local op = b
      if b == 12 then
        op = 1200 + s:byte(i)
        i = i + 1
      end
      out[op] = stack
      stack = {}
    elseif b == 28 then
      local v = s:byte(i + 1) * 256 + s:byte(i + 2)
      if v >= 32768 then v = v - 65536 end
      stack[#stack + 1] = v
      i = i + 3
    elseif b == 29 then
      local v = s:byte(i + 1) * 16777216 + s:byte(i + 2) * 65536
                + s:byte(i + 3) * 256 + s:byte(i + 4)
      if v >= 2147483648 then v = v - 4294967296 end
      stack[#stack + 1] = v
      i = i + 5
    elseif b == 30 then
      i = i + 1
      while i <= n do
        local c = s:byte(i)
        i = i + 1
        if c % 16 == 15 then break end
      end
    elseif b >= 32 and b <= 246 then
      stack[#stack + 1] = b - 139
      i = i + 1
    elseif b >= 247 and b <= 250 then
      stack[#stack + 1] = (b - 247) * 256 + s:byte(i + 1) + 108
      i = i + 2
    elseif b >= 251 and b <= 254 then
      stack[#stack + 1] = -(b - 251) * 256 - s:byte(i + 1) - 108
      i = i + 2
    else
      i = i + 1
    end
  end
  return out
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{cff_load}
% The charstrings of a \texttt{CFF} font and the two subroutine indexes a
% charstring may call into.
%    \begin{macrocode}
local function cff_load (f)
  local base = f.tables["CFF "] and f.tables["CFF "].offset
  if not base then return end
  local hdr = f.read(base + 2, 1)
  local p = base + hdr:byte(1)
  local names = cff_index(f, p)
  local tops = cff_index(f, names.next)
  local strings = cff_index(f, tops.next)
  local gsubrs = cff_index(f, strings.next)
  local top = cff_dict(cff_string(f, tops, 1))
  local cs = top[17] and top[17][1]
  if not cs then return end
  f.charstrings = cff_index(f, base + cs)
  f.gsubrs = gsubrs
  local priv = top[18]
  if priv then
    local size, offset = priv[1], priv[2]
    local pdict = cff_dict(f.read(base + offset, size))
    if pdict[19] then
      f.subrs = cff_index(f, base + offset + pdict[19][1])
    end
  end
  f.cff = true
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{cff_box}
% The horizontal extent of a Type 2 charstring. Every point of the outline is
% visited, the control points of a curve included, which is the box the font's
% own readers report; hints are counted only so that their masks can be
% skipped.
%    \begin{macrocode}
local function cff_box (f, cs)
  local x, xmin, xmax = 0, math.huge, -math.huge
  local stack, stems = {}, 0
  local function point (dx, dy)
    x = x + (dx or 0)
    if x < xmin then xmin = x end
    if x > xmax then xmax = x end
  end
  local function number (b, i)
    if b >= 32 and b <= 246 then return b - 139, i + 1 end
    if b >= 247 and b <= 250 then
      return (b - 247) * 256 + cs:byte(i + 1) + 108, i + 2
    end
    if b >= 251 and b <= 254 then
      return -(b - 251) * 256 - cs:byte(i + 1) - 108, i + 2
    end
    if b == 28 then
      local v = cs:byte(i + 1) * 256 + cs:byte(i + 2)
      if v >= 32768 then v = v - 65536 end
      return v, i + 3
    end
    if b == 255 then
      return (cs:byte(i + 1) * 256 + cs:byte(i + 2)) / 65536, i + 3
    end
    return nil, i
  end
  local run
  run = function (code, depth)
    local i, n = 1, #code
    while i <= n do
      local b = code:byte(i)
      local v
      v, i = number(b, i)
      if v ~= nil then
        stack[#stack + 1] = v
      else
        i = i + 1
        if b == 21 then
          point(stack[1], stack[2])
          stack = {}
        elseif b == 22 then
          point(stack[1], 0)
          stack = {}
        elseif b == 4 then
          point(0, stack[1])
          stack = {}
        elseif b == 5 then
          for k = 1, #stack - 1, 2 do point(stack[k], stack[k + 1]) end
          stack = {}
        elseif b == 6 or b == 7 then
          local horiz = (b == 6)
          for k = 1, #stack do
            if horiz then point(stack[k], 0) else point(0, stack[k]) end
            horiz = not horiz
          end
          stack = {}
        elseif b == 8 then
          for k = 1, #stack - 5, 6 do
            point(stack[k], stack[k + 1])
            point(stack[k + 2], stack[k + 3])
            point(stack[k + 4], stack[k + 5])
          end
          stack = {}
        elseif b == 24 then
          local k = 1
          while k <= #stack - 2 do
            point(stack[k], stack[k + 1])
            k = k + 2
          end
          point(stack[k], stack[k + 1])
          stack = {}
        elseif b == 25 then
          local k = 1
          while k <= #stack - 6 do
            point(stack[k], stack[k + 1])
            point(stack[k + 2], stack[k + 3])
            point(stack[k + 4], stack[k + 5])
            k = k + 6
          end
          point(stack[k], stack[k + 1])
          stack = {}
        elseif b == 26 then
          local k, dx = 1, 0
          if #stack % 2 == 1 then dx, k = stack[1], 2 end
          while k <= #stack - 3 do
            point(dx, stack[k])
            point(stack[k + 1], stack[k + 2])
            point(stack[k + 3], 0)
            dx = 0
            k = k + 4
          end
          stack = {}
        elseif b == 27 then
          local k, dy = 1, 0
          if #stack % 2 == 1 then dy, k = stack[1], 2 end
          while k <= #stack - 3 do
            point(stack[k], dy)
            point(stack[k + 1], stack[k + 2])
            point(0, stack[k + 3])
            dy = 0
            k = k + 4
          end
          stack = {}
        elseif b == 30 or b == 31 then
          local horiz = (b == 31)
          local k = 1
          while k <= #stack - 3 do
            local last = (#stack - k == 3)
            if horiz then
              point(stack[k], last and stack[k + 3] or 0)
              point(stack[k + 1], stack[k + 2])
              point(0, 0)
            else
              point(last and stack[k + 3] or 0, stack[k])
              point(stack[k + 1], stack[k + 2])
              point(0, 0)
            end
            horiz = not horiz
            k = k + 3
          end
          stack = {}
        elseif b == 1 or b == 3 or b == 18 or b == 23 then
          stems = stems + #stack // 2
          stack = {}
        elseif b == 19 or b == 20 then
          stems = stems + #stack // 2
          stack = {}
          i = i + (stems + 7) // 8
        elseif b == 10 or b == 29 then
          local sub = table.remove(stack)
          local arr = (b == 10) and f.subrs or f.gsubrs
          if arr and arr.count > 0 and sub then
            local bias = (arr.count < 1240) and 107
                      or (arr.count < 33900 and 1131 or 32768)
            local idx = sub + bias + 1
            if idx >= 1 and idx <= arr.count and depth < 8 then
              run(cff_string(f, arr, idx), depth + 1)
            end
          end
        elseif b == 11 or b == 14 then
          return
        else
          stack = {}
        end
      end
    end
  end
  run(cs, 0)
  if xmin == math.huge then return nil end
  return xmin, xmax
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{font_box}
% The box of one character in font units: a \texttt{CFF} outline from its
% charstring, a \texttt{glyf} outline from the ten-byte header that starts it,
% and nothing for a character the font does not have.
%    \begin{macrocode}
local function font_box (f, code)
  local known = f.boxes[code]
  if known ~= nil then
    return known or nil
  end
  if f.cff == nil then cff_load(f) end
  if f.cmap == nil then font_cmap(f) end
  local gid = font_glyph(f, code)
  if not gid or gid == 0 then
    f.boxes[code] = false
    return nil
  end
  local advance = font_advance(f, gid)
  local xmin, xmax
  if f.charstrings then
    if gid > f.charstrings.count then return nil end
    xmin, xmax = cff_box(f, cff_string(f, f.charstrings, gid + 1))
  else
    local glyf = f.tables.glyf and f.tables.glyf.offset
    local loca = f.tables.loca and f.tables.loca.offset
    local head = f.tables.head and f.tables.head.offset
    if not (glyf and loca and head) then return nil end
    local long = u16(f.read(head + 50, 2), 0) == 1
    local function loc (i)
      if long then return u32(f.read(loca + i * 4, 4), 0) end
      return u16(f.read(loca + i * 2, 2), 0) * 2
    end
    local a, b = loc(gid), loc(gid + 1)
    if b <= a then return nil end
    local hdr = f.read(glyf + a, 10)
    xmin, xmax = i16(hdr, 2), i16(hdr, 6)
  end
  if not xmin then return nil end
  local box = { xmin = xmin, xmax = xmax, advance = advance }
  f.boxes[code] = box
  return box
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{mark_blank}
% \changes{v0.0.2}{2026/11/20}{The hang of a mark is the blank its font
%   carries, read from the outline, so the ink of a line-final or line-initial
%   mark stands on the measure instead of half an em inside it; a file that
%   cannot be read falls back to half the advance.}
% The blank of a mark on the side that hangs, in scaled points, or nothing
% when the file cannot be read or is one member of a collection. The advance is
% the one the style gives the mark, so a compressed mark is measured inside its
% own advance, where \cs{apply_fixed_widths} puts its ink.
%    \begin{macrocode}
local function mark_blank (g, mark, target)
  local font = font.getfont(g.font)
  if not (font and font.filename and font.size and (font.index or 0) == 0) then
    return nil
  end
  local f = font_file(font.filename)
  if not f then
    return nil
  end
  local box = font_box(f, g.char)
  if not box then
    return nil
  end
  local scale = font.size / f.upem
  local delta = target - box.advance * scale
  local blank
  if mark == "open" then
    blank = box.xmin * scale + delta
  else
    blank = target - box.xmax * scale
    if mark == "middle" then
      blank = blank - delta / 2
    end
  end
  if blank < 0 then
    blank = 0
  elseif blank > target then
    blank = target
  end
  return math.floor(blank + 0.5)
end
%    \end{macrocode}
% \end{macro}


% \begin{macro}[int]{hang_amount}
% How much of a mark's advance stands outside the line: the part that
% \keys{PunctBoundWidth} leaves out, the blank the font carries for the mark,
% or half of the advance the style gives it when the file has no outline to
% read. The advance is the one \cs{apply_fixed_widths} gives it, so a
% compressed style hangs less.
%    \begin{macrocode}
local function hang_amount (g, mark, settings)
  local target = fixed_width(g, settings, style_of(settings)) or g.width
  local bound  = bound_width(settings)
  if bound then
    return math.max(0, target - bound)
  end
  local blank = mark_blank(g, mark, target)
  if blank then
    return blank
  end
  return math.floor(0.5 * target + 0.5)
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{hang_bounds}
% \changes{v0.0.2}{2026/11/20}{The hanging of a mark takes part in line
%   breaking, so a line that ends at a closing mark or begins with an opening
%   mark holds the mark the margin allows; the ink of that mark stands outside
%   the line, and \keys{PunctBoundWidth} decides how much of the advance stays
%   inside.}
% Bracket every break point that a mark ends or starts, so the line measures
% the hang and the text inside a line does not move. A break that a preceding
% penalty already forbids is left alone, so a fixed width does not carry a rule
% that can never be used.
%    \begin{macrocode}
local function hang_bounds (head)
  local prev = nil
  local last = nil
  local cur  = head
  while cur do
    if cur.id == GLYPH
       or ((cur.id == HLIST or cur.id == VLIST) and box_visible(cur)) then
      last = cur
    elseif is_break_point(cur) and last and cur.id == GLUE
           and not (prev and prev.id == PENALTY and prev.penalty >= 10000) then
      local nxt                       = next_visible(cur.next)
      local tail, _, tail_glyph       = edge_mark(last, true)
      local lead, _, lead_glyph       = nil, nil, nil
      if nxt then
        lead, _, lead_glyph = edge_mark(nxt, false)
      end
      local w_end   = 0
      local w_start = 0
      if tail_glyph and not disabled(tail_glyph)
         and (tail == "close" or tail == "middle")
         and style_of(settings_of(tail_glyph)).hang then
        w_end = hang_amount(tail_glyph, tail, settings_of(tail_glyph))
      end
      if lead_glyph and not disabled(lead_glyph) and lead == "open"
         and style_of(settings_of(lead_glyph)).hang then
        w_start = hang_amount(lead_glyph, "open", settings_of(lead_glyph))
      end
      if w_end > 0 or w_start > 0 then
        local delta = w_end + w_start
        cur.width = cur.width + delta
        if w_end > 0 then
          local r  = new_node("rule")
          r.width  = -w_end
          r.height = 0
          r.depth  = 0
          inherit_attributes(r, tail_glyph)
          r.next = cur
          if prev then
            prev.next = r
          else
            head = r
          end
          prev = r
        end
        if w_start > 0 then
          local r  = new_node("rule")
          r.width  = -w_start
          r.height = 0
          r.depth  = 0
          inherit_attributes(r, lead_glyph)
          r.next = cur.next
          cur.next = r
        end
      end
    end
    prev = cur
    cur  = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \TeX\ can break at the glue that LuaCJK inserts between CJK characters.
% At the end of a paragraph the last two such break points get a penalty,
% so that at least three CJK characters travel to the last line together
% instead of a single one.
%
% \begin{macro}[int]{apply_check_single}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{CheckSingle} and
%   \keys{WidowPenalty}, which stop a single CJK character from ending up
%   alone on the last line of a paragraph.}
% Insert the widow penalties. Only a paragraph whose last visible node
% is a CJK glyph is examined, and only when its settings ask for it.
%    \begin{macrocode}
local function apply_check_single (head)
  local trail = {}
  local node  = head
  while node do
    trail[#trail + 1] = node
    node = node.next
  end
  local last
  for i = #trail, 1, -1 do
    local item = trail[i]
    if item.id == GLYPH then
      if is_cjk(item.char, settings_of(item)) then
        last = i
      end
      break
    elseif item.id == HLIST or item.id == VLIST then
      break
    end
  end
  if not last then
    return head
  end
  local settings = settings_of(trail[last])
  if not settings.check_single then
    return head
  end
  local penalty  = settings.widow_penalty
  local inserted = 0
  local i        = last
  while i > 1 and inserted < 2 do
    local j = i - 1
    while j >= 1 and (trail[j].id == GLUE or trail[j].id == PENALTY) do
      j = j - 1
    end
    if j < 1 then
      break
    end
    local glyph = trail[j]
    if glyph.id ~= GLYPH or not is_cjk(glyph.char, settings_of(glyph)) then
      break
    end
    local target = trail[j + 1]
    if target and target.id == GLUE then
      local p = new_node("penalty")
      inherit_attributes(p, glyph)
      p.penalty  = penalty
      p.next     = target
      glyph.next = p
    end
    inserted = inserted + 1
    i        = j
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.process}
% Run the passes over a list, in the order in which they depend on each
% other: the font first, because the classes depend on it; then the
% spacing, the fixed widths, the prohibitions, and the widow penalties.
% The hang of a mark is inserted only when the list is a paragraph about to be
% broken, because a box packed by \tn{hpack} has no break to hang at.
%    \begin{macrocode}
local function process (head, linebreak)
  head = rewrite_fonts(head)
  head = spacing(head)
  head = apply_fixed_widths(head)
  if linebreak then
    head = hang_bounds(head)
  end
  head = apply_kinsoku(head)
  head = apply_check_single(head)
  return head
end

M.process = process

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.pre_linebreak}
% The line-breaking callback.
%    \begin{macrocode}
function M.pre_linebreak (head, groupcode)
  return process(head, true)
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.hpack}
% The box-packing callback.
%    \begin{macrocode}
function M.hpack (head, groupcode, size, packtype, direction, attributelist)
  return process(head)
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.pre_mlist_to_hlist}
% The math callback.
%    \begin{macrocode}
function M.pre_mlist_to_hlist (head, display, penalties)
  return rewrite_math(head)
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.hyphenate}
% The hyphenation callback.
% \TeX\ hyphenates a word while it breaks the lines, after the
% pre-linebreaking pass has already built the list, so the discretionaries of
% a word appear after the prohibitions have been placed and nothing forbids
% them yet.
% The callback hyphenates exactly as \TeX\ does and then reads the
% discretionaries it has just created, one word at a time.
%    \begin{macrocode}
function M.hyphenate (head, tail)
  lang.hyphenate(head, tail)
  local left = nil
  local cur  = head
  while cur do
    if cur.id == GLYPH then
      left = cur
    elseif cur.id == DISC then
      forbid_marked_disc(cur, left)
    end
    if cur == tail then
      break
    end
    cur = cur.next
  end
end

%    \end{macrocode}
% \end{macro}
%
% The callbacks are registered in this order: spacing, font correction,
% math, and hyphenation, which is the only one that runs inside the line
% breaker rather than around it.
%    \begin{macrocode}
luatexbase.add_to_callback("pre_linebreak_filter",
  M.pre_linebreak, "LuaCJK.spacing")
luatexbase.add_to_callback("hpack_filter", M.hpack, "LuaCJK.spacing")
luatexbase.add_to_callback("pre_mlist_to_hlist_filter",
  M.pre_mlist_to_hlist, "LuaCJK.math")
luatexbase.add_to_callback("hyphenate", M.hyphenate, "LuaCJK.hyphenate")
%</lua-core>
%    \end{macrocode}
%
% \subsection{Decorations}
%
% \pkg{lua-ul} draws each decoration as a pair of nodes: a leaders glue
% of width $w$ and a glue of width $-w$ that gives the space back,
% so the text does not move. Changing those numbers is enough to inset
% the decoration and to leave out the punctuation, which is why LuaCJK
% adjusts the box instead of drawing the decoration itself.
% \TeX\ numbers the glue subtypes, and 100 is \tn{leaders},
% the one both \pkg{lua-ul} and this package use.
%
% \begin{variable}[int]
%   {LuaCJKfntef.attr, LuaCJKfntef.settings}
% The attribute that carries the number of a settings entry, and the entry
% itself: the inset at both ends and whether punctuation is skipped.
% A separate entry per call keeps two decorations in one paragraph apart.
%    \begin{macrocode}
%<*lua-fntef>
LuaCJKfntef = LuaCJKfntef or {}

local M       = LuaCJKfntef
local GLYPH   = node.id("glyph")
local GLUE    = node.id("glue")
local LEADERS = 100
local KERN    = node.id("kern")
local HLIST   = node.id("hlist")
local RULE    = node.id("rule")

M.attr     = M.attr     or nil
M.settings = M.settings or {}
M.next_id  = M.next_id  or 1

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{LuaCJKfntef.em_descent}
% The descent of the em box of the current font, in scaled points.
% A CJK em box is one em square, so its descent is both what a highlight has
% to add below the baseline to cover a character, and what separates the ink
% from the bottom of that square.
%
% The value comes from \texttt{ascent}, \texttt{descent} and
% \texttt{units_per_em} of the font file, cached per file name: opening a CJK
% font costs about half a second, and one file serves every size.
%    \begin{macrocode}
local em_metrics = {}

local function font_em (filename)
  local m = em_metrics[filename]
  if m ~= nil then
    return m or nil
  end
  local ok, t = pcall(fontloader.open, filename)
  if ok and t and t.units_per_em and t.units_per_em > 0 and t.descent then
    m = { descent = t.descent, upem = t.units_per_em }
    fontloader.close(t)
  else
    m = false
  end
  em_metrics[filename] = m
  return m or nil
end

function M.em_descent (id)
  local f = tonumber(id)
  f = f and f > 0 and font.getfont(f) or nil
  local size = f and f.size or tex.sp("1em")
  local m = f and f.filename and font_em(f.filename)
  local sp
  if m then
    sp = math.floor(m.descent / m.upem * size + 0.5)
  else
    sp = math.floor(0.12 * size + 0.5)
  end
  return string.format("%d", sp)
end

%    \end{macrocode}
% \end{macro}
%
% A decoration records its settings by selecting an entry:
% the number of the entry goes into the attribute on the decorated text, and
% attribute zero means that the text carries no decoration of this package.
%
% \begin{macro}[int]{LuaCJKfntef.new_settings}
% Register one entry and select it.
%    \begin{macrocode}
function M.new_settings (subtract, skip)
  local id       = M.next_id
  M.next_id      = id + 1
  M.settings[id] = { subtract = subtract, skip = skip }
  if M.attr then
    tex.setattribute(M.attr, id)
  end
end
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{kind}
% The punctuation group of a character, as the core module classifies it.
%    \begin{macrocode}
local function kind (c)
  local class = LuaCJK.punct_class
  if class then
    return class(c)
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{segments}
% The intervals of a span of width \meta{w} that the decoration may cover:
% the first and the last \meta{inset} are taken off, and with
% \meta{skip-punct} every punctuation mark inside is cut out as well.
% A cut is clamped to the span,
% so a mark that straddles the end keeps the part that fits.
%    \begin{macrocode}
local function segments (w, start, inset, skip_punct)
  local cuts = {}
  if skip_punct then
    local x = 0
    local g = start
    while g and x < w do
      local width = g.width or 0
      if g.id == GLYPH and kind(g.char) then
        cuts[#cuts + 1] = { x, math.min(x + width, w) }
      end
      x = x + width
      g = g.next
    end
  end
  local result = {}
  local low    = math.min(inset, w)
  local high   = math.max(w - inset, low)
  for _, cut in ipairs(cuts) do
    if cut[1] > low then
      result[#result + 1] = { low, math.min(cut[1], high) }
    end
    low = math.max(low, cut[2])
  end
  if low < high then
    result[#result + 1] = { low, high }
  end
  return result
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{settings_at}
% The settings of the decoration whose leaders pair ends just
% before \meta{node}: the number is read from that node,
% because the pair itself is inserted before the marked text.
%    \begin{macrocode}
local function settings_at (node_)
  if not node_ or not M.attr then
    return nil
  end
  local id = node.has_attribute(node_, M.attr)
  if not id or id == 0 then
    return nil
  end
  return M.settings[id]
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{single_rule}
% The rule that a decoration box reduces to, and how far the box moves it
% down. A box holding nothing but kerns, glues and one rule qualifies.
% \tn{leaders} repeats the box, and only whole copies fit, so the last
% fraction of the span stays empty: with a one-point object that is a
% visible gap at the right end of a highlight. A box that reduces to one
% rule is therefore drawn as a single rule of the full width instead.
%    \begin{macrocode}
local function single_rule (list, down)
  local found
  local n = list
  while n do
    if n.id == RULE then
      if found then
        return nil
      end
      found = n
    elseif n.id == HLIST then
      if found then
        return nil
      end
      local r, d = single_rule(n.head, down + (n.shift or 0))
      if not r then
        return nil
      end
      found, down = r, d
    elseif n.id == KERN then
      -- horizontal material, no vertical effect
    elseif n.id == GLUE and not n.leader then
      -- a plain glue between the pieces
    else
      return nil
    end
    n = n.next
  end
  if found then
    return found, down
  end
  return nil
end

local function box_rule (box)
  if not box or box.id ~= HLIST then
    return nil
  end
  local rule, down = single_rule(box.head, box.shift or 0)
  -- Only a solid block qualifies: the rule must fill the box, or the
  -- pattern would lose whatever sits beside it.
  if rule and rule.width == box.width then
    return rule, down
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{replace_pair}
% Replace the leaders glue of one decoration.
% The pieces are kerns and shorter leaders whose total width stays
% \meta{w}, so the text does not move; the negative glue that follows
% the leaders is kept and becomes the tail of the replacement.
%    \begin{macrocode}
local function replace_pair (head, prev, leaders, settings)
  local w     = leaders.width
  local neg   = leaders.next
  local subtract = settings and settings.subtract or 0
  local skip     = settings and settings.skip or false
  local parts = segments(w, neg.next, subtract, skip)
  local rule, down = box_rule(leaders.leader)
  local first, last
  local cursor = 0
  local function append (node_)
    if last then
      last.next = node_
    else
      first = node_
    end
    last = node_
  end
  for _, part in ipairs(parts) do
    if part[1] > cursor then
      local k = node.new("kern")
      k.kern  = part[1] - cursor
      append(k)
    end
    if rule then
      local r  = node.copy(rule)
      r.width  = part[2] - part[1]
      r.height = rule.height - down
      r.depth  = rule.depth + down
      r.next   = nil
      append(r)
    else
      local copy   = node.copy(leaders)
      copy.width   = part[2] - part[1]
      copy.stretch = 0
      copy.shrink  = 0
      copy.next    = nil
      append(copy)
    end
    cursor = part[2]
  end
  if cursor < w then
    local k = node.new("kern")
    k.kern  = w - cursor
    append(k)
  end
  if first then
    if prev then
      prev.next = first
    else
      head = first
    end
    last.next = neg
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{adjust}
% Walk a horizontal list and rewrite every leaders pair whose following node
% carries a settings entry.
%    \begin{macrocode}
local function adjust (head)
  if not M.attr then
    return head
  end
  local prev = nil
  local n    = head
  while n do
    local nxt = n.next
    if n.id == GLUE and n.subtype == LEADERS and n.next
       and n.next.id == GLUE and n.next.width == -n.width then
      local neg      = n.next
      local settings = settings_at(neg.next)
      if settings or box_rule(n.leader) then
        head = replace_pair(head, prev, n, settings)
        n    = neg
        nxt  = neg.next
      end
    end
    prev = n
    n    = nxt
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJKfntef.hpack}
% The box-packing callback. The pass also runs before a box is appended
% to a vertical list, because a box built earlier is not packed again.
%    \begin{macrocode}
function M.hpack (head)
  return adjust(head)
end

luatexbase.add_to_callback("hpack_filter", M.hpack, "LuaCJKfntef.adjust")
luatexbase.add_to_callback("pre_append_to_vlist_filter",
  function (box)
    if box.id == node.id("hlist") then
      box.head = adjust(box.head)
    end
    return box
  end, "LuaCJKfntef.adjust")
%</lua-fntef>
%    \end{macrocode}
% \end{macro}

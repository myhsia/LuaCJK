\prop_new:N \g_@@_fallback_prop
\bool_new:N \l_@@_auto_fallback_bool
\bool_new:N \g_@@_load_fandol_bool
\tl_new:N \l_@@_fallback_family_tl
\tl_new:N \l_@@_fallback_key_tl
\prop_new:N \g_@@_shift_decl_prop
\prop_new:N \g_@@_font_shift_prop

% \begin{variable}[int]{\g_@@_family_prop, \l_@@_family_tl}
% The registered families, and the family name currently selected.
%    \begin{macrocode}
\prop_new:N \g_@@_family_prop
\tl_new:N \l_@@_family_tl
\tl_set:Nn \l_@@_family_tl { zhsong }
%    \end{macrocode}
% \end{variable}
% \begin{variable}[int]{\l_@@_fontspec_tl, \l_@@_family_name_tl, \l_@@_tmpa_tl}
% Scratch variables holding the generated \pkg{fontspec} family name,
% the family name looked up in the property list,
% and a temporary value.
%    \begin{macrocode}
\tl_new:N \l_@@_fontspec_tl
\tl_new:N \l_@@_family_name_tl
\tl_new:N \l_@@_tmpa_tl
\tl_new:N \l_@@_tmpb_tl
\int_new:N \l_@@_tmpa_int
\tl_new:N \l_@@_registered_name_tl
%    \end{macrocode}
% \end{variable}
% \begin{variable}[int]
%   {
%     \g_@@_font_name_prop,
%     \g_@@_font_feature_prop,
%     \l_@@_default_feature_tl
%   }
% The font name and the explicit options of each family,
% kept so that \cs{addCJKfontfeatures} can register the family again,
% and the features prepended to every family.
% \begin{variable}[int]
%   {
%     \l_@@_autofake_bold_given_bool,
%     \l_@@_autofake_slant_given_bool,
%     \l_@@_bold_font_given_bool,
%     \l_@@_italic_font_given_bool
%   }
% Whether one family's options already mention \keys{AutoFakeBold},
% \keys{AutoFakeSlant}, \texttt{BoldFont}, or \texttt{ItalicFont}.
%    \begin{macrocode}
\bool_new:N \l_@@_autofake_bold_given_bool
\bool_new:N \l_@@_autofake_slant_given_bool
\bool_new:N \l_@@_bold_font_given_bool
\bool_new:N \l_@@_italic_font_given_bool
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\prop_new:N \g_@@_font_name_prop
\prop_new:N \g_@@_font_feature_prop
\tl_new:N  \l_@@_default_feature_tl
\tl_set:Nn \l_@@_default_feature_tl { Script = CJK }
\tl_new:N  \l_@@_feature_tl
\cs_generate_variant:Nn \fontspec_gset_family:Nnn { NVV , NVn }
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_set_family:nnn #1#2#3
  {
    \@@_build_features:n {#2}
    \prop_gput:NnV \g_@@_font_feature_prop {#1} \l_@@_feature_tl
    \prop_gput:Nnn \g_@@_font_name_prop {#1} {#3}
    \@@_register_family:n {#1}
  }
%    \end{macrocode}
% \begin{macro}[int]{\@@_build_features:n}
% Combine the default features, the options given for this family,
% and the automatic fake bold and slant,
% unless the family sets them itself.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_note_feature_key:nn #1#2
  { \@@_note_feature_key:n {#1} }
\cs_new_protected:Npn \@@_note_feature_key:n #1
  {
    \str_case:en { \tl_trim_spaces:n {#1} }
      {
        { AutoFakeBold  } { \bool_set_true:N \l_@@_autofake_bold_given_bool  }
        { AutoFakeSlant } { \bool_set_true:N \l_@@_autofake_slant_given_bool }
        { BoldFont      } { \bool_set_true:N \l_@@_bold_font_given_bool      }
        { ItalicFont    } { \bool_set_true:N \l_@@_italic_font_given_bool    }
      }
  }
\cs_new_protected:Npn \@@_build_features:n #1
  {
    \clist_map_inline:nn
      { autofake_bold, autofake_slant, bold_font, italic_font }
      { \exp_args:Nc \bool_set_false:N { l_@@_##1_given_bool } }
    \keyval_parse:NNn
      \@@_note_feature_key:n \@@_note_feature_key:nn {#1}
    \tl_set_eq:NN \l_@@_feature_tl \l_@@_default_feature_tl
    \tl_if_blank:nF {#1}
      { \tl_put_right:Nn \l_@@_feature_tl { , ~ #1 } }
    \tl_if_empty:NF \g_@@_autofake_bold_tl
      {
        \bool_lazy_or:nnF
          { \l_@@_autofake_bold_given_bool }
          { \l_@@_bold_font_given_bool     }
          {
            \tl_put_right:Nx \l_@@_feature_tl
              { , ~ AutoFakeBold = \exp_not:V \g_@@_autofake_bold_tl }
          }
      }
    \tl_if_empty:NF \g_@@_autofake_slant_tl
      {
        \bool_lazy_or:nnF
          { \l_@@_autofake_slant_given_bool }
          { \l_@@_italic_font_given_bool    }
          {
            \tl_put_right:Nx \l_@@_feature_tl
              { , ~ AutoFakeSlant = \exp_not:V \g_@@_autofake_slant_tl }
          }
      }
  }
%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{\@@_register_family:n}
% Build the \pkg{fontspec} family from the stored font name
% and features, and re-select it if it is the current one.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_register_family:n #1
  {
    \prop_get:NnNF \g_@@_font_name_prop {#1} \l_@@_registered_name_tl
      { \tl_clear:N \l_@@_registered_name_tl }
    \prop_get:NnNF \g_@@_font_feature_prop {#1} \l_@@_feature_tl
      { \tl_clear:N \l_@@_feature_tl }
    \prop_get:NnNF \g_@@_shift_decl_prop {#1} \l_@@_shift_dim_tl
      { \tl_clear:N \l_@@_shift_dim_tl }
    \group_begin:
      \fontspec_gset_family:NVV \l_@@_fontspec_tl
        \l_@@_feature_tl \l_@@_registered_name_tl
      \prop_gput:NnV \g_@@_family_prop {#1} \l_@@_fontspec_tl
      \tl_if_empty:NF \l_@@_shift_dim_tl
        {
          \prop_gput:NVV \g_@@_font_shift_prop
            \l_@@_fontspec_tl \l_@@_shift_dim_tl
        }
    \group_end:
    \prop_if_in:NVT \g_@@_family_prop \l_@@_family_tl
      { \selectfont }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_push_fallback:, \@@_refresh_fallbacks:}
% Resolve the fallback families of the current CJK family to font
% identifiers at the current size, series, and shape, and hand the list to
% Lua together with the identifier of the family itself.
% A font identifier belongs to one instance of a font, so the list has to be
% resolved again whenever a font is selected: the identifier of the bold or
% enlarged main font is not the one the upright size was resolved at.
% \begin{variable}[int]
%   {\g_@@_fallback_pushed_prop, \g_@@_lua_loaded_bool}
% The CJK family whose list was last handed to Lua for each font identifier,
% which makes a selection that resolves to a known identifier cost one
% property lookup, and whether the Lua module has been loaded.
% The guard of \cs{@@_update_font:} is raised around the resolution, so the
% temporary selections it makes do not change the identifier they are
% resolved for.
%    \begin{macrocode}
\prop_new:N \g_@@_fallback_pushed_prop
\bool_new:N \g_@@_lua_loaded_bool
\cs_new_protected:Npn \@@_push_fallback:
  {
    \int_compare:nNnT { \g_@@_fontid_int } > { 0 }
      {
        \tl_set:Ne \l_@@_fontid_tl { \int_use:N \g_@@_fontid_int }
        \prop_get:NVNT \g_@@_fallback_prop \l_@@_family_tl \l_@@_tmpa_tl
          {
            \prop_get:NVNF \g_@@_fallback_pushed_prop
              \l_@@_fontid_tl \l_@@_tmpb_tl
              { \tl_clear:N \l_@@_tmpb_tl }
            \tl_if_eq:NNF \l_@@_tmpb_tl \l_@@_family_tl
              { \exp_args:NV \@@_push_fallback_aux:n \l_@@_tmpa_tl }
          }
      }
  }
\cs_new_protected:Npn \@@_push_fallback_aux:n #1
  {
    \group_begin:
      \tl_clear:N \l_@@_fallback_ids_tl
      \clist_map_inline:nn {#1}
        {
          \fontfamily {##1} \selectfont
          \tl_set:Ne \l_@@_tmpb_tl
            { \int_eval:n { \tex_fontid:D \tex_font:D } }
          \tl_put_right:NV \l_@@_fallback_ids_tl \l_@@_tmpb_tl
          \tl_put_right:Nn \l_@@_fallback_ids_tl { , }
          \@@_push_shift:nn { \l_@@_tmpb_tl } {##1}
        }
      \bool_if:NT \g_@@_lua_loaded_bool
        {
          \tl_if_empty:NF \l_@@_fallback_ids_tl
            {
              \lua_now:e
                {
                  LuaCJK.set_fallback
                    ( \int_use:N \g_@@_fontid_int ,
                      { \l_@@_fallback_ids_tl } )
                }
              \prop_gput:NVV \g_@@_fallback_pushed_prop
                \l_@@_fontid_tl \l_@@_family_tl
            }
        }
    \group_end:
  }
\cs_new_protected:Npn \@@_refresh_fallbacks:
  {
    \prop_gclear:N \g_@@_fallback_pushed_prop
    \bool_set_true:N \l_@@_selectfont_bool
    \@@_push_fallback:
    \bool_set_false:N \l_@@_selectfont_bool
  }
%    \end{macrocode}
% \end{variable}
% \end{macro}
%
% \begin{macro}[int]{\@@_push_shift:nn}
% Hand the vertical offset of one font to Lua, once per font identifier.
% \begin{variable}[int]
%   {
%     \g_@@_font_shift_prop, \g_@@_shift_pushed_prop,
%     \l_@@_shift_dim_tl,    \l_@@_shift_fid_tl, \l_@@_shift_family_tl
%   }
% The \keys{Baseline} value of each registered font, keyed by the family
% \pkg{fontspec} returned for it; the identifiers whose offset Lua already
% knows; and scratch variables for the identifier and the offset, which is
% evaluated at the size in force so that a value in |em| follows the text.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_push_shift:nn #1#2
  {
    \tl_set:Ne \l_@@_shift_fid_tl {#1}
    \tl_set:Ne \l_@@_shift_family_tl {#2}
    \prop_get:NVNT \g_@@_font_shift_prop
      \l_@@_shift_family_tl \l_@@_shift_dim_tl
      {
        \tl_if_empty:NF \l_@@_shift_dim_tl
          {
            \prop_if_in:NVF \g_@@_shift_pushed_prop \l_@@_shift_fid_tl
              {
                \prop_gput:NVn \g_@@_shift_pushed_prop
                  \l_@@_shift_fid_tl { }
                \lua_now:e
                  {
                    LuaCJK.set_yoffset
                      ( \l_@@_shift_fid_tl ,
                        \dim_to_decimal_in_sp:n
                          { \dim_eval:n { \l_@@_shift_dim_tl } } )
                  }
              }
          }
      }
  }
%    \end{macrocode}
% \end{variable}
% \end{macro}
% \end{macro}

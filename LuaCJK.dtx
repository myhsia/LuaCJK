          { }
          {
            \tl_put_right:Nx \l_LuaCJK_feature_tl
              { , ~ AutoFakeSlant = \exp_not:V \g_LuaCJK_autofake_slant_tl }
          }
      }
  }
%    \end{macrocode}
%   \end{macro}
%   \begin{macro}[internal]{\LuaCJK_register_family:n}
%     Build the \pkg{fontspec} family from the stored font name and
%     features, and re-select it if it is the current one.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_register_family:n #1
  {
    \prop_get:NnNF \g_LuaCJK_font_name_prop {#1} \l_LuaCJK_registered_name_tl
      { \tl_clear:N \l_LuaCJK_registered_name_tl }
    \prop_get:NnNF \g_LuaCJK_font_feature_prop {#1} \l_LuaCJK_feature_tl
      { \tl_clear:N \l_LuaCJK_feature_tl }
    \group_begin:
      \fontspec_gset_family:NVV \l_LuaCJK_fontspec_tl
        \l_LuaCJK_feature_tl \l_LuaCJK_registered_name_tl
      \prop_gput:NnV \g_LuaCJK_family_prop {#1} \l_LuaCJK_fontspec_tl
    \group_end:
    \LuaCJK_recall_fallback:n {#1}
    \prop_if_in:NVT \g_LuaCJK_family_prop \l_LuaCJK_family_tl
      { \selectfont }
  }
%    \end{macrocode}
%   \end{macro}
%
%   \begin{macro}[internal]{\LuaCJK_recall_fallback:n}
%     Resolve the fallback families of one CJK family to font identifiers
%     at the current size, and hand the list to Lua together with the
%     identifier of the family itself.  Font identifiers depend on the size,
%     so this runs again whenever a family is registered.
%     The variables used here are declared with the other options above.
%      \begin{macrocode}
%      \begin{macrocode}
\bool_new:N \g_LuaCJK_lua_loaded_bool
\cs_new_protected:Npn \LuaCJK_push_break_puncts:
  {
    \bool_if:NT \g_LuaCJK_lua_loaded_bool
      {
        \bool_if:NTF \l_LuaCJK_break_between_puncts_bool
          { \lua_now:n { LuaCJK.allow_break_between_puncts = true } }
          { \lua_now:n { LuaCJK.allow_break_between_puncts = false } }
      }
  }
\cs_new_protected:Npn \LuaCJK_push_fallback_switch:
  {
    \bool_if:NT \g_LuaCJK_lua_loaded_bool
      {
        \bool_if:NTF \g_LuaCJK_auto_fallback_bool
          { \lua_now:n { LuaCJK.auto_fallback = true } }
          { \lua_now:n { LuaCJK.auto_fallback = false } }
      }
  }
%      \end{macrocode}
%     \end{variable}
%      \begin{macrocode}
%      \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_recall_all_fallbacks:
  {
    \prop_map_inline:Nn \g_LuaCJK_family_prop
      { \LuaCJK_recall_fallback:n {##1} }
  }
%      \end{macrocode}
%     \end{variable}
%      \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_recall_fallback:n #1
  {
    \bool_if:NT \g_LuaCJK_auto_fallback_bool
      {
        \prop_get:NnNF \g_LuaCJK_fallback_prop {#1} \l_LuaCJK_tmpa_tl
          { \tl_clear:N \l_LuaCJK_tmpa_tl }
        \group_begin:
          \tl_clear:N \l_LuaCJK_fallback_ids_tl
          \prop_get:NnNF \g_LuaCJK_family_prop {#1}
            \l_LuaCJK_family_name_tl
            { \tl_clear:N \l_LuaCJK_family_name_tl }
          \exp_args:NV \fontfamily \l_LuaCJK_family_name_tl
          \selectfont
          \int_set:Nn \l_LuaCJK_main_fontid_int
            { \tex_fontid:D \tex_font:D }
          \clist_map_inline:Nn \l_LuaCJK_tmpa_tl
            {
              \fontfamily {##1} \selectfont
              \tl_put_right:Nx \l_LuaCJK_fallback_ids_tl
                { \int_eval:n { \tex_fontid:D \tex_font:D } , }
            }
          \bool_if:NT \g_LuaCJK_lua_loaded_bool
            {
              \tl_if_empty:NF \l_LuaCJK_fallback_ids_tl
                {
                  \lua_now:e
                    {
                      LuaCJK.set_fallback
                        ( \int_use:N \l_LuaCJK_main_fontid_int ,
                          { \l_LuaCJK_fallback_ids_tl } )
                    }
                }
            }
        \group_end:
      }
  }
%    \end{macrocode}
%   \end{macro}
% \end{macro}
%
% \begin{macro}[internal]{\LuaCJK_switch_family:n}
%   Select a registered family and warn once about an unknown name.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_switch_family:n #1
  {
    \prop_if_in:NnTF \g_LuaCJK_family_prop {#1}
      {
        \tl_set:Nn \l_LuaCJK_family_tl {#1}
        \selectfont
      }
      {
        \seq_if_in:NnF \g_LuaCJK_unknown_family_seq {#1}
          {
            \seq_gput_right:Nn \g_LuaCJK_unknown_family_seq {#1}
            \msg_warning:nnn { LuaCJK } { family-unknown } {#1}
          }
      }
  }
\seq_new:N \g_LuaCJK_unknown_family_seq
\msg_new:nnn { LuaCJK } { family-unknown }
  { Unknown~CJK~family~`#1'~is~being~ignored. }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{\LuaCJK_update_font:}
%   On every \tn{selectfont}, resolve the current family and the math
%   family to font identifiers and store them in the attributes.
%   \begin{variable}[internal]{\l_LuaCJK_selectfont_bool, \g_LuaCJK_fontid_int}
%     A guard against re-entering the update while \tn{selectfont} runs,
%     and the font identifier of the current CJK family.
%    \begin{macrocode}
\bool_new:N \l_LuaCJK_selectfont_bool
\int_new:N \g_LuaCJK_fontid_int
%    \end{macrocode}
%   \end{variable}
%   \begin{variable}[internal]
%     {\l_LuaCJK_math_family_tl, \g_LuaCJK_math_fontid_int,
%      \l_LuaCJK_punct_family_tl}
%     The math family registered by \cs{setCJKmathfont}, the font identifier
%     resolved from it, and the family chosen by \texttt{PunctFamily}.
%    \begin{macrocode}
\tl_new:N \l_LuaCJK_math_family_tl
\tl_new:N \l_LuaCJK_punct_family_tl
\int_new:N \g_LuaCJK_punct_fontid_int
\int_new:N \g_LuaCJK_math_fontid_int
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_update_font:
  {
    \bool_if:NF \l_LuaCJK_selectfont_bool
      {
        \bool_set_true:N \l_LuaCJK_selectfont_bool
        \prop_get:NVNTF \g_LuaCJK_family_prop \l_LuaCJK_family_tl \l_LuaCJK_family_name_tl
          {
            \group_begin:
              \exp_args:NV \fontfamily \l_LuaCJK_family_name_tl
              \selectfont
              \int_gset:Nn \g_LuaCJK_fontid_int
                { \tex_fontid:D \tex_font:D }
            \group_end:
            \g_LuaCJK_font_attr = \g_LuaCJK_fontid_int
          }
          { \g_LuaCJK_font_attr = \c_zero_int }
        \tl_if_empty:NTF \l_LuaCJK_math_family_tl
          { \int_gset:Nn \g_LuaCJK_math_fontid_int { \int_use:N \g_LuaCJK_fontid_int } }
          {
            \prop_get:NVNTF \g_LuaCJK_family_prop \l_LuaCJK_math_family_tl
              \l_LuaCJK_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \fontfamily \l_LuaCJK_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_LuaCJK_math_fontid_int
                    { \tex_fontid:D \tex_font:D }
                \group_end:
              }
              { \int_gzero:N \g_LuaCJK_math_fontid_int }
          }
        \LuaCJK_push_block_fonts:
        \g_LuaCJK_math_font_attr = \g_LuaCJK_math_fontid_int
        \tl_if_empty:NTF \l_LuaCJK_punct_family_tl
          { \g_LuaCJK_punct_font_attr = \c_zero_int }
          {
            \prop_get:NVNTF \g_LuaCJK_family_prop \l_LuaCJK_punct_family_tl
              \l_LuaCJK_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \fontfamily \l_LuaCJK_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_LuaCJK_punct_fontid_int
                    { \tex_fontid:D \tex_font:D }
                \group_end:
                \g_LuaCJK_punct_font_attr = \g_LuaCJK_punct_fontid_int
              }
              { \g_LuaCJK_punct_font_attr = \c_zero_int }
          }
        \bool_set_false:N \l_LuaCJK_selectfont_bool
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{\LuaCJK_push_block_fonts:}
%   Resolve the block fonts of the current family at the current size and
%   hand them to Lua, keyed by the font identifier of the family.  Font
%   identifiers depend on the size, so this runs again whenever a font is
%   selected.
%    \begin{macrocode}
\int_new:N \g_LuaCJK_block_fontid_int
\cs_new_protected:Npn \LuaCJK_push_block_fonts:
  {
    \int_compare:nNnT { \g_LuaCJK_fontid_int } > { 0 }
      {
        \clist_map_inline:Nn \g_LuaCJK_block_names_clist
          {
            \tl_set:Ne \l_LuaCJK_block_key_tl { \l_LuaCJK_family_tl | ##1 }
            \int_gzero:N \g_LuaCJK_block_fontid_int
            \prop_get:NVNT \g_LuaCJK_family_block_prop
              \l_LuaCJK_block_key_tl \l_LuaCJK_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \fontfamily \l_LuaCJK_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_LuaCJK_block_fontid_int
                    { \tex_fontid:D \tex_font:D }
                \group_end:
              }
            \lua_now:e
              {
                LuaCJK.set_block_font
                  ( \int_use:N \g_LuaCJK_fontid_int ,
                    "\lua_escape:e {##1}" ,
                    \int_use:N \g_LuaCJK_block_fontid_int )
              }
          }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macrocode}
\AddToHook { selectfont } { \LuaCJK_update_font: }
%    \end{macrocode}
%
% \subsection{Font selection commands}
%
% \begin{variable}
%   {\CJKrmdefault, \CJKsfdefault, \CJKttdefault, \CJKfamilydefault}
%   The CJK families used by the standard font commands.  The family
%   hooks below re-select the CJK family whenever \tn{rmfamily} and its
%   siblings run.
%    \begin{macrocode}
\tl_new:N \CJKrmdefault
\tl_new:N \CJKsfdefault
\tl_new:N \CJKttdefault
\tl_new:N \CJKfamilydefault
\tl_set:Nn \CJKrmdefault { zhsong }
\tl_set:Nn \CJKsfdefault { zhhei }
\tl_set:Nn \CJKttdefault { zhfs }
\tl_set:Nn \CJKfamilydefault { zhsong }
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\defaultCJKfontfeatures}
%   Set the features prepended to every CJK family, replacing the initial
%   \texttt{Script = CJK}.  Families registered earlier keep the value they
%   were given; call \cs{setCJKmainfont} again to apply a new default.
%    \begin{macrocode}
\NewDocumentCommand \defaultCJKfontfeatures { m }
  { \tl_set:Nn \l_LuaCJK_default_feature_tl {#1} }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\addCJKfontfeatures}
%   Add features to the current family for the rest of the group.  The star
%   form is accepted for compatibility; LuaCJK has no concept of blocks, so
%   both forms act on the same font.
%    \begin{macrocode}
\NewDocumentCommand \addCJKfontfeatures { s o m }
  {
    \exp_args:NV \LuaCJK_add_family_features:n
      \l_LuaCJK_family_tl {#3}
  }
%    \end{macrocode}
%   \begin{macro}[internal]{\LuaCJK_add_family_features:n}
%     Append features to the stored ones of a family and register it again.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_add_family_features:n #1#2
  {
    \prop_get:NnNTF \g_LuaCJK_font_feature_prop {#1} \l_LuaCJK_feature_tl
      {
        \tl_set:Ne \l_LuaCJK_feature_tl
          {
            \exp_not:V \l_LuaCJK_feature_tl
            \tl_if_blank:nF {#2} { , \exp_not:n {#2} }
          }
        \prop_get:NnNF \g_LuaCJK_font_name_prop {#1} \l_LuaCJK_registered_name_tl
          { \tl_clear:N \l_LuaCJK_registered_name_tl }
        \group_begin:
          \fontspec_gset_family:NVV \l_LuaCJK_fontspec_tl
            \l_LuaCJK_feature_tl \l_LuaCJK_registered_name_tl
        \group_end:
        \prop_put:NnV \g_LuaCJK_family_prop {#1} \l_LuaCJK_fontspec_tl
        \prop_put:NnV \g_LuaCJK_font_feature_prop {#1}
          \l_LuaCJK_feature_tl
        \selectfont
      }
      { \msg_warning:nnn { LuaCJK } { family-unknown } {#1} }
  }
%    \end{macrocode}
%   \end{macro}
% \end{macro}
%
% \begin{macro}
%   {\setCJKmainfont, \setCJKsansfont, \setCJKmonofont, \setCJKfamilyfont}
%   The public font commands, all built on
%   \cs{LuaCJK_set_family_with_options:nnnn}.
%    \begin{macrocode}
\NewDocumentCommand \setCJKmainfont { o m o }
  {
    \exp_args:NV \LuaCJK_set_family_with_options:nnnn
      \CJKrmdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKsansfont { o m o }
  {
    \exp_args:NV \LuaCJK_set_family_with_options:nnnn
      \CJKsfdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKmonofont { o m o }
  {
    \exp_args:NV \LuaCJK_set_family_with_options:nnnn
      \CJKttdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKfamilyfont { m o m o }
  { \LuaCJK_set_family_with_options:nnnn {#1} {#2} {#3} {#4} }
\NewDocumentCommand \setCJKfallbackfamilyfont { m o m o }
  {
    \tl_set:Ne \l_LuaCJK_fallback_key_tl {#1}
    \tl_if_novalue:nTF {#2}
      {
        \tl_if_novalue:nTF {#4}
          { \LuaCJK_add_fallback:nn { } {#3} }
          { \LuaCJK_add_fallback:nn {#4} {#3} }
      }
      { \LuaCJK_add_fallback:nn {#2} {#3} }
  }
%    \end{macrocode}
%   \begin{macro}[internal]{\LuaCJK_set_family_with_options:nnnn}
%     Accept the options before or after the font name.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_set_family_with_options:nnnn #1#2#3#4
  {
    \tl_if_novalue:nTF {#2}
      {
        \tl_if_novalue:nTF {#4}
          { \LuaCJK_set_family_with_options_aux:nnn {#1} { } {#3} }
          { \LuaCJK_set_family_with_options_aux:nnn {#1} {#4} {#3} }
      }
      { \LuaCJK_set_family_with_options_aux:nnn {#1} {#2} {#3} }
  }
\cs_generate_variant:Nn \LuaCJK_set_family:nnn { nVn }
\cs_new_protected:Npn \LuaCJK_set_family_with_options_aux:nnn #1#2#3
  {
    \LuaCJK_extract_blocks:nn {#1} {#2}
    \LuaCJK_set_family:nVn {#1} \l_LuaCJK_features_tl {#3}
  }
%    \end{macrocode}
%   \end{macro}
%   \begin{macro}[internal]{\LuaCJK_add_fallback:nn}
%     Register one fallback font for a CJK family, keeping the order in
%     which the fonts were declared.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_add_fallback:nn #1#2
  {
    \group_begin:
      \fontspec_gset_family:Nnn \l_LuaCJK_fallback_family_tl {#1} {#2}
      \prop_get:NVNF \g_LuaCJK_fallback_prop
        \l_LuaCJK_fallback_key_tl \l_LuaCJK_tmpa_tl
        { \tl_clear:N \l_LuaCJK_tmpa_tl }
      \clist_put_right:NV \l_LuaCJK_tmpa_tl \l_LuaCJK_fallback_family_tl
      \prop_gput:NVV \g_LuaCJK_fallback_prop
        \l_LuaCJK_fallback_key_tl \l_LuaCJK_tmpa_tl
    \group_end:
    \exp_args:NV \LuaCJK_recall_fallback:n \l_LuaCJK_fallback_key_tl
  }
%    \end{macrocode}
%   \end{macro}
% \end{macro}
%
% \begin{macro}{\CJKfamily}
%   Switch to a registered family and gobble the following spaces.
%    \begin{macrocode}
\NewDocumentCommand \CJKfamily { m }
  { \LuaCJK_switch_family:n {#1} \tex_ignorespaces:D }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\newCJKfontfamily}
%   Define a control sequence that switches to a new family, and register
%   the family under the same name.
%    \begin{macrocode}
\NewDocumentCommand \newCJKfontfamily { o m o m }
  {
    \tl_set:Ne \l_LuaCJK_tmpa_tl
      {
        \IfNoValueTF {#1}
          { \cs_to_str:N #2 }
          {#1}
      }
    \cs_set_protected:Npx #2
      { \exp_not:N \LuaCJK_switch_family:n { \exp_not:V \l_LuaCJK_tmpa_tl } }
    \exp_args:NV \LuaCJK_set_family_with_options:nnnn
      \l_LuaCJK_tmpa_tl {#3} {#4} { \NoValue }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\setCJKmathfont}
%   Register a family used for CJK characters in math mode and refresh
%   the attributes at once.
%    \begin{macrocode}
\NewDocumentCommand \setCJKmathfont { o m o }
  {
    \LuaCJK_set_family_with_options:nnnn { LuaCJK/math } {#1} {#2} {#3}
    \tl_set:Nn \l_LuaCJK_math_family_tl { LuaCJK/math }
    \LuaCJK_update_font:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\CJKfontspec}
%   Register a one-off family and switch to it immediately.
%   \begin{variable}[internal]{\g_LuaCJK_fontspec_int}
%     Gives every call its own family name.
%    \begin{macrocode}
\int_new:N \g_LuaCJK_fontspec_int
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\NewDocumentCommand \CJKfontspec { o m }
  {
    \int_gincr:N \g_LuaCJK_fontspec_int
    \tl_set:Ne \l_LuaCJK_tmpa_tl
      { LuaCJK/fontspec/ \int_use:N \g_LuaCJK_fontspec_int }
    \exp_args:NV \LuaCJK_set_family_with_options:nnnn
      \l_LuaCJK_tmpa_tl {#1} {#2} { \NoValue }
    \exp_args:NV \LuaCJK_switch_family:n \l_LuaCJK_tmpa_tl
    \tex_ignorespaces:D
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\songti, \heiti, \fangsong, \kaishu, \lishu, \youyuan}
%   Shortcuts for the usual families, plus the family hooks of the standard
%   font commands.
%    \begin{macrocode}
\cs_new_protected:Npn \songti { \CJKfamily { zhsong } }
\cs_new_protected:Npn \heiti { \CJKfamily { zhhei  } }
\cs_new_protected:Npn \fangsong { \CJKfamily { zhfs   } }
\cs_new_protected:Npn \kaishu { \CJKfamily { zhkai  } }
\cs_new_protected:Npn \lishu { \CJKfamily { zhli   } }
\cs_new_protected:Npn \youyuan { \CJKfamily { zhyou  } }
\AddToHook { cmd/rmfamily/after }
  { \exp_args:NV \LuaCJK_switch_family:n \CJKrmdefault }
\AddToHook { cmd/sffamily/after }
  { \exp_args:NV \LuaCJK_switch_family:n \CJKsfdefault }
\AddToHook { cmd/ttfamily/after }
  { \exp_args:NV \LuaCJK_switch_family:n \CJKttdefault }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Characters without CJK/Latin glue}
%
% \begin{macro}{\normalspacedchars}
%   The characters in the list get no glue on either side, which is what one
%   wants for slashes, backslashes, and hyphens inside Latin text.  The list
%   is kept on the Lua side as a set of code points, so the setting is
%   global: a group does not restore the previous list.
%   \begin{variable}[internal]{\g_LuaCJK_normal_spaced_chars_tl}
%     The list, initially \texttt{/}, \texttt{\c_backslash_str}, and
%     \texttt{-}.
%    \begin{macrocode}
\tl_new:N \g_LuaCJK_normal_spaced_chars_tl
\tl_gset:Nn \g_LuaCJK_normal_spaced_chars_tl
  { / , \c_backslash_str , - }
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_set_normal_spaced_chars:
  {
    \lua_now:e
      {
        LuaCJK.set_normal_spaced_chars
          ( "\lua_escape:e { \g_LuaCJK_normal_spaced_chars_tl } " )
      }
  }
\NewDocumentCommand \normalspacedchars { m }
  {
    \tl_gset:Nn \g_LuaCJK_normal_spaced_chars_tl {#1}
    \LuaCJK_set_normal_spaced_chars:
  }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Local configuration}
%
% \begin{macro}{\LuaCJK_load_local_config:}
%   Load the file chosen by the \texttt{LocalConfig} option.  The key is
%   read while the package is being loaded, but the file is only input at
%   the end, so that it can use everything LuaCJK defines.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_load_local_config:
  {
    \tl_if_empty:NF \l_LuaCJK_local_config_tl
      {
        \exp_args:NV \LuaCJK_load_config_file:n \l_LuaCJK_local_config_tl
      }
  }
\cs_new_protected:Npn \LuaCJK_load_config_file:n #1
  {
    \file_if_exist:nTF {#1}
      { \file_input:n {#1} }
      { \msg_warning:nnn { LuaCJK } { config-missing } {#1} }
  }
\msg_new:nnn { LuaCJK } { config-missing }
  { The~configuration~file~`#1'~was~not~found. }
%    \end{macrocode}
% \end{macro}
%

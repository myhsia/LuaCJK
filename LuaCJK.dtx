% \begin{macro}[int]{\@@_load_local_config:}
% \changes{v0.0.1}{2026/11/11}{Provide the \keys{LocalConfig} option, which
%   reads \file{luacjk.cfg} or \file{luacjk-<name>.cfg} at the end of the
%   package.}
% Load the file chosen by the \keys{LocalConfig} option.
% The key is read while the package is being loaded, but the file is only input
% at the end, so that it can use everything \pkg{LuaCJK} defines.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_load_local_config:
  {
    \tl_if_empty:NF \l_@@_local_config_tl
      {
        \exp_args:NV \@@_load_config_file:n \l_@@_local_config_tl
      }
  }
\cs_new_protected:Npn \@@_load_config_file:n #1
  {
    \file_if_exist:nTF {#1}
      { \file_input:n {#1} }
      { \msg_warning:nnn { LuaCJK } { config-missing } {#1} }
  }
\msg_new:nnn { LuaCJK } { config-missing }
  { The ~ configuration ~ file ~ `#1' ~ was ~ not ~ found. }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_load_fandol:}
% \changes{v0.0.1}{2026/11/11}{Provide the \keys{LoadFandol} option, which
%   supplies Fandol fonts when the document declares none.}
% \changes{v0.0.3}{2026/11/20}{\keys{LoadFandol} is on by default, so a
%   document that declares no CJK font is set in the four Fandol faces without
%   asking for them.}
% \changes{v0.0.3}{2026/11/20}{\keys{LoadFandol} gives the roman family
%   \texttt{FandolKai-Regular.otf} as its italic face, so \cs{emph} and
%   \cs{itshape} set the text in Kai instead of leaving it upright.}
% When the \keys{LoadFandol} option is on and the document
% did not declare any CJK font, fall back to the four Fandol faces.
% This runs at |\begin{document}| so that a family declared anywhere
% in the preamble still wins, and a document that declares some families but
% not the default one is reported by \cs{@@_ensure_family_default:} instead.
% The roman family is declared twice, once as the main family and once under
% the name \texttt{zhsong}, and both declarations carry the same options,
% because a family name holds one set of features and the later declaration
% would otherwise drop what the earlier one gave.
% Fandol Song has no italic face, and emphasis in Chinese is set in Kai, so
% the italic shape of the roman family is Fandol Kai; the other three families
% have no italic face of their own.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_load_fandol:
  {
    \setCJKmainfont{FandolSong-Regular.otf}
      [ BoldFont = FandolSong-Bold.otf, ItalicFont = FandolKai-Regular.otf ]
    \setCJKsansfont{FandolHei-Regular.otf}
      [ BoldFont = FandolHei-Bold.otf ]
    \setCJKmonofont{FandolFang-Regular.otf}
    \setCJKfamilyfont{zhsong}{FandolSong-Regular.otf}
      [ BoldFont = FandolSong-Bold.otf, ItalicFont = FandolKai-Regular.otf ]
    \setCJKfamilyfont{zhhei}{FandolHei-Regular.otf}
      [ BoldFont = FandolHei-Bold.otf ]
    \setCJKfamilyfont{zhkai}{FandolKai-Regular.otf}
    \setCJKfamilyfont{zhfs}{FandolFang-Regular.otf}
  }
%    \end{macrocode}
% \end{macro}
%
% \subsection{The Lua module}
%
% The Lua module reads the attribute numbers and installs its callbacks.
% The current font is resolved once the document starts.
%    \begin{macrocode}
\lua_load_module:n { LuaCJK }
\lua_now:e
  {
    LuaCJK.attr_font        =  \int_use:N   \c_@@_font_attr_int ;
    LuaCJK.attr_cjk_space   =  \int_use:N   \c_@@_cjk_space_attr_int ;
    LuaCJK.attr_xecglue     =  \int_use:N   \c_@@_xecglue_attr_int ;
    LuaCJK.attr_inserted    =  \int_use:N   \c_@@_inserted_attr_int ;
    LuaCJK.attr_math_font   =  \int_use:N   \c_@@_math_font_attr_int ;
    LuaCJK.attr_punct_font  =  \int_use:N   \c_@@_punct_font_attr_int ;
    LuaCJK.attr_nobreak     =  \int_use:N   \c_@@_nobreak_attr_int ;
    LuaCJK.attr_settings    =  \int_use:N   \c_@@_settings_attr_int ;
    LuaCJK.attr_disabled    =  \int_use:N   \c_@@_disabled_attr_int ;
    LuaCJK.attr_attached    =  \int_use:N   \c_@@_attached_attr_int ;
    LuaCJK.attr_explicit_space
                            =  \int_use:N   \c_@@_explicit_space_attr_int ;
    LuaCJK.name_ccglue      = "\cs_to_str:N \l_@@_ccglue_skip" ;
    LuaCJK.name_ecglue      = "\cs_to_str:N \l_@@_ecglue_skip" ;
  }
\bool_gset_true:N \g_@@_lua_loaded_bool
%    \end{macrocode}
%
% \begin{macro}[int]{\@@_detect_shaping:}
% Ask the module whether \pkg{luaotfload} offers the callback that runs before
% shaping, and record the answer for the two places that depend on it: the
% character setup below and the pass that \file{LuaCJK-core.lua} installs.
% Without the callback the package keeps its previous behavior in full,
% including the input removal of every zero-width character, so that a system
% never applies half of the change.
%    \begin{macrocode}
\bool_new:N \g_@@_shaping_bool
\cs_new_protected:Npn \@@_detect_shaping:
  {
    \str_if_eq:eeT
      { \lua_now:e { tex.sprint(tostring(LuaCJK.shaping)) } }
      { true }
      { \bool_gset_true:N \g_@@_shaping_bool }
    \bool_if:NF \g_@@_shaping_bool
      { \msg_warning:nn { LuaCJK } { no-pre-shaping } }
  }
\msg_new:nnn { LuaCJK } { no-pre-shaping }
  {
    This~ luaotfload~ has~ no~ pre_shaping_filter,~ so~ the~ CJK~ font~ is~
    applied~ after~ the~ text~ is~ shaped:~ a~ combining~ mark~ will~ not~
    attach~ to~ its~ base,~ and~ the~ joiners~ and~ variation~ selectors~
    are~ removed~ at~ the~ input.
  }
%    \end{macrocode}
% \end{macro}
%
% Read the package options now that every helper a key code calls exists and
% the Lua module is loaded, which \keys{CJLineBreak} needs.
% The hook at |\begin{document}| then settles the family the document starts
% in: \cs{CJKfamilydefault} follows \cs{CJKrmdefault} when the preamble did
% not choose it, \keys{LoadFandol} supplies the four Fandol faces when the
% preamble declared no family at all, a chosen default that no family carries
% is replaced by one that does, and the family that survives is selected, so a
% preamble that redefines \cs{CJKfamilydefault} sets the main text in that
% family from the first line instead of waiting for a \tn{normalfont}.
%    \begin{macrocode}
\ProcessKeyOptions [ LuaCJK / options ]
\@@_settings_push:
\@@_set_normal_spaced_chars:
\@@_detect_shaping:
\@@_setup_format_chars:
\hook_gput_code:nnn { begindocument } { LuaCJK }
  {
    \tl_if_eq:NNT \CJKfamilydefault \l_@@_family_default_init_tl
      { \tl_gset:Nn \CJKfamilydefault { \CJKrmdefault } }
    \bool_if:NT \g_@@_load_fandol_bool
      {
        \prop_if_empty:NT \g_@@_family_prop
          { \@@_load_fandol: }
      }
    \@@_ensure_family_default:
    \@@_reset_family:
    \@@_update_font:
    \g_@@_font_attr = \g_@@_fontid_int
  }
\@@_load_local_config:
\hook_gput_code:nnn { package / listings / after } { LuaCJK }
  { \RequirePackage { LuaCJK-listings } }
\cs_if_exist:cT { ver@listings.sty }
  { \RequirePackage { LuaCJK-listings } }
%    \end{macrocode}
%
%    \begin{macrocode}
%</package>
%    \end{macrocode}
%
% The package ships two Lua modules. \file{LuaCJK.lua} only loads the core
% module; all node processing lives in \file{LuaCJK-core.lua}.
% \begin{variable}[int]{LuaCJK}
% The table shared by the two modules.
% The core module adds its functions and constants to it.
%    \begin{macrocode}
%<*lua>
LuaCJK = LuaCJK or {}

require("LuaCJK-core")
%</lua>
%    \end{macrocode}
% \end{variable}
%
% The core module starts by creating the shared table and caching the node
% identifiers.
% The callbacks run on every list, so these lookups happen once.
%    \begin{macrocode}
%<*lua-core>
LuaCJK = LuaCJK or {}

%    \end{macrocode}
%
% \begin{variable}[int]
%   {
%     M,          GLYPH,         GLUE,
%     HLIST,      VLIST,         KERN,
%     LIGATURE,   PENALTY,       MATH,
%     DISC,       WHATSIT,       MARK,
%     INS,        ADJUST,        LOCAL_PAR,
%     SPACESKIP,  ITALICCORR,    new_node,
%     free_node,  has_attribute, set_attribute
%   }
% Short names for the module table, the node types,
% and the node functions.
%    \begin{macrocode}
local M               = LuaCJK
local GLYPH           = node.id("glyph")
local GLUE            = node.id("glue")
local HLIST           = node.id("hlist")
local VLIST           = node.id("vlist")
local KERN            = node.id("kern")
local LIGATURE        = node.id("ligature")
local PENALTY         = node.id("penalty")
local MATH            = node.id("math")
local DISC            = node.id("disc")
local WHATSIT         = node.id("whatsit")
local MARK            = node.id("mark")
local INS             = node.id("ins")
local ADJUST          = node.id("adjust")
local LOCAL_PAR       = node.id("local_par")
local SPACESKIP       = node.subtype("spaceskip") or 13
local ITALICCORR      = node.subtype("italiccorrection") or 3
local new_node        = node.new
local free_node       = node.free
local has_attribute   = node.has_attribute
local set_attribute   = node.set_attribute
local unset_attribute = node.unset_attribute

%    \end{macrocode}
% \end{variable}
%
% \begin{variable}[int]{LuaCJK.shaping}
% Whether \pkg{luaotfload} offers the callback that runs before a list is
% shaped. The \TeX\ side reads this to decide how the zero-width characters
% are handled at the input, and the module uses it to choose between the
% substitution before shaping and the copy after it.
%    \begin{macrocode}
M.shaping = luatexbase.callbacktypes ~= nil
  and luatexbase.callbacktypes.pre_shaping_filter ~= nil
%    \end{macrocode}
% \end{variable}
%
% \begin{variable}[int]
%   {
%     LuaCJK.attr_font,     LuaCJK.attr_cjk_space, LuaCJK.attr_xecglue,
%     LuaCJK.attr_inserted, LuaCJK.attr_math_font,
%     LuaCJK.attr_explicit_space
%   }
% The attribute numbers.
% The \TeX\ side fills them in after loading the module.
%    \begin{macrocode}
for _, field in ipairs {
  "font",      "cjk_space",  "xecglue", "inserted",
  "math_font", "punct_font", "nobreak", "settings",
  "attached",  "explicit_space",
} do
  local key = "attr_" .. field
  M[key] = M[key] or nil
end

%    \end{macrocode}
% \end{variable}
%
% \subsection{Settings and data}
%
% Most options describe how text is set, not how the document is configured,
% so they have to travel with the characters.
% A snapshot of the current options is registered once and its number is
% stored in an attribute on the glyphs created afterwards; a group that ends
% before the paragraph does therefore still decides how its own text is set.
%
% \begin{variable}[int]
%   {LuaCJK.settings, LuaCJK.settings_by_signature, LuaCJK.attr_settings}
% The snapshots, an index from a signature to a snapshot so that
% repeated font selections reuse one entry, and the attribute number.
%    \begin{macrocode}
local DEFAULT_SETTINGS = {
  ccglue        = { width = 0, stretch = 0, shrink = 0 },
  ecglue        = { width = 0, stretch = 0, shrink = 0 },
  punct_style   = "quanjiao",
  kinsoku       = true,
  cj_strict     = false,
  latin_punct   = false,
  cjk_math      = false,
  punct_width   = false,
  bound_width   = false,
  check_single  = false,
  widow_penalty = 10000,
  allow_break   = false,
  auto_fallback = false,
  blocks_off    = {},
}

M.settings              = { DEFAULT_SETTINGS }
M.settings_by_signature = {}

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{LuaCJK.new_settings}
% Read the current glue registers, build a snapshot, and select it.
% The glue has to be read here rather than passed in, because that is the only
% place where the registers still hold the values of the moment.
% The stretch and shrink orders travel with the value, so a register such as
% |0pt plus 1filll| can still fill a line after the node has been built.
%    \begin{macrocode}
local function glue_spec (name)
  local skip = name and tex.skip[name]
  if skip then
    return { width         = skip.width,
             stretch       = skip.stretch,
             shrink        = skip.shrink,
             stretch_order = skip.stretch_order,
             shrink_order  = skip.shrink_order }
  end
  return { width = 0, stretch = 0, shrink = 0 }
end

function M.new_settings (style, kinsoku, cj_strict, latin_punct, cjk_math,
                         punct_width, bound_width, check_single, widow_penalty,
                         allow_break, auto_fallback, off_list)
  local off = {}
  for name in string.gmatch(off_list or "", "[^,]+") do
    local trimmed = string.match(name, "^%s*(.-)%s*$")
    if trimmed ~= "" then
      off[trimmed] = true
    end
  end
  local entry = {
    ccglue        = glue_spec(M.name_ccglue),
    ecglue        = glue_spec(M.name_ecglue),
    punct_style   = style,
    kinsoku       = kinsoku,
    cj_strict     = cj_strict,
    latin_punct   = latin_punct,
    cjk_math      = cjk_math,
    punct_width   = punct_width,
    bound_width   = bound_width,
    check_single  = check_single,
    widow_penalty = widow_penalty,
    allow_break   = allow_break,
    auto_fallback = auto_fallback,
    blocks_off    = off,
  }
  local signature = table.concat({
    entry.ccglue.width, entry.ccglue.stretch, entry.ccglue.shrink,
    entry.ccglue.stretch_order, entry.ccglue.shrink_order,
    entry.ecglue.width, entry.ecglue.stretch, entry.ecglue.shrink,
    entry.ecglue.stretch_order, entry.ecglue.shrink_order,
    style, tostring(kinsoku), tostring(cj_strict), tostring(latin_punct),
    tostring(cjk_math),
    tostring(punct_width), tostring(bound_width),
    tostring(check_single), widow_penalty,
    tostring(allow_break), tostring(auto_fallback), off_list,
  }, "|")
  local id = M.settings_by_signature[signature]
  if not id then
    id                                 = #M.settings + 1
    M.settings[id]                     = entry
    M.settings_by_signature[signature] = id
  end
  if M.attr_settings then
    tex.setattribute(M.attr_settings, id)
  end
  return id
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{settings_of}
% The snapshot of a node, or the defaults when it carries none.
%    \begin{macrocode}
local function settings_of (n)
  if M.attr_settings and n then
    local id = has_attribute(n, M.attr_settings)
    if id and id > 0 and M.settings[id] then
      return M.settings[id]
    end
  end
  return M.settings[1]
end

M.settings_of = settings_of

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{LuaCJK.cj, LuaCJK.cj_count, LuaCJK.cj_loaded}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{CJLineBreak}, which forbids a
%   line break before the characters whose Unicode \texttt{Line\_Break}
%   property is \texttt{CJ}.}
% The characters whose \texttt{Line\_Break} property is \texttt{CJ}
% (the Japanese small kana and the like), how many there are, and whether
% the file has been read.
% The set is read from \file{LineBreak.txt} of the \pkg{unicode-data} bundle
% only when \keys{CJLineBreak} asks for \texttt{strict}, so a document that
% keeps the default never pays for the file.
%    \begin{macrocode}
M.cj        = {}
M.cj_count  = 0
M.cj_loaded = false

local function read_cj (data)
  local set, count = {}, 0
  for first, last, class in data:gmatch("(%x+)%.%.(%x+)%s*;%s*(%a+)") do
    if class == "CJ" then
      for code = tonumber(first, 16), tonumber(last, 16) do
        set[code] = true
      end
      count = count + 1
    end
  end
  for code, class in data:gmatch("(%x+)%s*;%s*(%a+)") do
    if class == "CJ" then
      set[tonumber(code, 16)] = true
      count = count + 1
    end
  end
  return set, count
end

function M.load_cj ()
  if M.cj_loaded then
    return M.cj_count
  end
  M.cj_loaded = true
  local path = kpse and kpse.find_file and kpse.find_file("LineBreak.txt")
  local file = path and io.open(path)
  if not file then
    texio.write_nl("term and log",
      "Package LuaCJK Warning: LineBreak.txt not found; "
      .. "CJLineBreak = strict has no effect.")
    return 0
  end
  local data = file:read("*a")
  file:close()
  M.cj, M.cj_count = read_cj(data)
  return M.cj_count
end

%    \end{macrocode}
% \end{variable}
%
% The middle dot, the quotation marks, the horizontal bar, the two dot leader,
% the ellipses, and the hyphenation point are shared with Latin scripts.
% With \keys{LatinPunct} on, the marks that key lists use the Latin font and
% are not compressed; the em dash is not in the table, because it stays CJK.
%
% \begin{macro}[int]{LuaCJK.is_cjk}
% \changes{v0.0.4}{2026/11/20}{A code point below U+0100 in a font that is not
%   Unicode-encoded is a position in that font's encoding, not a character, so
%   a symbol font's slot is no longer read as a CJK character: \pkg{pifont}'s
%   slot 0xB7, the circled 2, keeps its own font and prints.}
% Test whether a character is treated as CJK.
% The table is the set of code points this package sets with the CJK class.
% It is a policy rather than a Unicode property: the punctuation that CJK
% text shares with Latin (the middle dot U+00B7, the quotation marks, the
% horizontal bar U+2015, the two dot leader U+2025, the ellipses U+2026 and
% U+22EF, and the hyphenation point U+2027) is listed here even though its
% script is Common, and the combining Bopomofo tone marks U+02EA and U+02EB
% are left out on purpose, because they attach to the preceding letter and a
% glue between the two would break the attachment.
% The third argument is the font of the glyph, and it decides the code points
% below U+0100: a font that \pkg{luaotfload} did not load as Unicode holds an
% encoding rather than characters, so the number that reaches the node is a
% position in that encoding.  Slot 0xB7 of \pkg{pifont}'s dingbat font would
% otherwise be read as the shared middle dot, and a CJK font that lacks it
% would drop the character; the accent |\r{u}|, slot 0xB7 of a T1 text font,
% would be read the same way.  A code point above U+00FF cannot be a slot of
% an 8-bit font, so a CJK character typed in a legacy encoding still takes the
% CJK font, and a Unicode font is read as characters throughout.
% The script \file{scripts/check-charclass.lua} compares the table with
% \file{Scripts.txt} and reports a code point whose script is Han, Hiragana,
% Katakana, Bopomofo, or Hangul but which the table does not list.
%    \begin{macrocode}
M.class_override = {}
M.punct_override = {}

local CJK_RANGES = {
  { 0x00B7,  0x00B7 },  -- middle dot, shared with Latin
  { 0x1100,  0x11FF },  -- Hangul Jamo
  { 0x2014,  0x2014 },  -- em dash, shared with Latin
  { 0x2015,  0x2015 },  -- horizontal bar, shared with Latin
  { 0x2018,  0x2019 },  -- single quotation marks
  { 0x201C,  0x201D },  -- double quotation marks
  { 0x2025,  0x2025 },  -- two dot leader, shared with Latin
  { 0x2026,  0x2026 },  -- horizontal ellipsis, shared with Latin
  { 0x2027,  0x2027 },  -- hyphenation point, shared with Latin
  { 0x22EF,  0x22EF },  -- midline ellipsis, shared with Latin
  { 0x2E80,  0x9FFF },  -- radicals, punctuation, kana, ideographs
  { 0xA960,  0xA97C },  -- Hangul Jamo Extended-A
  { 0xAC00,  0xD7C6 },  -- Hangul syllables and Jamo Extended-B
  { 0xD7CB,  0xD7FB },  -- Hangul Jamo Extended-B
  { 0xF900,  0xFAFF },  -- compatibility ideographs
  { 0xFE30,  0xFE4F },  -- compatibility forms
  { 0xFF00,  0xFFEF },  -- fullwidth forms
  { 0x16FE2, 0x16FE3 }, -- Old Chinese hook and iteration marks
  { 0x16FF0, 0x16FF6 }, -- Han, Vietnamese alternate reading marks
  { 0x1AFF0, 0x1AFF3 }, -- Kana Extended-B
  { 0x1AFF5, 0x1AFFB },
  { 0x1AFFD, 0x1AFFE },
  { 0x1B000, 0x1B128 }, -- Kana Supplement and Kana Extended-A
  { 0x1B132, 0x1B132 },
  { 0x1B150, 0x1B152 },
  { 0x1B155, 0x1B155 },
  { 0x1B164, 0x1B168 },
  { 0x1F200, 0x1F200 }, -- square hiragana hoka
  { 0x20000, 0x3FFFF }, -- ideographic planes
}

local function in_ranges (c, ranges)
  for i = 1, #ranges do
    if c >= ranges[i][1] and c <= ranges[i][2] then
      return true
    end
  end
  return false
end

local LATIN_PUNCT = {
  [0x00B7] = true, [0x2018] = true, [0x2019] = true,
  [0x201C] = true, [0x201D] = true, [0x2025] = true,
  [0x2026] = true, [0x2027] = true,
}

local SLOT_FONT = { }

local function is_slot (c, f)
  if c > 0xFF or not f then
    return false
  end
  local known = SLOT_FONT[f]
  if known == nil then
    local data = font.getfont(f)
    known = not (data and data.encodingbytes == 2)
    SLOT_FONT[f] = known
  end
  return known
end

local function is_cjk (c, s, f)
  local override = M.class_override[c]
  if override ~= nil then
    return override
  end
  if s and s.latin_punct and LATIN_PUNCT[c] then
    return false
  end
  return in_ranges(c, CJK_RANGES) and not is_slot(c, f)
end

M.is_cjk = is_cjk

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.is_attached}
% Test whether a character attaches to the character in front of it instead of
% standing on its own: the two joiners and the variation selectors.
% A font shapes with these, and their own advance is nothing, so they follow
% the font of the character they attach to and take no part in the classes.
% The combining marks are not in this set: a CJK one is in the CJK ranges and
% is shaped with its base, which is where its attachment comes from.
%    \begin{macrocode}
local ATTACHED = {
  [0x200C] = true, [0x200D] = true,
}

local function is_attached (c)
  return ATTACHED[c]
    or (c >= 0xFE00  and c <= 0xFE0F)
    or (c >= 0xE0100 and c <= 0xE01EF)
end

M.is_attached = is_attached

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{PUNCT_CLASS}
% \changes{v0.0.4}{2026/11/20}{The punctuation table covers the marks
%   \pkg{xeCJK} classes as opening or closing, so the percent sign U+FF05 no
%   longer starts a line and the currency symbols no longer end one; the
%   halfwidth and compatibility forms and the three hyphen-like marks follow
%   the same class.}
% \changes{v0.0.4}{2026/11/20}{The ASCII brackets are punctuation marks of
%   their own: a half-width opening bracket no longer ends a line and a
%   half-width closing bracket no longer starts one, the pair hugs the text
%   between it, and a compression style leaves the bracket's own advance
%   alone.}
% The punctuation \pkg{LuaCJK} knows about, grouped as opening, closing,
% middle, dash, and ellipsis.
% The group decides compression, line-breaking prohibitions, and hanging.
% The groups are the lists of \pkg{xeCJK}: its \texttt{OP} and \texttt{PR} are
% opening, its \texttt{CL}, \texttt{PO}, \texttt{EX}, and \texttt{IS} are
% closing, its hyphens are dashes, and its \texttt{NS} is read as closing or
% middle.
% A mark is listed here only when the CJK table holds it as well, so the
% small-form and vertical variants outside that table keep no class.
% The ASCII brackets are the exception, because they are set in the Latin font
% and cannot be compressed or hung: \texttt{half-open} and \texttt{half-close}
% are their own groups, which only the prohibitions and the spacing read.
%    \begin{macrocode}
local PUNCT_CLASS = {
  [0x0028] = "half-open",  [0x005B] = "half-open",
  [0x007B] = "half-open",
  [0x0029] = "half-close", [0x005D] = "half-close",
  [0x007D] = "half-close",
  [0x2018] = "open",     [0x201C] = "open",
  [0x3008] = "open",     [0x300A] = "open",
  [0x300C] = "open",     [0x300E] = "open",
  [0x3010] = "open",     [0x3014] = "open",
  [0x3016] = "open",     [0x3018] = "open",
  [0x301A] = "open",     [0x301D] = "open",
  [0xFE35] = "open",     [0xFE37] = "open",
  [0xFE39] = "open",     [0xFE3B] = "open",
  [0xFE3D] = "open",     [0xFE3F] = "open",
  [0xFE41] = "open",     [0xFE43] = "open",
  [0xFE47] = "open",     [0xFF04] = "open",
  [0xFF08] = "open",     [0xFF3B] = "open",
  [0xFF5B] = "open",     [0xFF5F] = "open",
  [0xFF62] = "open",     [0xFFE1] = "open",
  [0xFFE5] = "open",     [0xFFE6] = "open",
  [0x2019] = "close",    [0x201D] = "close",
  [0x3001] = "close",    [0x3002] = "close",
  [0x3009] = "close",    [0x300B] = "close",
  [0x300D] = "close",    [0x300F] = "close",
  [0x3011] = "close",    [0x3015] = "close",
  [0x3017] = "close",    [0x3019] = "close",
  [0x301B] = "close",    [0x301E] = "close",
  [0x301F] = "close",    [0xFE36] = "close",
  [0xFE38] = "close",    [0xFE3A] = "close",
  [0xFE3C] = "close",    [0xFE3E] = "close",
  [0xFE40] = "close",    [0xFE42] = "close",
  [0xFE44] = "close",    [0xFE48] = "close",
  [0xFF01] = "close",    [0xFF05] = "close",
  [0xFF09] = "close",    [0xFF0C] = "close",
  [0xFF0E] = "close",    [0xFF1A] = "close",
  [0xFF1B] = "close",    [0xFF1F] = "close",
  [0xFF3D] = "close",    [0xFF5D] = "close",
  [0xFF60] = "close",    [0xFF61] = "close",
  [0xFF63] = "close",    [0xFF64] = "close",
  [0xFFE0] = "close",
  [0x00B7] = "middle",   [0x2027] = "middle",
  [0x30FB] = "middle",   [0xFF65] = "middle",
  [0x2013] = "dash",     [0x2014] = "dash",
  [0x2015] = "dash",     [0x301C] = "dash",
  [0x30A0] = "dash",     [0xFF0D] = "dash",
  [0xFF5E] = "dash",
  [0x2025] = "ellipsis", [0x2026] = "ellipsis", [0x22EF] = "ellipsis",
}

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{half_mark}
% Whether a group belongs to the half-width brackets.
%    \begin{macrocode}
local function half_mark (mark)
  return mark == "half-open" or mark == "half-close"
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{punct_class}
% Look up the group of a character.
% The font is passed on to \cs{LuaCJK.is_cjk}'s rule, because a slot of a
% legacy font is a punctuation mark no more than it is a CJK character: the
% middle dot of \pkg{pifont}'s slot 0xB7 takes no compression and no hanging.
%    \begin{macrocode}
local function punct_class (c, s, f)
  local override = M.punct_override[c]
  if override ~= nil then
    return override or nil
  end
  if is_slot(c, f) then
    return nil
  end
  if s and s.latin_punct and LATIN_PUNCT[c] then
    return nil
  end
  if M.charsets.middle[c] then
    return "middle"
  end
  return PUNCT_CLASS[c]
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.declare_ranges}
% Fill a table with \meta{value} over a list of code-point ranges,
% each given as \texttt{\{first, last\}}.
%    \begin{macrocode}
local function fill_ranges (target, value, ranges)
  for _, range in ipairs(ranges) do
    local first = range[1]
    local last  = range[2] or first
    for code = first, last do
      target[code] = value
    end
  end
end

function M.declare_class (ranges, cjk)
  fill_ranges(M.class_override, cjk, ranges)
end

function M.declare_punct (ranges, group)
  fill_ranges(M.punct_override, group, ranges)
end

function M.reset_classes ()
  M.class_override = {}
  M.punct_override = {}
  M.normal_spaced  = {}
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{M.charsets}
% The four character sets that the punctuation options can replace.
% \texttt{kaiming} holds the marks that keep a full
% em width in the \texttt{kaiming} style; \texttt{middle}
% and \texttt{long} are filled from the punctuation groups below,
% and \texttt{nobreak} starts as a copy of \texttt{long}.
%    \begin{macrocode}
M.charsets = {
  kaiming = {
    [0xFF0E] = true,  -- ．
    [0x3002] = true,  -- 。
    [0xFF1F] = true,  -- ？
    [0xFF01] = true,  -- ！
  },
  middle  = {},
  long    = {},
  nobreak = {},
}

for code, group in pairs(PUNCT_CLASS) do
  if group == "middle" then
    M.charsets.middle[code] = true
    PUNCT_CLASS[code]       = nil
  elseif group == "dash" or group == "ellipsis" then
    M.charsets.long[code] = true
  end
end

for code in pairs(M.charsets.long) do
  M.charsets.nobreak[code] = true
end

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{LuaCJK.set_charset}
% Replace, extend, or reduce one of the sets above.
% The ranges arrive from \TeX\ as a list of \texttt{\{first, last\}} pairs.
%    \begin{macrocode}
function M.set_charset (kind, mode, ranges)
  local target = M.charsets[kind]
  if not target then
    return
  end
  if mode == "set" then
    target           = {}
    M.charsets[kind] = target
  end
  for _, range in ipairs(ranges) do
    local first = range[1]
    local last  = range[2] or first
    for code = first, last do
      if mode == "remove" then
        target[code] = nil
      else
        target[code] = true
      end
    end
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{LuaCJK.punct_styles}
% The built-in styles. Each entry holds the compression switch,
% the compression ratio, the opening and closing exemption,
% whether the line-end hanging applies, and the optional fixed width.
%    \begin{macrocode}
M.punct_class = function (c, s, f)
  return punct_class(c, s or M.settings[1], f)
end

M.punct_styles = {
  quanjiao = { compress_adjacent = true,  ratio = 0.5,
               keep_open_close = true, hang = true },
  plain    = { compress_adjacent = false, ratio = 0.0,
               keep_open_close = true },
  banjiao  = { compress_adjacent = false, ratio = 0.0, keep_open_close = true,
               fixed_ratio = 0.5, hang = true },
  kaiming  = { compress_adjacent = false, ratio = 0.0, keep_open_close = true,
               fixed_ratio = 0.5, fixed_full = true, hang = true },
  CCT      = { compress_adjacent = false, ratio = 0.0, keep_open_close = true,
               fixed_ratio = 0.7, hang = true },
  hangmobanjiao = { compress_adjacent = false, ratio = 0.0,
                    keep_open_close = true, hang = true },
}

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{LuaCJK.define_punct_style}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{KaiMingPunct},
%   \keys{MiddlePunct}, \keys{LongPunct}, and \keys{NoBreakLongPunct}, each
%   with \texttt{+} and \texttt{-} forms, to edit the punctuation character
%   sets.}
% Register a style declared by \cs{LuaCJKDeclarePunctStyle}.
%    \begin{macrocode}
function M.define_punct_style (name, compress, ratio, keep)
  M.punct_styles[name] = {
    compress_adjacent = compress,
    ratio             = ratio,
    keep_open_close   = keep,
  }
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{punct_style}
% Read the style name from the \TeX\ token list and return the matching
% table, falling back to \texttt{plain}.
%    \begin{macrocode}
M.punct_width = {}
M.punct_kern  = {}

local function first_code (s)
  for _, code in utf8.codes(s) do
    return code
  end
end

function M.set_punct_width (chars, sp)
  for _, code in utf8.codes(chars) do
    M.punct_width[code] = sp
  end
end

function M.add_normal_spaced (ranges)
  for _, range in ipairs(ranges) do
    local first = range[1]
    local last  = range[2] or first
    for code = first, last do
      M.normal_spaced[code] = true
    end
  end
end

function M.set_punct_kern (before, after, sp)
  local a, b = first_code(before), first_code(after)
  if a and b then
    M.punct_kern[a]    = M.punct_kern[a] or {}
    M.punct_kern[a][b] = sp
  end
end

local function user_width (char)
  return M.punct_width[char]
end

local function user_kern (before, after)
  local row = M.punct_kern[before]
  return row and row[after]
end

function M.edit_punct_style (name, compress, ratio, keep)
  local style = M.punct_styles[name]
  if not style then
    return
  end
  if compress ~= nil then
    style.compress_adjacent = compress
  end
  if ratio ~= nil then
    style.ratio = ratio
  end
  if keep ~= nil then
    style.keep_open_close = keep
  end
end

local function style_of (settings)
  local name = settings and settings.punct_style
  return M.punct_styles[name] or M.punct_styles.plain
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{LuaCJK.attr_disabled}
% The attribute number of the suspension switch.
%    \begin{macrocode}
M.attr_disabled = M.attr_disabled or nil

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{disabled}
% Test the suspension attribute on a node.
%    \begin{macrocode}
local function disabled (n)
  if not (M.attr_disabled and n) then
    return false
  end
  local v = has_attribute(n, M.attr_disabled)
  return v ~= nil and v ~= 0
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{Node rewriting}
%
% A CJK glyph carries the identifier of the family that applies
% to it in an attribute. The pass below replaces it by a copy in that font,
% and takes a sub-block font or a fallback font instead when one applies.
%
% \begin{variable}[int]{M.blocks, M.block_order, M.block_fonts}
% The declared sub-blocks in declaration order,
% and the font identifier of each block for each family.
% The order decides which block wins when two ranges overlap.
%    \begin{macrocode}
M.blocks      = {}
M.block_order = {}
M.block_fonts = {}

function M.declare_block (name, ranges)
  if not M.blocks[name] then
    table.insert(M.block_order, name)
  end
  M.blocks[name] = { ranges = ranges }
end

function M.set_block_font (main, name, fid)
  local row = M.block_fonts[main]
  if not row then
    row                 = {}
    M.block_fonts[main] = row
  end
  if fid and fid > 0 then
    row[name] = fid
  else
    row[name] = nil
  end
end

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{block_font}
% The font of the first block of \meta{main} that contains \meta{char}
% and is not canceled in \meta{settings}.
%    \begin{macrocode}
local function block_font (main, char, settings)
  local row = M.block_fonts[main]
  if not row then
    return nil
  end
  local off = settings and settings.blocks_off or {}
  for _, name in ipairs(M.block_order) do
    local block = M.blocks[name]
    if block and not off[name] and row[name] then
      for _, range in ipairs(block.ranges) do
        if char >= range[1] and char <= (range[2] or range[1]) then
          return row[name]
        end
      end
    end
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{M.fallback}
% The fallback fonts of each family, as identifiers,
% in the order in which they were declared.
%    \begin{macrocode}
M.fallback = {}

function M.set_fallback (main, list)
  M.fallback[main] = list
end

%    \end{macrocode}
% \end{variable}
%
% \begin{variable}[int]{M.yoffset}
% The vertical offset of each font, in scaled points, positive upwards.
% The \keys{Baseline} key of a font declaration fills it,
% and \texttt{pre_shaping} adds it when it moves a glyph into the font, so the
% offset belongs to the font the glyph is set in and not to the text that
% asks for it.
%    \begin{macrocode}
M.yoffset = {}

function M.set_yoffset (fid, sp)
  M.yoffset[fid] = sp
end

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{has_char}
% Whether \meta{fid} has a glyph for \meta{char}. The answer is cached
% per font and code point, because the pass asks it once per glyph.
% \begin{variable}[int]{has_char_cache}
% The cache, keyed by the font identifier and the code point packed into
% one number.
%    \begin{macrocode}
local has_char_cache = {}

local function has_char (fid, char)
  local key    = fid * 0x200000 + char
  local cached = has_char_cache[key]
  if cached ~= nil then
    return cached
  end
  local f             = font.getfont(fid)
  local ok            = f and f.characters and f.characters[char] ~= nil
  has_char_cache[key] = ok
  return ok
end

%    \end{macrocode}
% \end{variable}
% \end{macro}
%
% \begin{macro}[int]{fallback_font}
% The first fallback font of \meta{fid} that has \meta{char}, or nothing
% when the feature is off or no fallback covers the character.
%    \begin{macrocode}
local function fallback_font (fid, char, settings)
  if not (settings and settings.auto_fallback) then
    return nil
  end
  local list = M.fallback[fid]
  if not list then
    return nil
  end
  for _, candidate in ipairs(list) do
    if has_char(candidate, char) then
      return candidate
    end
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{target_font}
% The font a CJK glyph takes: the family recorded on the glyph, then a
% sub-block font when one is declared for its block, then the punctuation
% family when the character is a mark it covers, then a fallback font when
% the font that applies does not have the character.
%    \begin{macrocode}
local function target_font (n)
  if not M.attr_font then
    return nil
  end
  local target = has_attribute(n, M.attr_font)
  if not (target and target > 0) then
    return nil
  end
  local settings = settings_of(n)
  local block    = block_font(target, n.char, settings)
  if block then
    target = block
  end
  if M.attr_punct_font and punct_class(n.char, nil, n.font) then
    local punct = has_attribute(n, M.attr_punct_font)
    if punct and punct > 0 then
      target = punct
    end
  end
  if not has_char(target, n.char) then
    target = fallback_font(target, n.char, settings) or target
  end
  return target
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{placeholder}
% Whether a glyph is the one \pkg{luaotfload} substitutes for a character the
% font does not have: the box it draws, or the slot it leaves empty.
%    \begin{macrocode}
local function placeholder (c)
  return c == 0 or (c >= 0xF0000 and c <= 0x10FFFD)
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{pre_shaping}
% \changes{v0.0.3}{2026/11/20}{The CJK font is applied to the characters before
%   the text is shaped instead of to the glyph nodes after it: a combining mark
%   attaches to its base, a variation sequence selects its glyph, and the
%   font's own ligatures and \texttt{locl} forms appear. An older
%   \pkg{luaotfload} keeps the previous behavior.}
% Set each CJK glyph in the font that sets it, before the list is shaped, and
% let a character that attaches to the one in front of it follow that font.
% The substitution comes before shaping because shaping is what attaches a
% mark to its base and what a variation selector and a joiner act on; a glyph
% copied into another font afterwards keeps the form of the font it was
% shaped in.
% A glyph already in its font is left alone, so the pass is idempotent across
% the two lists it sees, the paragraph and each line packed from it, and the
% \keys{Baseline} shift is added once.
% The joiner or selector is marked, because shaping may leave a space glyph
% and a negative kern where the font had no use for the character, and
% \texttt{drop_orphans} cannot recognize them afterwards.
% A CJK character that its CJK font does not have is remembered, because the
% box \pkg{luaotfload} leaves for it is removed only where the package moved
% the character into that font: a document with no CJK font at all still
% shows the box, which is what tells the reader that nothing sets the text.
%    \begin{macrocode}
local missing_chars = {}

local function pre_shaping (head)
  local last = nil
  local cur  = head
  while cur do
    if cur.id == GLYPH then
      if is_attached(cur.char) then
        if M.attr_attached then
          set_attribute(cur, M.attr_attached, 1)
        end
        if last then
          cur.font = last.font
        end
      elseif is_cjk(cur.char, settings_of(cur), cur.font) then
        local target = target_font(cur)
        if target and target > 0 and target ~= cur.font then
          if not has_char(target, cur.char) then
            missing_chars[target * 0x200000 + cur.char] = true
          end
          local shift = M.yoffset[target]
          if shift then
            cur.yoffset = (cur.yoffset or 0) + shift
          end
          cur.font = target
        end
      end
      last = cur
    end
    cur = cur.next
  end
  return head
end

M.pre_shaping = pre_shaping

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{drop_orphans}
% \changes{v0.0.3}{2026/11/20}{A joiner or a variation selector that the font
%   cannot use leaves nothing behind, and neither does a CJK character the CJK
%   font does not have.}
% Remove what shaping left of the two kinds of character that must not reach
% the spacing pass.
% A marked joiner or selector has done its work by now: the font either used
% it, in which case it is a ligature or a variant glyph and the node is gone,
% or it left a space glyph whose advance a negative kern cancels. Both the
% glyph and the kern are freed, so the text around it closes up and the two
% CJK characters on its sides take their glue.
% A CJK character that its CJK font does not have leaves the box glyph the
% font loader draws; it is freed as well, because the character was moved
% into a font that does not set it rather than left in the text font.
%    \begin{macrocode}
local function drop_orphans (head)
  local prev = nil
  local cur  = head
  while cur do
    local nxt  = cur.next
    local drop = false
    if cur.id == GLYPH and M.attr_attached
       and has_attribute(cur, M.attr_attached) ~= nil then
      drop = true
      if nxt and nxt.id == KERN and nxt.kern == -(cur.width or 0) then
        local after = nxt.next
        free_node(nxt)
        nxt = after
      end
    elseif cur.id == GLYPH and placeholder(cur.char)
       and prev and prev.id == GLYPH
       and missing_chars[prev.font * 0x200000 + prev.char] then
      drop = true
    end
    if drop then
      if prev then
        prev.next = nxt
      else
        head = nxt
      end
      free_node(cur)
      cur = nxt
    else
      prev = cur
      cur  = nxt
    end
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{copy_glyph}
% \changes{v0.0.1}{2026/11/11}{A character the font lacks leaves no
%   placeholder: the \texttt{.notdef} or private-use glyph a font substitutes
%   for it is removed.}
% Copy a glyph node, changing only its font.
% Only the fallback for a \pkg{luaotfload} without
% \texttt{pre\_shaping\_filter} uses it.
%    \begin{macrocode}
local function copy_glyph (n, fid)
  local g = new_node("glyph")
  g.font = fid
  for _, field in ipairs {
    "char",     "attr",    "lang",
    "left",     "right",   "uchyph",
    "xoffset",  "yoffset", "expansion_factor",
    "data",     "subtype",
  } do
    g[field] = n[field]
  end
  local shift = M.yoffset[fid]
  if shift then
    g.yoffset = (g.yoffset or 0) + shift
  end
  return g
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{rewrite_fonts}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{LatinPunct}, which keeps the
%   shared quotation marks, the middle dot, and the ellipses in the Latin font
%   instead of the CJK font.}
% Replace each CJK glyph by a copy in the font its attribute names, after
% shaping.
% This is the fallback for a \pkg{luaotfload} without
% \texttt{pre\_shaping\_filter}; the package then behaves as it did before the
% substitution moved in front of shaping, and every zero-width character is
% removed at the input, so no attached character reaches this point.
% A glyph that the old font did not have may sit next to the placeholder
% \pkg{luaotfload} emitted for it; the placeholder is freed at the same
% time, because it would otherwise add an advance of its own.
%    \begin{macrocode}
local function rewrite_fonts (head)
  local prev = nil
  local cur  = head
  while cur do
    local nxt = cur.next
    if cur.id == GLYPH and is_cjk(cur.char, settings_of(cur), cur.font) then
      local target = target_font(cur)
      if target and target > 0 and target ~= cur.font then
        if nxt and nxt.id == GLYPH and nxt.font == cur.font
           and placeholder(nxt.char) then
          local after = nxt.next
          free_node(nxt)
          nxt = after
        end
        local g = copy_glyph(cur, target)
        g.next  = nxt
        if prev then
          prev.next = g
        else
          head = g
        end
        free_node(cur)
        cur = g
      end
    end
    prev = cur
    cur  = nxt
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{class_of_char}
% Map a character to \texttt{CJK} or \texttt{LATIN}, with the font the glyph
% was set in, which \cs{LuaCJK.is_cjk} needs for the code points below U+0100.
%    \begin{macrocode}
local function class_of_char (c, s, f)
  if is_cjk(c, s, f) then
    return "CJK"
  end
  return "LATIN"
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{class_of_node}
% Return the class at both edges of a node. A box carries the class of the
% node at its edge, so filling glue or a kern between the last character and
% the edge leaves the box with no class there; a box of no size is
% transparent, and formulas count as Latin.
% \begin{macro}[int]{transparent_node}
% Whether a node carries neither text nor advance, so that the text reaches
% the edge past it.
%    \begin{macrocode}
local function transparent_node (n)
  return n.id == WHATSIT or n.id == MARK or n.id == INS
      or n.id == ADJUST or n.id == PENALTY
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{box_visible}
% \changes{v0.0.3}{2026/11/20}{A box that occupies no advance is passed over:
%   \cs{rlap}, \cs{llap} and \cs{clap} overlay ink on the text around them, so
%   they no longer take a \keys{CJKecglue} on either side.}
% Whether a box occupies an advance of its own. A box that occupies none is
% passed over, so the boundary rules read the text on both sides of it as one
% run: an empty box does not break the run, and the ink of \cs{rlap}, \cs{llap}
% and \cs{clap} lies on the text around it instead of separating it.
%    \begin{macrocode}
local function box_visible (n)
  return n.width ~= 0
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{attached_box}
% Whether a box belongs to the character in front of it. \TeX\ writes the
% shift of a raised or lowered box into the box node, and
% \cs{textsuperscript} and \cs{textsubscript} build one, so the baseline of
% such a box is not the baseline of the text around it.
%    \begin{macrocode}
local function attached_box (n)
  return (n.id == HLIST or n.id == VLIST) and n.shift ~= 0
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{first_visible_class}
% The class of the text at the start of a list: a glyph, a formula, or a box
% inspected at its own edge. Glue, a kern, a rule, and a discretionary are not
% text, so a list that starts with one has no class at that point, and a box
% whose first edge has no class ends the search instead of yielding to a
% character after it.
%    \begin{macrocode}
local function first_visible_class (list)
  local n = list
  while n do
    if n.id == GLYPH then
      return class_of_char(n.char, settings_of(n), n.font)
    elseif n.id == HLIST or n.id == VLIST then
      return first_visible_class(n.head)
    elseif n.id == MATH then
      return "LATIN"
    elseif not transparent_node(n) then
      return nil
    end
    n = n.next
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{last_visible_class}
% The class of the text at the end of a list, read the same way: a node that
% is not text ends the text, so the class is nothing when something follows
% the last character.
%    \begin{macrocode}
local function last_visible_class (list)
  local n    = list
  local last = nil
  while n do
    if n.id == GLYPH then
      last = class_of_char(n.char, settings_of(n), n.font)
    elseif n.id == HLIST or n.id == VLIST then
      last = last_visible_class(n.head)
    elseif n.id == MATH then
      last = "LATIN"
    elseif not transparent_node(n) then
      last = nil
    end
    n = n.next
  end
  return last
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{first_punct}
% The punctuation group of the first visible character of a list, the
% character itself, and whether a character was found at all, so that a box
% with no text can be skipped.  A formula counts as material with no mark.
%    \begin{macrocode}
local function first_punct (list)
  local n = list
  while n do
    if n.id == GLYPH then
      return punct_class(n.char, settings_of(n), n.font), n, true
    elseif n.id == HLIST or n.id == VLIST then
      local p, g, found = first_punct(n.head)
      if found then
        return p, g, true
      end
    elseif n.id == MATH then
      return nil, nil, true
    end
    n = n.next
  end
  return nil, nil, false
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{last_punct}
% The same for the last visible character of a list.
%    \begin{macrocode}
local function last_punct (list)
  local n     = list
  local punct = nil
  local glyph = nil
  local found = false
  while n do
    if n.id == GLYPH then
      punct = punct_class(n.char, settings_of(n), n.font)
      glyph = n
      found = true
    elseif n.id == HLIST or n.id == VLIST then
      local p, g, deep = last_punct(n.head)
      if deep then
        punct = p
        glyph = g
        found = true
      end
    elseif n.id == MATH then
      punct = nil
      glyph = nil
      found = true
    end
    n = n.next
  end
  return punct, glyph, found
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function class_of_node (n)
  if n.id == GLYPH then
    local c = class_of_char(n.char, settings_of(n), n.font)
    return c, c
  elseif n.id == HLIST or n.id == VLIST then
    return first_visible_class(n.head), last_visible_class(n.head)
  elseif n.id == MATH then
    return "LATIN", "LATIN"
  end
  return nil, nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{is_inserted}
% Test whether a node was inserted by \pkg{LuaCJK}.
%    \begin{macrocode}
local function is_inserted (n)
  return M.attr_inserted
    and has_attribute(n, M.attr_inserted) ~= nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{inherit_attributes}
% \changes{v0.0.1}{2026/11/11}{Glue, kerns, and penalties inserted by the
%   package carry the attributes of the neighbouring node, so a decoration
%   such as \cs{CJKunderdot} covers CJK/CJK and CJK/Latin boundaries without a
%   gap.}
% Give a new node the attribute list of the node it is spliced next to.
% \pkg{LuaCJK} creates glue, kerns, and penalties after \TeX\ has attached
% the surrounding attributes to the text, so a package that
% marks spans with attributes, such as \pkg{lua-ul}, would otherwise read
% the new node as the end of its span and start a new one. Assigning
% to the \meta{attr} field is reference counted, and later per-attribute
% changes are copy-on-write, so the source node is never modified.
%    \begin{macrocode}
local function inherit_attributes (new, source)
  if source and source.attr then
    new.attr = source.attr
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{make_glue}
% Create a glue node from a skip register, inherit the attributes
% of \meta{source}, and mark the node as inserted.
% The node keeps the stretch and shrink orders of the register.
%    \begin{macrocode}
local function make_glue (spec, source)
  if not spec then
    return nil
  end
  local s = spec
  local g = new_node("glue")
  inherit_attributes(g, source)
  g.width         = s.width
  g.stretch       = s.stretch
  g.shrink        = s.shrink
  g.stretch_order = s.stretch_order or 0
  g.shrink_order  = s.shrink_order  or 0
  if M.attr_inserted then
    set_attribute(g, M.attr_inserted, 1)
  end
  return g
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{set_glue}
% Give an existing glue node the dimensions of a skip register,
% including its stretch and shrink orders.
%    \begin{macrocode}
local function set_glue (g, spec)
  if not spec then
    return false
  end
  local s   = spec
  g.width   = s.width
  g.stretch = s.stretch
  g.shrink  = s.shrink
  g.stretch_order = s.stretch_order or 0
  g.shrink_order  = s.shrink_order  or 0
  if M.attr_inserted then
    set_attribute(g, M.attr_inserted, 1)
  end
  return true
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{make_kern}
% Create a kern node, inherit the attributes of \meta{source},
% and mark the node as inserted.
%    \begin{macrocode}
local function make_kern (width, source)
  local k = new_node("kern")
  inherit_attributes(k, source)
  k.kern = width
  if M.attr_inserted then
    set_attribute(k, M.attr_inserted, 1)
  end
  return k
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{The passes}
%
% \begin{macro}[int]{spacing}
% \changes{v0.0.1}{2026/11/11}{Provide CJK/CJK and CJK/Latin spacing with
%   \keys{CJKglue}, \keys{CJKecglue}, \keys{CJKspace}, and \keys{xCJKecglue};
%   a value keeps its stretch and shrink orders. A source space between two
%   CJK characters becomes the inter-character glue, so the boundary keeps its
%   break opportunity and its stretch, and no glue is inserted between two
%   long punctuation marks.}
% \changes{v0.0.3}{2026/11/20}{A superscript or subscript set with
%   \cs{textsuperscript} or \cs{textsubscript} stays with the character in
%   front of it: the shifted box takes no glue on either side, so no break is
%   offered before it.}
% Walk a list and insert the glue between CJK and Latin material.
% The walk tracks the last visible node and the class at its end,
% so that a formula acts as one Latin atom at its left edge;
% inside the formula the boundary rules are not applied.
% A box is an atom as well, and the class at its edge is the class of the
% node at that edge: filling glue or a kern means the box has no text there,
% so no glue is added beside it. A box that occupies no advance is passed over,
% so an empty box inside CJK text does not break the run, and the ink of an
% overlaid one does not split it.
% A box whose own baseline \TeX\ has shifted is attached to the character in
% front of it: the run ends at it, so it takes no glue on either side and
% offers no break. That is the box \cs{textsuperscript} and
% \cs{textsubscript} build; the shift is the box's own field, so the outer box
% of a \cs{raisebox} or of a footnote mark keeps its boundary.
% A penalty that prohibits the break is passed over the same way, because the
% glue of that boundary belongs after it; a smaller penalty, and a
% discretionary, end the run.
% \begin{macro}[int]{handle_boundary}
% \changes{v0.0.1}{2026/11/11}{A mark keeps its break opportunity beside
%   suspended text: the boundary glue at a mark has no width.}
% \changes{v0.0.3}{2026/11/20}{A penalty that prohibits the break no longer
%   removes the glue: the CJK--CJK and CJK--Latin spacing survives
%   \cs{nobreak}, because the glue goes after the penalty, where the
%   prohibition still covers it. A source space in front of the penalty is
%   converted and the penalty moves in front of it.}
% Decide what to do at the boundary between two visible nodes.
% Only source-generated glue is a candidate for replacement;
% other glue is left alone, and a discretionary is opaque, so neither is
% bridged.
% A penalty is read by its value. One that prohibits the break is not a
% barrier: the glue goes after it, so the prohibition still holds at the
% break the glue offers.
% A smaller penalty prices the break instead of forbidding it, and the glue
% would offer the same place a second break at no cost, so a priced break is
% left alone.
% A source space between the two characters is the boundary itself, so when
% one stands in front of a prohibiting penalty it is converted, and the
% penalty moves in front of it rather than letting the space offer the break.
% A boundary that touches a suspended run is bridged by nothing, except that a
% mark keeps its break opportunity: \keys{Verb} suspends the spacing, and the
% glue at a mark has no width, so restoring it there moves no ink. An opening
% mark is excluded, because a break after it is prohibited and the kinsoku pass
% cannot see the prohibition across a suspended node.
% \begin{macro}[int]{insert_boundary_glue}
% Insert the CJK--CJK or CJK--Latin glue,
% or the compression kern for two adjacent punctuation marks.
% The character on each side is the one the list shows, so a whatsit or a
% penalty between two characters does not hide them from these rules; the
% glue itself follows the node that carries the break, which may be such a
% whatsit or penalty.
% A run of dashes or ellipses is one unit: the marks are joined without glue,
% so that justification cannot pull a two-em dash apart, and the absence of a
% break opportunity replaces the explicit prohibition.
% A punctuation mark takes no CJK--Latin advance on either side: the advance
% of the mark already carries its spacing, and the glue would add a third of
% an em that the typography does not ask for.
% The boundary keeps a glue of zero width, so that it stays a break
% opportunity and the kinsoku penalty can forbid the break.
% A half-width bracket is the exception: the boundary in front of an opening
% one keeps the spacing that the two classes give it, and the other three
% sides of the pair take no glue at all.  The pair therefore hugs the text it
% encloses and offers no break inside, which is how \pkg{xeCJK} sets its
% half-width marks.
%    \begin{macrocode}
M.normal_spaced = {}

function M.set_normal_spaced_chars (chars)
  local set = {}
  for _, code in utf8.codes(chars) do
    set[code] = true
  end
  M.normal_spaced = set
end

local function normal_spaced (n)
  return n and n.id == GLYPH and M.normal_spaced[n.char] == true
end

local function long_punct (n)
  return n and n.id == GLYPH and M.charsets.long[n.char] == true
end

local PUNCT_BOUNDARY_GLUE = { width = 0, stretch = 0, shrink = 0 }

local function insert_boundary_glue (head, prev, prev_visible, prev_end,
                                    cur, cur_start, settings)
  if not prev_end or not cur_start then
    return head
  end
  if long_punct(prev_visible) and long_punct(cur) then
    return head
  end
  local style = style_of(settings)
  local prev_punct = nil
  if prev_visible then
    if prev_visible.id == GLYPH then
      prev_punct = punct_class(prev_visible.char, settings, prev_visible.font)
    elseif prev_visible.id == HLIST or prev_visible.id == VLIST then
      prev_punct = last_punct(prev_visible.head)
    end
  end
  local cur_punct = nil
  if cur then
    if cur.id == GLYPH then
      cur_punct = punct_class(cur.char, settings, cur.font)
    elseif cur.id == HLIST or cur.id == VLIST then
      cur_punct = first_punct(cur.head)
    end
  end
  local prev_mark = prev_punct and prev.id == GLYPH
      and not half_mark(prev_punct)
  local cur_mark  = cur_punct and cur.id == GLYPH
      and not half_mark(cur_punct)
  local spec = nil
  if prev_end == "CJK" and cur_start == "CJK" then
    spec = settings.ccglue
  elseif prev_end ~= cur_start
     and not normal_spaced(prev_visible) and not normal_spaced(cur) then
    if half_mark(prev_punct) then
      return head
    elseif cur_punct == "half-open" then
      spec = prev_punct and PUNCT_BOUNDARY_GLUE or settings.ecglue
    elseif half_mark(cur_punct) then
      return head
    elseif prev_punct or cur_punct then
      spec = PUNCT_BOUNDARY_GLUE
    else
      spec = settings.ecglue
    end
  end

  if prev_mark and cur_mark then
    local explicit = user_kern(prev.char, cur.char)
    if explicit then
      local k = make_kern(explicit, prev)
      k.next  = cur
      if prev then
        prev.next = k
      else
        head = k
      end
      return head
    end
  end
  if prev_mark and cur_mark and style.compress_adjacent then
    local exempt = (style.keep_open_close
        and prev_punct == "open" and cur_punct == "close")
      or (M.charsets.long[prev.char] and M.charsets.long[cur.char])
    if not exempt and prev.width and prev.width > 0 then
      local k = make_kern(-math.floor(style.ratio * prev.width + 0.5), prev)
      local g = spec and make_glue(spec, prev) or nil
      k.next  = g or cur
      if g then
        g.next = cur
      end
      if prev then
        prev.next = k
      else
        head = k
      end
      return head
    end
  end

  if not spec then
    return head
  end
  local g = make_glue(spec, prev or cur)
  if not g then
    return head
  end
  g.next = cur
  if prev then
    prev.next = g
  else
    head = g
  end
  return head
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{restore_source_spaces}
% \changes{v0.0.2}{2026/11/15}{The space in front of \cs{textbf} and its
%   siblings is still the inter-character glue: \LaTeX\ moves a space across
%   the italic correction of a text font command, and the move leaves the glue
%   with the subtype of a skip the document wrote.}
% \changes{v0.0.3}{2026/11/20}{\cs{hfill} after \cs{textbf} keeps its fill:
%   only a glue of normal order counts as a source space, so the fill of the
%   line is no longer turned into the inter-character glue.}
% Give a source space that a text font command moved across the italic
% correction its subtype back.
% \cs{textbf} and the other text font commands save the skip in front of them,
% remove it, apply the italic correction, and put it back with \tn{hskip}, so
% the glue keeps the dimensions of the space but not its subtype.
% The move is the only way a normal glue comes to follow an italic-correction
% kern, and the subtype is the one thing the spacing pass reads, so putting the
% subtype back is enough; a typeface whose interword space is rigid therefore
% needs no special case, at the price of retiming a skip that the document
% wrote in that very place.
% A space never has a stretch or shrink order, so a glue that has one was not
% a space at all: \tn{hfill} and \tn{hfil} follow the italic correction of the
% same command and keep their own subtype, or the fill of the line would become
% the inter-character glue.
%    \begin{macrocode}
local function restore_source_spaces (head)
  local prev = nil
  local cur  = head
  while cur do
    if cur.id == GLUE and cur.subtype ~= SPACESKIP
       and cur.stretch_order == 0 and cur.shrink_order == 0
       and prev and prev.id == KERN and prev.subtype == ITALICCORR then
      cur.subtype = SPACESKIP
    end
    prev = cur
    cur  = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{handle_source_space}
% Remove or retime a space typed in the source.
% Only a space that came from the source is a candidate; an explicit
% \tn{hskip} or \tn{hfill} has a different subtype and is left alone, and the
% space that a text font command moved across the italic correction has had
% its subtype put back above.
% A space between two CJK characters is not kept when \keys{CJKspace} is off,
% but dropping it must not drop the boundary with it: the space becomes the
% inter-character glue of \keys{CJKglue}. Freeing it instead would leave the
% two characters adjacent with no glue, and the pass that would add the glue
% runs after line breaking, so the break opportunity would be lost.
% A space the document wrote with |\ | or \tn{nobreakspace} is not a source
% space, and the attribute set around it is the only place that says so: the
% two are the same \texttt{spaceskip} glue, with the same dimensions, until
% that mark is read.  Such a space keeps its advance, on either side of the
% boundary it stands at, because \pkg{xeCJK} sets it as a space too and
% \keys{CJKspace} is about the source.
%    \begin{macrocode}
local function handle_source_space (head, glue, prev_end, cur,
                                    cur_start, settings)
  if glue.subtype ~= SPACESKIP then
    return head
  end
  if M.attr_explicit_space
     and (has_attribute(glue, M.attr_explicit_space) or 0) ~= 0 then
    return head
  end
  local prev_cjk = prev_end == "CJK"
  local cur_cjk  = cur_start == "CJK"
  if prev_cjk and cur_cjk then
    local cjk_space = M.attr_cjk_space
      and (has_attribute(glue, M.attr_cjk_space) or 0) ~= 0
    if not cjk_space then
      set_glue(glue, settings.ccglue)
      if M.attr_inserted then
        set_attribute(glue, M.attr_inserted, 1)
      end
    end
  elseif prev_cjk or cur_cjk then
    local xecglue = M.attr_xecglue
      and (has_attribute(glue, M.attr_xecglue) or 0) ~= 0
    if xecglue then
      set_glue(glue, settings.ecglue)
    end
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function handle_boundary (head, prev, prev_visible, prev_end,
                                cur, start_class, settings)
  if not prev_visible or not start_class then
    return head
  end
  if disabled(prev_visible) or disabled(cur) then
    local occupied = prev
      and (prev.id == GLUE or prev.id == KERN
           or prev.id == PENALTY or prev.id == DISC)
    if disabled(cur) and not disabled(prev_visible)
       and not occupied then
      local mark = prev_visible.id == GLYPH
        and punct_class(prev_visible.char, settings, prev_visible.font)
      if mark and mark ~= "open" and mark ~= "half-open" then
        local g = make_glue(PUNCT_BOUNDARY_GLUE, prev_visible)
        if g then
          g.next = cur
          if prev then
            prev.next = g
          else
            head = g
          end
        end
      end
    end
    return head
  end
  if prev and prev.id == GLUE then
    if not is_inserted(prev) then
      return handle_source_space(
        head, prev, prev_end, cur, start_class, settings)
    end
  elseif prev and prev.id == PENALTY then
    if prev.penalty >= 10000 then
      local space, before = nil, nil
      local n = prev_visible
      while n and n ~= prev do
        local nxt = n.next
        if nxt and nxt.id == GLUE and nxt.subtype == SPACESKIP then
          space, before = nxt, n
          break
        end
        n = nxt
      end
      if space then
        head = handle_source_space(
          head, space, prev_end, cur, start_class, settings)
        local pred = before
        local m    = space
        while m and m ~= prev do
          pred = m
          m    = m.next
        end
        pred.next   = prev.next
        before.next = prev
        prev.next   = space
        return head
      end
      return insert_boundary_glue(
        head, prev, prev_visible, prev_end, cur, start_class, settings)
    end
  elseif prev and prev.id == DISC then
  else
    return insert_boundary_glue(
      head, prev, prev_visible, prev_end, cur, start_class, settings)
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function spacing (head)
  head = restore_source_spaces(head)
  local prev         = nil
  local prev_visible = nil
  local prev_end     = nil
  local math_level   = 0
  local cur          = head
  while cur do
    local nxt = cur.next
    if cur.id == MATH then
      if cur.subtype == 0 then
        if math_level == 0 then
          head = handle_boundary(
            head, prev, prev_visible, prev_end, cur, "LATIN",
            settings_of(prev_visible or cur))
        end
        math_level   = math_level + 1
        prev_visible = nil
        prev_end     = nil
      else
        if math_level > 0 then
          math_level = math_level - 1
        end
        if math_level == 0 then
          prev_visible = cur
          prev_end     = "LATIN"
        end
      end
    elseif math_level > 0 then
    else
      local start_class, end_class = class_of_node(cur)
      local visible
      if cur.id == HLIST or cur.id == VLIST then
        visible = box_visible(cur)
      else
        visible = start_class ~= nil
      end
      if visible and attached_box(cur) then
        prev_visible = nil
        prev_end     = nil
      elseif visible then
        head = handle_boundary(
          head, prev, prev_visible, prev_end, cur, start_class,
          settings_of(prev_visible))
        prev_visible = cur
        prev_end     = end_class
      elseif cur.id == PENALTY or cur.id == DISC then
        if not (cur.id == PENALTY and cur.penalty >= 10000) then
          prev_visible = nil
          prev_end     = nil
        end
      end
    end
    prev = cur
    cur  = nxt
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \TeX\ may break at glue, at kern, and at a discretionary. The first two are
% places where \pkg{LuaCJK} inserts its own nodes, so after building the list a
% second pass puts a penalty 10000 in front of every break opportunity that
% must not be used.
% A discretionary states the value of its own break, so there the pass sets
% the node's penalty field rather than inserting a penalty.
% The hyphens of a word are not in the list yet when the pass runs: \TeX\
% inserts them during line breaking, so a \texttt{hyphenate} callback forbids
% those as well.
%
% \begin{macro}[int]{apply_kinsoku}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{PunctKinsoku} line-breaking
%   prohibitions: closing punctuation cannot start a line and opening
%   punctuation cannot end a line.}
% \changes{v0.0.2}{2026/11/15}{\keys{AllowBreakBetweenPuncts} no longer lets a
%   closing mark start a line or an opening mark end one, and a mark inside a
%   box takes part in the prohibitions.}
% \changes{v0.0.3}{2026/11/20}{A dash or an ellipsis cannot start a line either:
%   a break in front of a run of them is forbidden, so the run travels to the
%   next line whole, while the break between the marks of a run stays the
%   business of the \texttt{NoBreakLongPunct} set.}
% Add the prohibitions where the settings of the text ask for them.
% A node marked by \cs{LuaCJKnobreak} or by the verbatim addon
% is prohibited regardless, because the mark itself is the prohibition.
% A box is read at the edge that faces the break, the way the spacing pass
% reads it, so that a mark at the edge of the box is neither a line start nor
% a line end.
%    \begin{macrocode}
%    \end{macrocode}
% \begin{macro}[int]{no_break_mark}
% Whether a node carries the attribute of \cs{LuaCJKnobreak}.
%    \begin{macrocode}
local function no_break_mark (n)
  if not (M.attr_nobreak and n) then
    return false
  end
  local value = has_attribute(n, M.attr_nobreak)
  return value ~= nil and value ~= 0
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{next_glyph}
% The glyph a discretionary is followed by: the letters of a word are
% separated from it by a kern or a ligature at most, and a glue, a penalty,
% another discretionary or a formula ends the word.
%    \begin{macrocode}
local function next_glyph (n)
  while n and (n.id == KERN or n.id == LIGATURE) do
    n = n.next
  end
  if n and n.id == GLYPH then
    return n
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{forbid_marked_disc}
% Forbid the break at a discretionary that involves a marked node.
% The break lies between the letters on either side of the discretionary, so
% it is prohibited when either of them is marked, the way the break at a glue
% is.
% \TeX\ gives a discretionary the attributes of the character in front of it,
% which is why the node itself is read as well as its neighbours.
%    \begin{macrocode}
local function forbid_marked_disc (disc, left)
  if no_break_mark(disc) or no_break_mark(left)
     or no_break_mark(next_glyph(disc.next)) then
    disc.penalty = 10000
  end
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{adjacent_marks}
% Whether two marks are neighbours that stay together: a dash or an ellipsis
% is left out, because a run of them is one unit of its own, governed by the
% \texttt{nobreak} character set.
%    \begin{macrocode}
local function adjacent_marks (prev_mark, next_mark)
  return prev_mark and next_mark
     and prev_mark ~= "dash" and prev_mark ~= "ellipsis"
     and next_mark ~= "dash" and next_mark ~= "ellipsis"
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{run_mark}
% Whether a punctuation mark is one of the two a run is built from.
%    \begin{macrocode}
local function run_mark (mark)
  return mark == "dash" or mark == "ellipsis"
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{forbids_break}
% The rules: closing, middle, dash, and ellipsis punctuation must not start a
% line,
% opening punctuation must not end one,
% a half-width bracket follows the rule of the side it closes,
% a run of dashes or ellipses stays together,
% and two adjacent marks are not separated.
% A dash or an ellipsis is read as the run it begins, so the rule applies to
% the first mark of a run alone; between the marks of a run the
% \texttt{NoBreakLongPunct} set decides.
% \keys{AllowBreakBetweenPuncts} lifts the last rule alone: a mark that may
% not begin or end a line is a rule of the script, so the option cannot
% permit one.
%    \begin{macrocode}
local function forbids_break (prev_mark, prev_char, next_mark, next_char,
                              settings)
  if next_mark == "close" or next_mark == "middle"
     or next_mark == "half-close" then
    return true
  end
  if run_mark(next_mark) and not run_mark(prev_mark) then
    return true
  end
  if prev_mark == "open" or prev_mark == "half-open" then
    return true
  end
  if M.charsets.nobreak[prev_char] and M.charsets.nobreak[next_char] then
    return true
  end
  if adjacent_marks(prev_mark, next_mark)
     and not (settings and settings.allow_break) then
    return true
  end
  return false
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{edge_mark}
% The punctuation group and the character at one edge of a visible node:
% a glyph is its own edge, and a box is read at the edge that faces the
% break, so a mark inside a box takes part in the rules.  A formula carries
% no mark.
%    \begin{macrocode}
local function edge_mark (n, at_end)
  if n.id == GLYPH then
    return punct_class(n.char, settings_of(n), n.font), n.char, n
  elseif n.id == HLIST or n.id == VLIST then
    local mark, g = nil, nil
    if at_end then
      mark, g = last_punct(n.head)
    else
      mark, g = first_punct(n.head)
    end
    if g then
      return mark, g.char, g
    end
    return nil, nil, nil
  end
  return nil, nil, nil
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{next_visible}
% The next node that carries text: a glyph, a formula, or a box.  A box that
% occupies no advance is passed over, and an explicit break barrier ends the
% search.
%    \begin{macrocode}
local function next_visible (n)
  while n do
    if n.id == GLYPH or n.id == MATH then
      return n
    elseif n.id == HLIST or n.id == VLIST then
      if box_visible(n) then
        return n
      end
    elseif n.id == PENALTY or n.id == DISC then
      return nil
    end
    n = n.next
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{is_break_point}
% Glue and kerns are break opportunities;
% only the ones \pkg{LuaCJK} inserted and the source spaces are considered.
%    \begin{macrocode}
local function is_break_point (n)
  if n.id == GLUE then
    return is_inserted(n) or n.subtype == SPACESKIP
  elseif n.id == KERN then
    return is_inserted(n)
  end
  return false
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function apply_kinsoku (head)
  local prev = nil
  local last = nil
  local cur  = head
  while cur do
    if cur.id == GLYPH
       or ((cur.id == HLIST or cur.id == VLIST) and box_visible(cur)) then
      last = cur
    elseif cur.id == DISC then
      forbid_marked_disc(cur, last)
    elseif is_break_point(cur) and last then
      local nxt                  = next_visible(cur.next)
      local settings             = settings_of(last)
      local prev_mark, prev_char = edge_mark(last, true)
      local next_mark, next_char = nil, nil
      if nxt then
        next_mark, next_char = edge_mark(nxt, false)
      end
      local cj = settings.cj_strict and next_char and M.cj[next_char]
      if nxt and (no_break_mark(last) or no_break_mark(nxt)
                  or cj
                  or (settings.kinsoku
                      and not disabled(last) and not disabled(nxt)
                      and forbids_break(prev_mark, prev_char,
                                        next_mark, next_char, settings)))
      then
        if not (prev and prev.id == PENALTY and prev.penalty >= 10000) then
          local p = new_node("penalty")
          inherit_attributes(p, last)
          p.penalty = 10000
          if M.attr_inserted then
            set_attribute(p, M.attr_inserted, 1)
          end
          p.next = cur
          if prev then
            prev.next = p
          else
            head = p
          end
          cur = p
        end
      end
    end
    prev = cur
    cur  = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{apply_fixed_widths}
% \changes{v0.0.4}{2026/11/20}{A punctuation mark is given its fixed advance
%   once: a box that holds the list is packed again, and the mark no longer
%   takes a second compensating kern, so a fixed-width style no longer
%   squeezes a table cell or a parbox.}
% Styles such as \texttt{banjiao} give every punctuation mark a fixed
% advance. The glyph advance cannot be changed, so a compensating kern
% goes right after the glyph. A penalty in front of that kern keeps \TeX\
% from treating it as an extra break opportunity.
% The kern alone is only right for a mark whose ink sits at the left of its
% advance, which is what a closing mark does. An opening mark keeps its ink
% at the right, so the ink is moved left by the same amount; a middle mark is
% centered, so it moves by half. A dash or an ellipsis is not shortened by the
% style: its advance is the length of the stroke, and halving it would let the
% two halves of a two-em dash overlap.
% A half-width bracket is already narrow, so the ratio of a style leaves it
% alone; a width the document sets applies to it like any other.
% A mark keeps the kern it was given. \TeX\ runs the box-packing callback again
% for every box that holds the list, so a mark whose advance was corrected
% would be corrected a second time: the penalty and the kern the pass inserted
% are the record, and a mark that already carries them is passed over.
%    \begin{macrocode}
local function ink_shift (class, delta)
  if class == "open" or class == "half-open" then
    return delta
  elseif class == "middle" then
    return math.floor(delta / 2 + 0.5)
  end
  return 0
end

local function fixed_width (cur, settings, style)
  local target = user_width(cur.char)
  if not target and settings.punct_width then
    target = settings.punct_width
  end
  if target then
    return target
  end
  if half_mark(punct_class(cur.char, settings, cur.font)) then
    return nil
  end
  local ratio = style.fixed_ratio
  if not ratio or M.charsets.long[cur.char] then
    return nil
  end
  local full = style.fixed_full and M.charsets.kaiming
  if full and full[cur.char] then
    return nil
  end
  local f    = font.getfont(cur.font)
  local size = f and f.size or 0
  if size > 0 then
    return math.floor(ratio * size + 0.5)
  end
  return nil
end

local function fixed_done (n)
  local p = n.next
  if p and p.id == PENALTY and p.penalty == 10000 and is_inserted(p) then
    local k = p.next
    return k ~= nil and k.id == KERN and is_inserted(k)
  end
  return false
end

local function apply_fixed_widths (head)
  local cur = head
  while cur do
    local settings = settings_of(cur)
    local style    = style_of(settings)
    if cur.id == GLYPH and punct_class(cur.char, settings, cur.font)
       and not disabled(cur) and not fixed_done(cur) then
      local target = fixed_width(cur, settings, style)
      if target then
        local delta = target - cur.width
        if delta ~= 0 then
          local shift = ink_shift(punct_class(cur.char, settings, cur.font), delta)
          local p = new_node("penalty")
          inherit_attributes(p, cur)
          p.penalty = 10000
          if M.attr_inserted then
            set_attribute(p, M.attr_inserted, 1)
          end
          local k   = make_kern(delta, cur)
          p.next    = k
          k.next    = cur.next
          cur.next  = p
          if shift ~= 0 then
            cur.xoffset = cur.xoffset + shift
          end
        end
      end
    end
    cur = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% A CJK character in math mode reaches the math list as a \texttt{math_char}
% noad. Its family points at the math font, which usually has no CJK glyph,
% so \pkg{LuaCJK} replaces the nucleus by a \texttt{sub_box} holding the
% character in the CJK font.
%
% \begin{variable}[int]{MATH_CHAR, MATH_TEXT_CHAR}
% The node types of the two kinds of math character noad.
%    \begin{macrocode}
local MATH_CHAR      = node.id("math_char")
local MATH_TEXT_CHAR = node.id("math_text_char")

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{any_cjk_math_enabled}
% Whether any noad of the list asks for CJK in math mode. The switch
% is part of the settings of the text, so the answer is per list.
%    \begin{macrocode}
local function any_cjk_math_enabled (head)
  local cur = head
  while cur do
    if settings_of(cur).cjk_math then
      return true
    end
    cur = cur.next
  end
  return false
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{SUB_MLIST}
% The node type of a nested math list.
%    \begin{macrocode}
local SUB_MLIST = node.id("sub_mlist")

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{rewrite_math}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{CJKmath} and \cs{setCJKmathfont}
%   for CJK characters in math mode, including nested math lists such as
%   fractions. The family is registered as a math family, so a character in a
%   script or a fraction keeps the size of that math style; with
%   \keys{CJKmath} off, a CJK character in math mode warns once.}
% Rewrite the CJK noads of a math list,
% or warn once when the feature is off.
% \begin{macro}[int]{rewrite_math_list}
% Walk a math list, recursing into sub lists (fractions, braces,
% scripts) so that nested CJK characters are rewritten too.
% The declaration is split from the definition because of that recursion.
%    \begin{macrocode}
local rewrite_math_list

%    \end{macrocode}
% \begin{variable}[int]{M.math_fallback}
% The fallback chain of each CJK math family, as a flat list that alternates
% the identifier of the font a character is tested in and the number of the
% math family that sets it.
% The text font of the family itself comes first, so a character the family
% has is set by the family.
%    \begin{macrocode}
M.math_fallback = {}

function M.set_math_fallback (main, list)
  M.math_fallback[main] = list
end

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{math_family_for}
% The first math family of the chain of \meta{family} whose font has
% \meta{char}, or the family itself when none does.
% The fallback fonts are consulted only when \keys{AutoFallBack} is on, which
% the settings of the noad carry, so the switch reaches math mode like it
% reaches the text.
%    \begin{macrocode}
local function math_family_for (char, family, settings)
  local list = M.math_fallback[family]
  if not list then
    return family
  end
  for i = 1, #list, 2 do
    if i > 1 and not (settings and settings.auto_fallback) then
      break
    end
    if has_char(list[i], char) then
      return list[i + 1]
    end
  end
  return family
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{rewrite_noad}
% Point the nucleus of one noad at the math family of its CJK family, or at
% the first fallback family that has the character, and recurse into the sub
% lists of its numerator, denominator, superscript, and subscript.
% The family number comes from the attribute \TeX\ set for the current group,
% which is why \cs{setCJKmathfont} keeps its meaning inside a group: the
% family of the node changes, not a global font.
%    \begin{macrocode}
local function point_at_family (char, family)
  char.fam = family
  if M.attr_font then
    unset_attribute(char, M.attr_font)
  end
end

local function rewrite_field (s, noad, on, family)
  if not s then
    return
  end
  if s.id == MATH_CHAR or s.id == MATH_TEXT_CHAR then
    if is_cjk(s.char, settings_of(noad)) then
      point_at_family(s,
        math_family_for(s.char, family, settings_of(noad)))
    end
  elseif s.id == SUB_MLIST then
    rewrite_math_list(s.head, on, family)
  end
end

local function rewrite_noad (noad, enabled, family)
  if disabled(noad) then
    return
  end
  local on = enabled or settings_of(noad).cjk_math
  if not on or not family then
    return
  end
  rewrite_field(noad.nucleus, noad, on, family)
  for _, field in ipairs({ "num", "denom", "sup", "sub" }) do
    rewrite_field(noad[field], noad, on, family)
  end
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
rewrite_math_list = function (head, enabled, family)
  local cur = head
  while cur do
    rewrite_noad(cur, enabled, family)
    cur = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[int]{LuaCJK.warned_cjk_math}
% Whether the one-time warning has been shown.
%    \begin{macrocode}
M.warned_cjk_math = M.warned_cjk_math or false

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{warn_disabled_cjk_math}
% Warn once when a CJK character appears in math mode while the feature
% is off.
% \begin{macro}[int]{find_cjk_math}
% Search a math list, including its sub lists, for a CJK character.
%    \begin{macrocode}
local function find_cjk_math (head)
  local cur = head
  while cur do
    local nuc = cur.nucleus
    if nuc then
      if (nuc.id == MATH_CHAR or nuc.id == MATH_TEXT_CHAR)
         and is_cjk(nuc.char, settings_of(cur)) then
        return true
      elseif nuc.id == SUB_MLIST and find_cjk_math(nuc.head) then
        return true
      end
    end
    for _, field in ipairs({ "num", "denom", "sup", "sub" }) do
      local sub = cur[field]
      if sub and sub.id == SUB_MLIST and find_cjk_math(sub.head) then
        return true
      end
    end
    cur = cur.next
  end
  return false
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function warn_disabled_cjk_math (head)
  if M.warned_cjk_math then
    return
  end
  if find_cjk_math(head) then
    M.warned_cjk_math = true
    texio.write_nl("term and log",
      "Package LuaCJK Warning: CJK character in math mode, "
      .. "but CJKmath is not enabled.")
    texio.write_nl("term and log",
      "(LuaCJK)                Use \\LuaCJKsetup{CJKmath = true} " ..
      "to typeset it with the CJK font.")
  end
end

%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
local function math_family_of (head)
  local cur = head
  while cur do
    if M.attr_math_font then
      local family = has_attribute(cur, M.attr_math_font)
      if family and family > 0 then
        return family
      end
      local nuc = cur.nucleus
      if nuc then
        family = has_attribute(nuc, M.attr_math_font)
        if family and family > 0 then
          return family
        end
      end
    end
    cur = cur.next
  end
  return nil
end

local function rewrite_math (head)
  if not any_cjk_math_enabled(head) then
    warn_disabled_cjk_math(head)
    return head
  end
  return rewrite_math_list(head, true, math_family_of(head))
end

%    \end{macrocode}
% \end{macro}
%
% A line that ends at a closing or middle mark, or that starts with an opening
% mark, measures the mark's advance short of its ink: the blank half stands in
% the margin. A line that never counted that blank refuses the mark it could
% have held, and is set loose instead. The hang therefore has to be known while
% the line is broken, and by then only the node list is left, so it is
% expressed as a zero-size rule of negative width beside the break: a closing
% mark that ends a line is followed by such a rule and the break glue carries
% the same width, so the two cancel while the line is set and the rule alone
% shortens the line when the break is taken; a glue and a rule in the same
% order let an opening mark begin a line.
% A kern would not do, because a kern that follows a character is a break
% opportunity of its own and would take a kinsoku penalty, while \TeX\ never
% discards a rule at a line break.
%
% Character protrusion is no help either, because it does not move the ink at
% the end of a line: \tn{protrudechars} together with \tn{rpcode} makes
% \tn{rightmarginkern} report the amount while the glyph keeps its position,
% measured at 10pt with a right code of 1000 in a short line, an overfull line,
% and a line whose width is the natural width. Only \tn{lpcode} moves the line,
% which is what the visible effect of \pkg{microtype}'s protrusion on a Latin
% line consists of.
%
% \begin{macro}[int]{bound_width}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{PunctBoundWidth}, which leaves
%   only the given advance of a mark inside the line and hangs the rest into
%   the margin, at the end of a line, at its start, and when the mark ends a
%   box such as \tn{mbox}.}
% The advance that a mark keeps inside the line when it ends one,
% or nothing when the option is off.
% Without it the hang is the blank the font carries, or half of the advance
% when the file has no outline to read.
%    \begin{macrocode}
local function bound_width (settings)
  local value = settings and settings.bound_width
  if value then
    return value
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
%
% The hang of a mark is the blank its glyph carries, so the ink of a
% line-final or line-initial mark stands on the measure instead of a half em
% inside it. \pkg{xeCJK} reads that blank from the font with the \XeTeX\
% primitive \tn{XeTeXglyphbounds}; LuaTeX has no such query, so the outline is
% read from the font file, once per file and once per glyph.
%
% Only the tables a measurement needs are parsed, and the bytes of a glyph are
% read when it is first asked for, so a sixteen-megabyte CJK face does not sit
% in memory a second time. The box is the one the control points span, which is
% what \XeTeX\ reports as well.
%
% \begin{variable}[int]{font_files}
% One entry per font file, holding its directory, its character map, and the
% boxes already measured.
%    \begin{macrocode}
local font_files = {}

%    \end{macrocode}
% \end{variable}
% \begin{macro}[int]{u16, i16, u32}
% The big-endian integers of the file format.
%    \begin{macrocode}
local function u16 (s, o) return s:byte(o + 1) * 256 + s:byte(o + 2) end

local function i16 (s, o)
  local v = u16(s, o)
  if v >= 32768 then v = v - 65536 end
  return v
end

local function u32 (s, o) return u16(s, o) * 65536 + u16(s, o + 2) end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{font_file}
% The parsed directory of one font file, or nothing when it cannot be read.
% The handle stays open, because one file serves every mark of the document.
%    \begin{macrocode}
local function font_file (filename)
  local f = font_files[filename]
  if f ~= nil then
    return f or nil
  end
  local fh = io.open(filename, "rb")
  if not fh then
    font_files[filename] = false
    return nil
  end
  local function read (off, len)
    fh:seek("set", off)
    return fh:read(len) or ""
  end
  local head = read(0, 12)
  if #head < 12 then
    font_files[filename] = false
    return nil
  end
  local count = u16(head, 4)
  local dir = read(12, count * 16)
  local tables = {}
  for i = 0, count - 1 do
    local rec = i * 16
    local tag = dir:sub(rec + 1, rec + 4)
    tables[tag] = { offset = u32(dir, rec + 8), length = u32(dir, rec + 12) }
  end
  local t = { fh = fh, read = read, tables = tables, boxes = {} }
  if tables.head then
    t.upem = u16(read(tables.head.offset + 18, 2), 0)
  end
  if not (t.upem and t.upem > 0) then
    fh:close()
    font_files[filename] = false
    return nil
  end
  font_files[filename] = t
  return t
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{font_cmap}
% The character map, preferring a Unicode subtable: a format 12 table for
% the third platform, then a format 4 one, then whichever remains.
%    \begin{macrocode}
local function font_cmap (f)
  local off = f.tables.cmap and f.tables.cmap.offset
  if not off then return end
  local head = f.read(off, 4)
  local n = u16(head, 2)
  local recs = f.read(off + 4, n * 8)
  local choice
  for i = 0, n - 1 do
    local p = i * 8
    local pid, eid = u16(recs, p), u16(recs, p + 2)
    local sub = off + u32(recs, p + 4)
    local fmt = u16(f.read(sub, 2), 0)
    local rank
    if fmt == 12 and pid == 3 and eid == 10 then rank = 3
    elseif fmt == 12 then rank = 2
    elseif fmt == 4 and pid == 3 and eid == 1 then rank = 2
    elseif fmt == 4 then rank = 1 end
    if rank and (not choice or rank > choice.rank) then
      choice = { rank = rank, sub = sub, format = fmt }
    end
  end
  if not choice then return end
  if choice.format == 4 then
    local head4 = f.read(choice.sub, 14)
    local segX2 = u16(head4, 6)
    local seg = segX2 // 2
    f.cmap = {
      format = 4, data = f.read(choice.sub, u16(head4, 2)), segments = seg,
      end_of = 14, start_of = 14 + segX2 + 2,
      delta_of = 14 + segX2 + 2 + segX2,
      range_of = 14 + segX2 + 2 + segX2 + segX2,
    }
  else
    local head12 = f.read(choice.sub, 16)
    f.cmap = { format = 12, data = f.read(choice.sub, u32(head12, 4)) }
  end
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{font_glyph}
% The glyph index of a character, or zero.
%    \begin{macrocode}
local function font_glyph (f, code)
  if f.cmap then
    local c = f.cmap
    if c.format == 4 then
      local end_of, start_of, delta_of, range_of = c.end_of, c.start_of, c.delta_of, c.range_of
      for i = 0, c.segments - 1 do
        if code <= u16(c.data, end_of + i * 2) then
          local start = u16(c.data, start_of + i * 2)
          if code < start then return 0 end
          local delta = i16(c.data, delta_of + i * 2)
          local ro = u16(c.data, range_of + i * 2)
          if ro == 0 then return (code + delta) % 65536 end
          local addr = range_of + i * 2 + ro + (code - start) * 2
          local g = u16(c.data, addr)
          if g == 0 then return 0 end
          return (g + delta) % 65536
        end
      end
      return 0
    elseif c.format == 12 then
      local p = 16
      while p + 12 <= #c.data do
        local s, e, g = u32(c.data, p), u32(c.data, p + 4), u32(c.data, p + 8)
        if code >= s and code <= e then return g + (code - s) end
        p = p + 12
      end
      return 0
    end
    return 0
  end
  return 0
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{font_advance}
% The advance of a glyph from \texttt{hmtx}; a glyph past the last entry takes
% the last advance, as the format says.
%    \begin{macrocode}
local function font_advance (f, gid)
  if f.advances then
    return f.advances[gid] or f.last_advance or 0
  end
  local hhea = f.tables.hhea and f.tables.hhea.offset
  local hmtx = f.tables.hmtx and f.tables.hmtx.offset
  if not (hhea and hmtx) then return f.upem end
  local nhm = u16(f.read(hhea + 34, 2), 0)
  if nhm == 0 then return f.upem end
  local data = f.read(hmtx, nhm * 4)
  local advances, last = {}, 0
  for i = 0, nhm - 1 do
    last = u16(data, i * 4)
    advances[i] = last
  end
  f.advances, f.last_advance = advances, last
  return advances[math.min(gid, nhm - 1)] or last
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{cff_index}
% A \texttt{CFF} index: where its data starts and the offset of each item,
% which is one-based from that start.
%    \begin{macrocode}
local function cff_index (f, p)
  local head = f.read(p, 3)
  local count = u16(head, 0)
  if count == 0 then return { count = 0, next = p + 2, data = p + 2 } end
  local off_size = head:byte(3)
  local offs = f.read(p + 3, (count + 1) * off_size)
  local function off (i)
    local v = 0
    local base = (i - 1) * off_size
    for k = 1, off_size do v = v * 256 + offs:byte(base + k) end
    return v
  end
  local data = p + 3 + (count + 1) * off_size
  return { count = count, data = data, off = off, next = data + off(count + 1) - 1 }
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{cff_string}
% One item of a \texttt{CFF} index, which is a charstring or a dictionary.
%    \begin{macrocode}
local function cff_string (f, idx, i)
  local a, b = idx.off(i), idx.off(i + 1)
  return f.read(idx.data + a - 1, b - a)
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{cff_dict}
% A \texttt{CFF} dictionary as its operators and operands. Only the two
% operators that point at the charstrings and the private dictionary are read,
% so a real number is skipped rather than converted.
%    \begin{macrocode}
local function cff_dict (s)
  local out, stack = {}, {}
  local i, n = 1, #s
  while i <= n do
    local b = s:byte(i)
    if b <= 21 then
      i = i + 1
      local op = b
      if b == 12 then
        op = 1200 + s:byte(i)
        i = i + 1
      end
      out[op] = stack
      stack = {}
    elseif b == 28 then
      local v = s:byte(i + 1) * 256 + s:byte(i + 2)
      if v >= 32768 then v = v - 65536 end
      stack[#stack + 1] = v
      i = i + 3
    elseif b == 29 then
      local v = s:byte(i + 1) * 16777216 + s:byte(i + 2) * 65536
                + s:byte(i + 3) * 256 + s:byte(i + 4)
      if v >= 2147483648 then v = v - 4294967296 end
      stack[#stack + 1] = v
      i = i + 5
    elseif b == 30 then
      i = i + 1
      while i <= n do
        local c = s:byte(i)
        i = i + 1
        if c % 16 == 15 then break end
      end
    elseif b >= 32 and b <= 246 then
      stack[#stack + 1] = b - 139
      i = i + 1
    elseif b >= 247 and b <= 250 then
      stack[#stack + 1] = (b - 247) * 256 + s:byte(i + 1) + 108
      i = i + 2
    elseif b >= 251 and b <= 254 then
      stack[#stack + 1] = -(b - 251) * 256 - s:byte(i + 1) - 108
      i = i + 2
    else
      i = i + 1
    end
  end
  return out
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{cff_load}
% The charstrings of a \texttt{CFF} font and the two subroutine indexes a
% charstring may call into.
%    \begin{macrocode}
local function cff_load (f)
  local base = f.tables["CFF "] and f.tables["CFF "].offset
  if not base then return end
  local hdr = f.read(base + 2, 1)
  local p = base + hdr:byte(1)
  local names = cff_index(f, p)
  local tops = cff_index(f, names.next)
  local strings = cff_index(f, tops.next)
  local gsubrs = cff_index(f, strings.next)
  local top = cff_dict(cff_string(f, tops, 1))
  local cs = top[17] and top[17][1]
  if not cs then return end
  f.charstrings = cff_index(f, base + cs)
  f.gsubrs = gsubrs
  local priv = top[18]
  if priv then
    local size, offset = priv[1], priv[2]
    local pdict = cff_dict(f.read(base + offset, size))
    if pdict[19] then
      f.subrs = cff_index(f, base + offset + pdict[19][1])
    end
  end
  f.cff = true
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{cff_box}
% \changes{v0.0.3}{2026/11/20}{The blank of a mark is measured from the
%   charstring the glyph uses, so a glyph whose charstring calls a subroutine
%   is measured in the subroutine rather than in the charstring the
%   measurement began with.}
% \changes{v0.0.3}{2026/11/20}{A curve of four operands is read as one curve
%   in both axes, so the blank of a mark whose charstring draws it with the
%   alternating or the vertical curve operator is the blank the glyph has: a
%   double opening quotation mark no longer stands in the margin by more
%   than a tenth of a point.}
% The horizontal extent of a Type 2 charstring. Every point of the outline is
% visited, the control points of a curve included, which is the box the font's
% own readers report; hints are counted only so that their masks can be
% skipped.
% A curve operator takes four operands, and the alternating ones start on the
% axis their name gives; the one operand of a $4n+1$ run closes the last
% curve on the other axis.
% Each number is read from the charstring that holds it, since a subroutine
% carries its own operands, and the four bytes of the deprecated fixed form
% are read in full.
%    \begin{macrocode}
local function cff_box (f, cs)
  local x, xmin, xmax = 0, math.huge, -math.huge
  local stack, stems = {}, 0
  local function point (dx, dy)
    x = x + (dx or 0)
    if x < xmin then xmin = x end
    if x > xmax then xmax = x end
  end
  local function number (code, b, i)
    if b >= 32 and b <= 246 then return b - 139, i + 1 end
    if b >= 247 and b <= 250 then
      return (b - 247) * 256 + code:byte(i + 1) + 108, i + 2
    end
    if b >= 251 and b <= 254 then
      return -(b - 251) * 256 - code:byte(i + 1) - 108, i + 2
    end
    if b == 28 then
      local v = code:byte(i + 1) * 256 + code:byte(i + 2)
      if v >= 32768 then v = v - 65536 end
      return v, i + 3
    end
    if b == 255 then
      local v = code:byte(i + 1) * 16777216 + code:byte(i + 2) * 65536
                + code:byte(i + 3) * 256 + code:byte(i + 4)
      if v >= 2147483648 then v = v - 4294967296 end
      return v / 65536, i + 5
    end
    return nil, i
  end
  local run
  run = function (code, depth)
    local i, n = 1, #code
    while i <= n do
      local b = code:byte(i)
      local v
      v, i = number(code, b, i)
      if v ~= nil then
        stack[#stack + 1] = v
      else
        i = i + 1
        if b == 21 then
          point(stack[1], stack[2])
          stack = {}
        elseif b == 22 then
          point(stack[1], 0)
          stack = {}
        elseif b == 4 then
          point(0, stack[1])
          stack = {}
        elseif b == 5 then
          for k = 1, #stack - 1, 2 do point(stack[k], stack[k + 1]) end
          stack = {}
        elseif b == 6 or b == 7 then
          local horiz = (b == 6)
          for k = 1, #stack do
            if horiz then point(stack[k], 0) else point(0, stack[k]) end
            horiz = not horiz
          end
          stack = {}
        elseif b == 8 then
          for k = 1, #stack - 5, 6 do
            point(stack[k], stack[k + 1])
            point(stack[k + 2], stack[k + 3])
            point(stack[k + 4], stack[k + 5])
          end
          stack = {}
        elseif b == 24 then
          local k = 1
          while k <= #stack - 2 do
            point(stack[k], stack[k + 1])
            k = k + 2
          end
          point(stack[k], stack[k + 1])
          stack = {}
        elseif b == 25 then
          local k = 1
          while k <= #stack - 6 do
            point(stack[k], stack[k + 1])
            point(stack[k + 2], stack[k + 3])
            point(stack[k + 4], stack[k + 5])
            k = k + 6
          end
          point(stack[k], stack[k + 1])
          stack = {}
        elseif b == 26 or b == 27 then
          local k, first = 1, 0
          if #stack % 4 == 1 then first, k = stack[1], 2 end
          while k <= #stack - 3 do
            if b == 26 then
              point(first, stack[k])
              point(stack[k + 1], stack[k + 2])
              point(0, stack[k + 3])
            else
              point(stack[k], first)
              point(stack[k + 1], stack[k + 2])
              point(stack[k + 3], 0)
            end
            first = 0
            k = k + 4
          end
          stack = {}
        elseif b == 30 or b == 31 then
          local horiz = (b == 31)
          local k = 1
          while k <= #stack - 3 do
            if horiz then
              point(stack[k], 0)
              point(stack[k + 1], stack[k + 2])
              point(0, stack[k + 3])
            else
              point(0, stack[k])
              point(stack[k + 1], stack[k + 2])
              point(stack[k + 3], 0)
            end
            horiz = not horiz
            k = k + 4
          end
          if k == #stack then
            if horiz then
              point(stack[k], 0)
            else
              point(0, stack[k])
            end
          end
          stack = {}
        elseif b == 1 or b == 3 or b == 18 or b == 23 then
          stems = stems + #stack // 2
          stack = {}
        elseif b == 19 or b == 20 then
          stems = stems + #stack // 2
          stack = {}
          i = i + (stems + 7) // 8
        elseif b == 10 or b == 29 then
          local sub = table.remove(stack)
          local arr = (b == 10) and f.subrs or f.gsubrs
          if arr and arr.count > 0 and sub then
            local bias = (arr.count < 1240) and 107
                      or (arr.count < 33900 and 1131 or 32768)
            local idx = sub + bias + 1
            if idx >= 1 and idx <= arr.count and depth < 8 then
              run(cff_string(f, arr, idx), depth + 1)
            end
          end
        elseif b == 11 or b == 14 then
          return
        else
          stack = {}
        end
      end
    end
  end
  run(cs, 0)
  if xmin == math.huge then return nil end
  return xmin, xmax
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{font_box}
% The box of one character in font units: a \texttt{CFF} outline from its
% charstring, a \texttt{glyf} outline from the ten-byte header that starts it,
% and nothing for a character the font does not have.
%    \begin{macrocode}
local function font_box (f, code)
  local known = f.boxes[code]
  if known ~= nil then
    return known or nil
  end
  if f.cff == nil then cff_load(f) end
  if f.cmap == nil then font_cmap(f) end
  local gid = font_glyph(f, code)
  if not gid or gid == 0 then
    f.boxes[code] = false
    return nil
  end
  local advance = font_advance(f, gid)
  local xmin, xmax
  if f.charstrings then
    if gid > f.charstrings.count then return nil end
    xmin, xmax = cff_box(f, cff_string(f, f.charstrings, gid + 1))
  else
    local glyf = f.tables.glyf and f.tables.glyf.offset
    local loca = f.tables.loca and f.tables.loca.offset
    local head = f.tables.head and f.tables.head.offset
    if not (glyf and loca and head) then return nil end
    local long = u16(f.read(head + 50, 2), 0) == 1
    local function loc (i)
      if long then return u32(f.read(loca + i * 4, 4), 0) end
      return u16(f.read(loca + i * 2, 2), 0) * 2
    end
    local a, b = loc(gid), loc(gid + 1)
    if b <= a then return nil end
    local hdr = f.read(glyf + a, 10)
    xmin, xmax = i16(hdr, 2), i16(hdr, 6)
  end
  if not xmin then return nil end
  local box = { xmin = xmin, xmax = xmax, advance = advance }
  f.boxes[code] = box
  return box
end
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{mark_blank}
% \changes{v0.0.2}{2026/11/15}{The hang of a mark is the blank its font
%   carries, read from the outline, so the ink of a line-final or line-initial
%   mark stands on the measure instead of half an em inside it; a file that
%   cannot be read falls back to half the advance.}
% The blank of a mark on the side that hangs, in scaled points, or nothing
% when the file cannot be read or is one member of a collection. The advance is
% the one the style gives the mark, so a compressed mark is measured inside its
% own advance, where \cs{apply_fixed_widths} puts its ink.
%    \begin{macrocode}
local function mark_blank (g, mark, target)
  local font = font.getfont(g.font)
  if not (font and font.filename and font.size and (font.index or 0) == 0) then
    return nil
  end
  local f = font_file(font.filename)
  if not f then
    return nil
  end
  local box = font_box(f, g.char)
  if not box then
    return nil
  end
  local scale = font.size / f.upem
  local delta = target - box.advance * scale
  local blank
  if mark == "open" then
    blank = box.xmin * scale + delta
  else
    blank = target - box.xmax * scale
    if mark == "middle" then
      blank = blank - delta / 2
    end
  end
  if blank < 0 then
    blank = 0
  elseif blank > target then
    blank = target
  end
  return math.floor(blank + 0.5)
end
%    \end{macrocode}
% \end{macro}


% \begin{macro}[int]{hang_amount}
% How much of a mark's advance stands outside the line: the part that
% \keys{PunctBoundWidth} leaves out, the blank the font carries for the mark,
% or half of the advance the style gives it when the file has no outline to
% read. The advance is the one \cs{apply_fixed_widths} gives it, so a
% compressed style hangs less.
%    \begin{macrocode}
local function hang_amount (g, mark, settings)
  local target = fixed_width(g, settings, style_of(settings)) or g.width
  local bound  = bound_width(settings)
  if bound then
    return math.max(0, target - bound)
  end
  local blank = mark_blank(g, mark, target)
  if blank then
    return blank
  end
  return math.floor(0.5 * target + 0.5)
end

%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{open_hang, item_label, head_lead, hang_rule}
% The hang of an opening mark that a line begins with, as a length and the
% glyph it belongs to, or zero when the mark does not open or its style does
% not hang; the rule that carries that length into the line, of negative width
% and with the attributes of the mark; and the head of a paragraph, found by
% walking over what carries no text of the paragraph: the local paragraph
% node, the whatsits, the indentation, which \LuaTeX\ puts in front of the
% text as an empty box of the width of \tn{parindent}, and the label box of a
% list item, which the list writes in front of the item's text.
% A box is passed over when it carries no content, when it occupies no
% advance, or when a penalty of zero follows it, and a penalty is passed over
% unless it forces a break.
% The penalty of zero is the one the list writes after the label box of an
% item, so the label takes an advance in the line without being part of the
% paragraph, and a mark that begins the item hangs into it the way it hangs
% into the indentation of a paragraph.
%    \begin{macrocode}
local function open_hang (n)
  local lead, _, glyph = edge_mark(n, false)
  if not (glyph and not disabled(glyph) and lead == "open"
          and style_of(settings_of(glyph)).hang) then
    return 0, nil
  end
  return hang_amount(glyph, "open", settings_of(glyph)) or 0, glyph
end

local function item_label (b)
  local n = b.next
  return n ~= nil and n.id == PENALTY and n.penalty == 0
end

local function head_lead (head)
  local indent = tex.parindent or 0
  local prev   = nil
  local cur    = head
  while cur do
    if cur.id == GLYPH then
      return cur, prev
    elseif cur.id == HLIST or cur.id == VLIST then
      if cur.head and cur.width ~= 0 and not item_label(cur) then
        return nil, nil
      end
    elseif cur.id == GLUE then
      if cur.width ~= indent or cur.stretch ~= 0 or cur.shrink ~= 0 then
        return nil, nil
      end
    elseif cur.id == KERN then
      if cur.kern ~= 0 then
        return nil, nil
      end
    elseif cur.id == PENALTY then
      if cur.penalty < 0 then
        return nil, nil
      end
    elseif cur.id == MATH or cur.id == DISC or cur.id == RULE then
      return nil, nil
    end
    prev = cur
    cur  = cur.next
  end
  return nil, nil
end

local function hang_rule (width, glyph, prev, after)
  local r  = new_node("rule")
  r.width  = -width
  r.height = 0
  r.depth  = 0
  inherit_attributes(r, glyph)
  r.next = after
  if prev then
    prev.next = r
  end
  return r
end

local function hang_rule (width, glyph, prev, next_)
  local r  = new_node("rule")
  r.width  = -width
  r.height = 0
  r.depth  = 0
  inherit_attributes(r, glyph)
  r.next = next_
  if prev then
    prev.next = r
  end
  return r
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{hang_bounds}
% \changes{v0.0.2}{2026/11/15}{The hanging of a mark takes part in line
%   breaking, so a line that ends at a closing mark or begins with an opening
%   mark holds the mark the margin allows; the ink of that mark stands outside
%   the line, and \keys{PunctBoundWidth} decides how much of the advance stays
%   inside.}
% \changes{v0.0.3}{2026/11/20}{An opening mark that begins a paragraph, or a
%   line the document forces a break at, hangs as well: its blank stands in
%   the indentation or in the margin, and \keys{PunctBoundWidth} decides how
%   much of the advance stays inside the line there too.}
% \changes{v0.0.4}{2026/11/20}{The first line of a list item hangs as well:
%   the label box that the list writes in front of the item's text is passed
%   over, so a mark that begins the item leaves its blank in the label's
%   advance.}
% Bracket every break point that a mark ends or starts, so the line measures
% the hang and the text inside a line does not move. A break that a preceding
% penalty already forbids is left alone, so a fixed width does not carry a rule
% that can never be used. The two boundaries that carry no glue of their own
% are bracketed as well: the start of the paragraph, and the penalty that
% holds a break the document forced, where the rule that shifts the line is
% all there is to insert.
%    \begin{macrocode}
local function hang_bounds (head)
  local first, before = head_lead(head)
  if first then
    local width, glyph = open_hang(first)
    if width > 0 then
      local r = hang_rule(width, glyph, before, first)
      if not before then
        head = r
      end
    end
  end
  local prev = nil
  local last = nil
  local cur  = head
  while cur do
    if cur.id == GLYPH
       or ((cur.id == HLIST or cur.id == VLIST) and box_visible(cur)) then
      last = cur
    elseif cur.id == PENALTY and cur.penalty <= -10000 then
      local nxt = next_visible(cur.next)
      local width, glyph = 0, nil
      if nxt then
        width, glyph = open_hang(nxt)
      end
      if width > 0 then
        hang_rule(width, glyph, cur, cur.next)
        cur = cur.next
      end
    elseif is_break_point(cur) and last and cur.id == GLUE
           and not (prev and prev.id == PENALTY and prev.penalty >= 10000) then
      local nxt                       = next_visible(cur.next)
      local tail, _, tail_glyph       = edge_mark(last, true)
      local w_end                     = 0
      local w_start, lead_glyph       = 0, nil
      if nxt then
        w_start, lead_glyph = open_hang(nxt)
      end
      if tail_glyph and not disabled(tail_glyph)
         and (tail == "close" or tail == "middle")
         and style_of(settings_of(tail_glyph)).hang then
        w_end = hang_amount(tail_glyph, tail, settings_of(tail_glyph))
      end
      if w_end > 0 or w_start > 0 then
        local delta = w_end + w_start
        cur.width = cur.width + delta
        if w_end > 0 then
          local r  = new_node("rule")
          r.width  = -w_end
          r.height = 0
          r.depth  = 0
          inherit_attributes(r, tail_glyph)
          r.next = cur
          if prev then
            prev.next = r
          else
            head = r
          end
          prev = r
        end
        if w_start > 0 then
          local r  = new_node("rule")
          r.width  = -w_start
          r.height = 0
          r.depth  = 0
          inherit_attributes(r, lead_glyph)
          r.next = cur.next
          cur.next = r
        end
      end
    end
    prev = cur
    cur  = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \TeX\ can break at the glue that \pkg{LuaCJK} inserts between CJK characters.
% At the end of a paragraph the last two such break points get a penalty,
% so that at least three CJK characters travel to the last line together
% instead of a single one.
%
% \begin{macro}[int]{apply_check_single}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{CheckSingle} and
%   \keys{WidowPenalty}, which stop a single CJK character from ending up
%   alone on the last line of a paragraph.}
% \changes{v0.0.3}{2026/11/20}{A whatsit between two CJK characters no longer
%   hides the break point from \keys{CheckSingle}: a color change, a mark, and
%   the other nodes that carry no text are passed over, so they no longer
%   leave a single character on the last line.}
% Insert the widow penalties. Only a paragraph whose last visible node
% is a CJK glyph is examined, and only when its settings ask for it.
% The scan back to the previous character passes over what carries no text —
% a whatsit such as a color change, a mark, an insertion, the adjustment of a
% box, a penalty, and a kern this package inserted — so such a node does not
% end the run.
% The penalty goes in front of the glue that the break is taken at, and it is
% left out when a penalty already stands in front of that glue, so a second
% run over the same list adds nothing.
%    \begin{macrocode}
local function apply_check_single (head)
  local trail = {}
  local node  = head
  while node do
    trail[#trail + 1] = node
    node = node.next
  end
  local last
  for i = #trail, 1, -1 do
    local item = trail[i]
    if item.id == GLYPH then
      if is_cjk(item.char, settings_of(item), item.font) then
        last = i
      end
      break
    elseif item.id == HLIST or item.id == VLIST then
      break
    end
  end
  if not last then
    return head
  end
  local settings = settings_of(trail[last])
  if not settings.check_single then
    return head
  end
  local penalty  = settings.widow_penalty
  local inserted = 0
  local i        = last
  while i > 1 and inserted < 2 do
    local j = i - 1
    while j >= 1 and (trail[j].id == GLUE or transparent_node(trail[j])
                      or (trail[j].id == KERN and is_inserted(trail[j]))) do
      j = j - 1
    end
    if j < 1 then
      break
    end
    local glyph = trail[j]
    if glyph.id ~= GLYPH or not is_cjk(glyph.char, settings_of(glyph), glyph.font) then
      break
    end
    local at    = nil
    local taken = false
    for k = j + 1, i - 1 do
      local item = trail[k]
      if item.id == GLUE then
        at = k
        break
      elseif item.id == PENALTY then
        taken = true
      end
    end
    if at and not taken then
      local p = new_node("penalty")
      inherit_attributes(p, glyph)
      p.penalty          = penalty
      p.next             = trail[at]
      trail[at - 1].next = p
    end
    inserted = inserted + 1
    i        = j
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.process}
% Run the passes over a list, in the order in which they depend on each
% other: what shaping left of the zero-width characters first, so that the
% spacing pass sees the text as it is set; then the spacing, the fixed
% widths, the prohibitions, and the widow penalties.
% Without \texttt{pre\_shaping\_filter} the font is moved here instead, after
% shaping, because there was no pass in front of it.
% The hang of a mark is inserted only when the list is a paragraph about to be
% broken, because a box packed by \tn{hpack} has no break to hang at.
%    \begin{macrocode}
local function process (head, linebreak)
  if M.shaping then
    head = drop_orphans(head)
  else
    head = rewrite_fonts(head)
  end
  head = spacing(head)
  head = apply_fixed_widths(head)
  if linebreak then
    head = hang_bounds(head)
  end
  head = apply_kinsoku(head)
  head = apply_check_single(head)
  return head
end

M.process = process

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.pre_linebreak}
% The line-breaking callback.
%    \begin{macrocode}
function M.pre_linebreak (head, groupcode)
  return process(head, true)
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.hpack}
% The box-packing callback.
%    \begin{macrocode}
function M.hpack (head, groupcode, size, packtype, direction, attributelist)
  return process(head)
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.pre_mlist_to_hlist}
% The math callback.
%    \begin{macrocode}
function M.pre_mlist_to_hlist (head, display, penalties)
  return rewrite_math(head)
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{hyphenate_runs}
% Hyphenate the runs of a word that lie between its CJK characters.
% \TeX\ counts a CJK character as a letter, so the patterns see a CJK
% character and the Latin word beside it as one word, and a point they find
% there puts a hyphen right next to the character.
% A CJK character ends a word here instead: the run of text on each side of
% it is hyphenated on its own, so no point the patterns find can stand
% between a CJK character and the letters that follow, and the boundary keeps
% the glue that \keys{CJKecglue} gives it.
%    \begin{macrocode}
local function hyphenate_runs (head, tail)
  local run  = nil
  local prev = nil
  local cur  = head
  while cur do
    if cur.id == GLYPH and is_cjk(cur.char, settings_of(cur), cur.font) then
      if run then
        lang.hyphenate(run, prev)
      end
      run = nil
    elseif not run then
      run = cur
    end
    prev = cur
    if cur == tail then
      break
    end
    cur = cur.next
  end
  if run then
    lang.hyphenate(run, prev)
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJK.hyphenate}
% \changes{v0.0.4}{2026/11/20}{A CJK character ends a word for hyphenation, so
%   the line breaker no longer puts a hyphen beside a CJK character, and the
%   boundary keeps the \keys{CJKecglue} that the two sides give it.}
% The hyphenation callback.
% \TeX\ hyphenates a word while it breaks the lines, after the
% pre-linebreaking pass has already built the list, so the discretionaries of
% a word appear after the prohibitions have been placed and nothing forbids
% them yet.
% The callback hyphenates exactly as \TeX\ does, a run of non-CJK text at a
% time, and then reads the discretionaries it has just created, one word at a
% time.
%    \begin{macrocode}
function M.hyphenate (head, tail)
  hyphenate_runs(head, tail)
  local left = nil
  local cur  = head
  while cur do
    if cur.id == GLYPH then
      left = cur
    elseif cur.id == DISC then
      forbid_marked_disc(cur, left)
    end
    if cur == tail then
      break
    end
    cur = cur.next
  end
end

%    \end{macrocode}
% \end{macro}
%
% The callbacks are registered in this order: the font substitution, which
% \pkg{luaotfload} calls from its own handler before it shapes a list; the
% spacing, which runs on both lists; the math; and the hyphenation, which is
% the only one that runs inside the line breaker rather than around it.
% The substitution is registered only when \pkg{luaotfload} has the callback;
% without it, \texttt{process} applies the font after shaping instead.
%    \begin{macrocode}
if M.shaping then
  luatexbase.add_to_callback("pre_shaping_filter",
    M.pre_shaping, "LuaCJK.font")
end
luatexbase.add_to_callback("pre_linebreak_filter",
  M.pre_linebreak, "LuaCJK.spacing")
luatexbase.add_to_callback("hpack_filter", M.hpack, "LuaCJK.spacing")
luatexbase.add_to_callback("pre_mlist_to_hlist_filter",
  M.pre_mlist_to_hlist, "LuaCJK.math")
luatexbase.add_to_callback("hyphenate", M.hyphenate, "LuaCJK.hyphenate")
%</lua-core>
%    \end{macrocode}
%
% \subsection{Decorations}
%
% \pkg{lua-ul} draws each decoration as a pair of nodes: a leaders glue
% of width $w$ and a glue of width $-w$ that gives the space back,
% so the text does not move. Changing those numbers is enough to inset
% the decoration and to leave out the punctuation, which is why \pkg{LuaCJK}
% adjusts the box instead of drawing the decoration itself.
% \TeX\ numbers the glue subtypes, and 100 is \tn{leaders}, 101 \tn{cleaders},
% and 102 \tn{xleaders}; \pkg{lua-ul} uses the first and this package adds the
% third where a grid cell may be spread, so the pass takes all three.
%
% The emphasis dots are the exception: a pattern repeated along the span
% cannot follow the characters when the inter-character glue stretches, and
% it would dot Latin text as well, so the ink of \cs{CJKunderdot} goes into
% the text itself.  Its leaders pair carries an empty box and keeps the
% width, the stretch, and the shrink of the span, while the pass writes one
% dot behind each CJK character, centred on the advance of that character.
%
% \begin{variable}[int]
%   {LuaCJKfntef.attr, LuaCJKfntef.settings, LuaCJKfntef.dot_attr,
%   LuaCJKfntef.color_attr}
% The attribute that carries the number of a settings entry, and the entry
% itself: the inset at both ends, whether punctuation is skipped, and the
% geometry of the emphasis dots.
% A separate entry per call keeps two decorations in one paragraph apart.
% The dots carry an attribute of their own, so that a box the pass sees
% twice is not dotted twice, and the number of \pkg{luacolor}'s attribute,
% which is what colors a rule.
%    \begin{macrocode}
%<*lua-fntef>
LuaCJKfntef = LuaCJKfntef or {}

local M        = LuaCJKfntef
local GLYPH    = node.id("glyph")
local GLUE     = node.id("glue")
local LEADERS  = 100
local CLEADERS = 101
local XLEADERS = 102
local KERN     = node.id("kern")
local HLIST    = node.id("hlist")
local RULE     = node.id("rule")
local WHATSIT  = node.id("whatsit")

M.attr       = M.attr     or nil
M.settings   = M.settings or {}
M.next_id    = M.next_id  or 1
M.dot_attr   = M.dot_attr or luatexbase.new_attribute("LuaCJKfntef.dot")
M.color_attr = luatexbase.attributes
  and luatexbase.attributes["LuaCol@Attribute"]

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{LuaCJKfntef.em_descent}
% The descent of the em box of the current font, in scaled points.
% A CJK em box is one em square, so its descent is both what a highlight has
% to add below the baseline to cover a character, and what separates the ink
% from the bottom of that square.
%
% The value comes from \texttt{ascent}, \texttt{descent} and
% \texttt{units_per_em} of the font file, cached per file name: opening a CJK
% font costs about half a second, and one file serves every size.
%    \begin{macrocode}
local em_metrics = {}

local function font_em (filename)
  local m = em_metrics[filename]
  if m ~= nil then
    return m or nil
  end
  local ok, t = pcall(fontloader.open, filename)
  if ok and t and t.units_per_em and t.units_per_em > 0 and t.descent then
    m = { descent = t.descent, upem = t.units_per_em }
    fontloader.close(t)
  else
    m = false
  end
  em_metrics[filename] = m
  return m or nil
end

function M.em_descent (id)
  local f = tonumber(id)
  f = f and f > 0 and font.getfont(f) or nil
  local size = f and f.size or tex.sp("1em")
  local m = f and f.filename and font_em(f.filename)
  local sp
  if m then
    sp = math.floor(m.descent / m.upem * size + 0.5)
  else
    sp = math.floor(0.12 * size + 0.5)
  end
  return string.format("%d", sp)
end

%    \end{macrocode}
% \end{macro}
%
% A decoration records its settings by selecting an entry:
% the number of the entry goes into the attribute on the decorated text, and
% attribute zero means that the text carries no decoration of this package.
%
% \begin{macro}[int]{LuaCJKfntef.new_settings}
% Register one entry and select it.
% The entry carries the dots of \cs{CJKunderdot} when the command gave no
% symbol: the side of one dot, the distance from the baseline to its top,
% and the color attribute of \keys{format}, zero when the dots follow the
% color of their text.
%    \begin{macrocode}
function M.new_settings (subtract, skip, hidden, dots, size, top, color)
  local id       = M.next_id
  M.next_id      = id + 1
  if dots then
    dots = { size = size or 0, top = top or 0, color = color or 0 }
  else
    dots = nil
  end
  M.settings[id] = { subtract = subtract, skip = skip, hidden = hidden,
                     dots = dots }
  if M.attr then
    tex.setattribute(M.attr, id)
  end
end
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{kind}
% The punctuation group of a character, as the core module classifies it.
%    \begin{macrocode}
local function kind (c)
  local class = LuaCJK.punct_class
  if class then
    return class(c)
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{node_width}
% The horizontal extent of a node, whether it stores it as a width or as a
% kern: a \texttt{kern} node has no |width| field in \LuaTeX, and reading a
% nil where a dimension belongs put every later interval in the wrong place.
%    \begin{macrocode}
local function node_width (n)
  if n.id == KERN then
    return n.kern or 0
  end
  return n.width or 0
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{segments}
% The intervals of a span of width \meta{w} that the decoration may cover:
% the first and the last \meta{inset} are taken off, and with
% \meta{skip-punct} every punctuation mark inside is cut out as well.
% A cut is clamped to the span,
% so a mark that straddles the end keeps the part that fits.
%    \begin{macrocode}
local function segments (w, start, inset, skip_punct)
  local cuts = {}
  if skip_punct then
    local x = 0
    local g = start
    while g and x < w do
      local width = node_width(g)
      if g.id == GLYPH and kind(g.char) then
        cuts[#cuts + 1] = { x, math.min(x + width, w) }
      end
      x = x + width
      g = g.next
    end
  end
  local result = {}
  local low    = math.min(inset, w)
  local high   = math.max(w - inset, low)
  for _, cut in ipairs(cuts) do
    if cut[1] > low then
      result[#result + 1] = { low, math.min(cut[1], high) }
    end
    low = math.max(low, cut[2])
  end
  if low < high then
    result[#result + 1] = { low, high }
  end
  return result
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{settings_at}
% The settings of the decoration whose leaders pair ends just
% before \meta{node}: the number is read from that node,
% because the pair itself is inserted before the marked text.
%    \begin{macrocode}
local function settings_at (node_)
  if not node_ or not M.attr then
    return nil
  end
  local id = node.has_attribute(node_, M.attr)
  if not id or id == 0 then
    return nil
  end
  return M.settings[id]
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{single_rule}
% The rule that a decoration box reduces to, and how far the box moves it
% down. A box holding nothing but kerns, glues and one rule qualifies.
% \tn{leaders} repeats the box, and only whole copies fit, so the last
% fraction of the span stays empty: with a one-point object that is a
% visible gap at the right end of a highlight. A box that reduces to one
% rule is therefore drawn as a single rule of the full width instead.
%    \begin{macrocode}
local function single_rule (list, down)
  local found
  local n = list
  while n do
    if n.id == RULE then
      if found then
        return nil
      end
      found = n
    elseif n.id == HLIST then
      if found then
        return nil
      end
      local r, d = single_rule(n.head, down + (n.shift or 0))
      if not r then
        return nil
      end
      found, down = r, d
    elseif n.id == KERN then
      -- horizontal material, no vertical effect
    elseif n.id == GLUE and not n.leader then
      -- a plain glue between the pieces
    else
      return nil
    end
    n = n.next
  end
  if found then
    return found, down
  end
  return nil
end

local function box_rule (box)
  if not box or box.id ~= HLIST then
    return nil
  end
  local rule, down = single_rule(box.head, box.shift or 0)
  -- Only a solid block qualifies: the rule must fill the box, or the
  -- pattern would lose whatever sits beside it.
  if rule and rule.width == box.width then
    return rule, down
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{copy_attributes}
% Copy every attribute of one node onto another.
% The ink of a leaders box takes the attributes of the glue, not of the box
% it repeats, so a piece whose rule carries a color of its own would lose it.
%    \begin{macrocode}
local function copy_attributes (target, source)
  local a = source.attr
  while a do
    node.set_attribute(target, a.number, a.value)
    a = a.next
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{hide_text}
% Take the ink out of a decorated span and keep its dimensions.
% Every glyph becomes a kern of the same width, so the text still occupies the
% same space and the line breaks of the paragraph are the ones TeX found
% before the pass ran; one rule of no width carries the height and the depth,
% because a kern has neither.  The span is the text the leaders pair covers,
% so the walk stops at the width of that pair.
%    \begin{macrocode}
local function hide_text (start, w)
  local x, height, depth = 0, 0, 0
  local prev = nil
  local n    = start
  while n and x < w do
    local nxt = n.next
    local width = node_width(n)
    if n.id == GLYPH then
      height = math.max(height, n.height or 0)
      depth  = math.max(depth,  n.depth  or 0)
      local k = node.new("kern")
      k.kern  = width
      copy_attributes(k, n)
      k.next  = nxt
      if prev then
        prev.next = k
      else
        start = k
      end
      node.free(n)
      prev = k
    else
      if n.id == HLIST then
        height = math.max(height, n.height or 0)
        depth  = math.max(depth,  n.depth  or 0)
        n.head = hide_text(n.head, n.width)
      end
      prev = n
    end
    x = x + width
    n = nxt
  end
  if height ~= 0 or depth ~= 0 then
    local r = node.new("rule")
    r.width, r.height, r.depth = 0, height, depth
    if prev then
      r.next    = prev.next
      prev.next = r
    else
      r.next = start
      start  = r
    end
  end
  return start
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{dot_box}
% One emphasis dot, written into the text after the character it belongs to.
% The box takes no space and adds neither height nor depth, so the decorated
% text keeps its width and the line keeps its leading; the dot is centred on
% the advance of the character by a kern of half of it, and the inner box
% carries the ink at the depth of the call.  The attributes travel from the
% character, so a dot takes the color of its text, and \keys{format} replaces
% the color attribute with the value the \TeX{} side resolved.  The dot
% itself is marked, so that a box the pass sees twice is not dotted twice.
%    \begin{macrocode}
local function dot_box (glyph, dots)
  local outer = node.new("hlist")
  outer.width, outer.height, outer.depth = 0, 0, 0
  outer.dir = "TLT"
  local kern = node.new("kern")
  kern.kern  = -math.floor(((glyph.width or 0) + dots.size) / 2 + 0.5)
  local box = node.new("hlist")
  box.width, box.height, box.depth = dots.size, dots.size, 0
  box.shift = dots.top
  box.dir   = "TLT"
  local rule = node.new("rule")
  rule.width, rule.height, rule.depth = dots.size, dots.size, 0
  copy_attributes(kern, glyph)
  copy_attributes(box, glyph)
  copy_attributes(outer, glyph)
  copy_attributes(rule, glyph)
  if dots.color > 0 and M.color_attr then
    node.set_attribute(rule, M.color_attr, dots.color)
  end
  node.set_attribute(outer, M.dot_attr, 1)
  box.head   = rule
  kern.next  = box
  outer.head = kern
  return outer
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{insert_dots}
% Write one dot under each CJK character of the span of a leaders pair.
% The walk stops at the width of the pair, and an inner box of the text is
% walked with the interval of its own, so a character inside a box is dotted
% as well.  A dot goes where the centre of its character lies inside the
% span that \keys{subtract} leaves, and \keys{skip} leaves the punctuation
% marks undotted.  A character that already carries a dot behind it is passed
% over, because the pass also runs when a box is packed a second time.
%    \begin{macrocode}
local function insert_dots (start, w, settings, dots, offset)
  offset = offset or 0
  local subtract = settings.subtract or 0
  local low      = math.min(subtract, w)
  local high     = math.max(w - subtract, low)
  local x        = 0
  local n        = start
  while n and x < w do
    local nxt   = n.next
    local width = node_width(n)
    if n.id == GLYPH and width > 0
       and LuaCJK.is_cjk(n.char, LuaCJK.settings_of(n), n.font) then
      local centre = offset + x + width / 2
      local dotted = nxt and nxt.id == HLIST
                     and node.has_attribute(nxt, M.dot_attr) ~= nil
      if centre >= low and centre <= high and not dotted
         and not (settings.skip and kind(n.char)) then
        local dot = dot_box(n, dots)
        dot.next = nxt
        n.next   = dot
      end
    elseif n.id == HLIST then
      insert_dots(n.head, n.width or 0, settings, dots, offset + x)
    end
    x = x + width
    n = nxt
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{replace_pair}
% Replace the leaders glue of one decoration.
% The replacement covers the same span, with the same natural width,
% stretch, and shrink, in the same orders: the pieces are leaders of the
% intervals that \texttt{segments} allows, with their share of the dimensions
% of the pair, and kerns where a mark is cut out or the span is shortened.
% The last piece takes the remainder, so the sums are exact, and the negative
% glue that follows the leaders is kept as the tail.
%
% A pair whose leader box reduces to one solid rule gets a leader box of zero
% width instead: \TeX\ fills such a rule to the whole width of the glue, so the
% rule covers the interval exactly and grows with the glue, where a repeated
% rule box would leave the last fraction of the interval empty.
%    \begin{macrocode}
local function replace_pair (head, prev, leaders, settings)
  local w     = leaders.width
  local neg   = leaders.next
  local subtract = settings and settings.subtract or 0
  local skip     = settings and settings.skip or false
  local parts = segments(w, neg.next, subtract, skip)
  if settings and settings.hidden then
    neg.next = hide_text(neg.next, w)
  end
  local rule, down = box_rule(leaders.leader)
  local block
  if rule then
    block = node.copy(rule)
    block.width  = 0
    block.height = rule.height - down
    block.depth  = rule.depth + down
    block.next   = nil
  end
  local covered = {}
  for _, part in ipairs(parts) do
    if part[2] > part[1] then
      covered[#covered + 1] = part
    end
  end
  local stretch = leaders.stretch or 0
  local shrink  = leaders.shrink or 0
  local given_st, given_sh = 0, 0
  local first, last
  local cursor = 0
  local function append (node_)
    if last then
      last.next = node_
    else
      first = node_
    end
    last = node_
  end
  local function gap (to)
    if to > cursor then
      local k = node.new("kern")
      k.kern  = to - cursor
      append(k)
      cursor = to
    end
  end
  for i, part in ipairs(covered) do
    gap(part[1])
    local piece    = node.copy(leaders)
    piece.width    = part[2] - part[1]
    piece.next     = nil
    if i < #covered then
      piece.stretch  = math.floor(stretch * piece.width / w + 0.5)
      piece.shrink   = math.floor(shrink  * piece.width / w + 0.5)
      given_st = given_st + piece.stretch
      given_sh = given_sh + piece.shrink
    else
      piece.stretch  = stretch - given_st
      piece.shrink   = shrink - given_sh
    end
    if block then
      piece.leader = node.copy(block)
      copy_attributes(piece, piece.leader)
    end
    append(piece)
    cursor = part[2]
  end
  gap(w)
  if #covered == 0 then
    -- Every interval was cut away, so the pair keeps its dimensions in one
    -- glue of no width, or the line would lose the stretch it had.
    local g = node.new("glue")
    g.width, g.stretch, g.shrink = 0, stretch, shrink
    g.stretch_order, g.shrink_order =
      leaders.stretch_order or 0, leaders.shrink_order or 0
    append(g)
  end
  if first then
    if prev then
      prev.next = first
    else
      head = first
    end
    last.next = neg
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{adjust}
% Walk a horizontal list and rewrite every leaders pair whose following node
% carries a settings entry.
% A pair of the emphasis dots keeps the nodes \pkg{lua-ul} made, because its
% leader box is empty and there is no pattern to place; what the pass adds is
% the ink, one dot behind each CJK character of the span.
%    \begin{macrocode}
local function adjust (head)
  if not M.attr then
    return head
  end
  local prev = nil
  local n    = head
  while n do
    local nxt = n.next
    if n.id == GLUE
       and (n.subtype == LEADERS or n.subtype == CLEADERS
            or n.subtype == XLEADERS)
       and n.next
       and n.next.id == GLUE and n.next.width == -n.width then
      local neg      = n.next
      local settings = settings_at(neg.next)
      if settings and settings.dots then
        insert_dots(neg.next, n.width, settings, settings.dots, 0)
        if settings.hidden then
          neg.next = hide_text(neg.next, n.width)
        end
        n    = neg
        nxt  = neg.next
      elseif settings or box_rule(n.leader) then
        head = replace_pair(head, prev, n, settings)
        n    = neg
        nxt  = neg.next
      end
    end
    prev = n
    n    = nxt
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{glue_width}
% The width a glue node actually has in a packed box.
% The node keeps its natural width, and the box records how much of the glue's
% stretch or shrink was used: \texttt{glue\_set} is the fraction, and
% \texttt{glue\_sign} says whether it is applied to the stretch (1) or to the
% shrink (2), against the glue whose order is \texttt{glue\_order}. This is the
% only place where the final width of a decoration is available, since it is
% fixed when the line is packed.
%    \begin{macrocode}
local function glue_width (box, g)
  local w    = g.width or 0
  local set  = box.glue_set or 0
  local sign = box.glue_sign or 0
  local order = box.glue_order or 0
  if sign == 1 and (g.stretch_order or 0) == order then
    w = w + math.floor(set * (g.stretch or 0) + 0.5)
  elseif sign == 2 and (g.shrink_order or 0) == order then
    w = w - math.floor(set * (g.shrink or 0) + 0.5)
  end
  return w
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{drawn}
% Whether a leader box holds a drawing rather than ink of its own.
% A drawing reaches the page as PDF literals, so the box holds whatsits and no
% glyph and no rule; the dots and the symbols hold a rule or a glyph, and a
% symbol wrapped in an \texttt{ActualText} sequence holds both.
%    \begin{macrocode}
local function drawn (box)
  if not box or box.id ~= HLIST then
    return false
  end
  local literal, ink = false, false
  local n = box.head
  while n do
    if n.id == GLYPH or n.id == RULE then
      ink = true
    elseif n.id == WHATSIT then
      literal = true
    elseif n.id == HLIST then
      local l, i = drawn(n)
      literal = literal or l
      ink     = ink or i
    end
    n = n.next
  end
  return literal, ink
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{literal}
% One PDF literal, placed at the current point: the mode \texttt{0} the backend
% wraps in a translation, which is the mode \pkg{l3draw} uses for its own
% operations.
%    \begin{macrocode}
local function literal (data)
  local n = node.new("whatsit", node.subtype("pdf_literal"))
  n.data  = data
  n.mode  = 0
  return n
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{scale_ink}
% Make the period of a copy equal to the width of its slot.
% A leader box is one period wide, and the slot the append callback divides the
% piece into is almost never the same width: the two differ by the remainder
% divided by the number of copies, which is a hundredth of a point or less, but
% it is still a phase shift between two copies and shows as a hairline gap or a
% thin doubling in the drawing. The ink of the copy is therefore painted inside
% a scope that scales it horizontally by \meta{width} divided by the period: the
% path then ends exactly where the next copy's begins, and its period is the
% slot's. The stroke keeps its thickness, because only the horizontal axis is
% scaled; the pen's horizontal extent changes by the same fraction.
%    \begin{macrocode}
local function scale_ink (box, scale, advance)
  if not box or box.id ~= HLIST or not box.head then
    return
  end
  if math.abs(scale - 1) < 0.0000005 then
    return
  end
  local q = literal("q " .. string.format("%.6f", scale) .. " 0 0 1 0 0 cm")
  local z = literal("Q 1 0 0 1 " .. string.format("%.6f", advance) .. " 0 cm")
  q.next = box.head
  local last = q
  while last.next do
    last = last.next
  end
  last.next  = z
  box.head   = q
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{tile}
% Write the copies of a drawn decoration into the piece it covers.
% The append callback is the one place where the width of the piece is
% final, so there it is divided into the nearest whole number of patterns and
% the piece is rebuilt from copies of the leader box, each as wide as that
% division: the copies are adjacent, the pattern reaches both ends of the span,
% and its period follows the stretch of the line. The width is rounded down, so
% that the remainder is a few scaled points at most and is left as a kern, and
% the ink of a copy is scaled to the width it is given, so that one copy's path
% ends exactly where the next one's begins: the period of the drawing is one
% em, and the width the piece is divided into is almost never the same.
%
% The copies are written here rather than repeated by \tn{leaders}, because the
% copies of a leader glue are not laid out from its left edge: a span that is
% not a whole number of patterns loses one at one end, which is what a
% decoration showed whose span ended in the middle of a stretched line.
% \tn{xleaders} cannot spread the pattern either, because the glue it puts
% between two copies separates two butt caps.
%
% A copy also loses the record of the drawing's origin, which \pkg{l3draw} puts
% in front of every drawing: it is a box of no width that holds nothing but
% whatsits, and a label that every copy records is multiply defined.
%    \begin{macrocode}
local function only_whatsits (head)
  local n = head
  while n do
    if n.id ~= WHATSIT then
      return false
    end
    n = n.next
  end
  return true
end

local function strip_record (head)
  local n = head
  while n do
    local nxt = n.next
    if n.id == HLIST then
      if (n.width or 0) == 0 and n.head and n.head.id == WHATSIT
         and only_whatsits(n.head) then
        head = node.remove(head, n)
      else
        n.head = strip_record(n.head)
      end
    end
    n = nxt
  end
  return head
end

local function tile (box)
  local prev = nil
  local n    = box.head
  while n do
    local nxt = n.next
    if n.id == GLUE and n.subtype == LEADERS and n.leader then
      local literal, ink = drawn(n.leader)
      if literal and not ink then
        local w      = glue_width(box, n)
        local period = n.leader.width
        if period > 0 and w >= period then
          local k     = math.floor(w / period + 0.5)
          local width = math.floor(w / k)
          local first, last
          for _ = 1, k do
            local copy = node.copy(n.leader)
            copy.head  = strip_record(node.copy_list(n.leader.head))
            copy.width = width
            scale_ink(copy, width / period, period / 65536 * 72 / 72.27)
            copy_attributes(copy, n)
            copy.next = nil
            if last then
              last.next = copy
            else
              first = copy
            end
            last = copy
          end
          local rest = w - k * width
          if rest > 0 then
            local tail = node.new("kern")
            tail.kern  = rest
            last.next  = tail
            last       = tail
          end
          last.next = nxt
          if prev then
            prev.next = first
          else
            box.head  = first
          end
          n = last
        end
      end
    end
    prev = n
    n    = nxt
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{LuaCJKfntef.hpack}
% The box-packing callback. The pass also runs before a box is appended
% to a vertical list, because a box built earlier is not packed again;
% that is where a decoration is divided into whole patterns.
%    \begin{macrocode}
function M.hpack (head)
  return adjust(head)
end

luatexbase.add_to_callback("hpack_filter", M.hpack, "LuaCJKfntef.adjust")
luatexbase.add_to_callback("pre_append_to_vlist_filter",
  function (box)
    if box.id == node.id("hlist") then
      box.head = adjust(box.head)
      tile(box)
    end
    return box
  end, "LuaCJKfntef.adjust")
%</lua-fntef>
%    \end{macrocode}
% \end{macro}
%
% The \pkg*{LuaCJKfntef} package is a thin layer over \pkg{lua-ul},

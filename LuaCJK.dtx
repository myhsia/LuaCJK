% \begin{macro}[int]{\@@_fntef_decoration_setup:n}
% \changes{v0.0.1}{2026/11/11}{Every decoration takes the same key set:
%   \keys{color}, \keys{gap}, \keys{height}, \keys{symbol}, \keys{sep},
%   \keys{textformat}, and \keys{hidden}, which keeps the dimensions of the
%   text and draws no glyph. A bare color name is accepted, so |[red]| and
%   |[subtract]| both work, and a key that a command does not use is ignored.
%   Every decoration accepts \keys{selectable}, \texttt{false} by default: a
%   decoration symbol is then wrapped in an \texttt{ActualText} sequence that
%   readers drop from the text they copy or select. Every decoration also
%   accepts \keys{subtract} (inset at both ends) and \keys{skip} (leave out
%   the punctuation). \cs{CJKsout} strikes at \texttt{height = 0.3em}, through
%   the middle of a CJK glyph; \texttt{0.5ex} gives the Latin position.}
% The settings that the decoration pass reads.
% They are pushed on every call, so a command without options starts
% from the defaults instead of inheriting the previous call.
%    \begin{macrocode}
\keys_define:nn { LuaCJKfntef / decoration }
  {
    subtract  .code:n             =
      {
        \str_if_eq:nnTF {#1} { true }
          { \dim_set:Nn \l_@@_fntef_subtract_dim { .5em } }
          {
            \str_if_eq:nnTF {#1} { false }
              { \dim_zero:N \l_@@_fntef_subtract_dim }
              { \dim_set:Nn \l_@@_fntef_subtract_dim {#1} }
          }
      },
    subtract  .default:n          = { true },
    skip      .code:n             =
      {
        \str_if_eq:nnTF {#1} { true }
          { \tl_set:Nn \l_@@_fntef_skip_tl { 1 } }
          { \tl_set:Nn \l_@@_fntef_skip_tl { 0 } }
      },
    skip      .default:n          = { true },
    hidden    .bool_set:N         = \l_@@_fntef_hidden_bool,
    hidden    .default:n          = { true },
    selectable.bool_set_inverse:N = \l_@@_fntef_silent_bool,
    selectable.default:n          = { true },
    depth     .dim_set:N          = \l_@@_fntef_depth_dim,
    depth     .value_required:n   = true,
    thickness .dim_set:N          = \l_@@_fntef_thickness_dim,
    thickness .value_required:n   = true,
    gap       .dim_set:N          = \l_@@_fntef_gap_dim,
    gap       .value_required:n   = true,
    height    .dim_set:N          = \l_@@_fntef_height_dim,
    height    .value_required:n   = true,
    format    .tl_set:N           = \l_@@_fntef_format_tl,
    color     .tl_set:N           = \l_@@_fntef_format_tl,
    color     .value_required:n   = true,
    symbol    .tl_set:N           = \l_@@_fntef_symbol_tl,
    sep       .dim_set:N          = \l_@@_fntef_symbol_sep_dim,
    sep       .value_required:n   = true,
    textformat.tl_set:N           = \l_@@_fntef_textformat_tl,
    unknown   .code:n             =
      {
        \tl_put_right:Nx \l_@@_fntef_pass_tl
          {
            \l_keys_key_str
            \tl_if_empty:NF \l_keys_value_tl
              { = \exp_not:V \l_keys_value_tl }
            ,
          }
      },
  }
\cs_new_protected:Npn \@@_fntef_reset_decoration:
  {
    \dim_zero:N \l_@@_fntef_subtract_dim
    \tl_set:Nn \l_@@_fntef_skip_tl { 0 }
    \bool_set_true:N \l_@@_fntef_silent_bool
    \bool_set_false:N \l_@@_fntef_hidden_bool
    \dim_set:Nn \l_@@_fntef_depth_dim     { .2em }
    \dim_set:Nn \l_@@_fntef_thickness_dim { .4pt }
    \dim_set:Nn \l_@@_fntef_gap_dim       { 1.1pt }
    \dim_set:Nn \l_@@_fntef_height_dim    { .3em }
    \clist_map_inline:nn { format, symbol, textformat, pass }
      { \tl_clear:c { l_@@_fntef_##1_tl } }
    \dim_set:Nn \l_@@_fntef_symbol_sep_dim { .1em }
  }
\cs_new_protected:Npn \@@_fntef_decoration_setup:n #1
  {
    \@@_fntef_options:n {#1}
    \@@_fntef_push_settings:
  }

% \begin{macro}[int]{\@@_switch_family:n}
% \changes{v0.0.1}{2026/11/05}{Warn only once for an unknown CJK family.}
% Select a registered family and warn once about an unknown name.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_switch_family:n #1
  {
    \prop_if_in:NnTF \g_@@_family_prop {#1}
      {
        \tl_set:Nn \l_@@_family_tl {#1}
        \selectfont
      }
      {
        \seq_if_in:NnF \g_@@_unknown_family_seq {#1}
          {
            \seq_gput_right:Nn \g_@@_unknown_family_seq {#1}
            \msg_warning:nnn { LuaCJK } { family-unknown } {#1}
          }
      }
  }
\seq_new:N \g_@@_unknown_family_seq
\msg_new:nnn { LuaCJK } { family-unknown }
  { Unknown~CJK~family~`#1'~is~being~ignored. }
%    \end{macrocode}
% \end{macro}

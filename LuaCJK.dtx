% \maketitle
%
% \begin{abstract}
%   \pkg{LuaCJK} provides Chinese typesetting for \LuaLaTeX.
%   It records the current CJK font in a \LuaTeX\ attribute
%   and replaces CJK glyph nodes before line breaking and box packing.
% \end{abstract}
%
% \tableofcontents
%
% \begin{documentation}
%
% \section{Introduction}
%
% \pkg{LuaCJK} is a \LuaTeX-only package for Chinese typesetting. Its main
% interface is \cs{setCJKmainfont}, \cs{setCJKsansfont}, \cs{setCJKmonofont},
% \cs{setCJKfamilyfont}, \cs{CJKfamily}, and \cs{LuaCJKsetup}.
%
% The current CJK font is recorded in a \LuaTeX\ attribute,
% and CJK glyph nodes are replaced before line breaking and box packing.
%
% \section{Loading}
%
% \begin{quote}
%   \cs{usepackage}\oarg{options}"{LuaCJK}"
% \end{quote}
%
% LuaCJK requires \LuaLaTeX. It conflicts with \pkg{luatexja}:
% loading either package before or after the other raises an error.
%
% \begin{function}{\LuaCJKversion}
%   Print the version of LuaCJK.
% \end{function}
%
% \begin{function}{\LuaCJKsetup}
%   \begin{syntax}
%     \tn{LuaCJKsetup} \marg{key-value list}
%   \end{syntax}
%   Configure LuaCJK.
%   The keys are the ones documented in the following sections.
% \end{function}
%
% The keys fall into two groups.
%
% The settings that describe how text is set are local to the current group,
% and they are recorded on the characters themselves,
% so text inside a group keeps its settings even when the group has already
% ended by the time the paragraph is broken:
% \begin{quote}
%   |\vbox{\begingroup\LuaCJKsetup{CJKglue=10pt}中中\endgroup\par}|
% \end{quote}
% uses the 10pt glue, although the group is closed before |\par|.
% This group contains
% \begin{itemize}
%   \item \keys{CJKglue, CJKecglue, CJKspace}, and \keys{xCJKecglue};
%   \item \keys{PunctStyle, PunctKinsoku, AllowBreakBetweenPuncts, PunctWidth},
%   and \keys{PunctBoundWidth};
%   \item \keys{LatinPunct} and \keys{CJKmath};
%   \item \keys{CheckSingle, WidowPenalty}, and \keys{CJLineBreak};
%   \item \keys{AutoFallBack} and \keys{Verb};
%   \item the two commands \cs{LuaCJKCancelSubCJKBlock} and
%   \cs{LuaCJKRestoreSubCJKBlock}.
% \end{itemize}
%
% The other keys are global or act while the package is loaded:
% \begin{itemize}
%   \item \keys{KaiMingPunct, MiddlePunct, LongPunct},
%   and \keys{NoBreakLongPunct} edit character sets;
%   \item \keys{AutoFakeBold, AutoFakeSlant, EmboldenFactor},
%   and \keys{SlantFactor} act when a family is registered;
%   \item \keys{LoadFandol} and \keys{LocalConfig} act while the package
%   is loaded.
% \end{itemize}
% The declarations \cs{LuaCJKDeclareCharClass},
% \cs{LuaCJKDeclarePunctClass}, \cs{LuaCJKDeclareSubCJKBlock},
% \cs{LuaCJKsetwidth}, and \cs{LuaCJKsetkern} are global as well,
% as noted with each of them.
%
% The same keys may be given as package options:
% \begin{quote}
%   |\usepackage[PunctStyle = banjiao]{LuaCJK}|
% \end{quote}
%
% \begin{keyval}
%   \item[\keys{LocalConfig}]\val{\TTF, name}
%   Read local settings from a configuration file.
%   \texttt{true} loads \file{luacjk.cfg},
%   \meta{name} loads \file{luacjk-}\meta{name}\file{.cfg},
%   and \texttt{false} (the initial value) loads nothing.
%   The file is read at the end of the package, so it may use every
%   command LuaCJK defines. A missing file only warns.
% \end{keyval}
%
% To use LuaCJK with \pkg{ctex}, run \cs{LuaCJKwriteCtexConfig} once
% in a plain document; it writes \file{ctexopts.cfg}, and every \pkg{ctex}
% document in that directory or below it then uses LuaCJK, while \XeLaTeX\
% documents keep their own backend. Writing the file by hand works as well.
%
% \begin{function}{\LuaCJKwriteCtexConfig}
%   \begin{syntax}
%     \tn{LuaCJKwriteCtexConfig} \oarg{directory}
%   \end{syntax}
%   Write the redirect into \meta{directory}, the current directory by
%   default. An existing file is left alone; the starred form overwrites it.
%   The class then finds the \cs{ctex_...} commands it calls, \cs{ccwd},
%   and the |punct| option.
% \end{function}
%
% \section{Fonts}
%
% The main font commands take an optional list of \pkg{fontspec} options.
% Options may be written before or after the font name.
%
% \begin{function}{\setCJKmainfont,\setCJKsansfont,\setCJKmonofont}
%   \begin{syntax}
%     \tn{setCJKmainfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Set the CJK font for the roman, sans serif, and monospaced families.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKfamily{zhsong}中文宋体\quad
\CJKfamily{zhhei}中文黑体\\
\CJKfamily{zhkai}中文楷体\quad
\CJKfamily{zhfs}中文仿宋
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\setCJKfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfamilyfont}\marg{family}\oarg{options}\marg{font}\oarg{options}
%   \end{syntax}
%   Define a named CJK family.
% \end{function}
%
% \begin{function}{\CJKfamily}
%   \begin{syntax}
%     \tn{CJKfamily} \marg{family}
%   \end{syntax}
%   Switch to a named CJK family.
% \end{function}
%
% \begin{function}{\newCJKfontfamily}
%   \begin{syntax}
%     \tn{newCJKfontfamily}\oarg{family}\meta{command}\oarg{options}\marg{font}
%   \end{syntax}
%   Define a command that switches to a newly declared family.
%   The command is local to the current group, like \cs{newfontfamily}.
% \end{function}
%
% \begin{function}{\CJKfontspec}
%   \begin{syntax}
%     \tn{CJKfontspec} \oarg{options} \marg{font}
%   \end{syntax}
%   Select a CJK font for the current group.
% \end{function}
%
% \begin{function}{\songti, \heiti, \fangsong, \kaishu, \lishu, \youyuan}
%   Shortcuts for the families named \texttt{zhsong}, \texttt{zhhei},
%   \texttt{zhfs}, \texttt{zhkai}, \texttt{zhli}, and \texttt{zhyou}.
% \end{function}
%
% \begin{variable}
%   {\CJKrmdefault, \CJKsfdefault, \CJKttdefault,
%   \CJKfamilydefault} The CJK families selected by \tn{rmfamily},
%   \tn{sffamily}, and \tn{ttfamily}.
% \end{variable}

% \subsection{Sub-blocks}
%
% One CJK font rarely covers every block of \textsc{Unicode}.
% A sub-block gives a range of characters its own font inside a family;
% the block then becomes an option of the font commands.
%
% \begin{function}{\LuaCJKDeclareSubCJKBlock}
%   \begin{syntax}
%     \tn{LuaCJKDeclareSubCJKBlock} \marg{block} \marg{range list}
%   \end{syntax}
%   Declare \meta{block} with the given ranges, in the same spelling
%   as \cs{LuaCJKDeclareCharClass}. The name becomes a font option,
%   as the example below shows: a family that sets it uses the second font
%   for the characters of the block, and a family that does not leaves them
%   in the main font. Overlapping blocks are resolved in declaration order.
% \end{function}
%
% \begin{function}{\LuaCJKCancelSubCJKBlock, \LuaCJKRestoreSubCJKBlock}
%   \begin{syntax}
%     \tn{LuaCJKCancelSubCJKBlock}  \marg{block list} \\
%     \tn{LuaCJKRestoreSubCJKBlock} \marg{block list}
%   \end{syntax}
%   Turn the listed blocks off or on again for the rest of the group.
%   Because the choice of font is recorded per font identifier,
%   two families that supply the same font share one setting:
%   the family that selected the font last decides.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKDeclareSubCJKBlock{Kana}{3040 -> 30FF}
\setCJKmainfont[Kana = FandolKai-Regular.otf]
  {FandolSong-Regular.otf}中 あ
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{Fallback fonts}
%
% A CJK font rarely covers every character one needs.
% Fallback fonts are tried in the order they were declared when
% the selected CJK font has no glyph for a character.
%
% \begin{function}{\setCJKfallbackfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfallbackfamilyfont} \marg{family} \oarg{options} \\
%        \                          \marg{font}   \oarg{options}
%   \end{syntax}
%   Add \meta{font} to the fallback list of \meta{family}. The family may
%   be given as \cs{CJKrmdefault} and friends. Call the command several
%   times to build a chain; the first font that has the character wins.
% \end{function}
%
% \begin{keyval}
%   \item[\keys{AutoFallBack}]\val{\TFF}
%   Whether to use the declared fallback fonts. The switch follows the text
%   like the spacing keys, so it can be turned on for one group.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\setCJKmainfont{FandolSong-Regular.otf}
\setCJKfallbackfamilyfont{\CJKrmdefault}
  {FandolKai-Regular.otf}
\LuaCJKsetup{AutoFallBack = true}中文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{Loading Fandol}
%
% \begin{keyval}
%   \item[\keys{LoadFandol}]\val{\TTF}
%   When the document does not declare any CJK font, load the four Fandol
%   faces at \tn{begin}\{document\}: Song as the main font,
%   Hei as the sans serif font, Fang as the monospaced font,
%   and all of Song, Hei, Kai, and Fang as the named families.
% \end{keyval}
%
% \subsection{Fake bold and slant}
%
% A CJK family often has no bold or italic face. The following keys make
% LuaCJK ask \pkg{fontspec} to embolden or slant the regular face instead.
% They apply to families registered afterwards, and are not used when the
% family itself sets \texttt{BoldFont} or \texttt{ItalicFont}. They are
% global: a group does not change what an already registered family uses.
%
% \begin{keyval}
%   \item[\keys{AutoFakeBold}]\val{\TFF, number}
%   Embolden the regular face when the bold shape is requested.
%   A number also sets \texttt{EmboldenFactor}.
%   \item[\keys{AutoFakeSlant}]\val{\TFF, number}
%   Slant the regular face when the italic shape is requested.
%   A number also sets \texttt{SlantFactor}.
%   \item[\keys{EmboldenFactor}]\val{number}: The amount of emboldening.
%   The initial value is \texttt{4}.
%   \item[\keys{SlantFactor}]\val{number}: The amount of slanting, between
%   $-0.999$ and $0.999$. The initial value is \texttt{0.167}.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{AutoFakeBold = true}
\setCJKmainfont{FandolSong-Regular.otf}
\textbf{中文} and 中文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\defaultCJKfontfeatures}
%   \begin{syntax}
%     \tn{defaultCJKfontfeatures} \marg{font features}
%   \end{syntax}
%   Set the features prepended to every CJK family registered afterwards.
%   The initial value is |Script = CJK|.
%   Families registered before the call keep the features they were given.
% \end{function}
%
% \begin{function}{\addCJKfontfeatures}
%   \begin{syntax}
%     \tn{addCJKfontfeatures} \oarg{ignored} \marg{font features}
%   \end{syntax}
%   Add features to the current CJK family for the rest of the group,
%   for example |\addCJKfontfeatures{Scale = 1.2}|.
%   A leading \texttt{*} is accepted; both forms act on the same font.
% \end{function}
%
% \subsection{CJK in mathematics}
%
% \begin{keyval}
%   \item[\keys{CJKmath}]\val{\TFF}: Whether CJK characters may be typed
%   directly in math mode.
%   When it is on, such a character is typeset as a box in the CJK math font
%   instead of being looked up in the math font.
%   Enable it with |\LuaCJKsetup{CJKmath = true}| or with the package option
%   |CJKmath = true|.
%   Without it a CJK character in math mode is looked up in the math font
%   and usually disappears, so LuaCJK issues a one-time warning in that case.
% \end{keyval}
%
% \begin{function}{\setCJKmathfont}
%   \begin{syntax}
%     \tn{setCJKmathfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Select the CJK font used for characters in math mode.
%   Without this command the CJK main font is used.
%   This manual enables \keys{CJKmath} and sets this font in its preamble.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
$ x + 中文 $ and 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{Text layout}
%
% \subsection{Spacing}
%
% \begin{keyval}
%   \item[\keys{CJKglue}]\val{glue}: Glue inserted between adjacent CJK
%   characters.
%   The initial value is \texttt{0pt plus 0.08\cs{baselineskip}}, recomputed
%   at every font selection, so it follows the size; a value given
%   by the document is used as written and does not change with the size.
%   \item[\keys{CJKecglue}]\val{glue}: Glue inserted between CJK and Latin
%   characters.
%   The initial value is \texttt{0.3333em plus 0.1667em minus 0.1111em},
%   which follows the size in the same way.
%   \item[\keys{CJKspace}]\val{\TFF}: Whether to keep source spaces between
%   CJK characters.
%   \item[\keys{xCJKecglue}]\val{\TFF}: Whether to replace source spaces
%   between CJK and Latin characters with \texttt{CJKecglue}.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
中文 English 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{CJKspace = true}中 文 中 文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\normalspacedchars}
%   \begin{syntax}
%     \tn{normalspacedchars} \marg{character list}
%   \end{syntax}
%   The listed characters get no glue on either side, so that a hyphen
%   or a slash inside Latin text does not pull the surrounding text apart.
%   The initial list is |/|, |\|, and |-|. The setting is global.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
中x中\\
\normalspacedchars{x}中x中
\end{codemo}
\normalspacedchars{/,\,,-}
\endgroup
% \iffalse
%</example>
% \fi
%
% Characters that only control the text and have no advance of their own
% (U+200B, U+200C, U+200D, U+2060, U+180E, U+FEFF, and the variation
% selectors) are removed at the input. They therefore neither take glue nor
% separate two CJK characters: a zero-width space does not add the two
% \keys{CJKecglue} that would otherwise surround it, and the break
% opportunity it was meant to create already exists at the surrounding glue.
% A character requested with \tn{char} is not removed, because \tn{char}
% asks for the glyph itself.
%
% \begin{environment}{CJKfilltwosides}
%   \begin{syntax}
%   \tn{begin}\{CJKfilltwosides\}\oarg{position}\marg{width}
%   \   \meta{lines} \\
%   \tn{end}\{CJKfilltwosides\}
%   \end{syntax}
%   Set the lines in a vertical box whose lines are justified
%   to \meta{width}, separated by |\\|. Its \meta{position} argument puts
%   the box on the baseline: \texttt{t} for top, \texttt{c} for centered
%   (the default), or \texttt{b} for bottom. A width of zero or less keeps
%   the surrounding line width. The starred form behaves the same;
%   it does not compare against the natural width of the content.
% \end{environment}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begin{CJKfilltwosides}{6em}
  瞻彼阕者，\\虚室生白
\end{CJKfilltwosides}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \subsection{Punctuation}
%
% \begin{keyval}
%   \item[\keys{PunctStyle}]\val{style}: Select a punctuation style.
%   The implemented styles are \texttt{quanjiao} (the default),
%   \texttt{plain}, \texttt{banjiao}, \texttt{kaiming}, \texttt{CCT},
%   and \texttt{hangmobanjiao}.
%   An unknown name issues a warning and falls back to \texttt{plain}.
%   \item[\keys{PunctWidth}]\val{length, false}: Give
%   every punctuation mark the same advance, whatever the style says.
%   A width set with \cs{LuaCJKsetwidth} still wins for that mark.
%   \item[\keys{PunctBoundWidth}]\val{length, false}: How much of a mark's
%   advance stays inside the line when the mark ends the line;
%   the rest of the ink hangs into the margin, and the line keeps its width.
%   This replaces the fixed half-em shift of \texttt{hangmobanjiao}
%   at the end of a line, while a mark at the start of a line is still
%   shifted by the style. \texttt{false} turns the option off.
%   \item[\keys{LatinPunct}]\val{\TFF}: Treat the quotation marks
%   (U+2018, U+2019, U+201C, U+201D), the middle dot (U+00B7),
%   and the ellipses (U+2026, U+2027, U+22EF) as Latin punctuation:
%   they stay in the current Latin font and are not compressed.
%   This keeps an apostrophe inside an English word from turning into
%   a full-width form. The em dash is not affected.
%   \item[\keys{PunctFamily}]\val{family, false}: Use a
%   different CJK family for the punctuation marks.
%   The family must be declared with \cs{setCJKfamilyfont}; \texttt{false}
%   (the initial value) makes the marks follow the text again.
%   \item[\keys{AllowBreakBetweenPuncts}]\val{\TFF}: Whether two adjacent
%   punctuation marks may be separated by a line break.
%   The marks are still compressed.
%   \item[\keys{PunctKinsoku}]\val{\TTF}: Whether to apply line-breaking
%   prohibitions for punctuation.
%   A closing or middle punctuation cannot start a line, an opening punctuation
%   cannot end a line, and a run of long punctuation is kept together.
%   The prohibitions are independent of \texttt{PunctStyle},
%   so they stay active with |PunctStyle = plain|.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
字，字\\
\LuaCJKsetup{PunctFamily = zhkai}字，字
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
a’a\quad 字！字\\
\LuaCJKsetup{LatinPunct, PunctWidth = .8em}
a’a\quad 字！字
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
字字。\\
\LuaCJKsetup{PunctBoundWidth=.5em}字字。
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% The character sets that the punctuation code works with come next. Each
% of their keys has three forms: the plain one replaces the set, the form
% with \texttt{+} adds characters, and the form with \texttt{-} removes
% them. Ranges use the same spelling as \cs{LuaCJKDeclareCharClass}.
% The sets are global: a group does not bring the previous members back.
%
% \begin{keyval}
%   \item[\keys{KaiMingPunct<+->}]\val{char list}:
%   The marks that keep a full width in the \texttt{kaiming} style.
%   Initially \texttt{。}、\texttt{．}、\texttt{？}、\texttt{！}.
%   \item[\keys{MiddlePunct<+->}]\val{char list}:
%   The marks centered between the two halves of their box.
%   A middle mark cannot start a line.
%   \item[\keys{LongPunct<+->}]\val{char list}: The
%   marks that are never compressed against each other,
%   such as dashes and ellipses.
%   \item[\keys{NoBreakLongPunct<+->}]
%   \val{char list}: The long marks that must not be separated by a line
%   break. Initially the same as \texttt{LongPunct}.
% \end{keyval}
%
% \begin{function}{\LuaCJKDeclareCharClass}
%   \begin{syntax}
%     \tn{LuaCJKDeclareCharClass} \marg{class} \marg{range list}
%   \end{syntax}
%   Override the class of a code-point range.
%   Ranges are written in hexadecimal with a leading |"|,
%   and |"START -> "END| gives a range; the list is comma separated.
%
%   The classes are: \texttt{CJK} and \texttt{Default} make the range
%   behave like CJK or Latin text;
%   \texttt{FullLeft} and \texttt{HalfLeft} treat it as an opening mark,
%   \texttt{FullRight} and \texttt{HalfRight} as a closing mark,
%   so the line-breaking prohibitions apply;
%   \texttt{NormalSpace} takes the range out of the CJK/Latin glue,
%   like \cs{normalspacedchars}; \texttt{CJStarter}, \texttt{CM},
%   and \texttt{Boundary} are treated as \texttt{CJK},
%   because \LuaTeX\ has no model of combining marks or run boundaries.
% \end{function}
%
% \begin{function}{\LuaCJKDeclarePunctClass}
%   \begin{syntax}
%     \tn{LuaCJKDeclarePunctClass} \marg{group} \marg{range list}
%   \end{syntax}
%   Override the punctuation group of a range. The groups
%   are \texttt{open}, \texttt{close}, \texttt{middle}, \texttt{dash},
%   and \texttt{ellipsis}; \texttt{none} removes the punctuation
%   treatment, so the characters are no longer compressed or hung.
% \end{function}
%
% \begin{function}{\LuaCJKResetCharClass}
%   Drop every class and punctuation override declared so far,
%   and put the normal-spaced set back to the characters
%   of \cs{normalspacedchars}.
% \end{function}
%
% \begin{function}{\LuaCJKEditPunctStyle}
%   \begin{syntax}
%     \tn{LuaCJKEditPunctStyle} \marg{style} \marg{key-value list}
%   \end{syntax}
%   Change the parameters of an existing style.
%   The keys are \keys{compress-adjacent, adjacent-ratio, keep-open-close};
%   a key that is not given keeps its value.
% \end{function}
%
% \begin{function}{\LuaCJKsetwidth}
%   \begin{syntax}
%     \tn{LuaCJKsetwidth} \marg{punctuation list} \marg{length}
%   \end{syntax}
%   Give the listed punctuation marks a fixed advance,
%   overriding the selected \keys{PunctStyle} and \keys{PunctWidth}.
%   The setting is global: a group does not restore the previous width,
%   and a later call adds to the table rather than replacing it.
%   A leading \texttt{*} is accepted; the width it would set at the start
%   or end of a line is not implemented, and the star warns once.
% \end{function}
%
% \begin{function}{\LuaCJKsetkern}
%   \begin{syntax}
%     \tn{LuaCJKsetkern} \marg{before} \marg{after} \marg{length}
%   \end{syntax}
%   Set the gap between two adjacent punctuation marks, overriding
%   the style. Only the first character of each argument is used.
%   Like \cs{LuaCJKsetwidth}, the setting is global.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetwidth{「}{1.5em}字「字\\
\LuaCJKsetkern{「}{」}{.3em}字「」字
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKDeclarePunctStyle}
%   \begin{syntax}
%     \tn{LuaCJKDeclarePunctStyle} \marg{name} \marg{key-value list}
%   \end{syntax}
%   Define a punctuation style.
%   The available keys are \keys{compress-adjacent},
%   \keys{adjacent-ratio}, and \keys{keep-open-close}.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
字，，字
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \subsection{Line breaking}
%
% A run of dashes or ellipses (U+2013, U+2014, U+2015, U+FF0D, U+2026,
% and U+22EF) is one unit: the marks are joined without glue, so
% justification cannot pull a two-em dash apart, and no break is offered
% between them. The key \keys{LongPunct} replaces the set.
%
% \begin{keyval}
%   \item[\keys{CheckSingle}]\val{\TFF}
%   When on, the last two break points of a paragraph whose final character
%   is CJK are made unbreakable, so a single character cannot end up alone
%   on the last line. The initial value is \meta{false}.
%   \item[\keys{WidowPenalty}]\val{penalty}: The penalty used by
%   \texttt{CheckSingle}. The initial value is \texttt{10000};
%   a lower value allows the break when it is worth the cost.
%   \item[\keys{CJLineBreak}]\val{normal, strict}: In the \texttt{strict}
%   mode a character whose Unicode \texttt{Line\_Break} property is
%   \texttt{CJ} (the small kana and the like) may not start a line.
%   The mode only adds prohibitions; it does not remove any.
%   The initial value is \texttt{normal}, which treats those characters
%   like other CJK characters.
%   The set is read from \file{LineBreak.txt} of the \pkg{unicode-data}
%   bundle, so the package needs that bundle for the strict mode.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{CheckSingle = true}
\parbox{4em}{字字字字字字\par}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKnobreak}
%   \begin{syntax}
%     \tn{LuaCJKnobreak} \marg{text}
%   \end{syntax}
%   Keep \meta{text} on one line. The nodes of the argument are marked
%   and the line-breaking pass forbids a break at any of their boundaries.
%   The marking ends with the current group.
% \end{function}
%
% \subsection{Suspending and hooks}
%
% \begin{function}{\LuaCJKdisable, \LuaCJKenable}
%   \tn{LuaCJKdisable} stops the typographic adjustments: no \keys{CJKglue}
%   or \keys{CJKecglue} is inserted, punctuation is not compressed,
%   no line-breaking prohibitions are added, punctuation is not hung, and
%   CJK characters in math mode are left alone. CJK characters are still
%   typeset in the CJK font, so text stays readable. The switch is local
%   to the current group; \tn{LuaCJKenable} turns the adjustments back on.
% \end{function}
%
% This is the hook verbatim-like environments use,
% and it is also useful when measuring raw node lists.
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKdisable 中 文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKShipoutHook}
%   \begin{syntax}
%     \tn{LuaCJKShipoutHook} \marg{code}
%   \end{syntax}
%   Run \meta{code} before every page is shipped out. The code is added to
%   the \texttt{shipout/before} hook, so it obeys the usual hook ordering.
% \end{function}
%
% \subsection{Verbatim and listings}
%
% \begin{function}{\LuaCJKVerbAddon, \LuaCJKOffVerbAddon}
%   Make one CJK character as wide as two spaces of the current monospaced
%   font, which keeps columns aligned when a code listing contains CJK text.
%   The gap is added as \keys{CJKglue}, so the CJK font itself
%   is not scaled; a negative gap only raises a warning and adds nothing.
%   Breaks between CJK characters are forbidden until the group ends,
%   as in Latin verbatim text.
%
%   The command does nothing at the outermost group level,
%   so it is meant to be used inside the environment that needs it,
%   for example in the \texttt{formatcom} option of \pkg{fancyvrb}.
%   \tn{LuaCJKOffVerbAddon} cancels it again inside the same group.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\ttfamily 中中\\
\ttfamily\LuaCJKVerbAddon 中中
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{keyval}
%   \item[\keys{Verb}]\val{\TTF, env, env+}
%   What to do inside \tn{verb} and the verbatim-like environments
%   (\env{verbatim}, \env{Verbatim}, \env{lstlisting},
%   and their relatives). \texttt{true} suspends the adjustments in both;
%   \texttt{env} keeps them inside the environments but not in \tn{verb},
%   which preserves column alignment when the code contains CJK text;
%   \texttt{env+} keeps them everywhere; \texttt{false} leaves verbatim
%   material entirely alone. Since \texttt{env+} and \texttt{false} both
%   leave the adjustments on, they behave the same in LuaCJK.
% \end{keyval}
%
% \pkg{listings} processes one character at a time and typesets a character
% that is outside its character table at the moment it is read.
% CJK characters are outside that table, so they end up in front of the
% surrounding Latin text. The companion package \pkg{LuaCJK-listings} fixes
% this: it adds the CJK characters to the character table of \pkg{listings},
% so they stay in place, counts each of them as two columns,
% and turns the spacing adjustments off inside the listing.
% LuaCJK loads it automatically when \pkg{listings} is used,
% so no extra command is needed.
%
% \tn{lstinline} reads its argument with changed category codes;
% the patch would break that scanner,
% so inline code is left alone and takes the normal handling.
%

%
% \subsection{Decorations}
%
% The companion package \pkg{LuaCJKfntef} provides underlining,
% emphasis dots, and strike-through. It builds on \pkg{lua-ul},
% so the decorated text may contain arbitrary commands, CJK and Latin text,
% and may still be hyphenated and broken between lines.
%
% \begin{function}{\CJKunderline}
%   \begin{syntax}
%     \tn{CJKunderline} \oarg{options} \marg{text}
%   \end{syntax}
%   Underline \meta{text}. The options are
%   \begin{itemize}
%     \item \keys{thickness}, the thickness of the rule;
%     \item \keys{depth}, the distance from the baseline to the top of the
%     rule;
%     \item \keys{textformat}, code applied to the text, for example
%     |textformat=\bfseries|;
%     \item \keys{format}, the color of the rule, given as a name,
%     for example |format=red|. It affects the rule only, not the text;
%     \item \keys{subtract}, a length (or \texttt{true} for half an em)
%     taken off the rule at both ends,
%     so two neighbouring commands do not run together;
%     \item \keys{skip}, which leaves the punctuation out of the rule;
%     \item \keys{hidden}, which hides the text and keeps the rule, with
%     the width, height, and depth of the hidden text.
%   \end{itemize}
%   The initial geometry is \texttt{depth=0.2em}
%   and \texttt{thickness=0.4pt}. \keys{subtract, skip, hidden} work the
%   same way for \cs{CJKunderdblline},
%   \cs{CJKunderwave}, \cs{CJKxout}, and \cs{CJKunderdot}.
%   The keys \texttt{top} and \texttt{bottom} are passed
%   to \pkg{lua-ul} and override the computed geometry.
%   The drawn patterns of \cs{CJKunderwave}, \cs{CJKxout},
%   and \cs{CJKunderdot} never change the height
%   or depth of the line they decorate, so their leading does not grow.
%   A leading \texttt{*} or \texttt{-} is accepted and ignored.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderline[thickness = 1pt]{中}\\
\CJKunderline[format = red]{中}\\
\CJKunderline[textformat = \bfseries]{中}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderline{中文}\CJKunderline{中文}\\
\CJKunderline[subtract]{中文}\\
\CJKunderline[skip]{中，文}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKunderdblline}
%   \begin{syntax}
%     \tn{CJKunderdblline} \oarg{options} \marg{text}
%   \end{syntax}
%   Put two parallel rules under \meta{text}.
%   Besides the keys of \cs{CJKunderline}, the optional argument takes
%   \keys{gap}, the distance between the two rules (initial \texttt{1.1pt});
%   both rules use \keys{thickness} and the top rule starts at \keys{depth}.
%   A leading \texttt{*} or \texttt{-} is accepted and ignored.
% \end{function}
%
% \begin{function}{\CJKunderwave}
%   \begin{syntax}
%     \tn{CJKunderwave} \oarg{options} \marg{text}
%   \end{syntax}
%   Put a wave under \meta{text}.
%   The wave is drawn with \pkg{l3draw} and repeated with \tn{leaders},
%   so it has the same phase across the parts of one line. One period
%   is half an em and the whole pattern scales with the font size; like the
%   other drawn patterns it leaves the height and depth of the line alone.
%   The optional argument takes the keys of \cs{CJKunderline} and,
%   in addition, \keys{symbol} to replace the wave with another symbol:
%   one symbol per em, centered, its top half an em below the baseline.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderwave{中文}\quad
\CJKunderwave[symbol = \textbullet]{中文}\\
\CJKunderdot {中文}\quad
\CJKunderdot [symbol = \textbullet]{中文}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKxout}
%   \begin{syntax}
%     \tn{CJKxout} \oarg{options} \marg{text}
%   \end{syntax}
%   Strike \meta{text} out with a repeated slash, like \pkg{ulem}'s
%   \tn{xout}. The slash runs from \texttt{-0.15em} to \texttt{0.8em}
%   relative to the baseline, so it crosses the whole body of a CJK glyph.
%   The optional argument takes the same keys as \cs{CJKunderline}.
% \end{function}
%
% \begin{function}{\CJKunderanyline}
%   \begin{syntax}
%     \tn{CJKunderanyline} \marg{depth} \marg{object} \marg{text}
%   \end{syntax}
%   Put \meta{object} under \meta{text}, repeated by \tn{leaders}.
%   The bottom of \meta{object} is placed \meta{depth} below
%   the baseline, so for a \cs{rule} (which has no depth of its own)
%   the rule occupies \meta{depth} below the baseline upwards.
%   To cover the body of a CJK glyph, use the descender
%   of the body and its height, as the example below does.
%   The type is cached, so the same arguments reuse one underline type.
% \end{function}
%
% \begin{function}{\CJKunderanysymbol}
%   \begin{syntax}
%   \tn{CJKunderanysymbol}\oarg{options}\marg{depth}\marg{symbol}\marg{text}
%   \end{syntax}
%   The same, with one \meta{symbol} per em: the symbol is centered in a cell
%   as wide as a CJK character, so a row of symbols lines up with the
%   characters above them. \meta{depth} is the distance from the baseline
%   to the top of the symbol; |0pt| puts the top of the symbol right under
%   the characters. The option \keys{sep} is accepted for compatibility
%   but has no effect, because the cell is fixed at one em.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderanyline{.16em}
  {\color{yellow}\rule{1pt}{.94em}}{中}\\
\CJKunderanysymbol{.02em}{\tiny$\triangle$}{中}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKunderdot}
%   \begin{syntax}
%     \tn{CJKunderdot} \oarg{options} \marg{text}
%   \end{syntax}
%   Put emphasis dots under \meta{text}.
%   The optional argument takes the keys of \cs{CJKunderline}.
%   With |symbol=|\meta{symbol} a symbol takes the place of the dots
%   and is placed like the symbol of \cs{CJKunderanysymbol}: one per em,
%   centered, its top \texttt{0.3em} under the baseline.
% \end{function}
%
% \begin{function}{\CJKsout}
%   \begin{syntax}
%     \tn{CJKsout} \oarg{options} \marg{text}
%   \end{syntax}
%   Strike \meta{text} through. The optional argument takes
%   \keys{thickness}, \keys{height} (the distance from the baseline to the
%   center of the rule, initial \texttt{0.3em}), \keys{format} (a color
%   name), and the keys \keys{subtract, skip, hidden}.
%   A bare color name is still accepted and means |format = |\meta{color};
%   \texttt{color} is another name for \keys{format}.
%   The initial height passes through the middle of a CJK glyph,
%   which sits higher than the middle of the Latin x-height;
%   use |height = 0.5ex| for text that is entirely Latin.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKunderline   {中文 test 中文}\\
\CJKunderdblline{中文 test 中文}\\
\CJKunderwave   {中文 test 中文}\\
\CJKunderdot    {中文 test 中文}\\
\CJKsout        {中文 test 中文}\\
\CJKxout        {中文 test 中文}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{Comparison with \pkg{xeCJK}}
%
% \pkg{LuaCJK} follows the \pkg{xeCJK} interface where the two engines allow
% it, so a document that already uses \pkg{xeCJK} mostly needs no change.
% This section lists only the places where the two differ: a \LuaTeX\ node
% list is not an \XeTeX\ character class table, so some options mean
% something slightly different here, and some have no counterpart at all.
%
% \subsection{Different behavior}
%
% \begin{itemize}
%   \item \keys{Verb} accepts the four \pkg{xeCJK} values, but
%   \texttt{env+} behaves like \texttt{false}: both leave the adjustments
%   on, so the distinction has no observable effect here.
%   \item The punctuation geometry is approximate. \texttt{banjiao},
%   \texttt{kaiming}, and \texttt{CCT} give a mark half,
%   half (with the sentence-ending marks full),
%   or 0.7 of the current size, and the hanging shift is half an em.
%   The ink is placed by the class of the mark: an opening mark moves by the
%   whole amount, a middle mark by half, and a closing mark not at all.
%   \pkg{xeCJK} instead measures the real side bearings of each glyph.
%   \item \cs{LuaCJKDeclarePunctStyle} takes \keys{compress-adjacent},
%   \keys{adjacent-ratio}, and \keys{keep-open-close} instead
%   of the thirty geometry keys of \pkg{xeCJK}.
%   \item \texttt{CJKfilltwosides*} does not compare with the natural width
%   of its content.
%   \item The \pkg{LuaCJKfntef} option \keys{format} takes the color of
%   the rule as a name (|format=red|),
%   not as code (|format=\color{red}|).
%   \item The CJK font is applied to the glyph node after the text has been
%   read and shaped with the current font.
%   The OpenType features of the CJK font (ligatures, \texttt{locl},
%   \texttt{palt}, and the variation sequences) therefore do not take effect;
%   the spacing, the punctuation advance, and the line-breaking prohibitions
%   come from LuaCJK itself.
% \end{itemize}
%
% \subsection{Not available}
%
% \begin{itemize}
%   \item \texttt{NewLineCS}, \texttt{EnvCS}, \texttt{InlineEnv}, and
%   \texttt{PlainEquation}. They exist so that \pkg{xeCJK} can recognize
%   \TeX\ constructs while it scans tokens;
%   LuaCJK looks at the finished node list and needs no hint.
%   \item \texttt{PoZheHaoLigature}. A CJK font can carry a ligature that
%   turns two dashes into one two-em dash, and the font loader does apply it
%   when the CJK font is the current font.
%   LuaCJK instead applies the CJK font to the glyph node after the text has
%   been shaped with the Latin font, so the substitution has already been
%   decided and cannot be asked for here.
%   \item \texttt{RubberPunctSkip}. The advance of a punctuation mark is
%   fixed with a kern. A kern is not a break opportunity and takes no part in
%   justification, which is what keeps the fixed-width styles stable; making
%   the advance a flexible glue would give that up.
%   \item \texttt{CheckFullRight}, because it needs the control sequence that
%   follows the mark, which the node list no longer shows.
%   Use \cs{LuaCJKnobreak} for the few places that need it.
%   \item The detailed punctuation keys of \pkg{xeCJK}
%   (\texttt{fixed-punct-*}, \texttt{mixed-*}, \texttt{middle-*},
%   \texttt{bound-*}, \texttt{kerning-*}, \texttt{optimize-*},
%   \texttt{margin-minimum}), which describe \pkg{xeCJK}'s model
%   of adjusting the side bearings.
%   \item In \pkg{LuaCJKfntef}: the \texttt{ulem} option, which passes
%   options to the commands of \pkg{ulem}.
%   \pkg{LuaCJKfntef} builds on \pkg{lua-ul} instead,
%   and its \tn{underLine} may be configured directly.
%   \item A \pkg{ctex} backend that is picked up without a redirect.
%   \pkg{ctex} asks for a file of its own naming,
%   so LuaCJK ships |ctex-engine-luacjk.def| and a \file{ctexopts.cfg}
%   written by \cs{LuaCJKwriteCtexConfig} points \pkg{ctex} at it.
%   Choosing a backend inside \pkg{ctex} itself still needs the agreement
%   of the \pkg{ctex} maintainers.
% \end{itemize}
%
% \end{documentation}
%
% \StopEventually{\PrintIndex}
% \clearpage \appendix
%
% \begin{implementation}
%
% \section{Implementation}
%
%    \begin{macrocode}
%<*package>
%    \end{macrocode}
%
%    \begin{macrocode}
%<@@=LuaCJK>
%    \end{macrocode}
%
% \subsection{Loading and conflicts}
%
% LuaCJK only works with \LuaTeX. The engine test runs before any other
% package is loaded, so that a wrong engine stops with a clear message.
%    \begin{macrocode}
\sys_if_engine_luatex:F
  {
    \msg_new:nnn { LuaCJK } { engine }
      { LuaCJK~requires~LuaTeX. }
    \msg_critical:nn { LuaCJK } { engine }
    \tex_endinput:D
  }
\RequirePackage { fontspec }
%    \end{macrocode}
%
% \begin{macro}{\LuaCJKversion}
% \changes{v0.0.1}{2026/11/05}{Use the \pkg{LuaCJK} spelling for the package
%   and derived files; the l3build/CTAN module stays \pkg{luacjk}.}
% \changes{v0.0.1}{2026/11/05}{Only \pkg{luatexja} is rejected now;
%   \pkg{xeCJK} already refuses to run outside XeTeX, so LuaCJK no longer
%   duplicates that check.}
% The version of the package.
% \begin{variable}[int]{\c_@@_version_tl}
% The version string, taken from the package metadata.
%    \begin{macrocode}
\tl_const:Nx \c_@@_version_tl { \ExplFileVersion }
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new:Npn \LuaCJKversion { \tl_use:N \c_@@_version_tl }
%    \end{macrocode}
% \end{macro}
%
% \pkg{luatexja} installs its own CJK font and spacing layer and works
% on the same callbacks as LuaCJK, so the two are rejected
% whatever the loading order. \pkg{xeCJK} needs no check here:
% it stops by itself on any engine other than \XeTeX.
%    \begin{macrocode}
\msg_new:nnn { LuaCJK } { luatexja-conflict }
  {
    LuaCJK~and~LuaTeX-ja~must~not~be~loaded~together.\\
    Load~only~one~of~them.
  }
\cs_if_exist:cT { ver@luatexja.sty }
  { \msg_critical:nn { LuaCJK } { luatexja-conflict } }
\hook_gput_code:nnn { package / luatexja / before } { LuaCJK }
  { \msg_critical:nn { LuaCJK } { luatexja-conflict } }
%    \end{macrocode}
%
% \subsection{Registers, styles, and options}
%
% The runtime state lives in attributes and registers,
% which the options below fill in.
%
% \begin{variable}[int]
%   {
%     \g_@@_font_attr,       \c_@@_font_attr_int,
%     \g_@@_cjk_space_attr,  \c_@@_cjk_space_attr_int,
%     \g_@@_xecglue_attr,    \c_@@_xecglue_attr_int,
%     \g_@@_inserted_attr,   \c_@@_inserted_attr_int,
%     \g_@@_math_font_attr,  \c_@@_math_font_attr_int,
%     \g_@@_disabled_attr,   \c_@@_disabled_attr_int,
%     \g_@@_punct_font_attr, \c_@@_punct_font_attr_int,
%     \g_@@_settings_attr,   \c_@@_settings_attr_int,
%     \g_@@_nobreak_attr,    \c_@@_nobreak_attr_int
%   }
% The attributes record, per node, the CJK font, the space and glue
% policies, whether the node was inserted by LuaCJK, the CJK math font,
% and whether the adjustments are suspended. The integer constants hold
% the allocated attribute numbers for the Lua side.
%    \begin{macrocode}
\newattribute \g_@@_font_attr
\int_const:Nn \c_@@_font_attr_int { \int_use:N \allocationnumber }
\newattribute \g_@@_cjk_space_attr
\int_const:Nn \c_@@_cjk_space_attr_int { \int_use:N \allocationnumber }
\newattribute \g_@@_xecglue_attr
\int_const:Nn \c_@@_xecglue_attr_int { \int_use:N \allocationnumber }
\newattribute \g_@@_inserted_attr
\int_const:Nn \c_@@_inserted_attr_int { \int_use:N \allocationnumber }
\newattribute \g_@@_math_font_attr
\int_const:Nn \c_@@_math_font_attr_int { \int_use:N \allocationnumber }
\newattribute \g_@@_disabled_attr
\int_const:Nn \c_@@_disabled_attr_int { \int_use:N \allocationnumber }
\newattribute \g_@@_punct_font_attr
\int_const:Nn \c_@@_punct_font_attr_int { \int_use:N \allocationnumber }
\newattribute \g_@@_settings_attr
\int_const:Nn \c_@@_settings_attr_int { \int_use:N \allocationnumber }
\newattribute \g_@@_nobreak_attr
\int_const:Nn \c_@@_nobreak_attr_int { \int_use:N \allocationnumber }
\g_@@_math_font_attr  = 0
\g_@@_punct_font_attr = 0
\g_@@_settings_attr   = 0
\g_@@_cjk_space_attr  = 0
\g_@@_xecglue_attr    = 0
%    \end{macrocode}
% \end{variable}
%
% \begin{variable}[int]{\l_@@_ccglue_skip, \l_@@_ecglue_skip}
% The glue used between CJK characters and between CJK and Latin text.
%    \begin{macrocode}
\skip_new:N \l_@@_ccglue_skip
\skip_new:N \l_@@_ecglue_skip
\bool_new:N \l_@@_ccglue_touched_bool
\bool_new:N \l_@@_ecglue_touched_bool
\skip_set:Nn \l_@@_ccglue_skip { 0pt plus 0.08 \tex_baselineskip:D }
\skip_set:Nn \l_@@_ecglue_skip
  { 0.3333em plus 0.1667em minus 0.1111em }
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{\@@_set_ccglue:n, \@@_set_ecglue:n}
% \changes{v0.0.1}{2026/11/05}{The default \keys{CJKglue} and \keys{CJKecglue}
%   are recomputed at every font selection, so they follow \cs{small},
%   \cs{Large}, and \cs{zihao} instead of staying at the value of the
%   \texttt{10pt} size.}
% The two glues keep their default relative to the current size, so they
% are recomputed on every font selection unless the document set them.
% A value given by the document is taken as it is.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_set_ccglue:n #1
  {
    \skip_set:Nn \l_@@_ccglue_skip {#1}
    \bool_set_true:N \l_@@_ccglue_touched_bool
  }
\cs_new_protected:Npn \@@_set_ecglue:n #1
  {
    \skip_set:Nn \l_@@_ecglue_skip {#1}
    \bool_set_true:N \l_@@_ecglue_touched_bool
  }
\cs_new_protected:Npn \@@_refresh_glues:
  {
    \bool_if:NF \l_@@_ccglue_touched_bool
      {
        \skip_set:Nn \l_@@_ccglue_skip
          { 0pt plus 0.08 \tex_baselineskip:D }
      }
    \bool_if:NF \l_@@_ecglue_touched_bool
      {
        \skip_set:Nn \l_@@_ecglue_skip
          { 0.3333em plus 0.1667em minus 0.1111em }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% A punctuation style is a property list,
% read through the settings of each node.
%
% \begin{variable}[int]{\g_@@_punct_style_prop}
% The names of the styles LuaCJK knows about,
% including those defined by \cs{LuaCJKDeclarePunctStyle}.
%    \begin{macrocode}
\prop_new:N \g_@@_punct_style_prop
\prop_gput:Nnn \g_@@_punct_style_prop { quanjiao      } { }
\prop_gput:Nnn \g_@@_punct_style_prop { plain         } { }
\prop_gput:Nnn \g_@@_punct_style_prop { banjiao       } { }
\prop_gput:Nnn \g_@@_punct_style_prop { kaiming       } { }
\prop_gput:Nnn \g_@@_punct_style_prop { CCT           } { }
\prop_gput:Nnn \g_@@_punct_style_prop { hangmobanjiao } { }
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[int]{\@@_set_punct_style:n}
% \changes{v0.0.1}{2026/11/05}{Add the \keys{PunctStyle} interface with working
%   \texttt{quanjiao}, \texttt{plain}, \texttt{banjiao}, \texttt{kaiming},
%   \texttt{CCT}, and \texttt{hangmobanjiao} styles.}
% Store the selected style,
% or warn and fall back to \texttt{plain} when the name is unknown.
% \begin{variable}[int]{\l_@@_punct_style_tl}
% The style name read by the Lua side.
%    \begin{macrocode}
\tl_new:N \l_@@_punct_style_tl
\tl_set:Nn \l_@@_punct_style_tl { quanjiao }
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\msg_new:nnn { LuaCJK } { punct-style-unknown }
  {
    PunctStyle~`#1'~is~not~implemented.\\
    Using~`plain'~instead.
  }
\cs_new_protected:Npn \@@_set_punct_style:n #1
  {
    \prop_if_in:NnTF \g_@@_punct_style_prop {#1}
      { \tl_set:Nn \l_@@_punct_style_tl {#1} }
      {
        \msg_warning:nnn { LuaCJK } { punct-style-unknown } {#1}
        \tl_set:Nn \l_@@_punct_style_tl { plain }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKEditPunctStyle}
% \changes{v0.0.1}{2026/11/05}{Add \cs{LuaCJKEditPunctStyle} and
%   \keys{AllowBreakBetweenPuncts}.}
% Change the parameters of an existing style. A key that is not given
% keeps its current value, which is why the three ``given'' switches
% are tracked here instead of starting from the defaults.
% \begin{variable}[int]
%   {
%     \l_@@_punct_compress_given_bool,
%     \l_@@_punct_ratio_given_bool,
%     \l_@@_punct_keep_given_bool
%   }
% Whether the corresponding key was part of the edit.
%    \begin{macrocode}
\bool_new:N \l_@@_punct_compress_given_bool
\bool_new:N \l_@@_punct_ratio_given_bool
\bool_new:N \l_@@_punct_keep_given_bool
\tl_new:N \l_@@_punct_compress_value_tl
\tl_new:N \l_@@_punct_keep_value_tl
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\keys_define:nn { LuaCJK / punct-edit }
  {
    compress-adjacent .code:n =
      {
        \bool_set_true:N \l_@@_punct_compress_given_bool
        \tl_set:Nn \l_@@_punct_compress_value_tl {#1}
      },
    adjacent-ratio    .code:n =
      {
        \bool_set_true:N \l_@@_punct_ratio_given_bool
        \fp_set:Nn \l_@@_punct_ratio_fp {#1}
      },
    keep-open-close   .code:n =
      {
        \bool_set_true:N \l_@@_punct_keep_given_bool
        \tl_set:Nn \l_@@_punct_keep_value_tl {#1}
      },
  }
\NewDocumentCommand \LuaCJKEditPunctStyle { m m }
  {
    \bool_set_false:N \l_@@_punct_compress_given_bool
    \bool_set_false:N \l_@@_punct_ratio_given_bool
    \bool_set_false:N \l_@@_punct_keep_given_bool
    \keys_set:nn { LuaCJK / punct-edit } {#2}
    \lua_now:e
      {
        LuaCJK.edit_punct_style
          ( "\lua_escape:e {#1}" ,
            \bool_if:NTF \l_@@_punct_compress_given_bool
              { \l_@@_punct_compress_value_tl }
              { nil } ,
            \bool_if:NTF \l_@@_punct_ratio_given_bool
              { \fp_use:N \l_@@_punct_ratio_fp }
              { nil } ,
            \bool_if:NTF \l_@@_punct_keep_given_bool
              { \l_@@_punct_keep_value_tl }
              { nil } )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKsetwidth}
% \changes{v0.0.1}{2026/11/05}{Add \cs{LuaCJKsetwidth} and \cs{LuaCJKsetkern}
%   for per-mark widths and per-pair gaps that override the selected
%   punctuation style.}
% Give specific punctuation marks a fixed advance, overriding the
% selected style. The star form of \pkg{xeCJK}, which sets the width used
% at the start or end of a line, has no counterpart yet and only warns.
% \begin{variable}[int]{\l_@@_bound_width_warned_bool}
% Guards the one-time warning for the star form.
%    \begin{macrocode}
\bool_new:N \l_@@_bound_width_warned_bool
\msg_new:nnn { LuaCJK } { bound-width-unsupported }
  {
    The~star~form~of~\token_to_str:N \LuaCJKsetwidth,~which~sets~the~width~
    at~the~start~or~end~of~a~line,~is~not~implemented.\\
    The~width~is~applied~to~every~position~instead.
  }
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKsetwidth { s m m }
  {
    \IfBooleanT {#1}
      {
        \bool_if:NF \l_@@_bound_width_warned_bool
          {
            \bool_set_true:N \l_@@_bound_width_warned_bool
            \msg_warning:nn { LuaCJK } { bound-width-unsupported }
          }
      }
    \lua_now:e
      {
        LuaCJK.set_punct_width
          ( "\lua_escape:e {#2}" , \dim_to_decimal_in_sp:n {#3} )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKsetkern}
% Set the gap between two adjacent punctuation marks, overriding the
% selected style. Only the first character of each argument is used.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKsetkern { m m m }
  {
    \lua_now:e
      {
        LuaCJK.set_punct_kern
          ( "\lua_escape:e {#1}" , "\lua_escape:e {#2}"
          , \dim_to_decimal_in_sp:n {#3} )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% A single CJK font rarely covers every block of \textsc{Unicode}.
% A sub-block gives a range of characters its own font inside a family,
% named by an option of the font commands.
%
% \begin{macro}{\LuaCJKDeclareSubCJKBlock}
% \changes{v0.0.1}{2026/11/05}{Add \cs{LuaCJKDeclareSubCJKBlock} with
%   \cs{LuaCJKCancelSubCJKBlock} and \cs{LuaCJKRestoreSubCJKBlock}, so a range
%   of characters can use its own font inside a family.}
% \begin{variable}[int]
%   {\g_@@_block_prop, \g_@@_block_names_clist}
% The ranges of each block, and the declaration order that decides
% which block wins when the ranges overlap.
%    \begin{macrocode}
\prop_new:N \g_@@_block_prop
\clist_new:N \g_@@_block_names_clist
\NewDocumentCommand \LuaCJKDeclareSubCJKBlock { m m }
  {
    \@@_build_ranges:n {#2}
    \prop_gput:NnV \g_@@_block_prop {#1} \l_@@_ranges_tl
    \clist_if_in:NnF \g_@@_block_names_clist {#1}
      { \clist_gput_right:Nn \g_@@_block_names_clist {#1} }
    \lua_now:e
      {
        LuaCJK.declare_block
          ( "\lua_escape:e {#1}" , { \l_@@_ranges_tl } )
      }
  }
%    \end{macrocode}
% \end{variable}
% \end{macro}
%
% \begin{macro}{\LuaCJKCancelSubCJKBlock, \LuaCJKRestoreSubCJKBlock}
% Turn a block off or on again. The list of canceled blocks is part
% of the settings of the text, so the change ends with the group; the
% fonts of the current family are refreshed so it takes effect at once.
%    \begin{macrocode}
\clist_new:N \l_@@_blocks_off_clist
\cs_new_protected:Npn \@@_set_block_enabled:nn #1#2
  {
    \clist_map_inline:nn {#1}
      {
        \str_if_eq:nnTF {#2} { false }
          {
            \clist_if_in:NnF \l_@@_blocks_off_clist {##1}
              { \clist_put_right:Nn \l_@@_blocks_off_clist {##1} }
          }
          { \clist_remove_all:Nn \l_@@_blocks_off_clist {##1} }
      }
    \@@_settings_push:
    \@@_update_font:
  }
\NewDocumentCommand \LuaCJKCancelSubCJKBlock { m }
  { \@@_set_block_enabled:nn {#1} { false } }
\NewDocumentCommand \LuaCJKRestoreSubCJKBlock { m }
  { \@@_set_block_enabled:nn {#1} { true } }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_extract_blocks:nn}
% Pull the block options out of a family's option list
% and register one \pkg{fontspec} family per block font.
% The remaining options go into \cs{l_@@_features_tl}.
% \begin{variable}[int]
%   {
%     \g_@@_family_block_prop, \g_@@_pending_block_prop,
%     \l_@@_features_tl,       \l_@@_block_key_tl,
%     \l_@@_option_key_tl,     \l_@@_option_seq
%   }
% The block font of each family and block, the blocks found in the
% option list being processed, the filtered options, and scratch
% variables for splitting one option at the equals sign.
%    \begin{macrocode}
\prop_new:N \g_@@_family_block_prop
\prop_new:N \g_@@_pending_block_prop
\tl_new:N \l_@@_features_tl
\tl_new:N \l_@@_block_key_tl
\tl_new:N \l_@@_option_key_tl
\seq_new:N \l_@@_option_seq
\bool_new:N \l_@@_is_block_bool
\cs_new_protected:Npn \@@_block_option:nn #1#2
  {
    \tl_set:Nn \l_@@_option_key_tl {#1}
    \tl_trim_spaces:N \l_@@_option_key_tl
    \bool_set_false:N \l_@@_is_block_bool
    \clist_map_inline:Nn \g_@@_block_names_clist
      {
        \str_if_eq:eeT {##1} { \l_@@_option_key_tl }
          { \bool_set_true:N \l_@@_is_block_bool }
      }
    \bool_if:NTF \l_@@_is_block_bool
      { \prop_gput:NVn \g_@@_pending_block_prop
          \l_@@_option_key_tl {#2} }
      { \tl_put_right:Nn \l_@@_features_tl { , ~ #1 = {#2} } }
  }
\cs_new_protected:Npn \@@_block_option:n #1
  { \tl_put_right:Nn \l_@@_features_tl { , ~ #1 } }
\cs_new_protected:Npn \@@_extract_blocks:nn #1#2
  {
    \clist_if_empty:NTF \g_@@_block_names_clist
      { \tl_set:Nn \l_@@_features_tl {#2} }
      {
        \tl_clear:N \l_@@_features_tl
        \prop_gclear:N \g_@@_pending_block_prop
        \keyval_parse:NNn
          \@@_block_option:n \@@_block_option:nn {#2}
        \@@_register_block_fonts:n {#1}
      }
  }
\cs_new_protected:Npn \@@_register_block_fonts:n #1
  {
    \prop_map_inline:Nn \g_@@_pending_block_prop
      {
        \group_begin:
          \fontspec_gset_family:Nnn \l_@@_tmpa_tl { } {##2}
          \tl_set:Ne \l_@@_block_key_tl { #1 | ##1 }
          \prop_gput:NVV \g_@@_family_block_prop
            \l_@@_block_key_tl \l_@@_tmpa_tl
        \group_end:
      }
  }
%    \end{macrocode}
% \end{variable}
% \end{macro}
%
% \begin{macro}{\LuaCJKDeclareCharClass}
% \changes{v0.0.1}{2026/11/05}{Add \cs{LuaCJKDeclareCharClass},
%   \cs{LuaCJKDeclarePunctClass}, and \cs{LuaCJKResetCharClass} to override
%   the class of a code-point range.}
% \changes{v0.0.1}{2026/11/05}{\cs{LuaCJKDeclareCharClass} accepts the class
%   names of \pkg{xeCJK} (\texttt{FullLeft}, \texttt{FullRight},
%   \texttt{HalfLeft}, \texttt{HalfRight}, \texttt{NormalSpace},
%   \texttt{CJStarter}, \texttt{CM}, \texttt{Boundary});
%   \cs{LuaCJKResetCharClass} also restores the normal-spaced set.}
% Override the class of a code-point range.
% The range list uses the \pkg{xeCJK} spelling: hexadecimal numbers
% with a leading |"|, and |"START -> "END| for a range.
% \begin{variable}[int]
%   {
%     \l_@@_ranges_tl,     \l_@@_range_seq,
%     \l_@@_range_pair_tl, \l_@@_hex_tl,
%     \l_@@_hex_int_tl
%   }
% The Lua table being built, the two halves of one range,
% and the current hexadecimal number and its value.
%    \begin{macrocode}
\tl_new:N \l_@@_ranges_tl
\seq_new:N \l_@@_range_seq
\tl_new:N \l_@@_range_pair_tl
\tl_new:N \l_@@_hex_tl
\tl_new:N \l_@@_hex_int_tl
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_hex_store:n #1
  {
    \tl_set:Nn \l_@@_hex_tl {#1}
    \tl_replace_all:Nnn \l_@@_hex_tl { " } { }
    \tl_trim_spaces:N \l_@@_hex_tl
    \tl_set:Ne \l_@@_hex_int_tl
      { \exp_args:NV \int_from_hex:n \l_@@_hex_tl }
  }
\cs_new_protected:Npn \@@_range_entry:n #1
  {
    \seq_set_split:Nnn \l_@@_range_seq { -> } {#1}
    \tl_clear:N \l_@@_range_pair_tl
    \seq_map_inline:Nn \l_@@_range_seq
      {
        \@@_hex_store:n {##1}
        \tl_put_right:Nx \l_@@_range_pair_tl
          { \exp_not:V \l_@@_hex_int_tl , }
      }
    \tl_put_right:Nx \l_@@_ranges_tl
      { { \exp_not:V \l_@@_range_pair_tl } , }
  }
\cs_new_protected:Npn \@@_build_ranges:n #1
  {
    \tl_clear:N \l_@@_ranges_tl
    \clist_map_inline:nn {#1} { \@@_range_entry:n {##1} }
  }
\msg_new:nnn { LuaCJK } { unknown-char-class }
  { Unknown~character~class~`#1'~is~being~ignored. }
\msg_new:nnn { LuaCJK } { unknown-punct-class }
  { Unknown~punctuation~class~`#1'~is~being~ignored. }
\NewDocumentCommand \LuaCJKDeclareCharClass { m m }
  {
    \str_case:nnF {#1}
      {
        { CJK         } { \@@_push_class:nn { true } {#2}    }
        { Default     } { \@@_push_class:nn { false } {#2}   }
        { FullLeft    } { \@@_push_punct:nn { "open" } {#2}  }
        { HalfLeft    } { \@@_push_punct:nn { "open" } {#2}  }
        { FullRight   } { \@@_push_punct:nn { "close" } {#2} }
        { HalfRight   } { \@@_push_punct:nn { "close" } {#2} }
        { NormalSpace } { \@@_push_normal_space:n {#2}       }
        { CJStarter   } { \@@_push_class:nn { true } {#2}    }
        { CM          } { \@@_push_class:nn { true } {#2}    }
        { Boundary    } { \@@_push_class:nn { true } {#2}    }
      } { \msg_warning:nnn { LuaCJK } { unknown-char-class } {#1} }
  }
\cs_new_protected:Npn \@@_push_normal_space:n #1
  {
    \@@_build_ranges:n {#1}
    \lua_now:e
      { LuaCJK.add_normal_spaced ( { \l_@@_ranges_tl } ) }
  }
\cs_new_protected:Npn \@@_push_class:nn #1#2
  {
    \@@_build_ranges:n {#2}
    \lua_now:e
      { LuaCJK.declare_class ( { \l_@@_ranges_tl } , #1 ) }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKDeclarePunctClass}
% Override the punctuation group of a range,
% or with \texttt{none} remove the punctuation treatment from it.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKDeclarePunctClass { m m }
  {
    \str_case:nnF {#1}
      {
        { open     } { \@@_push_punct:nn { "open" } {#2}     }
        { close    } { \@@_push_punct:nn { "close" } {#2}    }
        { middle   } { \@@_push_punct:nn { "middle" } {#2}   }
        { dash     } { \@@_push_punct:nn { "dash" } {#2}     }
        { ellipsis } { \@@_push_punct:nn { "ellipsis" } {#2} }
        { none     } { \@@_push_punct:nn { false } {#2}      }
      } { \msg_warning:nnn { LuaCJK } { unknown-punct-class } {#1} }
  }
\cs_new_protected:Npn \@@_push_punct:nn #1#2
  {
    \@@_build_ranges:n {#2}
    \lua_now:e
      { LuaCJK.declare_punct ( { \l_@@_ranges_tl } , #1 ) }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_set_charset:nnn}
% Replace, extend, or reduce one of the punctuation character sets. The
% ranges are converted the same way as for \cs{LuaCJKDeclareCharClass}.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_set_charset:nnn #1#2#3
  {
    \@@_build_ranges:n {#3}
    \lua_now:e
      {
        LuaCJK.set_charset
          ( "#1" , "#2" , { \l_@@_ranges_tl } )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKResetCharClass}
% Drop every class and punctuation override declared so far,
% and put the normal-spaced set back to the characters
% of \cs{normalspacedchars}.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKResetCharClass { }
  {
    \lua_now:n { LuaCJK.reset_classes() }
    \@@_set_normal_spaced_chars:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKDeclarePunctStyle}
% Define a style from a small set of keys and hand the result to Lua.
% \begin{variable}[int]
%   {
%     \l_@@_punct_compress_bool, \l_@@_punct_ratio_fp,
%     \l_@@_punct_keep_bool
%   }
% The values collected from the keys,
% with the defaults used when a key is not given.
%    \begin{macrocode}
\bool_new:N \l_@@_punct_compress_bool
\fp_new:N \l_@@_punct_ratio_fp
\bool_new:N \l_@@_punct_keep_bool
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\keys_define:nn { LuaCJK / punct-style }
  {
    compress-adjacent .bool_set:N = \l_@@_punct_compress_bool,
    adjacent-ratio    .fp_set:N   = \l_@@_punct_ratio_fp,
    keep-open-close   .bool_set:N = \l_@@_punct_keep_bool,
  }
\NewDocumentCommand \LuaCJKDeclarePunctStyle { m m }
  {
    \bool_set_true:N \l_@@_punct_compress_bool
    \fp_set:Nn \l_@@_punct_ratio_fp { 0.5 }
    \bool_set_true:N \l_@@_punct_keep_bool
    \keys_set:nn { LuaCJK / punct-style } {#2}
    \prop_gput:Nnn \g_@@_punct_style_prop {#1} { }
    \lua_now:e
      {
        LuaCJK.define_punct_style(
          "\lua_escape:e {#1}",
          \bool_if:NTF \l_@@_punct_compress_bool { true } { false },
          \fp_use:N \l_@@_punct_ratio_fp,
          \bool_if:NTF \l_@@_punct_keep_bool { true } { false } )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_set_autofake:nn}
% \changes{v0.0.1}{2026/11/05}{Add \keys{AutoFakeBold}, \keys{AutoFakeSlant},
%   \keys{EmboldenFactor}, and \keys{SlantFactor}; a family that sets
%   \keys{BoldFont} or \keys{ItalicFont} keeps its real faces.}
% Turn fake bold or slant on or off. A number both enables the feature
% and sets the factor, as in \pkg{xeCJK}.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_set_autofake:nn #1#2
  {
    \str_case:nnF {#2}
      {
        { true  }
        {
          \str_if_eq:nnTF {#1} { bold }
            {
              \tl_gset_eq:NN \g_@@_autofake_bold_tl
                \g_@@_embolden_factor_tl
            }
            {
              \tl_gset_eq:NN \g_@@_autofake_slant_tl
                \g_@@_slant_factor_tl
            }
        }
        { false }
        {
          \str_if_eq:nnTF {#1} { bold }
            { \tl_gclear:N \g_@@_autofake_bold_tl  }
            { \tl_gclear:N \g_@@_autofake_slant_tl }
        }
      }
      {
        \str_if_eq:nnTF {#1} { bold }
          {
            \tl_gset:Nn \g_@@_embolden_factor_tl {#2}
            \tl_gset:Nn \g_@@_autofake_bold_tl   {#2}
          }
          {
            \tl_gset:Nn \g_@@_slant_factor_tl    {#2}
            \tl_gset:Nn \g_@@_autofake_slant_tl  {#2}
          }
      }
  }
%    \end{macrocode}
% \end{macro}

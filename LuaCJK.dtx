% \subsection{Suspending the adjustments}
%
% \begin{macro}{\LuaCJKdisable, \LuaCJKenable}
%   Set the node attribute that makes the Lua callbacks skip the
%   adjustments.  The attribute follows the \TeX{} grouping.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKdisable { }
  { \g_LuaCJK_disabled_attr = 1 }
\NewDocumentCommand \LuaCJKenable { }
  { \g_LuaCJK_disabled_attr = 0 }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKShipoutHook}
%   Run code just before every page is shipped out.  This is the place for
%   work that must see the finished page; \pkg{xeCJK} calls a macro at the
%   same moment, so the name is kept, but the code goes into the
%   \texttt{shipout/before} hook and therefore follows its rules.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKShipoutHook { m }
  { \AddToHook { shipout/before } {#1} }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKnobreak}
%   Keep the argument on one line.  The nodes of the argument are marked,
%   and the line-breaking pass puts a penalty in front of every break
%   opportunity that involves a marked node.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKnobreak { +m }
  {
    \group_begin:
      \g_LuaCJK_nobreak_attr = 1
      #1
    \group_end:
  }
%    \end{macrocode}
% \end{macro}

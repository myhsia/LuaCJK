% \begin{macro}[int]{\@@_add_fallback:nn}
% \changes{v0.0.1}{2026/11/11}{Provide \cs{setCJKfallbackfamilyfont} and
%   \keys{AutoFallBack} for characters that the selected CJK font does not
%   have.}
% \changes{v0.0.2}{2026/11/15}{The fallback list is resolved again at every
%   font selection, so the fallback follows the series, shape, and size of
%   the text.}
% Register one fallback font for a CJK family,

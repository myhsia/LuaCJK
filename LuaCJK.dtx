% \begin{macro}{\LuaCJKDeclarePunctStyle}
% \changes{v0.0.1}{2026/11/11}{Provide \cs{LuaCJKDeclarePunctStyle} for a
%   punctuation style of your own, with the keys \keys{compress-adjacent},
%   \keys{adjacent-ratio}, and \keys{keep-open-close}.}
% Define a style from a small set of keys and hand the result to Lua.
% \begin{variable}[int]
%   {
%     \l_@@_punct_compress_bool, \l_@@_punct_ratio_fp,
%     \l_@@_punct_keep_bool
%   }
% The values collected from the keys,
% with the defaults used when a key is not given.
%    \begin{macrocode}
\bool_new:N \l_@@_punct_compress_bool
\fp_new:N \l_@@_punct_ratio_fp
\bool_new:N \l_@@_punct_keep_bool
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\keys_define:nn { LuaCJK / punct-style }
  {
    compress-adjacent .bool_set:N = \l_@@_punct_compress_bool,
    adjacent-ratio    .fp_set:N   = \l_@@_punct_ratio_fp,
    keep-open-close   .bool_set:N = \l_@@_punct_keep_bool,
  }
\NewDocumentCommand \LuaCJKDeclarePunctStyle { m m }
  {
    \bool_set_true:N \l_@@_punct_compress_bool
    \fp_set:Nn \l_@@_punct_ratio_fp { 0.5 }
    \bool_set_true:N \l_@@_punct_keep_bool
    \keys_set:nn { LuaCJK / punct-style } {#2}
    \prop_gput:Nnn \g_@@_punct_style_prop {#1} { }
    \lua_now:e
      {
        LuaCJK.define_punct_style(
          "\lua_escape:e {#1}",
          \bool_if:NTF \l_@@_punct_compress_bool { true } { false },
          \fp_use:N \l_@@_punct_ratio_fp,
          \bool_if:NTF \l_@@_punct_keep_bool { true } { false } )
      }
  }
%    \end{macrocode}
% \end{macro}

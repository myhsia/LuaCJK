% \title{\bfseries The \pkg{LuaCJK} package}
% \author{Mingyu Xia\thanks{\url{https://github.com/myhsia/LuaCJK}}}
% \date{Released \DocFileDate\quad \texttt{\DocFileVersion}}
% \maketitle
%
% \begin{abstract}
%   \pkg{LuaCJK} provides Chinese typesetting for \LuaLaTeX.  It is inspired
%   by \pkg{xeCJK}, but uses \LuaTeX\ node callbacks instead of \XeTeX
%   character classes.  This manual documents the first development release.
% \end{abstract}
%
% \tableofcontents
%
% \begin{documentation}
%
% \section{Introduction}
%
% \pkg{LuaCJK} is a \LuaTeX-only package for Chinese typesetting.  Its public
% interface follows the familiar \pkg{xeCJK} commands:
% \cs{setCJKmainfont}, \cs{setCJKsansfont}, \cs{setCJKmonofont},
% \cs{setCJKfamilyfont}, \cs{CJKfamily}, and \cs{LuaCJKsetup}.
%
% The implementation does not use \XeTeX's inter-character token mechanism.
% Instead, LuaCJK records the current CJK font in a \LuaTeX\ attribute and
% replaces CJK glyph nodes before line breaking and box packing.
%
% \section{Loading}
%
% \begin{quote}
%   \cs{usepackage}\oarg{options}"{LuaCJK}"
% \end{quote}
%
% LuaCJK requires \LuaLaTeX.  It conflicts with \pkg{luatexja}: loading
% either package before or after the other raises an error.
%
% \begin{function}{\LuaCJKversion}
%   Print the version of LuaCJK.
% \end{function}
%
% \begin{function}{\LuaCJKsetup}
%   \begin{syntax}
%     \tn{LuaCJKsetup} \marg{key-value list}
%   \end{syntax}
%   Configure LuaCJK.  The keys are the ones documented in the following
%   sections, and each setting is local to the current group.
% \end{function}
%
% The same keys may be given as package options:
% \begin{quote}
%   |\usepackage[PunctStyle = banjiao]{LuaCJK}|
% \end{quote}
%
% \section{Font selection}
%
% The main font commands take an optional list of \pkg{fontspec} options.
% Options may be written before or after the font name.
%
% \begin{function}{\setCJKmainfont,\setCJKsansfont,\setCJKmonofont}
%   \begin{syntax}
%     \tn{setCJKmainfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Set the CJK font for the roman, sans serif, and monospaced families.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKfamily{zhsong}中文宋体\quad
\CJKfamily {zhhei}中文黑体\\
\CJKfamily {zhkai}中文楷体\quad
\CJKfamily  {zhfs}中文仿宋
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\setCJKfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfamilyfont} \marg{family} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Define a named CJK family.
% \end{function}
%
% \begin{function}{\CJKfamily}
%   \begin{syntax}
%     \tn{CJKfamily} \marg{family}
%   \end{syntax}
%   Switch to a named CJK family.
% \end{function}
%
% \begin{function}{\newCJKfontfamily}
%   \begin{syntax}
%     \tn{newCJKfontfamily} \oarg{family} \meta{command} \oarg{options} \marg{font}
%   \end{syntax}
%   Define a command that switches to a newly declared family.  The command is
%   local to the current group, like \cs{newfontfamily}.
% \end{function}
%
% \begin{function}{\CJKfontspec}
%   \begin{syntax}
%     \tn{CJKfontspec} \oarg{options} \marg{font}
%   \end{syntax}
%   Select a CJK font for the current group.
% \end{function}
%
% \begin{function}{\songti, \heiti, \fangsong, \kaishu, \lishu, \youyuan}
%   Shortcuts for the families named \texttt{zhsong}, \texttt{zhhei},
%   \texttt{zhfs}, \texttt{zhkai}, \texttt{zhli}, and \texttt{zhyou}.
% \end{function}
%
% \begin{variable}
%   {\CJKrmdefault, \CJKsfdefault, \CJKttdefault, \CJKfamilydefault}
%   The CJK families selected by \tn{rmfamily}, \tn{sffamily}, and
%   \tn{ttfamily}.
% \end{variable}

% \subsection{Sub-blocks}
%
% One CJK font rarely covers every block of \textsc{Unicode}.  A sub-block
% gives a range of characters its own font inside a family; the block then
% becomes an option of the font commands.
%
% \begin{function}{\LuaCJKDeclareSubCJKBlock}
%   \begin{syntax}
%     \tn{LuaCJKDeclareSubCJKBlock} \marg{block} \marg{range list}
%   \end{syntax}
%   Declare \meta{block} with the given ranges, in the same spelling as
%   \cs{LuaCJKDeclareCharClass}.  The name becomes a font option:
%   |\setCJKmainfont{SimSun}[ExtB=SimSun-ExtB]|.  A family that does not set
%   the option leaves those characters in the main font.  Overlapping blocks
%   are resolved in declaration order.
% \end{function}
%
% \begin{function}{\LuaCJKCancelSubCJKBlock, \LuaCJKRestoreSubCJKBlock}
%   \begin{syntax}
%     \tn{LuaCJKCancelSubCJKBlock} \marg{block list} \\
%     \tn{LuaCJKRestoreSubCJKBlock} \marg{block list}
%   \end{syntax}
%   Turn the listed blocks off or on again for the rest of the group.
%   Because the choice of font is recorded per font identifier, two families
%   that supply the same font share one setting: the family that selected the
%   font last decides.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begingroup
  \LuaCJKDeclareSubCJKBlock{Kana}{3040 -> 30FF}
  \setCJKmainfont{FandolSong-Regular.otf}[Kana = FandolKai-Regular.otf]
  中 あ
\endgroup
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \subsection{Fallback fonts}
%
% A CJK font rarely covers every character one needs.  Fallback fonts are
% tried in the order they were declared when the selected CJK font has no
% glyph for a character.
%
% \begin{function}{\setCJKfallbackfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfallbackfamilyfont} \marg{family} \oarg{options} \marg{font}
%   \end{syntax}
%   Add \meta{font} to the fallback list of \meta{family}.  The family may
%   be given as \cs{CJKrmdefault} and friends.  Call the command several
%   times to build a chain; the first font that has the character wins.
% \end{function}
%
% \begin{keyval}
%   \item[\keys{AutoFallBack}]\val{\TFF}
%   Whether to use the declared fallback fonts.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begingroup
  \setCJKmainfont{FandolSong-Regular.otf}
  \setCJKfallbackfamilyfont{\CJKrmdefault}{FandolKai-Regular.otf}
  \LuaCJKsetup{AutoFallBack = true}
  中文
\endgroup
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \subsection{Loading Fandol}
%
% \begin{keyval}
%   \item[\keys{LoadFandol}]\val{\TTF}
%   When the document does not declare any CJK font, load the four Fandol
%   faces at \tn{begin}\marg{document}: Song as the main font, Hei as the
%   sans serif font, Fang as the monospaced font, and all of Song, Hei, Kai,
%   and Fang as the named families.
% \end{keyval}
%
% \subsection{Fake bold and slant}
%
% A CJK family often has no bold or italic face.  The following keys make
% LuaCJK ask \pkg{fontspec} to embolden or slant the regular face instead.
% They apply to families registered afterwards, and are not used when the
% family itself sets \texttt{BoldFont} or \texttt{ItalicFont}.
%
% \begin{keyval}
%   \item[\keys{AutoFakeBold}]\val{\TFF, number}
%   Embolden the regular face when the bold shape is requested.  A number
%   also sets \texttt{EmboldenFactor}.
%   \item[\keys{AutoFakeSlant}]\val{\TFF, number}
%   Slant the regular face when the italic shape is requested.  A number
%   also sets \texttt{SlantFactor}.
%   \item[\keys{EmboldenFactor}]\val{number}: The amount of emboldening.
%   The initial value is \texttt{4}.
%   \item[\keys{SlantFactor}]\val{number}: The amount of slanting, between
%   $-0.999$ and $0.999$.  The initial value is \texttt{0.167}.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begingroup
  \LuaCJKsetup{AutoFakeBold = true}
  \setCJKmainfont{FandolSong-Regular.otf}
  \textbf{中文} and 中文
\endgroup
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\defaultCJKfontfeatures}
%   \begin{syntax}
%     \tn{defaultCJKfontfeatures} \marg{font features}
%   \end{syntax}
%   Set the features prepended to every CJK family registered afterwards.
%   The initial value is |Script = CJK|.  Families registered before the
%   call keep the features they were given.
% \end{function}
%
% \begin{function}{\addCJKfontfeatures}
%   \begin{syntax}
%     \tn{addCJKfontfeatures} \oarg{ignored} \marg{font features}
%   \end{syntax}
%   Add features to the current CJK family for the rest of the group, for
%   example |\addCJKfontfeatures{Scale = 1.2}|.  A leading \texttt{*} is
%   accepted for compatibility with \pkg{xeCJK}, where it also covers the
%   sub-blocks; LuaCJK has no blocks, so both forms act on the same font.
% \end{function}
%
% \section{Spacing}
%
% \begin{keyval}
%   \item[\keys{CJKglue}]\val{glue}: Glue inserted between adjacent CJK
%   characters.  The initial value is
%   \texttt{0pt plus 0.08\cs{baselineskip}}.
%   \item[\keys{CJKecglue}]\val{glue}: Glue inserted between CJK and Latin
%   characters.  The initial value is a normal interword space.
%   \item[\keys{CJKspace}]\val{\TFF}: Whether to keep source spaces between
%   CJK characters.
%   \item[\keys{xCJKecglue}]\val{\TFF}: Whether to replace source spaces
%   between CJK and Latin characters with \texttt{CJKecglue}.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
中文 English 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begingroup
  \LuaCJKsetup{CJKspace = true}
  中 文 中 文
\endgroup
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\normalspacedchars}
%   \begin{syntax}
%     \tn{normalspacedchars} \marg{character list}
%   \end{syntax}
%   The listed characters get no glue on either side, so that a hyphen or a
%   slash inside Latin text does not pull the surrounding text apart.  The
%   initial list is |/|, |\|, and |-|.  The setting is global.
% \end{function}
%
% \section{Suspending the adjustments}
%
% \begin{function}{\LuaCJKdisable, \LuaCJKenable}
%   \begin{syntax}
%     \tn{LuaCJKdisable} \\
%     \tn{LuaCJKenable}
%   \end{syntax}
%   \tn{LuaCJKdisable} stops the typographic adjustments: no \texttt{CJKglue}
%   or \texttt{CJKecglue} is inserted, punctuation is not compressed, no
%   line-breaking prohibitions are added, punctuation is not hung, and CJK
%   characters in math mode are left alone.  CJK characters are still
%   typeset in the CJK font, so text stays readable.  The switch is local to
%   the current group; \tn{LuaCJKenable} turns the adjustments back on.
% \end{function}
%
% This is the hook verbatim-like environments use, and it is also useful when
% measuring raw node lists.
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begingroup
  \LuaCJKdisable
  中 文
\endgroup
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{keyval}
%   \item[\keys{LocalConfig}]\val{\TTF, name}
%   Read local settings from a configuration file.  \texttt{true} loads
%   \file{luacjk.cfg}, \meta{name} loads \file{luacjk-\meta{name}.cfg}, and
%   \texttt{false} (the initial value) loads nothing.  The file is read at
%   the end of the package, so it may use every command LuaCJK defines.  A
%   missing file only warns.
% \end{keyval}
%
% \begin{function}{\LuaCJKShipoutHook}
%   \begin{syntax}
%     \tn{LuaCJKShipoutHook} \marg{code}
%   \end{syntax}
%   Run \meta{code} before every page is shipped out.  The code is added to
%   the \texttt{shipout/before} hook, so it obeys the usual hook ordering.
% \end{function}
%
% \begin{function}{\LuaCJKnobreak}
%   \begin{syntax}
%     \tn{LuaCJKnobreak} \marg{text}
%   \end{syntax}
%   Keep \meta{text} on one line.  The nodes of the argument are marked and
%   the line-breaking pass forbids a break at any of their boundaries.  The
%   marking ends with the current group.
% \end{function}
%
% \begin{function}{\LuaCJKVerbAddon, \LuaCJKOffVerbAddon}
%   \begin{syntax}
%     \tn{LuaCJKVerbAddon} \\
%     \tn{LuaCJKOffVerbAddon}
%   \end{syntax}
%   Make one CJK character as wide as two spaces of the current monospaced
%   font, which keeps columns aligned when a code listing contains CJK text.
%   The gap is added as \texttt{CJKglue}, so the CJK font itself is not
%   scaled; a negative gap only raises a warning and adds nothing.  Breaks
%   between CJK characters are forbidden until the group ends, as in Latin
%   verbatim text.
%
%   The command does nothing at the outermost group level, so it is meant to
%   be used inside the environment that needs it, for example in the
%   \texttt{formatcom} option of \pkg{fancyvrb}.
%   \tn{LuaCJKOffVerbAddon} cancels it again inside the same group.
% \end{function}
%
% \begin{keyval}
%   \item[\keys{Verb}]\val{\TTF, env, env+}
%   What to do inside \tn{verb} and the verbatim-like environments
%   (\env{verbatim}, \env{Verbatim}, \env{lstlisting}, and their
%   relatives).  \texttt{true} suspends the adjustments in both;
%   \texttt{env} keeps them inside the environments but not in \tn{verb},
%   which preserves column alignment when the code contains CJK text;
%   \texttt{env+} keeps them everywhere; \texttt{false} leaves verbatim
%   material entirely alone.  Since \texttt{env+} and \texttt{false} both
%   leave the adjustments on, they behave the same in LuaCJK.
% \end{keyval}
%
% \section{Paragraph endings}
%
% \begin{keyval}
%   \item[\keys{CheckSingle}]\val{\TFF}
%   When on, the last two break points of a paragraph whose final character
%   is CJK are made unbreakable, so a single character cannot end up alone
%   on the last line.  The initial value is \meta{false}.
%   \item[\keys{WidowPenalty}]\val{penalty}: The penalty used by
%   \texttt{CheckSingle}.  The initial value is \texttt{10000}; a lower
%   value allows the break when it is worth the cost.
% \end{keyval}
%
% \pkg{xeCJK} needs the \texttt{NewLineCS}, \texttt{EnvCS},
% \texttt{InlineEnv}, and \texttt{PlainEquation} options to recognise
% \TeX{} constructs while it scans tokens.  LuaCJK looks at the finished
% node list instead, so these options have no counterpart and are not
% accepted.
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begingroup
  \LuaCJKsetup{CheckSingle = true}
  \hsize = 4em 字字字字字字字字字\par
\endgroup
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{CJK in mathematics}
%
% \begin{keyval}
%   \item[\keys{CJKmath}]\val{\TFF}: Whether CJK characters may be typed
%   directly in math mode.  When it is
%   on, such a character is typeset as a box in the CJK math font instead of
%   being looked up in the math font.  Enable it with
%   \cs{LuaCJKsetup}\marg{CJKmath = true} or with the package option
%   |CJKmath = true|.  Without it a CJK character in math mode is looked up
%   in the math font and usually disappears, so LuaCJK issues a one-time
%   warning in that case.
% \end{keyval}
%
% \begin{function}{\setCJKmathfont}
%   \begin{syntax}
%     \tn{setCJKmathfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Select the CJK font used for characters in math mode.  Without this
%   command the CJK main font is used.  This manual enables \texttt{CJKmath}
%   and sets this font in its preamble.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
$ x + 中文 $ and 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{Punctuation}
%
% \begin{keyval}
%   \item[\keys{PunctStyle}]\val{style}: Select a punctuation style.  The
%   implemented styles are
%   \texttt{quanjiao} (the default), \texttt{plain}, \texttt{banjiao},
%   \texttt{kaiming}, \texttt{CCT}, and \texttt{hangmobanjiao}.  An unknown
%   name issues a warning and falls back to \texttt{plain}.
%   \item[\keys{PunctWidth}]\val{length, false}: Give
%   every punctuation mark the same advance, whatever the style says.  A
%   width set with \cs{LuaCJKsetwidth} still wins for that mark.
%   \item[\keys{PunctBoundWidth}]\val{length, false}: How much of a mark's
%   advance stays inside the line when the mark ends the line; the rest of
%   the ink hangs into the margin, and the line keeps its width.  This
%   replaces the fixed half-em shift of \texttt{hangmobanjiao} at the end of
%   a line, while a mark at the start of a line is still shifted by the
%   style.  \texttt{false} turns the option off.
%   \item[\keys{LatinPunct}]\val{\TFF}: Treat the quotation marks
%   (\texttt{‘ ’ “ ”}), the middle dot (\texttt{·}), and the ellipses
%   (\texttt{⋯ … ‧}) as Latin punctuation: they stay in the current Latin
%   font and are not compressed.  This keeps an apostrophe inside an English
%   word from turning into a full-width form.  The em dash is not affected.
%   \item[\keys{PunctFamily}]\val{family, false}: Use a
%   different CJK family for the punctuation marks.  The family must be
%   declared with \cs{setCJKfamilyfont}; \texttt{false} (the initial value)
%   makes the marks follow the text again.
%   \item[\keys{AllowBreakBetweenPuncts}]\val{\TFF}: Whether two adjacent
%   punctuation marks may be separated by a line break.  The marks are still
%   compressed.
%   \item[\keys{PunctKinsoku}]\val{\TTF}: Whether to apply line-breaking
%   prohibitions for punctuation.  A closing
%   or middle punctuation cannot start a line, an opening punctuation cannot
%   end a line, and a run of long punctuation is kept together.  The
%   prohibitions are independent of \texttt{PunctStyle}, so they stay active
%   with |PunctStyle = plain|.
% \end{keyval}
%
% \subsection{Punctuation character sets}
%
% Each of these keys comes in three forms: the plain one replaces the set,
% the form with \texttt{+} adds characters, and the form with \texttt{-}
% removes them.  Ranges use the same spelling as
% \cs{LuaCJKDeclareCharClass}.
%
% \begin{keyval}
%   \item[\keys{KaiMingPunct(+-)}]\val{char list}:
%   The marks that keep a full width in the \texttt{kaiming} style.
%   Initially \texttt{。}、\texttt{．}、\texttt{？}、\texttt{！}.
%   \item[\keys{MiddlePunct(+-)}]\val{char list}:
%   The marks centred between the two halves of their box.  A middle mark
%   cannot start a line.
%   \item[\keys{LongPunct(+-)}]\val{char list}: The
%   marks that are never compressed against each other, such as dashes and
%   ellipses.
%   \item[\keys{NoBreakLongPunct(+-)}]
%   \val{char list}: The long marks that must not be separated by a line
%   break.  Initially the same as \texttt{LongPunct}.
% \end{keyval}
%
% \begin{function}{\LuaCJKDeclareCharClass}
%   \begin{syntax}
%     \tn{LuaCJKDeclareCharClass} \marg{class} \marg{range list}
%   \end{syntax}
%   Override the class of a code-point range.  Ranges use the \pkg{xeCJK}
%   spelling, hexadecimal with a leading |"| and |"START -> "END| for a
%   range; the list is comma separated.
%
%   The classes are the ones \pkg{xeCJK} knows, mapped onto the LuaCJK
%   model: \texttt{CJK} and \texttt{Default} make the range behave like CJK
%   or Latin text; \texttt{FullLeft} and \texttt{HalfLeft} treat it as an
%   opening mark, \texttt{FullRight} and \texttt{HalfRight} as a closing
%   mark, so the line-breaking prohibitions apply; \texttt{NormalSpace}
%   takes the range out of the CJK/Latin glue, like
%   \cs{normalspacedchars}; \texttt{CJStarter}, \texttt{CM}, and
%   \texttt{Boundary} are treated as \texttt{CJK}, because \LuaTeX\ has no
%   model of combining marks or run boundaries.
% \end{function}
%
% \begin{function}{\LuaCJKDeclarePunctClass}
%   \begin{syntax}
%     \tn{LuaCJKDeclarePunctClass} \marg{group} \marg{range list}
%   \end{syntax}
%   Override the punctuation group of a range.  The groups are
%   \texttt{open}, \texttt{close}, \texttt{middle}, \texttt{dash}, and
%   \texttt{ellipsis}; \texttt{none} removes the punctuation treatment, so
%   the characters are no longer compressed or hung.
% \end{function}
%
% \begin{function}{\LuaCJKResetCharClass}
%   Drop every class and punctuation override declared so far, and put the
%   normal-spaced set back to the characters of
%   \texttt{\textbackslash normalspacedchars}.
% \end{function}
%
% \begin{function}{\LuaCJKEditPunctStyle}
%   \begin{syntax}
%     \tn{LuaCJKEditPunctStyle} \marg{style} \marg{key-value list}
%   \end{syntax}
%   Change the parameters of an existing style.  The keys are
%   \texttt{compress-adjacent}, \texttt{adjacent-ratio}, and
%   \texttt{keep-open-close}; a key that is not given keeps its value.
% \end{function}
%
% \begin{function}{\LuaCJKsetwidth}
%   \begin{syntax}
%     \tn{LuaCJKsetwidth} \marg{punctuation list} \marg{length}
%   \end{syntax}
%   Give the listed punctuation marks a fixed advance, overriding the
%   selected \texttt{PunctStyle} and \texttt{PunctWidth}.  The setting is
%   global: a group does not restore the previous width, and a later call
%   adds to the table rather than replacing it.  A leading \texttt{*} is
%   accepted for compatibility with \pkg{xeCJK}, where it sets the width
%   used at the start or end of a line; that case is not implemented and
%   warns once.
% \end{function}
%
% \begin{function}{\LuaCJKsetkern}
%   \begin{syntax}
%     \tn{LuaCJKsetkern} \marg{before} \marg{after} \marg{length}
%   \end{syntax}
%   Set the gap between two adjacent punctuation marks, overriding the
%   style.  Only the first character of each argument is used.  Like
%   \cs{LuaCJKsetwidth}, the setting is global.
% \end{function}
%
% \begin{function}{\LuaCJKDeclarePunctStyle}
%   \begin{syntax}
%     \tn{LuaCJKDeclarePunctStyle} \marg{name} \marg{key-value list}
%   \end{syntax}
%   Define a punctuation style.  The available keys are
%   \texttt{compress-adjacent}, \texttt{adjacent-ratio}, and
%   \texttt{keep-open-close}.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
字，，字
\end{codemo}
% \iffalse
%</example>
% \fi

% \section{Font effects}
%
% The companion package \pkg{LuaCJKfntef} provides underlining, emphasis
% dots, and strike-through.  It builds on \pkg{lua-ul}, so the decorated text
% may contain arbitrary commands, CJK and Latin text, and may still be
% hyphenated and broken between lines.
%
% \begin{function}{\CJKunderline}
%   \begin{syntax}
%     \tn{CJKunderline} \oarg{options} \marg{text}
%   \end{syntax}
%   Underline \meta{text}.  The options are
%   \begin{itemize}
%     \item \texttt{thickness}, the thickness of the rule;
%     \item \texttt{depth}, the distance from the baseline to the top of the
%       rule;
%     \item \texttt{textformat}, code applied to the text, for example
%       |textformat=\bfseries|;
%     \item \texttt{format}, the colour of the rule, given as a color name,
%       for example |format=red|.  \pkg{xeCJK} takes code here
%       (|format=\color{red}|); a color name is all LuaCJK needs, and the
%       color affects the rule only, not the text;
%     \item \texttt{subtract}, a length (or \texttt{true} for half an em)
%       taken off the rule at both ends, so two neighbouring commands do not
%       run together;
%     \item \texttt{skip}, which leaves the punctuation out of the rule;
%     \item \texttt{hidden}, which hides the text and keeps the rule, with
%       the width, height, and depth of the hidden text;
%     \item \texttt{boxdepth}, the depth that the rule may add to the box.
%       The ink is not moved, so the rule still shows; |boxdepth=0pt| keeps
%       the rule from changing the line spacing.
%   \end{itemize}
%   These four keys work the same way for \cs{CJKunderdblline},
%   \cs{CJKunderwave}, \cs{CJKxout}, and \cs{CJKunderdot}.
%   The default geometry is the one \pkg{lua-ul} uses.  Any other key is
%   passed to \pkg{lua-ul}, which understands |top|, |bottom|, and |height|;
%   note that \pkg{lua-ul} expects |bottom| to be a negative length.  A
%   leading \texttt{*} or \texttt{-} is accepted for compatibility with
%   \pkg{xeCJKfntef} and ignored.
% \end{function}
%
% \begin{function}{\CJKunderdblline}
%   \begin{syntax}
%     \tn{CJKunderdblline} \oarg{options} \marg{text}
%   \end{syntax}
%   Put two parallel rules under \meta{text}.  The optional argument
%   takes the same keys as \cs{CJKunderline}.  A leading \texttt{*} or
%   \texttt{-} is accepted and ignored.
% \end{function}
%
% \begin{function}{\CJKunderwave}
%   \begin{syntax}
%     \tn{CJKunderwave} \oarg{options} \marg{text}
%   \end{syntax}
%   Put a wave under \meta{text}.  The wave is drawn with \pkg{l3draw} and
%   repeated with \tn{leaders}, so it has the same phase across the parts of
%   one line.  The optional argument takes the same keys as
%   \cs{CJKunderline}.
% \end{function}
%
% \begin{function}{\CJKxout}
%   \begin{syntax}
%     \tn{CJKxout} \oarg{options} \marg{text}
%   \end{syntax}
%   Strike \meta{text} out with a repeated slash, like \pkg{ulem}'s
%   \tn{xout}.  The optional argument takes the same keys as
%   \cs{CJKunderline}.
% \end{function}
%
% \begin{function}{\CJKunderanyline}
%   \begin{syntax}
%     \tn{CJKunderanyline} \marg{depth} \marg{object} \marg{text}
%   \end{syntax}
%   Put \meta{object} under \meta{text}, lowered by \meta{depth} and
%   repeated by \tn{leaders}.  The type is cached, so the same arguments
%   reuse one underline type.  For example, a highlight:
%   |\CJKunderanyline{0.5ex}{\color{yellow}\rule{1.5pt}{2.5ex}}{...}|.
% \end{function}
%
% \begin{function}{\CJKunderanysymbol}
%   \begin{syntax}
%     \tn{CJKunderanysymbol} \oarg{options} \marg{depth} \marg{symbol}
%       \marg{text}
%   \end{syntax}
%   The same, with a gap between two symbols.  The option \texttt{sep}
%   sets the gap; the initial value is \texttt{0.1em}.
% \end{function}
%
% \begin{function}{\CJKunderdot}
%   \begin{syntax}
%     \tn{CJKunderdot} \oarg{options} \marg{text}
%   \end{syntax}
%   Put emphasis dots under \meta{text}.  The optional argument takes the
%   same keys as \cs{CJKunderline}.
% \end{function}
%
% \begin{function}{\CJKsout}
%   \begin{syntax}
%     \tn{CJKsout} \oarg{color} \marg{text}
%   \end{syntax}
%   Strike \meta{text} through.  The optional argument is the color of the
%   rule.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKunderline{中文 test 中文}\\
\CJKunderdblline{中文 test 中文}\\
\CJKunderwave{中文 test 中文}\\
\CJKunderdot{中文 test 中文}\\
\CJKsout{中文 test 中文}\\
\CJKxout{中文 test 中文}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{environment}{CJKfilltwosides}
%   \begin{syntax}
%     \tn{begin}\marg{CJKfilltwosides}\oarg{position}\marg{width}
%       \meta{line} \tn{} \meta{line} \dots
%     \tn{end}\marg{CJKfilltwosides}
%   \end{syntax}
%   Set the lines in a vertical box whose lines are justified to
%   \meta{width}, separated by |\\|.  The \meta{position} places the box on
%   the baseline: \texttt{t} for top, \texttt{c} for centred (the default),
%   or \texttt{b} for bottom.  A width of zero or less keeps the surrounding
%   line width.  The starred form behaves the same; unlike \pkg{xeCJK} it
%   does not additionally compare against the natural width of the content.
% \end{environment}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begin{CJKfilltwosides}{6em}
瞻彼阕者，\\
虚室生白
\end{CJKfilltwosides}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{Comparison with \pkg{xeCJK}}
%
% \pkg{LuaCJK} follows the \pkg{xeCJK} interface where the two engines allow
% it, but a \LuaTeX{} node list is not an \XeTeX{} character class table, so
% some options mean something slightly different here, and some have no
% counterpart at all.  This section records the differences so that a
% document can be migrated with the eyes open.
%
% \subsection{Available with the same meaning}
%
% \begin{itemize}
%   \item The font commands \cs{setCJKmainfont}, \cs{setCJKsansfont},
%     \cs{setCJKmonofont}, \cs{setCJKfamilyfont}, \cs{newCJKfontfamily},
%     \cs{CJKfontspec}, and \cs{setCJKmathfont}, with the options before or
%     after the font name.
%   \item \cs{CJKfamily}, the four \cs{CJK...default} family names, and
%     \cs{defaultCJKfontfeatures} and \cs{addCJKfontfeatures}.
%   \item \texttt{CJKglue}, \texttt{CJKecglue}, \texttt{CJKspace}, and
%     \texttt{xCJKecglue}.
%   \item \cs{normalspacedchars}.
%   \item \texttt{AutoFakeBold}, \texttt{AutoFakeSlant},
%     \texttt{EmboldenFactor}, and \texttt{SlantFactor}.
%   \item \texttt{CJKmath} and \cs{setCJKmathfont}.
%   \item \texttt{PunctStyle} with the six presets, \cs{xeCJKDeclarePunctStyle}
%     and \cs{xeCJKEditPunctStyle} (the keys differ, see below),
%     \cs{xeCJKsetwidth} and \cs{xeCJKsetkern} (as \cs{LuaCJKsetwidth} and
%     \cs{LuaCJKsetkern}), \texttt{PunctFamily}, \texttt{KaiMingPunct},
%     \texttt{MiddlePunct}, \texttt{LongPunct}, and \texttt{NoBreakLongPunct}
%     with their \texttt{+} and \texttt{-} forms.
%   \item \texttt{CheckSingle} and \texttt{WidowPenalty}.
%   \item \texttt{PunctWidth} and \texttt{PunctBoundWidth}, and
%     \cs{xeCJKnobreak}, \cs{xeCJKShipoutHook}, \cs{xeCJKVerbAddon}, and
%     \cs{xeCJKOffVerbAddon} as the \cs{LuaCJK...} spellings.
%   \item \cs{xeCJKDeclareSubCJKBlock} with its cancel and restore commands,
%     as the \cs{LuaCJK...} spellings.
%   \item \cs{xeCJKDeclareCharClass}, with all the class names of
%     \pkg{xeCJK}; \texttt{CJStarter}, \texttt{CM}, and \texttt{Boundary}
%     are approximated, as described with the command.
%   \item \cs{setCJKfallbackfamilyfont} and \texttt{AutoFallBack},
%     \texttt{LoadFandol}, and \texttt{LocalConfig}.
% \end{itemize}
%
% \subsection{Available with a different meaning}
%
% \begin{itemize}
%   \item \texttt{xeCJKactive} becomes \cs{LuaCJKdisable} and
%     \cs{LuaCJKenable}.  The switch is stored per node, so it follows the
%     \TeX{} grouping, and CJK characters keep their font while the
%     adjustments are off.
%   \item \texttt{Verb} accepts the four \pkg{xeCJK} values, but
%     \texttt{env+} behaves like \texttt{false}: both leave the adjustments
%     on, so the distinction has no observable effect here.
%   \item The punctuation geometry is approximate.  \texttt{banjiao},
%     \texttt{kaiming}, and \texttt{CCT} give a mark half, half (with the
%     sentence-ending marks full), or 0.7 of the current size, and the
%     hanging shift is half an em.  \pkg{xeCJK} instead measures the real
%     side bearings of each glyph.
%   \item \cs{LuaCJKDeclarePunctStyle} takes \texttt{compress-adjacent},
%     \texttt{adjacent-ratio}, and \texttt{keep-open-close} instead of the
%     thirty geometry keys of \pkg{xeCJK}.
%   \item \texttt{CJKfilltwosides*} does not compare with the natural width
%     of its content.
%   \item The \pkg{LuaCJKfntef} option \texttt{format} takes the colour of
%     the rule as a name (|format=red|), not as code
%     (|format=\color{red}|).
% \end{itemize}
%
% \subsection{Not available}
%
% \begin{itemize}
%   \item \texttt{NewLineCS}, \texttt{EnvCS}, \texttt{InlineEnv}, and
%     \texttt{PlainEquation}.  They exist so that \pkg{xeCJK} can recognise
%     \TeX{} constructs while it scans tokens; LuaCJK looks at the finished
%     node list and needs no hint.
%   \item \texttt{PoZheHaoLigature}, because \LuaTeX\ shapes one glyph at a
%     time, so two dashes cannot be merged into the ligature of the font.
%   \item \texttt{RubberPunctSkip}, because the advance of a punctuation mark
%     is a fixed kern rather than stretchable glue.
%   \item \texttt{CheckFullRight}, because it needs the control sequence that
%     follows the mark, which the node list no longer shows.  Use
%     \cs{LuaCJKnobreak} for the few places that need it.
%   \item The detailed punctuation keys of \pkg{xeCJK}
%     (\texttt{fixed-punct-*}, \texttt{mixed-*}, \texttt{middle-*},
%     \texttt{bound-*}, \texttt{kerning-*}, \texttt{optimize-*},
%     \texttt{margin-minimum}), which describe \pkg{xeCJK}'s model of
%     adjusting the side bearings.
%   \item In \pkg{LuaCJKfntef}: the \texttt{gap}, \texttt{height},
%     \texttt{symbol}, and \texttt{ulem} options.  \cs{CJKsout} takes a
%     color instead of the option list of \pkg{xeCJK}.
%   \item The \pkg{xeCJK-listings} integration.
%   \item A \pkg{ctex} backend.  The package is not wired into
%     \pkg{ctex} yet; that needs the agreement of the \pkg{ctex}
%     maintainers.
% \end{itemize}
%
% \end{documentation}
%
% \StopEventually{\clearpage\PrintIndex}
%
% \begin{implementation}
%
% \section{Implementation}
%
% \begin{macrocode}
%<*package>
%    \end{macrocode}
%
% \begin{macrocode}
%<@@=LuaCJK>
%    \end{macrocode}
%
% \subsection{Engine check and package loading}
%
% LuaCJK only works with \LuaTeX.  The engine test runs before any other
% package is loaded, so that a wrong engine stops with a clear message.
%    \begin{macrocode}
\sys_if_engine_luatex:F
  {
    \msg_new:nnn { LuaCJK } { engine }
      { LuaCJK~requires~LuaTeX. }
    \msg_critical:nn { LuaCJK } { engine }
    \tex_endinput:D
  }
\RequirePackage { l3keys2e }
\RequirePackage { fontspec }
\RequirePackage { xparse }
%    \end{macrocode}
%
% \begin{macro}{\LuaCJKversion}
%   The version of the package.
%   \begin{variable}[internal]{\c_LuaCJK_version_tl}
%     The version string, taken from the package metadata.
%    \begin{macrocode}
\tl_const:Nx \c_LuaCJK_version_tl { \ExplFileVersion }
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\cs_new:Npn \LuaCJKversion { \tl_use:N \c_LuaCJK_version_tl }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Conflicting packages}
%
% \pkg{luatexja} installs its own CJK font and spacing layer and works on the
% same callbacks as LuaCJK, so the two are rejected whatever the loading
% order.  \pkg{xeCJK} needs no check here: it stops by itself on any engine
% other than \XeTeX.
%    \begin{macrocode}
\msg_new:nnn { LuaCJK } { luatexja-conflict }
  {
    LuaCJK~and~LuaTeX-ja~must~not~be~loaded~together.\\
    Load~only~one~of~them.
  }
\cs_if_exist:cT { ver@luatexja.sty }
  { \msg_critical:nn { LuaCJK } { luatexja-conflict } }
\AddToHook { package/luatexja/before }
  { \msg_critical:nn { LuaCJK } { luatexja-conflict } }
%    \end{macrocode}
%

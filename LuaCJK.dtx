% \begin{macro}{\CJKfilltwosides}
%   Set the body in a vertical box whose lines are justified to the given
%   width, with the lines separated by \tn{}.  The optional argument places
%   the box on the baseline: \texttt{t} for top, \texttt{c} for centred (the
%   default), and \texttt{b} for bottom.  A width of zero or less keeps the
%   surrounding line width.
%   \begin{variable}[internal]
%     {\l_LuaCJKfntef_fill_box, \l_LuaCJKfntef_fill_width_dim,
%      \l_LuaCJKfntef_fill_half_dim, \l_LuaCJKfntef_fill_position_tl}
%     The box being filled, its requested width, the half height used for
%     centring, and the requested baseline position.
%    \begin{macrocode}
\box_new:N \l_LuaCJKfntef_fill_box
\dim_new:N \l_LuaCJKfntef_fill_width_dim
\dim_new:N \l_LuaCJKfntef_fill_half_dim
\tl_new:N \l_LuaCJKfntef_fill_position_tl
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJKfntef_fill_begin:nn #1#2
  {
    \group_begin:
    \tl_set:Nn \l_LuaCJKfntef_fill_position_tl {#1}
    \dim_set:Nn \l_LuaCJKfntef_fill_width_dim {#2}
    \vbox_set:Nw \l_LuaCJKfntef_fill_box
      \dim_compare:nNnT { \l_LuaCJKfntef_fill_width_dim } > { 0pt }
        { \hsize = \l_LuaCJKfntef_fill_width_dim }
      \let \\ \par
      \noindent \ignorespaces
  }
\cs_new_protected:Npn \LuaCJKfntef_fill_end:
  {
    \par
    \vbox_set_end:
    \str_case:Vn \l_LuaCJKfntef_fill_position_tl
      {
        { t }
          {
            \dim_set:Nn \l_LuaCJKfntef_fill_half_dim
              { \box_ht:N \l_LuaCJKfntef_fill_box
                + \box_dp:N \l_LuaCJKfntef_fill_box }
            \box_set_ht:Nn \l_LuaCJKfntef_fill_box { 0pt }
            \box_set_dp:Nn \l_LuaCJKfntef_fill_box
              { \l_LuaCJKfntef_fill_half_dim }
          }
        { c }
          {
            \dim_set:Nn \l_LuaCJKfntef_fill_half_dim
              { ( \box_ht:N \l_LuaCJKfntef_fill_box
                  + \box_dp:N \l_LuaCJKfntef_fill_box ) / 2 }
            \box_set_ht:Nn \l_LuaCJKfntef_fill_box
              { \l_LuaCJKfntef_fill_half_dim }
            \box_set_dp:Nn \l_LuaCJKfntef_fill_box
              { \l_LuaCJKfntef_fill_half_dim }
          }
      }
      { }
    \box_use_drop:N \l_LuaCJKfntef_fill_box
    \group_end:
  }
\NewDocumentEnvironment { CJKfilltwosides } { O{c} m }
  { \LuaCJKfntef_fill_begin:nn {#1} {#2} }
  { \LuaCJKfntef_fill_end: }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\CJKfilltwosides*}
%   The starred form behaves like the plain one; a width of zero or less
%   keeps the surrounding line width in both.
%    \begin{macrocode}
\NewDocumentEnvironment { CJKfilltwosides* } { O{c} m }
  { \LuaCJKfntef_fill_begin:nn {#1} {#2} }
  { \LuaCJKfntef_fill_end: }
%</fntef>

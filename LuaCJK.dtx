% Every decoration takes the same options, so one key set serves them all:
% the keys a command does not use are accepted and ignored, and a bare item
% that is not a key is a color name, which is \keys{format}.
%
% \begin{macro}[int]{\@@_fntef_option_pair:nn, \@@_fntef_option_bare:n,
%   \@@_fntef_options:n}
% Parse the option list of a decoration and reset the defaults first.
% A pair goes to the key set as it is; a bare item is a key when it exists
% and a color name otherwise, so |[subtract]| keeps its meaning and |[red]|
% is |[format = red]|.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_option_pair:nn #1#2
  { \keys_set:nn { LuaCJKfntef / decoration } { #1 = {#2} } }
\cs_new_protected:Npn \@@_fntef_option_bare:n #1
  {
    \keys_if_exist:nnTF { LuaCJKfntef / decoration } {#1}
      { \keys_set:nn { LuaCJKfntef / decoration } {#1} }
      { \keys_set:nn { LuaCJKfntef / decoration } { format = #1 } }
  }
\cs_new_protected:Npn \@@_fntef_options:n #1
  {
    \@@_fntef_reset_decoration:
    \tl_if_novalue:nF {#1}
      {
        \keyval_parse:NNn
          \@@_fntef_option_bare:n \@@_fntef_option_pair:nn {#1}
      }
  }
%    \end{macrocode}
% \end{macro}

% and the keys that \pkg{lua-ul} receives.
%    \begin{macrocode}
\dim_new:N \l_@@_fntef_depth_dim
\dim_new:N \l_@@_fntef_thickness_dim
\tl_new:N \l_@@_fntef_textformat_tl
\tl_new:N \l_@@_fntef_format_tl
\dim_new:N \l_@@_fntef_subtract_dim
\tl_new:N \l_@@_fntef_skip_tl
\tl_new:N \l_@@_fntef_skip_js_tl
\bool_new:N \l_@@_fntef_hidden_bool
\dim_new:N \l_@@_fntef_rule_height_dim
\dim_new:N \l_@@_fntef_rule_depth_dim
\prop_new:N \g_@@_fntef_format_prop
\int_new:N \g_@@_fntef_format_int
\tl_new:N \l_@@_fntef_cache_key_tl
\tl_new:N \l_@@_fntef_cache_name_tl
\tl_new:N \l_@@_fntef_pass_tl
\dim_new:N \l_@@_fntef_top_dim
\dim_new:N \l_@@_fntef_bottom_dim
\dim_new:N \l_@@_fntef_gap_dim
\dim_new:N \l_@@_fntef_height_dim
\tl_new:N \l_@@_fntef_symbol_tl

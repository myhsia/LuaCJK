% \begin{macro}[int]{\@@_load_cj:}
% Read the \texttt{CJ} set from \file{LineBreak.txt} once.
% The key \keys{CJLineBreak} calls this when it selects \texttt{strict};
% a second call is cheap because the Lua side remembers that it has read
% the file.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_load_cj:
  { \lua_now:e { LuaCJK.load_cj() } }

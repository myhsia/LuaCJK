% \begin{macro}[int]{\@@_math_font_update:}
% Register the CJK family used by the current settings as a math family and
% hand the fallback chain of that family to Lua, or clear the math font
% attribute when \keys{CJKmath} is off or the family is not known.
% \cs{@@_update_font:} runs it at every font selection, and
% \cs{@@_math_version_refresh:} runs it again when the math version changes,
% which is why it stands on its own.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_math_font_update:
  {
    \tl_if_eq:NnTF \l_@@_cjk_math_tl { 1 }
      {
        \tl_if_empty:NTF \l_@@_math_family_tl
          { \tl_set_eq:NN \l_@@_tmpa_tl \l_@@_family_tl }
          { \tl_set_eq:NN \l_@@_tmpa_tl \l_@@_math_family_tl }
        \prop_get:NVNTF \g_@@_family_prop \l_@@_tmpa_tl \l_@@_tmpb_tl
          {
            \exp_args:NV \@@_register_math_family:n \l_@@_tmpb_tl
            \exp_args:NV \@@_math_fallbacks_push:n \l_@@_tmpa_tl
          }
          { \g_@@_math_font_attr = \c_zero_int }
      }
      { \g_@@_math_font_attr = \c_zero_int }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_update_font:}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{PunctFamily}, which sets a
%   separate CJK family for the punctuation marks.}
% \changes{v0.0.3}{2026/11/20}{\keys{PunctFamily} shifts its marks by the
%   \keys{Baseline} of the family it names.}
% On every \tn{selectfont}, resolve the current family, its fallback
% families, the math family, and the \keys{PunctFamily} family to font
% identifiers and store them in the attributes, and hand the \keys{Baseline}
% offset of each to Lua.
% The punctuation family takes a selection of its own, because nothing reaches
% it through \cs{CJKfamily}; without the offset handed over here its marks
% would stand on the baseline of a font they are not set in.
% \begin{variable}[int]{\l_@@_selectfont_bool, \g_@@_fontid_int}
% A guard against re-entering the update while \tn{selectfont} runs,
% and the font identifier of the current CJK family.
%    \begin{macrocode}
\bool_new:N \l_@@_selectfont_bool
\int_new:N \g_@@_fontid_int
%    \end{macrocode}
% \end{variable}
% \begin{variable}[int]
%   {
%     \l_@@_math_family_tl, \l_@@_punct_family_tl,
%     \g_@@_punct_fontid_int
%   }
% The math family registered by \cs{setCJKmathfont}, the family chosen by
% \keys{PunctFamily}, and the font identifier resolved for the latter.
%    \begin{macrocode}
\tl_new:N \l_@@_math_family_tl
\tl_new:N \l_@@_punct_family_tl
\int_new:N \g_@@_punct_fontid_int
%    \end{macrocode}
% \end{variable}
% \begin{variable}[int]
%   {
%     \g_@@_math_family_int, \g_@@_math_family_prop,
%     \c_@@_math_family_max_int
%   }
% The last math family number handed out, the map from a CJK family name to
% its number, and the upper bound.
% A CJK character in a math list needs a math family of its own, because the
% family is what selects the font \emph{and} its size for the three math
% styles.  \LaTeXe\ allocates the 256 families that \LuaTeX\ allows from zero
% upwards, so the numbers start at 240; a document that needs more than
% sixteen numbers is out of luck and gets an error.
% A fallback font used in math takes a number of its own, and the families
% that declare it share that number.
%    \begin{macrocode}
\int_new:N \g_@@_math_family_int
\int_gset:Nn \g_@@_math_family_int { 239 }
\int_const:Nn \c_@@_math_family_max_int { 255 }
\prop_new:N \g_@@_math_family_prop
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_update_font:
  {
    \bool_if:NF \l_@@_selectfont_bool
      {
        \bool_set_true:N \l_@@_selectfont_bool
        \prop_get:NVNTF \g_@@_family_prop \l_@@_family_tl \l_@@_family_name_tl
          {
            \group_begin:
              \exp_args:NV \@@_family_font:n \l_@@_family_name_tl
              \selectfont
              \int_gset:Nn \g_@@_fontid_int
                { \tex_fontid:D \tex_font:D }
              \@@_push_shift:nn
                { \int_use:N \g_@@_fontid_int } { \l_@@_family_name_tl }
            \group_end:
            \g_@@_font_attr = \g_@@_fontid_int
          }
          {
            \g_@@_font_attr = \c_zero_int
            \tl_clear:N \l_@@_family_name_tl
          }
        \@@_math_font_update:
        \@@_push_fallback:
        \@@_push_block_fonts:
        \tl_if_empty:NTF \l_@@_punct_family_tl
          { \g_@@_punct_font_attr = \c_zero_int }
          {
            \prop_get:NVNTF \g_@@_family_prop \l_@@_punct_family_tl
              \l_@@_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \@@_family_font:n \l_@@_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_@@_punct_fontid_int
                    { \tex_fontid:D \tex_font:D }
                  \@@_push_shift:nn
                    { \int_use:N \g_@@_punct_fontid_int }
                    { \l_@@_tmpa_tl }
                \group_end:
                \g_@@_punct_font_attr = \g_@@_punct_fontid_int
              }
              { \g_@@_punct_font_attr = \c_zero_int }
          }
        \bool_set_false:N \l_@@_selectfont_bool
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_math_family:n}
% Give a CJK family or one of its fallback fonts a math family number.
% A number is handed out once per family name, so two CJK families that
% declare the same fallback font share its number.
%    \begin{macrocode}
\msg_new:nnn { LuaCJK } { math-family-exhausted }
  {
    Too ~ many ~ CJK ~ and ~ fallback ~ families ~ for ~ the ~ math ~
    families ~ 240--255.
  }
\cs_new_protected:Npn \@@_math_family:n #1
  {
    \prop_if_in:NnF \g_@@_math_family_prop {#1}
      {
        \int_gincr:N \g_@@_math_family_int
        \int_compare:nNnT \g_@@_math_family_int > \c_@@_math_family_max_int
          { \msg_error:nn { LuaCJK } { math-family-exhausted } }
        \prop_gput:NnV \g_@@_math_family_prop {#1}
          \g_@@_math_family_int
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_math_size_set:}
% \begin{variable}[int]{\l_@@_math_size_tl}
% The text size a math family is built at: the size \LaTeXe\ has installed
% the math fonts for, which is \tn{glb@currsize}, and \tn{f@size} before the
% document starts.
% The two differ inside \pkg{amsmath}'s \tn{text}, whose \tn{mathchoice} sets
% \tn{f@size} to the script and scriptscript size for the branches it
% discards, and a math family built there would keep that size for every
% character after the \tn{text}.
%    \begin{macrocode}
\tl_new:N \l_@@_math_size_tl
\cs_new_protected:Npn \@@_math_size_set:
  {
    \tl_set_eq:NN \l_@@_math_size_tl \f@size
    \cs_if_exist:NT \glb@currsize
      {
        \tl_if_empty:NF \glb@currsize
          { \tl_set_eq:NN \l_@@_math_size_tl \glb@currsize }
      }
  }
%    \end{macrocode}
% \end{variable}
% \end{macro}
%
% \begin{macro}[int]{\@@_math_family_fonts:nn}
% Fill the three style fonts of one math family number from a CJK family, at
% the text size of the formula and at seven and five tenths of it, which is
% the ratio of the standard \LaTeX\ size tables.
% The family is selected inside a group, so the caller's font is not
% disturbed, and the assignments are global because a math font belongs to a
% family, not to a group.
% The series and the shape come from the math version, not from the text
% around the formula: the family is selected at \cs{mddefault} and
% \cs{shapedefault}, and, in the \texttt{bold} math version, at
% \cs{bfdefault} as well when the family declares that shape.  The regular
% face is what loads the shape list the test reads, and a family without a
% bold face keeps its regular one in silence.  A formula therefore follows
% \cs{boldmath}, and a \cs{bfseries} that happens to precede it no longer
% leaks into it.
% The font identifier of the text size is recorded in
% \cs{g_@@_math_textfont_int}, which is the font a fallback chain tests for
% the character, because coverage does not depend on the size.
%    \begin{macrocode}
\int_new:N \g_@@_math_textfont_int
\cs_new_protected:Npn \@@_math_family_fonts:nn #1#2
  {
    \group_begin:
      \@@_family_font:n {#1}
      \fontseries { \mddefault }
      \fontshape { \shapedefault }
      \fontsize { \l_@@_math_size_tl pt } { \baselineskip }
      \selectfont
      \bool_lazy_and:nnT
        { \str_if_eq_p:ee { \math@version } { bold } }
        {
          \cs_if_exist_p:c
            { \use:c { f@encoding } / #1 / \bfdefault / \shapedefault }
        }
        { \fontseries { \bfdefault } \selectfont }
      \global \textfont #2 = \font
      \int_gset:Nn \g_@@_math_textfont_int
        { \tex_fontid:D \tex_font:D }
      \fontsize
        { \dim_eval:n { \l_@@_math_size_tl pt * 7 / 10 } }
        { \baselineskip }
      \selectfont
      \global \scriptfont #2 = \font
      \fontsize
        { \dim_eval:n { \l_@@_math_size_tl pt * 5 / 10 } }
        { \baselineskip }
      \selectfont
      \global \scriptscriptfont #2 = \font
    \group_end:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_register_math_family:n}
% \changes{v0.0.3}{2026/11/20}{The three sizes of a CJK math family come from
%   the text size of the formula, so a \tn{text} inside it no longer sets the
%   other characters of the formula in a script size.}
% Register a CJK family as a math family and point the math font attribute at
% its number.
% A CJK character in a math list needs a family rather than a box, because the
% family is what selects the font \emph{and} its size for text, script, and
% scriptscript style; a box is built once and keeps the size it was built at.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_register_math_family:n #1
  {
    \@@_math_family:n {#1}
    \int_set:Nn \l_@@_tmpa_int
      { \prop_item:Nn \g_@@_math_family_prop {#1} }
    \@@_math_size_set:
    \@@_math_family_fonts:nn {#1} \l_@@_tmpa_int
    \g_@@_math_font_attr = \l_@@_tmpa_int
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_math_fallbacks_push:n}
% \changes{v0.0.3}{2026/11/20}{A CJK character in math mode takes a fallback
%   font when the CJK font of the formula does not have it.}
% Register the fallback fonts of a CJK family as math families and hand the
% chain to Lua, which sets the character in the first font that has it.
% The chain holds the text font of the family itself first, so that Lua can
% test it too, then each fallback in the order it was declared, as pairs of a
% font identifier and a math family number.
% The family is given by the key it was declared under, which is the key of
% the fallback list, so a formula falls back like the text of the same family.
%    \begin{macrocode}
\tl_new:N \l_@@_math_fallback_ids_tl
\cs_new_protected:Npn \@@_math_fallbacks_push:n #1
  {
    \bool_if:NT \g_@@_lua_loaded_bool
      {
        \@@_math_size_set:
        \tl_clear:N \l_@@_math_fallback_ids_tl
        \tl_put_right:Nx \l_@@_math_fallback_ids_tl
          {
            \int_use:N \g_@@_math_textfont_int ,
            \int_use:N \g_@@_math_font_attr ,
          }
        \prop_get:NnNT \g_@@_fallback_prop {#1} \l_@@_tmpa_tl
          {
            \exp_args:NV \clist_map_inline:nn \l_@@_tmpa_tl
              {
                \@@_math_family:n {##1}
                \int_set:Nn \l_@@_tmpa_int
                  { \prop_item:Nn \g_@@_math_family_prop {##1} }
                \@@_math_family_fonts:nn {##1} \l_@@_tmpa_int
                \tl_put_right:Nx \l_@@_math_fallback_ids_tl
                  {
                    \int_use:N \g_@@_math_textfont_int ,
                    \int_use:N \l_@@_tmpa_int ,
                  }
              }
          }
        \lua_now:e
          {
            LuaCJK.set_math_fallback
              ( \int_use:N \g_@@_math_font_attr ,
                { \l_@@_math_fallback_ids_tl } )
          }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_math_version_refresh:}
% Register the math family again when the math version changes.
% \LaTeXe\ knows the numbers of its own math families only, so \tn{mathversion}
% cannot reach the fonts of a CJK math family: the version is applied by hand.
% \cs{glb@settings} is where a version change and a text-size change are
% applied, and it runs \tn{every@math@size} afterwards, so that register is
% where the refresh belongs.  It runs there also when the group that changed
% the version ends and the version in force before the group is applied again,
% which is what keeps |{\boldmath $中$}| local.  The guard stops the font
% selections of the registration from running the whole update again.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_math_version_refresh:
  {
    \bool_if:NF \l_@@_selectfont_bool
      {
        \bool_set_true:N \l_@@_selectfont_bool
        \@@_math_font_update:
        \bool_set_false:N \l_@@_selectfont_bool
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_toks_put_right:Nn}
% Append tokens to a token register such as \tn{every@math@size}.
% The register holds tokens rather than a token list variable, and
% \cs{tl_put_right:Nn} would put the name of the register into its own value,
% so the assignment is written out with \tn{the}.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_toks_put_right:Nn #1#2
  { #1 \expandafter { \tex_the:D #1 #2 } }
\exp_args:Nc \@@_toks_put_right:Nn { every@math@size }
  { \@@_math_version_refresh: }
%    \end{macrocode}
% \end{macro}
%
%
% \begin{macro}[int]{\@@_push_block_fonts:}
% Resolve the block fonts of the current family at the current size
% and hand them to Lua, keyed by the font identifier of the family.
% Font identifiers depend on the size,
% so this runs again whenever a font is selected.
%    \begin{macrocode}
\int_new:N \g_@@_block_fontid_int
\cs_new_protected:Npn \@@_push_block_fonts:
  {
    \int_compare:nNnT { \g_@@_fontid_int } > { 0 }
      {
        \clist_map_inline:Nn \g_@@_block_names_clist
          {
            \tl_set:Ne \l_@@_block_key_tl { \l_@@_family_tl | ##1 }
            \int_gzero:N \g_@@_block_fontid_int
            \prop_get:NVNT \g_@@_family_block_prop
              \l_@@_block_key_tl \l_@@_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \@@_family_font:n \l_@@_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_@@_block_fontid_int
                    { \tex_fontid:D \tex_font:D }
                \group_end:
              }
            \lua_now:e
              {
                LuaCJK.set_block_font
                  ( \int_use:N \g_@@_fontid_int ,
                    "\lua_escape:e {##1}" ,
                    \int_use:N \g_@@_block_fontid_int )
              }
          }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% The glues and the settings belong to the size that is being selected,
% but \cs{baselineskip} has not changed yet when the \texttt{selectfont}
% hook runs, so they are refreshed after the font selection.
% The guard keeps the temporary font selections inside \cs{@@_update_font:}
% from doing the same twice.

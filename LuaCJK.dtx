% \begin{macro}[int]{\@@_verbatim@font_hook:}
% Verbatim-like material must usually be left alone.
% \tn{verb} opens its own group and selects \tn{verbatim@font} inside
% it, so extending that command covers \tn{verb} on its own.
% The hook consults the current \keys{Verb} setting, so that
% \cs{LuaCJKsetup} can change the behavior after the package is loaded.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_verbatim@font_hook:
  {
    \tl_if_eq:VnTF \l_@@_verb_mode_tl { true }
      { \LuaCJKdisable }
      {
        \tl_if_eq:VnT \l_@@_verb_mode_tl { env }
          { \LuaCJKdisable }
      }
  }
\cs_if_exist:NT \verbatim@font
  {
    \cs_gset_protected:Npx \verbatim@font
      {
        \exp_not:o { \verbatim@font }
        \exp_not:N \@@_verbatim@font_hook:
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_verbatim_block_disable:, \@@_fv_prep_hook:, \@@_fv_patch:}
% \changes{v0.0.3}{2026/11/20}{The \keys{Verb} option also reaches the inline
%   \tn{Verb} and \tn{UseVerb} of \pkg{fancyvrb}, which never select
%   \tn{verbatim@font} and are set as \tn{verb} sets them; the block commands
%   \tn{VerbatimInput} and \tn{UseVerbatim} follow the environments instead.}
% \pkg{fancyvrb} never selects \tn{verbatim@font}, and its formatting hook
% serves the inline commands and every block at once, so the hook waits for
% the package to be loaded and then applies the rule of the call it serves:
% the rule of \tn{verb} while no block is open, and the rule of the
% environments, which only \texttt{true} suspends, when one is.
% A block is an environment of the list below, or a command that sets saved
% verbatim material, and both mark themselves in their own group.
% The inline commands cannot mark themselves: a token placed after \tn{Verb}
% is scanned as part of its text, because the scanner reads to the end of the
% line, and \tn{FVC@Verb} closes its group from inside the box it sets, so
% neither can be wrapped.  The bool is therefore false by default and set by
% the block side.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_verbatim_block_disable:
  {
    \tl_if_eq:VnT \l_@@_verb_mode_tl { true }
      { \LuaCJKdisable }
  }
\cs_new_protected:Npn \@@_fv_prep_hook:
  {
    \bool_if:NTF \l_@@_verbatim_block_bool
      { \@@_verbatim_block_disable: }
      { \@@_verbatim@font_hook: }
  }
\cs_new_protected:Npn \@@_fv_patch:
  {
    \cs_if_exist:NT \FV@FormattingPrep
      {
        \cs_gset_protected:Npx \FV@FormattingPrep
          {
            \exp_not:N \@@_fv_prep_hook:
            \exp_not:o { \FV@FormattingPrep }
          }
      }
    \cs_if_exist:NT \FV@UseVerbatim
      {
        \cs_gset_eq:NN \@@_fv_use_verbatim: \FV@UseVerbatim
        \cs_gset_protected:Npn \FV@UseVerbatim ##1
          {
            \group_begin:
              \bool_set_true:N \l_@@_verbatim_block_bool
              \@@_fv_use_verbatim: {##1}
            \group_end:
          }
      }
  }
\hook_gput_code:nnn { package / fancyvrb / after } { LuaCJK }
  { \@@_fv_patch: }
\@@_fv_patch:
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_verbatim_env_begin:, \@@_verbatim_env_end:}
% \changes{v0.0.1}{2026/11/11}{Suspend the adjustments inside \cs{verb} and
%   the verbatim-like environments (\env{verbatim}, \pkg{fancyvrb},
%   \pkg{listings}); the \keys{Verb} option (\texttt{true}, \texttt{env},
%   \texttt{env+}, \texttt{false}) controls what is suspended there.}
% Environments that do not go through \tn{verbatim@font} need their own
% hooks. Only the \texttt{true} setting suspends the adjustments here:
% \texttt{env} and \texttt{env+} keep them, which is what keeps code
% columns aligned when CJK text is used inside the code.
% The begin hook marks the block for \cs{@@_fv_prep_hook:} as well, so that
% the formatting hook of \pkg{fancyvrb} applies the rule of the environment
% rather than the rule of \tn{verb} inside it.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_verbatim_env_begin:
  {
    \bool_set_true:N \l_@@_verbatim_block_bool
    \@@_verbatim_block_disable:
  }
\cs_new_protected:Npn \@@_verbatim_env_end:
  {
    \tl_if_eq:VnT \l_@@_verb_mode_tl { true }
      { \LuaCJKenable }
  }
\clist_map_inline:nn
  {
    verbatim,  Verbatim,  BVerbatim,
    verbatim*, Verbatim*, LVerbatim, lstlisting
  }
  {
    \hook_gput_code:nnn { env / #1 / begin } { LuaCJK }
      { \@@_verbatim_env_begin: }
    \hook_gput_code:nnn { env / #1 / end   } { LuaCJK }
      { \@@_verbatim_env_end:   }
  }
%    \end{macrocode}
% \end{macro}

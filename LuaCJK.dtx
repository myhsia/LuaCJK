% \begin{macro}{\LuaCJKdisable, \LuaCJKenable}
% \changes{v0.0.1}{2026/11/05}{Add \cs{LuaCJKdisable} and \cs{LuaCJKenable} to
%   suspend the typographic adjustments while keeping CJK font selection.}
% Set the node attribute that makes the Lua callbacks skip
% the adjustments. The attribute follows the \TeX\ grouping.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKdisable { }
  { \g_@@_disabled_attr = 1 }
\NewDocumentCommand \LuaCJKenable { }
  { \g_@@_disabled_attr = 0 }
%    \end{macrocode}

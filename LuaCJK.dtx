%
% \begin{documentation}
%
% \section{Introduction}
%
% \pkg{LuaCJK} is a \LuaTeX-only package for Chinese typesetting. Its main
% interface is \cs{setCJKmainfont}, \cs{setCJKsansfont}, \cs{setCJKmonofont},
% \cs{setCJKfamilyfont}, \cs{CJKfamily}, and \cs{LuaCJKsetup}.
%
% The current CJK font is recorded in a \LuaTeX\ attribute,
% and CJK glyph nodes are replaced before line breaking and box packing.
%
% \section{Loading}
%
% \begin{quote}
%   \cs{usepackage}\oarg{options}"{LuaCJK}"
% \end{quote}
%
% LuaCJK requires the \LuaTeX\ engine. It conflicts with \pkg{luatexja}:
% loading either package before or after the other raises an error.
%
% \begin{function}{\LuaCJKversion}
%   Print the version of LuaCJK.
% \end{function}
%
% \begin{function}{\LuaCJKsetup}
%   \begin{syntax}
%     \tn{LuaCJKsetup} \marg{key-value list}
%   \end{syntax}
%   Configure LuaCJK.
%   The keys are the ones documented in the following sections.
% \end{function}
%
% The keys fall into two groups.
%
% The settings that describe how text is set are local to the current group,
% and they are recorded on the characters themselves,
% so text inside a group keeps its settings even when the group has already
% ended by the time the paragraph is broken:
% \begin{quote}
%   |\vbox{\begingroup\LuaCJKsetup{CJKglue = 10pt}中中\endgroup\par}|
% \end{quote}
% uses the 10pt glue, although the group is closed before |\par|.
% This group contains
% \begin{itemize}
%   \item \keys{CJKglue, CJKecglue, CJKspace}, and \keys{xCJKecglue};
%   \item \keys{PunctStyle, PunctKinsoku, AllowBreakBetweenPuncts, PunctWidth},
%   and \keys{PunctBoundWidth};
%   \item \keys{LatinPunct} and \keys{CJKmath};
%   \item \keys{CheckSingle, WidowPenalty}, and \keys{CJLineBreak};
%   \item \keys{AutoFallBack} and \keys{Verb};
%   \item the two commands \cs{LuaCJKCancelSubCJKBlock} and
%   \cs{LuaCJKRestoreSubCJKBlock}.
% \end{itemize}
%
% The other keys are global or act while the package is loaded:
% \begin{itemize}
%   \item \keys{KaiMingPunct, MiddlePunct, LongPunct},
%   and \keys{NoBreakLongPunct} edit character sets;
%   \item \keys{AutoFakeBold, AutoFakeSlant, EmboldenFactor},
%   and \keys{SlantFactor} act when a family is registered;
%   \item \keys{LoadFandol} and \keys{LocalConfig} act while the package
%   is loaded.
% \end{itemize}
% The declarations \cs{LuaCJKDeclareCharClass},
% \cs{LuaCJKDeclarePunctClass}, \cs{LuaCJKDeclareSubCJKBlock},
% \cs{LuaCJKsetwidth}, and \cs{LuaCJKsetkern} are global as well,
% as noted with each of them.
%
% The same keys may be given as package options:
% \begin{quote}
%   |\usepackage[PunctStyle = banjiao]{LuaCJK}|
% \end{quote}
%
% \begin{keyval}
%   \item[\keys{LocalConfig}]\val{\TTF, name}
%   Read local settings from a configuration file.
%   \texttt{true} loads \file{luacjk.cfg},
%   \meta{name} loads \file{luacjk-}\meta{name}\file{.cfg},
%   and \texttt{false} (the initial value) loads nothing.
%   The file is read at the end of the package, so it may use every
%   command LuaCJK defines. A missing file only warns.
% \end{keyval}
%
% To use LuaCJK with \pkg{ctex}, pass the \keys{engine} option with the value
% \val{luacjk}:
% \begin{quote}
%   |\documentclass[engine = luacjk]{ctexart}|
% \end{quote}
% \pkg{ctex} then inputs |ctex-engine-luacjk.def| instead of its own
% \LuaTeX\ backend, and that file loads the package, so LuaCJK is not loaded
% separately.
%
% LuaCJK cooperates with the \LaTeX\ tagged-PDF project.
% A document that declares
% \begin{quote}
%   |\DocumentMetadata{tagging = on}|
% \end{quote}
% marks the ink of a decoration as \texttt{artifact}, and a decoration symbol
% is left out of the text a reader copies or selects;
% \keys{selectable = true} keeps the symbol as text.
% Under the \cls{l3doc} class, load \pkg{latex-lab-testphase-l3doc} as well;
% this manual is built that way.
% A PDF reader derives the height of a selection from the font's
% \texttt{hhea} ascent and descent, which is 1.437em for
% \texttt{Noto Serif CJK SC}; the selection is therefore taller than the 1em
% square.  LuaCJK cannot change that, and it does not affect the glyph.
%
% \section{Fonts}
%
% The main font commands take an optional list of \pkg{fontspec} options.
% Options may be written before or after the font name.
%
% \begin{function}{\setCJKmainfont,\setCJKsansfont,\setCJKmonofont}
%   \begin{syntax}
%     \tn{setCJKmainfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Set the CJK font for the roman, sans serif, and monospaced families.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\setCJKmainfont[Scale = 1.2]
  {FandolSong-Regular.otf}中文\\
\setCJKsansfont[Scale = 1.2]
  {FandolKai-Regular.otf}\sffamily 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\setCJKfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfamilyfont}\marg{family}\oarg{options}\marg{font}\oarg{options}
%   \end{syntax}
%   Define a named CJK family.
% \end{function}
%
% \begin{function}{\CJKfamily}
%   \begin{syntax}
%     \tn{CJKfamily} \marg{family}
%   \end{syntax}
%   Switch to a named CJK family.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKfamily{zhsong}中文宋体\quad
\CJKfamily{zhhei}中文黑体\\
\CJKfamily{zhkai}中文楷体\quad
\CJKfamily{zhfs}中文仿宋
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\newCJKfontfamily}
%   \begin{syntax}
%     \tn{newCJKfontfamily}\oarg{family}\meta{command}
%     \                    \oarg{options}\marg{font}\oarg{options}
%   \end{syntax}
%   Define a command that switches to a newly declared family.
%   The command is local to the current group, like \cs{newfontfamily}.
%   The options may be given before or after the font name.
% \end{function}
%
% \begin{function}{\CJKfontspec}
%   \begin{syntax}
%     \tn{CJKfontspec} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Select a CJK font for the current group.
%   The options may be given before or after the font name.
% \end{function}
%
% \begin{function}{\songti, \heiti, \fangsong, \kaishu, \lishu, \youyuan}
%   Shortcuts for the families named \texttt{zhsong}, \texttt{zhhei},
%   \texttt{zhfs}, \texttt{zhkai}, \texttt{zhli}, and \texttt{zhyou}.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\newCJKfontfamily[kai]\mykai{FandolKai-Regular.otf}
  \mykai 中文\quad \songti 中文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{variable}
%   {\CJKrmdefault, \CJKsfdefault, \CJKttdefault,
%   \CJKfamilydefault} The CJK families selected by \tn{rmfamily},
%   \tn{sffamily}, and \tn{ttfamily}, and the family selected by
%   \tn{normalfont}. \cs{CJKfamilydefault} follows \cs{CJKrmdefault}
%   by default.
% \end{variable}

% \subsection{Sub-blocks}
%
% One CJK font rarely covers every block of \textsc{Unicode}.
% A sub-block gives a range of characters its own font inside a family;
% the block then becomes an option of the font commands.
%
% \begin{function}{\LuaCJKDeclareSubCJKBlock}
%   \begin{syntax}
%     \tn{LuaCJKDeclareSubCJKBlock} \marg{block} \marg{range list}
%   \end{syntax}
%   Declare \meta{block} with the given ranges, in the same spelling
%   as \cs{LuaCJKDeclareCharClass}. The name becomes a font option,
%   as the example below shows: a family that sets it uses the second font
%   for the characters of the block, and a family that does not leaves them
%   in the main font. Overlapping blocks are resolved in declaration order.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKDeclareSubCJKBlock{Kana}{3040 -> 30FF}
\setCJKmainfont[Kana = FandolKai-Regular.otf]
  {FandolSong-Regular.otf}中 あ
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKCancelSubCJKBlock, \LuaCJKRestoreSubCJKBlock}
%   \begin{syntax}
%     \tn{LuaCJKCancelSubCJKBlock}  \marg{block list} \\
%     \tn{LuaCJKRestoreSubCJKBlock} \marg{block list}
%   \end{syntax}
%   Turn the listed blocks off or on again for the rest of the group.
%   Because the choice of font is recorded per font identifier,
%   two families that supply the same font share one setting:
%   the family that selected the font last decides.
% \end{function}
%
% \subsection{Fallback fonts}
%
% A CJK font rarely covers every character one needs.
% Fallback fonts are tried in the order they were declared when
% the selected CJK font has no glyph for a character.
%
% \begin{function}{\setCJKfallbackfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfallbackfamilyfont} \marg{family} \oarg{options} \\
%        \                          \marg{font}   \oarg{options}
%   \end{syntax}
%   Add \meta{font} to the fallback list of \meta{family}. The family may
%   be given as \cs{CJKrmdefault} and friends. Call the command several
%   times to build a chain; the first font that has the character wins.
%   The chain is resolved in the weight, shape, and size of the text, so a
%   character in bold takes the bold face of the fallback font.
% \end{function}
%
% \begin{keyval}
%   \item[\keys{AutoFallBack}]\val{\TFF}
%   Whether to use the declared fallback fonts. The switch follows the text
%   like the spacing keys, so it can be turned on for one group.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\setCJKmainfont{FandolSong-Regular.otf}
\setCJKfallbackfamilyfont{\CJKrmdefault}
  {FandolKai-Regular.otf}
\LuaCJKsetup{AutoFallBack = true}中あ
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{Baseline shift}
%
% Two CJK fonts are rarely designed for each other: mixed in one line, the
% characters of one font sit too high or too low.
% A font may carry a \keys{Baseline} value that moves its characters up or
% down, so that the two fonts stand on one baseline.
% The value belongs to the font rather than to the text, which is why it is
% an option of the command that declares the font.
%
% \begin{keyval}
%   \item[\keys{Baseline}]\meta{dimension}
%   Raise the characters of this font by \meta{dimension}; a negative value
%   lowers them. It is an option like the others, so a fallback declaration
%   may carry it as well, and that is its usual use: it makes a fallback font
%   stand on the baseline of the main font. Any \TeX\ unit works, and |em|
%   follows the size. Two declarations that supply the same font share the
%   value of the last one, because a position is recorded per font.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\setCJKfamilyfont{high}[Baseline = .3em]
  {FandolKai-Regular.otf}
\songti 基线\quad\CJKfamily{high}基线
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{Loading Fandol}
%
% \begin{keyval}
%   \item[\keys{LoadFandol}]\val{\TTF}
%   When the document does not declare any CJK font, load the four Fandol
%   faces at |\begin{document}|: Song as the main font,
%   Hei as the sans serif font, Fang as the monospaced font,
%   and all of Song, Hei, Kai, and Fang as the named families.
% \end{keyval}
%
% \subsection{Fake bold and slant}
%
% A CJK family often has no bold or italic face. The following keys make
% LuaCJK ask \pkg{fontspec} to embolden or slant the regular face instead.
% They apply to families registered afterwards, and are not used when the
% family itself sets \texttt{BoldFont} or \texttt{ItalicFont}. They are
% global: a group does not change what an already registered family uses.
%
% \begin{keyval}
%   \item[\keys{AutoFakeBold}]\val{\TFF, number}
%   Embolden the regular face when the bold shape is requested.
%   A number also sets \texttt{EmboldenFactor}.
%   \item[\keys{AutoFakeSlant}]\val{\TFF, number}
%   Slant the regular face when the italic shape is requested.
%   A number also sets \texttt{SlantFactor}.
%   \item[\keys{EmboldenFactor}]\val{number}: The amount of emboldening.
%   The initial value is \texttt{4}.
%   \item[\keys{SlantFactor}]\val{number}: The amount of slanting, between
%   $-0.999$ and $0.999$. The initial value is \texttt{0.167}.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{AutoFakeBold = true}
\setCJKmainfont{FandolSong-Regular.otf}
\textbf{中文} and 中文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\defaultCJKfontfeatures}
%   \begin{syntax}
%     \tn{defaultCJKfontfeatures} \marg{font features}
%   \end{syntax}
%   Set the features prepended to every CJK family registered afterwards.
%   The initial value is |Script = CJK|.
%   Families registered before the call keep the features they were given.
% \end{function}
%
% \begin{function}{\addCJKfontfeatures}
%   \begin{syntax}
%     \tn{addCJKfontfeatures} \oarg{ignored} \marg{font features}
%   \end{syntax}
%   Add features to the current CJK family for the rest of the group,
%   for example |\addCJKfontfeatures{Scale = 1.2}|.
%   A leading \texttt{*} is accepted; both forms act on the same font.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\defaultCJKfontfeatures{Scale = 1.5}
\setCJKfamilyfont{big}{FandolSong-Regular.otf}
\CJKfamily{big}中文\quad
\CJKfamily{zhsong}中文\quad
\addCJKfontfeatures{Scale = 1.2}中文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{CJK in mathematics}
%
% \begin{keyval}
%   \item[\keys{CJKmath}]\val{\TFF}: Whether CJK characters may be typed
%   directly in math mode.
%   When it is on, such a character is set in the CJK font of a math family
%   of its own instead of being looked up in the math font, so a character in
%   a superscript or a fraction takes the size of that math style.
%   Enable it with |\LuaCJKsetup{CJKmath = true}| or with the package option
%   |CJKmath = true|.
%   Such a character takes the font of the math version, as \tn{mathversion}
%   sets it: the bold face of the family in the \texttt{bold} version, its
%   regular face when it has no bold one, and the upright shape of the family
%   rather than the shape of the text.
%   Without it a CJK character in math mode is looked up in the math font
%   and usually disappears, so LuaCJK issues a one-time warning in that case.
% \end{keyval}
%
% \begin{function}{\setCJKmathfont}
%   \begin{syntax}
%     \tn{setCJKmathfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Select the CJK font used for characters in math mode.
%   Without this command the CJK main font is used.
%   This manual enables \keys{CJKmath} and sets this font in its preamble.
%   The selection is local to the current group, like the other font commands:
%   a formula in a group uses the family selected in that group.
% \end{function}
%
% Each CJK family that appears in math is registered as a math family of its
% own, so that \TeX\ can pick the text, script, or scriptscript size of it.
% The family takes its font from the math version: \cs{bfdefault} in the
% \texttt{bold} version and \cs{mddefault} in the others, with the shape
% \cs{shapedefault}.  \cs{boldmath} therefore bolds the CJK characters of a
% formula, within the group that asks for it, and a family without a bold face
% keeps its regular one without a warning.
% The family number comes from the range 240--255, the last sixteen of the 256
% that \LaTeXe\ allocates under \LuaTeX, which an ordinary document never
% reaches; more than sixteen CJK families in math stops with an error.
% The script sizes are seven and five tenths of the current text size, the
% ratio of the standard size tables.
% The math parameters are not taken from the CJK font, which has no
% \texttt{MathConstants} table: they stay those of the document's math font,
% which is why a fraction of two CJK characters has the rule and the gaps of
% the surrounding math.
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
$ x + 中文 $ and 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{Text layout}
%
% \subsection{Spacing}
%
% \begin{keyval}
%   \item[\keys{CJKglue}]\val{glue}: Glue inserted between adjacent CJK
%   characters.
%   The initial value is \texttt{0pt plus 0.08\cs{baselineskip}}, recomputed
%   at every font selection, so it follows the size; a value given
%   by the document is used as written and does not change with the size,
%   and its stretch order (for example |plus 1filll|) is kept as well.
%   \item[\keys{CJKecglue}]\val{glue}: Glue inserted between CJK and Latin
%   characters.
%   Beside a punctuation mark the glue has no advance: the mark's own advance
%   already carries the spacing.
%   The initial value is \texttt{0.3333em plus 0.1667em minus 0.1111em},
%   which follows the size in the same way.
%   \item[\keys{CJKspace}]\val{\TFF}: Whether to keep source spaces between
%   CJK characters. When they are not kept, the space becomes the
%   inter-character glue, so the break opportunity and the stretch survive.
%   \item[\keys{xCJKecglue}]\val{\TFF}: Whether to replace source spaces
%   between CJK and Latin characters with \texttt{CJKecglue}.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
中文 English 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{CJKspace = true}中 文 中 文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\normalspacedchars}
%   \begin{syntax}
%     \tn{normalspacedchars} \marg{character list}
%   \end{syntax}
%   The listed characters get no glue on either side, so that a hyphen
%   or a slash inside Latin text does not pull the surrounding text apart.
%   The initial list is |/|, |\|, and |-|. The setting is global.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
中x中\par
\normalspacedchars{x}中x中
\end{codemo}
\normalspacedchars{/,\,,-}
\endgroup
% \iffalse
%</example>
% \fi
%
% Characters that only control the text and have no advance of their own
% (U+200B, U+200C, U+200D, U+2060, U+180E, U+FEFF, and the variation
% selectors) are removed at the input. They therefore neither take glue nor
% separate two CJK characters: a zero-width space does not add the two
% \keys{CJKecglue} that would otherwise surround it, and the break
% opportunity it was meant to create already exists at the surrounding glue.
% A character requested with \tn{char} is not removed, because \tn{char}
% asks for the glyph itself.
%
% \begin{environment}{CJKfilltwosides}
%   \begin{syntax}
%   \tn{begin}\{CJKfilltwosides\}\oarg{position}\marg{width}
%   \   \meta{lines} \\
%   \tn{end}\{CJKfilltwosides\}
%   \end{syntax}
%   Set the lines in a vertical box whose lines are justified
%   to \meta{width}, separated by |\\|. Its \meta{position} argument puts
%   the box on the baseline: \texttt{t} for top, \texttt{c} for centered
%   (the default), or \texttt{b} for bottom. A width of zero or less keeps
%   the surrounding line width. The starred form behaves the same;
%   it does not compare against the natural width of the content.
% \end{environment}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begin{CJKfilltwosides}{6em}
  瞻彼阕者，\\虚室生白
\end{CJKfilltwosides}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begin{CJKfilltwosides*}{0pt}
  瞻彼阕者，\\虚室生白
\end{CJKfilltwosides*}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \subsection{Punctuation}
%
% \begin{keyval}
%   \item[\keys{PunctStyle}]\val{style}: Select a punctuation style.
%   The implemented styles are \texttt{quanjiao} (the default),
%   \texttt{plain}, \texttt{banjiao}, \texttt{kaiming}, \texttt{CCT},
%   and \texttt{hangmobanjiao}.
%   An unknown name issues a warning and falls back to \texttt{plain}.
%   \item[\keys{PunctWidth}]\val{length, false}: Give
%   every punctuation mark the same advance, whatever the style says.
%   A width set with \cs{LuaCJKsetwidth} still wins for that mark.
%   \item[\keys{PunctBoundWidth}]\val{length, false}: How much of a mark's
%   advance stays inside the line when the mark ends or starts the line;
%   the rest of the ink stands in the margin, or in the indentation at the
%   start of a paragraph.
%   The default leaves the mark's own blank out, so its ink stands on the
%   measure, and line breaking counts that hang, so a mark can end the line the
%   natural width would refuse. \texttt{false} returns to that default.
%   \item[\keys{LatinPunct}]\val{\TFF}: Treat the quotation marks
%   (U+2018, U+2019, U+201C, U+201D), the middle dot (U+00B7),
%   and the ellipses (U+2026, U+2027, U+22EF) as Latin punctuation:
%   they stay in the current Latin font and are not compressed.
%   This keeps an apostrophe inside an English word from turning into
%   a full-width form. The em dash is not affected.
%   \item[\keys{PunctFamily}]\val{family, false}: Use a
%   different CJK family for the punctuation marks.
%   The family must be declared with \cs{setCJKfamilyfont}; \texttt{false}
%   (the initial value) makes the marks follow the text again.
%   \item[\keys{AllowBreakBetweenPuncts}]\val{\TFF}: Whether two adjacent
%   punctuation marks may be separated by a line break.
%   A dash or an ellipsis is not affected: a run of them is governed by
%   \texttt{NoBreakLongPunct}.
%   The prohibitions that keep a closing or middle mark out of the line start
%   and an opening mark out of the line end are not lifted, so a closing
%   quotation mark is never set at the start of a line.
%   The marks are still compressed.
%   \item[\keys{PunctKinsoku}]\val{\TTF}: Whether to apply line-breaking
%   prohibitions for punctuation.
%   A closing or middle punctuation cannot start a line, an opening punctuation
%   cannot end a line, two adjacent marks are not separated, and a run of long
%   punctuation is kept together.
%   A mark at the edge of a box takes part as well.
%   The prohibitions are independent of \texttt{PunctStyle},
%   so they stay active with |PunctStyle = plain|.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
字，字\\
\LuaCJKsetup{PunctFamily = zhkai}字，字
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{LatinPunct = false}%
a’a\quad 字！字\\
\LuaCJKsetup{LatinPunct, PunctWidth = .8em}
a’a\quad 字！字
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
字字。\\
\LuaCJKsetup{PunctBoundWidth = .5em}字字。\\
（字字
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% The character sets that the punctuation code works with come next. Each
% of their keys has three forms: the plain one replaces the set, the form
% with \texttt{+} adds characters, and the form with \texttt{-} removes
% them. Ranges use the same spelling as \cs{LuaCJKDeclareCharClass}.
% The sets are global: a group does not bring the previous members back.
%
% \begin{keyval}
%   \item[\keys{KaiMingPunct<+->}]\val{char list}:
%   The marks that keep a full width in the \texttt{kaiming} style.
%   Initially \texttt{。}、\texttt{．}、\texttt{？}、\texttt{！}.
%   \item[\keys{MiddlePunct<+->}]\val{char list}:
%   The marks centered between the two halves of their box.
%   A middle mark cannot start a line.
%   \item[\keys{LongPunct<+->}]\val{char list}: The
%   marks that are never compressed against each other,
%   such as dashes and ellipses.
%   \item[\keys{NoBreakLongPunct<+->}]
%   \val{char list}: The long marks that must not be separated by a line
%   break. Initially the same as \texttt{LongPunct}.
% \end{keyval}
%
% \begin{function}{\LuaCJKDeclareCharClass}
%   \begin{syntax}
%     \tn{LuaCJKDeclareCharClass} \marg{class} \marg{range list}
%   \end{syntax}
%   Override the class of a code-point range.
%   Ranges are written in hexadecimal and the leading |"| may be
%   omitted; |"START -> "END| gives a range, and the list is comma separated.
%
%   The classes are: \texttt{CJK} and \texttt{Default} make the range
%   behave like CJK or Latin text;
%   \texttt{FullLeft} and \texttt{HalfLeft} treat it as an opening mark,
%   \texttt{FullRight} and \texttt{HalfRight} as a closing mark,
%   so the line-breaking prohibitions apply;
%   \texttt{NormalSpace} takes the range out of the CJK/Latin glue,
%   like \cs{normalspacedchars}; \texttt{CJStarter}, \texttt{CM},
%   and \texttt{Boundary} are treated as \texttt{CJK},
%   because \LuaTeX\ has no model of combining marks or run boundaries.
% \end{function}
%
% \begin{function}{\LuaCJKDeclarePunctClass}
%   \begin{syntax}
%     \tn{LuaCJKDeclarePunctClass} \marg{group} \marg{range list}
%   \end{syntax}
%   Override the punctuation group of a range. The groups
%   are \texttt{open}, \texttt{close}, \texttt{middle}, \texttt{dash},
%   and \texttt{ellipsis}; \texttt{none} removes the punctuation
%   treatment, so the characters are no longer compressed or hung.
% \end{function}
%
% \begin{function}{\LuaCJKResetCharClass}
%   Drop every class and punctuation override declared so far,
%   and put the normal-spaced set back to the characters
%   of \cs{normalspacedchars}.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
中ABC中\par
\LuaCJKDeclareCharClass{CJK}{0041 -> 005A}
中ABC中\par
\LuaCJKDeclarePunctClass{none}{FF0C}%
字，，字\par
\LuaCJKResetCharClass 中ABC中
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKEditPunctStyle}
%   \begin{syntax}
%     \tn{LuaCJKEditPunctStyle} \marg{style} \marg{key-value list}
%   \end{syntax}
%   Change the parameters of an existing style.
%   The keys are \keys{compress-adjacent, adjacent-ratio, keep-open-close};
%   a key that is not given keeps its value.
% \end{function}
%
% \begin{function}{\LuaCJKsetwidth}
%   \begin{syntax}
%     \tn{LuaCJKsetwidth} \marg{punctuation list} \marg{length}
%   \end{syntax}
%   Give the listed punctuation marks a fixed advance,
%   overriding the selected \keys{PunctStyle} and \keys{PunctWidth}.
%   The setting is global: a group does not restore the previous width,
%   and a later call adds to the table rather than replacing it.
%   A leading \texttt{*} is accepted; the width it would set at the start
%   or end of a line is not implemented, and the star warns once.
% \end{function}
%
% \begin{function}{\LuaCJKsetkern}
%   \begin{syntax}
%     \tn{LuaCJKsetkern} \marg{before} \marg{after} \marg{length}
%   \end{syntax}
%   Set the gap between two adjacent punctuation marks, overriding
%   the style. Only the first character of each argument is used.
%   Like \cs{LuaCJKsetwidth}, the setting is global.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetwidth{「}{1.5em}字「字\\
\LuaCJKsetkern{「}{」}{.3em}字「」字
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKDeclarePunctStyle}
%   \begin{syntax}
%     \tn{LuaCJKDeclarePunctStyle} \marg{name} \marg{key-value list}
%   \end{syntax}
%   Define a punctuation style.
% \end{function}
%
% \begin{keyval}
%   \item[\keys{compress-adjacent}]\val{\TTF}: whether two adjacent
%   punctuation marks are compressed.
%   \item[\keys{adjacent-ratio}]\val{number}: the ratio of the compression,
%   relative to the width of the mark that is compressed.
%   \item[\keys{keep-open-close}]\val{\TTF}: whether an opening mark next
%   to a closing one stays uncompressed.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\LuaCJKDeclarePunctStyle{mine}
  {adjacent-ratio = .25}
字，，字\par
\LuaCJKsetup{PunctStyle = mine}字，，字\par
\LuaCJKEditPunctStyle{mine}
  {adjacent-ratio = .75}
字，，字
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \subsection{Line breaking}
%
% A run of dashes or ellipses (U+2013, U+2014, U+2015, U+FF0D, U+2026,
% and U+22EF) is one unit: the marks are joined without glue, so
% justification cannot pull a two-em dash apart, and no break is offered
% between them. The key \keys{LongPunct} replaces the set.
%
% \begin{keyval}
%   \item[\keys{CheckSingle}]\val{\TFF}
%   When on, the last two break points of a paragraph whose final character
%   is CJK are made unbreakable, so a single character cannot end up alone
%   on the last line. The initial value is \meta{false}.
%   \item[\keys{WidowPenalty}]\val{penalty}: The penalty used by
%   \texttt{CheckSingle}. The initial value is \texttt{10000};
%   a lower value allows the break when it is worth the cost.
%   \item[\keys{CJLineBreak}]\val{normal, strict}: In the \texttt{strict}
%   mode a character whose Unicode \texttt{Line\_Break} property is
%   \texttt{CJ} (the small kana and the like) may not start a line.
%   The mode only adds prohibitions; it does not remove any.
%   The initial value is \texttt{normal}, which treats those characters
%   like other CJK characters.
%   The set is read from \file{LineBreak.txt} of the \pkg{unicode-data}
%   bundle, so the package needs that bundle for the strict mode.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\parbox{4em}{字字字字字字\par}\par
\LuaCJKsetup{CheckSingle = true}
\parbox{4em}{字字字字字字\par}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKnobreak}
%   \begin{syntax}
%     \tn{LuaCJKnobreak} \marg{text}
%   \end{syntax}
%   Keep \meta{text} on one line. The nodes of the argument are marked
%   and the line-breaking pass forbids a break at any of their boundaries.
%   The marking ends with the current group.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\parbox{5em}{字字字字字字}\quad
\parbox{5em}{字字字字\LuaCJKnobreak{字字}}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{Suspending and hooks}
%
% \begin{function}{\LuaCJKdisable, \LuaCJKenable}
%   \tn{LuaCJKdisable} stops the typographic adjustments: no \keys{CJKglue}
%   or \keys{CJKecglue} is inserted, punctuation is not compressed,
%   no line-breaking prohibitions are added, punctuation is not hung, and
%   CJK characters in math mode are left alone. CJK characters are still
%   typeset in the CJK font, so text stays readable. The switch is local
%   to the current group; \tn{LuaCJKenable} turns the adjustments back on.
% \end{function}
%
% This is the hook verbatim-like environments use,
% and it is also useful when measuring raw node lists.
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
中 文\\
\LuaCJKdisable 中 文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKShipoutHook}
%   \begin{syntax}
%     \tn{LuaCJKShipoutHook} \marg{code}
%   \end{syntax}
%   Run \meta{code} before every page is shipped out. The code is added to
%   the \texttt{shipout/before} hook, so it obeys the usual hook ordering.
% \end{function}
%
% \subsection{Verbatim and listings}
%
% \begin{function}{\LuaCJKVerbAddon, \LuaCJKOffVerbAddon}
%   Make one CJK character as wide as two spaces of the current monospaced
%   font, which keeps columns aligned when a code listing contains CJK text.
%   The gap is added as \keys{CJKglue}, so the CJK font itself
%   is not scaled; a negative gap only raises a warning and adds nothing.
%   Breaks between CJK characters are forbidden until the group ends,
%   as in Latin verbatim text.
%
%   The command does nothing at the outermost group level,
%   so it is meant to be used inside the environment that needs it,
%   for example in the \texttt{formatcom} option of \pkg{fancyvrb}.
%   \tn{LuaCJKOffVerbAddon} cancels it again inside the same group.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\ttfamily 中中\\
\ttfamily\LuaCJKVerbAddon 中中
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{keyval}
%   \item[\keys{Verb}]\val{\TTF, env, env+}
%   What to do inside \tn{verb} and the verbatim-like environments
%   (\env{verbatim}, \env{Verbatim}, \env{lstlisting},
%   and their relatives). \texttt{true} suspends the adjustments in both;
%   \texttt{env} keeps them inside the environments but not in \tn{verb},
%   which preserves column alignment when the code contains CJK text;
%   \texttt{env+} keeps them everywhere; \texttt{false} leaves verbatim
%   material entirely alone. Since \texttt{env+} and \texttt{false} both
%   leave the adjustments on, they behave the same in LuaCJK.
%   Suspension removes the spacing only: a punctuation mark next to suspended
%   material still keeps the break opportunity that follows it.
% \end{keyval}
%
% \pkg{listings} processes one character at a time and typesets a character
% that is outside its character table at the moment it is read.
% CJK characters are outside that table, so they end up in front of the
% surrounding Latin text. The companion package \pkg{LuaCJK-listings} fixes
% this: it adds the CJK characters to the character table of \pkg{listings},
% so they stay in place, counts each of them as two columns,
% and turns the spacing adjustments off inside the listing.
% LuaCJK loads it automatically when \pkg{listings} is used,
% so no extra command is needed.
%
% \tn{lstinline} reads its argument with changed category codes;
% the patch would break that scanner,
% so inline code is left alone and takes the normal handling.
%
% \subsection{Decorations}
%
% The companion package \pkg{LuaCJKfntef} provides underlining,
% emphasis dots, and strike-through. It builds on \pkg{lua-ul},
% so the decorated text may contain arbitrary commands, CJK and Latin text,
% and may still be hyphenated and broken between lines.
%
% \begin{function}{\CJKunderline}
%   \begin{syntax}
%     \tn{CJKunderline} \oarg{options} \marg{text}
%   \end{syntax}
%   Underline \meta{text}. The initial geometry is \texttt{depth = 0.2em}
%   and \texttt{thickness = 0.4pt}.
%   A leading \texttt{*} or \texttt{-} is accepted and ignored.
% \end{function}
%
% Every decoration takes the keys below; a key that a command does not use
% is accepted and has no effect. A bare color name with no key means
% \texttt{format = }\meta{color}. The keys \texttt{top} and \texttt{bottom}
% are passed to \pkg{lua-ul}, so they apply to \cs{CJKunderline} alone and
% override the computed geometry. A drawn pattern never changes the height
% or depth of the line it decorates, so the leading does not grow.
%
% \begin{keyval}
%   \item[\keys{thickness}]\val{length}: the thickness of the rule,
%   initially \texttt{0.4pt}.
%   \item[\keys{depth}]\val{length}: the distance from the baseline to the
%   top of the rule, initially \texttt{0.2em}.
%   \item[\keys{textformat}]\val{code}: code applied to the text, for
%   example |textformat = \bfseries|.
%   \item[\keys{format}]\val{color name}: the color of the rule, for
%   example |format = red|; it affects the rule only, not the text.
%   \item[\keys{color}]\val{color name}: another name for \texttt{format}.
%   \item[\keys{subtract}]\val{length}: taken off the rule at both ends,
%   off by default; \texttt{true} means half an em, so two neighbouring
%   commands do not run together.
%   \item[\keys{skip}]\val{\TFF}: leaves the punctuation out of the rule.
%   \item[\keys{hidden}]\val{\TFF}: hides the text and keeps the rule,
%   with the width, height, and depth of the hidden text.
%   \item[\keys{gap}]\val{length}: the distance between the two rules of
%   the double line, initially \texttt{1.1pt}.
%   \item[\keys{height}]\val{length}: the distance from the baseline to the
%   center of the strike-out rule, initially \texttt{0.3em}.
%   \item[\keys{symbol}]\val{code}: a symbol replacing the wave or the dots.
%   \item[\keys{selectable}]\val{\TFF}: whether the decoration symbol stays
%   as text, initially \texttt{false}; with \texttt{true} a PDF reader can
%   copy and select it.
% \end{keyval}
%
% Without \keys{format} the rule takes the color of the text it decorates,
% for example the color set by \cs{textcolor}.
%
% \keys{sep} is accepted for compatibility and has no effect.
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderline[thickness = 1pt]{中}\\
\CJKunderline[format = red]{中}\\
\CJKunderline[textformat = \bfseries]{中}\\
\CJKunderline[hidden]{中}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
今天是 \CJKunderline{\hspace*{3em}} 年\\
第 \CJKunderline{\hspace*{2em}} 题
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderline{中文}\CJKunderline{中文}\\
\CJKunderline[subtract]{中文}\\
\CJKunderline[skip]{中，文}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKunderdblline}
%   \begin{syntax}
%     \tn{CJKunderdblline} \oarg{options} \marg{text}
%   \end{syntax}
%   Put two parallel rules under \meta{text}, with the keys listed above.
%   Both rules use \keys{thickness}, the top rule starts at \keys{depth},
%   and \keys{gap} is the distance between them.
%   A leading \texttt{*} or \texttt{-} is accepted and ignored.
% \end{function}
%
% \begin{function}{\CJKunderwave}
%   \begin{syntax}
%     \tn{CJKunderwave} \oarg{options} \marg{text}
%   \end{syntax}
%   Put a wave under \meta{text}.
%   The wave is drawn with \pkg{l3draw} and repeated with \tn{leaders},
%   so it has the same phase across the parts of one line. One period
%   is half an em and the whole pattern scales with the font size; like the
%   other drawn patterns it leaves the height and depth of the line alone.
%   \keys{symbol} replaces the wave with another symbol:
%   one symbol per em, centered, its top half an em below the baseline.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderwave{中文}\quad
\CJKunderwave[symbol = \textbullet]{中文}\\
\CJKunderdot {中文}\quad
\CJKunderdot [symbol = \textbullet]{中文}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKxout}
%   \begin{syntax}
%     \tn{CJKxout} \oarg{options} \marg{text}
%   \end{syntax}
%   Strike \meta{text} out with a repeated slash, like \pkg{ulem}'s
%   \tn{xout}. The slash runs from \texttt{-0.15em} to \texttt{0.8em}
%   relative to the baseline, so it crosses the whole body of a CJK glyph.
% \end{function}
%
% \begin{function}{\LuaCJKemdescent}
%   The depth of the em box of the current font, usable as a length.
%   A CJK em box is one em square, so an object of height \texttt{1em}
%   placed at this depth covers the area a CJK character occupies; a font
%   without OpenType metrics falls back to \texttt{.12em}.
% \end{function}
%
% \begin{function}{\CJKunderanyline}
%   \begin{syntax}
%     \tn{CJKunderanyline} \marg{depth} \marg{object} \marg{text}
%   \end{syntax}
%   Put \meta{object} under \meta{text}, repeated by \tn{leaders}.
%   The bottom of \meta{object} is placed \meta{depth} below
%   the baseline, so for a \cs{rule} (which has no depth of its own)
%   the rule occupies \meta{depth} below the baseline upwards.
%   To cover a CJK character, use the em box of the font:
%   \meta{depth} is \cs{LuaCJKemdescent} and the object is \texttt{1em}
%   high, as the example below does.  The object fills the em box, which is
%   the area a PDF reader selects: the advance across, the em box down, so a
%   font whose ink is smaller shows its side bearing all round. The type is
%   cached, so the same arguments reuse one underline type.
% \end{function}
%
% \begin{function}{\CJKunderanysymbol}
%   \begin{syntax}
%   \tn{CJKunderanysymbol}\oarg{options}\marg{depth}\marg{symbol}\marg{text}
%   \end{syntax}
%   The same, with one \meta{symbol} per em: the symbol is centered in a cell
%   as wide as a CJK character, so a row of symbols lines up with the
%   characters above them. \meta{depth} is the distance from the top of the
%   symbol to the \emph{bottom of the em box}, so |0pt| leaves the same gap
%   below the character as the side bearings leave beside it; a font without
%   OpenType metrics is computed at |.12em|. The option \keys{sep} is
%   accepted for compatibility but has no effect, because the cell is fixed
%   at one em.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderanyline{\LuaCJKemdescent}
  {\color{yellow}\rule{1pt}{1em}}{中}\\
\CJKunderanysymbol{0pt}{\tiny$\triangle$}{中}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKunderdot}
%   \begin{syntax}
%     \tn{CJKunderdot} \oarg{options} \marg{text}
%   \end{syntax}
%   Put emphasis dots under \meta{text}.
%   With |symbol = |\meta{symbol} a symbol takes the place of the dots
%   and is placed like the symbol of \cs{CJKunderanysymbol}: one per em,
%   centered, its top \texttt{0.3em} under the bottom of the em box.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderline{虚室生白，\CJKunderdot{吉祥}止止，
  虚室生白}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKsout}
%   \begin{syntax}
%     \tn{CJKsout} \oarg{options} \marg{text}
%   \end{syntax}
%   Strike \meta{text} through, with the keys listed above.
%   The initial height passes through the middle of a CJK glyph,
%   which sits higher than the middle of the Latin x-height;
%   use |height = 0.5ex| for text that is entirely Latin.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKsout[thickness = 2pt, format = red]{中文}\\
\CJKsout[height = .5ex]{中文}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKunderline   {中文 test 中文}\\
\CJKunderdblline{中文 test 中文}\\
\CJKunderwave   {中文 test 中文}\\
\CJKunderdot    {中文 test 中文}\\
\CJKsout        {中文 test 中文}\\
\CJKxout        {中文 test 中文}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{Comparison with \pkg{xeCJK}}
%
% \pkg{LuaCJK} follows the \pkg{xeCJK} interface where the two engines allow
% it, so a document that already uses \pkg{xeCJK} mostly needs no change.
% Only the differences are listed.
%
% \subsection{Different behavior}
%
% \begin{itemize}
%   \item \keys{Verb}: \texttt{env+} behaves like \texttt{false}, because both
%   leave the adjustments on.
%   \item Punctuation geometry. A style gives a mark half the size, half with
%   the sentence-ending marks kept full, or 0.7 of it, and the ink moves with
%   the advance by class: an opening mark by the whole amount, a middle mark by
%   half, a closing mark not at all.
%   \pkg{xeCJK} measures the real side bearings of each glyph instead.
%   \item \cs{LuaCJKDeclarePunctStyle} takes the three keys
%   \keys{compress-adjacent}, \keys{adjacent-ratio}, and
%   \keys{keep-open-close}; the thirty geometry keys of \pkg{xeCJK} describe
%   its side-bearing model and have no counterpart here.
%   \item \texttt{CJKfilltwosides*} does not compare with the natural width.
%   \item The CJK font is applied to the glyph node after the text has been
%   shaped with the current font, so the OpenType features of the CJK font
%   (ligatures, \texttt{locl}, \texttt{palt}, variation sequences) do not take
%   effect: the spacing, the punctuation advance, and the prohibitions come
%   from LuaCJK itself.
%   \item In \pkg{LuaCJKfntef}, \keys{format} takes a color name rather than
%   code, and the decoration is drawn by \pkg{lua-ul}, so the \texttt{ulem}
%   option list does not exist and \tn{underLine} is configured directly.
% \end{itemize}
%
% \subsection{Not available}
%
% \begin{itemize}
%   \item \texttt{NewLineCS}, \texttt{EnvCS}, \texttt{InlineEnv}, and
%   \texttt{PlainEquation}: they exist so that \pkg{xeCJK} can recognize
%   \TeX\ constructs while it scans tokens, and a finished node list needs no
%   hint.
%   \item \texttt{PoZheHaoLigature}, for the reason given above: the font's
%   two-em dash ligature is decided before LuaCJK applies the CJK font.
%   \item \texttt{RubberPunctSkip}: the advance of a mark is a kern, which is
%   neither a break opportunity nor part of justification, and that is what
%   keeps a fixed-width style stable.
%   \item \texttt{CheckFullRight}: it needs the control sequence after the
%   mark, which a node list does not show; use \cs{LuaCJKnobreak}.
% \end{itemize}
%
% \end{documentation}
%
% \StopEventually{\PrintIndex}
% \clearpage \appendix
%
% \begin{implementation}
%
% \section{Implementation}
%
%    \begin{macrocode}
%<*package>
%    \end{macrocode}
%
%    \begin{macrocode}
%<@@=LuaCJK>
%    \end{macrocode}
%
% \subsection{Loading and conflicts}
%
% LuaCJK only works with \LuaTeX. The engine test runs before any other
% package is loaded, so that a wrong engine stops with a clear message.
%    \begin{macrocode}
\sys_if_engine_luatex:F
  {
    \msg_new:nnn { LuaCJK } { engine }
      { LuaCJK ~ requires ~ LuaTeX. }
    \msg_critical:nn { LuaCJK } { engine }
    \tex_endinput:D
  }
\RequirePackage { fontspec }
%    \end{macrocode}

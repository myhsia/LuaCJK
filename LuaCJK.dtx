% \subsection{Listings and ctex}
%
% The block listing environments are patched by making the CJK characters
% active while the character table of a listing is built. The active
% character is defined through the \tn{lccode} of two helper characters: the
% token in the body keeps category code 12, so it can be stored in the token
% list of \pkg{listings} and typeset later. The definitions are made once;
% each listing only sets the category codes again in its own group.
% \changes{v0.0.1}{2026/11/05}{Add \pkg{LuaCJK-listings}, which keeps CJK
%   characters in place inside a \pkg{listings} block, counts each of them as
%   two columns, and turns the spacing adjustments off. LuaCJK loads it
%   automatically with \pkg{listings}.}
%    \begin{macrocode}
%<*listings>
\RequirePackage { LuaCJK }
\RequirePackage { listings }
\makeatletter
\newif\ifLuaCJK@listings@cjkrun
\newif\ifLuaCJK@listings@defined
\lst@AddToHook{InitVars}{\LuaCJK@listings@cjkrunfalse}
\def\LuaCJK@listings@process#1{%
  \lst@whitespacefalse
  \LuaCJK@listings@setcjkflag
  \advance\lst@length\@ne
  \lst@Append#1}
\def\LuaCJK@listings@setcjkflag{%
  \lst@ifletter
    \lst@Output
  \else
    \ifLuaCJK@listings@cjkrun\else\lst@OutputOther\fi
    \lst@lettertrue
  \fi
  \LuaCJK@listings@cjkruntrue}
\def\LuaCJK@listings@define#1#2{%
  \@tempcnta=#1\relax
  \loop\ifnum\@tempcnta<#2\relax
    \advance\@tempcnta\@ne
    \lccode`\~=\@tempcnta
    \lccode`\/=\@tempcnta
    \lowercase{\gdef~{\LuaCJK@listings@process/}}%
  \repeat}
\def\LuaCJK@listings@catcodes#1#2{%
  \@tempcnta=#1\relax
  \loop\ifnum\@tempcnta<#2\relax
    \advance\@tempcnta\@ne
    \catcode\@tempcnta=13\relax
  \repeat}
\def\LuaCJK@listings@ranges#1{%
  #1{"2E80}{"9FFF}%
  #1{"F900}{"FAFF}%
  #1{"FF00}{"FFEF}%
  #1{"AC00}{"D7AF}}
\def\LuaCJK@listings@activate{%
  \ifLuaCJK@listings@defined\else
    \LuaCJK@listings@ranges\LuaCJK@listings@define
    \global\LuaCJK@listings@definedtrue
  \fi
  \LuaCJK@listings@ranges\LuaCJK@listings@catcodes}
%    \end{macrocode}
%
% \tn{lstinline} reads its argument with changed category codes,
% so the patch is limited to the block listing environments.
%    \begin{macrocode}
\lst@AddToHook{SelectCharTable}{%
  \ifx\lst@inlinechars\@empty
    \LuaCJK@listings@activate
  \fi}
\lst@AddToHook{OutputBox}{%
  \ifx\lst@inlinechars\@empty
    \LuaCJKdisable
  \fi}
\makeatother
%</listings>
%    \end{macrocode}
%
% \pkg{ctex} chooses its \LuaTeX\ backend by inputting a file whose name
% it fixes itself:
% \begin{quote}
%   |\file_if_exist:nTF { ctex-engine-luatex.def } { ... }|\\
%   \dots\ |\ctex_file_input:n { \c__ctex_engine_file_str }|
% \end{quote}
% A backend can therefore only be provided under that very name, and LuaCJK
% cannot ship a file of it without colliding with \pkg{ctex}. Its engine file
% is called |ctex-engine-luacjk.def| instead, and \pkg{ctex} is redirected
% to it through |ctexopts.cfg|, which \pkg{ctex} inputs after the name has
% been fixed and before the file is read; changing the name there therefore
% takes effect for the current run. The redirect acts only on \LuaTeX,
% so an \XeLaTeX\ document in the same directory keeps its own backend.
% \changes{v0.0.1}{2026/11/05}{Ship \file{ctex-engine-luacjk.def} as the
%   LuaTeX backend for \pkg{ctex}. The name differs from the file that
%   \pkg{ctex} installs, so both packages can be installed side by side and
%   CTAN has no duplicate file.}
%
% The file defines the handful of \cs{ctex_...} commands that the \pkg{ctex}
% kernel calls, and maps the parts of the \pkg{luatexja} interface that
% \pkg{ctex} and some documents still use.
%    \begin{macrocode}
%<*ctex>
\typeout{LuaCJK~ctex~engine~loaded}
\sys_if_engine_luatex:F
  {
    \msg_new:nnn { LuaCJK } { ctex-engine }
      { The~ctex~engine~file~of~LuaCJK~requires~LuaTeX. }
    \msg_critical:nn { LuaCJK } { ctex-engine }
    \tex_endinput:D
  }
%    \end{macrocode}
%
% The file tells the package that it was reached through this engine file,
% so that \pkg{ctex} can check the redirect of \file{ctexopts.cfg}.
%    \begin{macrocode}
\cs_gset_eq:NN \@@_from_ctex_engine: \scan_stop:
\RequirePackage { LuaCJK }
%    \end{macrocode}
%
% The fontset of \pkg{ctex} defines these shortcuts itself and checks
% for an existing definition, so the ones of LuaCJK have to go first.
%    \begin{macrocode}
\clist_map_inline:nn
  { \songti , \heiti , \fangsong , \kaishu , \lishu , \youyuan ,
    \yahei , \pingfang }
  { \cs_undefine:N #1 }
%</ctex>
%    \end{macrocode}
%
% The interface that the \pkg{ctex} kernel and its classes rely on.
%    \begin{macrocode}
%<*ctex>
\cs_new_protected:Npn \ctex_add_to_selectfont:n #1
  { \hook_gput_code:nnn { selectfont } { LuaCJK } {#1} }
\cs_new_eq:NN \ctex_ltj_zero_globaldefs: \prg_do_nothing:
\cs_new_protected:Npn \CTEX@alchar #1 {#1}
\cs_new_eq:NN \CTEX@beginallalchar \prg_do_nothing:
\cs_new_eq:NN \CTEX@endallalchar \prg_do_nothing:
\dim_new:N \ccwd
\dim_new:N \cht
\dim_new:N \cdp
\dim_new:N \cwd
\cs_new_protected:Npn \ctex_update_ccwd:
  { \dim_set:Nn \ccwd { \f@size \p@ } }
\cs_new_protected:Npn \ctex_update_em_unit:
  { \dim_set:Nn \ccwd { \f@size \p@ } }
\cs_new_protected:Npn \ctex_update_kanjisize:
  {
    \dim_set:Nn \cwd { \ccwd }
    \dim_set:Nn \cht { \f@size \p@ }
    \dim_set:Nn \cdp { \c_zero_dim }
  }
%</ctex>
%    \end{macrocode}
%
% \pkg{ctex} keeps its own copy of the CJK glue so that it can tell whether
% the document changed it. The two copies are kept in step here.
%    \begin{macrocode}
%<*ctex>
\skip_new:N \l__ctex_ccglue_skip
\skip_set_eq:NN \l__ctex_ccglue_skip \l_@@_ccglue_skip
\cs_new_protected:Npn \ctex_ltj_set_kanjiskip:N #1
  {
    \skip_set_eq:NN \l_@@_ccglue_skip #1
    \bool_set_true:N \l_@@_ccglue_touched_bool
    \@@_settings_push:
  }
\cs_new_protected:Npn \ctex_ltj_set_xkanjiskip:N #1
  {
    \skip_set_eq:NN \l_@@_ecglue_skip #1
    \bool_set_true:N \l_@@_ecglue_touched_bool
    \@@_settings_push:
  }
\cs_new_protected:Npn \ctex_update_ccglue:
  {
    \skip_set_eq:NN \l_@@_ccglue_skip \l__ctex_ccglue_skip
    \bool_set_true:N \l_@@_ccglue_touched_bool
    \@@_settings_push:
  }
\prg_new_conditional:Npnn \ctex_if_ccglue_touched: { TF }
  {
    \skip_if_eq:nnTF
      { \l__ctex_ccglue_skip } { \l_@@_ccglue_skip }
      { \prg_return_false:   } { \prg_return_true: }
  }
\ctex_at_end:n
  {
    \cs_set_protected:Npn \__ctex_update_stretch_auxii:
      {
        \ctex_if_ccglue_touched:TF
          { \ctex_update_ccwd: }
          { \__ctex_update_stretch_auxiii: }
      }
  }
%</ctex>
%    \end{macrocode}
%
% The gap between CJK and Latin text has its own default under \pkg{ctex},
% |.25em|, and follows the size in the same way.
%    \begin{macrocode}
%<*ctex>
\skip_set:Nn \l_@@_ecglue_skip { .25em plus 1pt minus 1pt }
\skip_new:N \l__ctex_xkanjiskip_skip
\skip_set_eq:NN \l__ctex_xkanjiskip_skip \l_@@_ecglue_skip
\tl_new:N \l__ctex_xkanjiskip_tl
\tl_set:Nn \l__ctex_xkanjiskip_tl { .25em plus 1pt minus 1pt }
\cs_new_protected:Npn \ctex_update_xkanjiskip:
  {
    \skip_if_eq:nnT
      { \l_@@_ecglue_skip } { \l__ctex_xkanjiskip_skip }
      {
        \skip_set:Nn \l__ctex_xkanjiskip_skip { \l__ctex_xkanjiskip_tl }
        \skip_set_eq:NN
          \l_@@_ecglue_skip \l__ctex_xkanjiskip_skip
        \bool_set_true:N \l_@@_ecglue_touched_bool
        \@@_settings_push:
      }
  }
\ctex_add_to_selectfont:n { \ctex_update_xkanjiskip: }
\ctex_add_to_selectfont:n { \ctex_update_kanjisize:  }
%</ctex>
%    \end{macrocode}
%
% The \pkg{ctex} option |punct| selects a punctuation style, and |space|
% has no counterpart here.
%    \begin{macrocode}
%<*ctex>
\cs_new_protected:Npn \ctex_set_jfm:n #1
  {
    \tl_set:Nn \l__ctex_jfm_tl {#1}
    \LuaCJKsetup { PunctStyle = {#1} }
  }
\cs_generate_variant:Nn \ctex_set_jfm:n { o }
\tl_new:N \l__ctex_jfm_tl
\ctex_define:n
  {
    space .code:n =
      { \msg_warning:nn { ctex } { invalid-option } }
  }
\ctex_define:n
  {
    punct .code:n =
      {
        \tl_set:Ne \l__ctex_punct_tl {#1}
        \ctex_set_jfm:o { \l__ctex_punct_tl }
      },
    punct .default:n = { quanjiao },
  }
\ctex_define:n
  { experiment .meta:nn = { ctex / experiment } {#1} }
\keys_define:nn { ctex / experiment }
  {
    CJKecglue .code:n           =
      {
        \tl_set:Nn \l__ctex_xkanjiskip_tl {#1}
        \skip_set:Nn \l__ctex_xkanjiskip_skip {#1}
        \ctex_ltj_set_xkanjiskip:N \l__ctex_xkanjiskip_skip
      },
    CJKecglue .value_required:n = true
  }
\ctex_set_jfm:o { \l__ctex_punct_tl }
%</ctex>
%    \end{macrocode}
%
% A very small part of the \pkg{luatexja} parameter interface is kept, for
% documents that set the skips directly. Only |kanjiskip| and |xkanjiskip|
% are understood; any other key is silently ignored, because this
% is not a reimplementation of the \pkg{luatexja} parameter system.
%    \begin{macrocode}
%<*ctex>
\keys_define:nn { LuaCJK / ctex / ltj }
  {
    kanjiskip  .code:n = { \@@_set_ccglue:n {#1} },
    xkanjiskip .code:n = { \@@_set_ecglue:n {#1} },
    unknown    .code:n = { },
  }
\NewDocumentCommand \ltjsetparameter { m }
  { \keys_set:nn { LuaCJK / ctex / ltj } {#1} }
\cs_new:Npn \ltjgetparameter #1
  {
    \str_case:nnF {#1}
      {
        { kanjiskip  } { \skip_use:N \l_@@_ccglue_skip }
        { xkanjiskip } { \skip_use:N \l_@@_ecglue_skip }
      } { 0pt }
  }
%</ctex>
%    \end{macrocode}
%
% \end{implementation}

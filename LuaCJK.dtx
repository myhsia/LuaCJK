% \begin{macro}[int]{\@@_fntef_use_leader_type:nn}
% Build the underline type of a decoration that is made of \tn{leaders},
% which repeats one rule or one symbol along the decorated text, and use it.
% A type is built once per leader code and color and then reused, so a
% document pays for each combination of geometry and color only once.
%
% The type keeps the color that was in force when it was built:
% \pkg{luacolor} colors a rule by attribute, and \pkg{lua-ul} puts the
% attributes of the built box on every leader it inserts.
% A type cached by the geometry alone would therefore keep the color of the
% first call, so the color is part of the key: \keys{format} when it is
% given, and otherwise the value of \pkg{luacolor}'s attribute, which is the
% color of the surrounding text. A requested color is also applied inside
% the box, so that it holds wherever the leader is placed.
%
% The name of the type already carries a counter, so the context that
% \pkg{lua-ul} puts in the name of the type it defines is a constant: one
% that expands again when the type is used would rebuild the type with
% whatever color happened to be current then.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_use_leader_type:nn #1#2
  {
    \tl_if_empty:NTF \l_@@_fntef_format_tl
      {
        \tl_set:Ne \l_@@_fntef_color_key_tl
          { ambient | \tex_the:D \use:c { LuaCol@Attribute } }
      }
      {
        \luaul_set_color:n { \l_@@_fntef_format_tl }
        \tl_set:Nn \l_@@_fntef_color_key_tl
          { format | \l_@@_fntef_format_tl }
      }
    \tl_set:Ne \l_@@_fntef_cache_key_tl
      { \exp_not:n {#1} | \l_@@_fntef_color_key_tl }
    \prop_get:NVNF \g_@@_fntef_format_prop
      \l_@@_fntef_cache_key_tl \l_@@_fntef_cache_name_tl
      {
        \int_gincr:N \g_@@_fntef_format_int
        \tl_set:Ne \l_@@_fntef_cache_name_tl
          { LuaCJKfntef / ul / \int_use:N \g_@@_fntef_format_int }
        \tl_if_empty:NTF \l_@@_fntef_format_tl
          {
            \exp_args:Nc \newunderlinetype
              { \l_@@_fntef_cache_name_tl } [ LuaCJKfntef ] {#2}
          }
          {
            \exp_args:Nc \newunderlinetype
              { \l_@@_fntef_cache_name_tl } [ LuaCJKfntef ]
              { \luaul_apply_color: #2 }
          }
        \prop_gput:NVV \g_@@_fntef_format_prop
          \l_@@_fntef_cache_key_tl \l_@@_fntef_cache_name_tl
      }
    \use:c { \l_@@_fntef_cache_name_tl }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\CJKunderanysymbol}
% One symbol per em, which is what one wants for a repeated mark:
% the cell is as wide as a CJK character, so a row of symbols lines up with
% the characters above, and the symbol is centered in its cell.
% The depth is handed to \cs{LuaCJKfntef_use_symbol:n},
% which puts the top of the symbol that far below the baseline.
%    \begin{macrocode}
\NewDocumentCommand \CJKunderanysymbol { O{} m m +m }
  {
    \group_begin:
      \@@_fntef_decoration_setup:n {#1}
      \tl_set:Nn \l_@@_fntef_symbol_tl {#3}
      \@@_fntef_use_symbol:n {#2}
      \@@_fntef_body:n {#4}
    \group_end:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\CJKunderdot}
% Emphasise with dots below the glyphs. The optional argument takes the key
% set of \cs{CJKunderline}, like the other decorations.
%    \begin{macrocode}
\NewDocumentCommand \CJKunderdot { s t- o +m }
  {
    \group_begin:
      \@@_fntef_decoration_setup:n {#3}
      \tl_if_empty:NTF \l_@@_fntef_symbol_tl
        { \@@_fntef_underdot:n { \@@_fntef_body:n {#4} } }
        {
          \@@_fntef_use_symbol:n { .3em }
          \@@_fntef_body:n {#4}
        }
    \group_end:
  }
%    \end{macrocode}
% \begin{macro}[int]{\@@_fntef_underdot:n}
% Apply the dot pattern inside a group. One repeating unit is a dot of
% \texttt{.06em} with \texttt{.12em} on each side, lowered by \texttt{.4em}.
% The unit is written with |em| units so that it scales with the font size.
% \begin{macro}[int]{\@@_fntef_dots}
% The underline type that repeats one dot of the pattern.
%    \begin{macrocode}
\newunderlinetype \@@_fntef_dots
  {
    \tex_leaders:D \hbox:n
      {
        \hbox_set:Nn \l_@@_fntef_pattern_box
          {
            \skip_horizontal:n { .12em }
            \box_move_up:nn { -.4em }
              {
                \hbox:n
                  {
                    \tex_vrule:D width .06em height .06em
                      depth \c_zero_dim
                  }
              }
            \skip_horizontal:n { .12em }
          }
        \box_set_ht:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
        \box_set_dp:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
        \box_use_drop:N \l_@@_fntef_pattern_box
      }
  }
%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_underdot:n #1
  {
    \group_begin:
      \@@_fntef_dots
      #1
    \group_end:
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{environment}{CJKfilltwosides}
% \changes{v0.0.1}{2026/11/11}{Provide the \env{CJKfilltwosides} environment,
%   which justifies every line to a given width and places the box on the
%   baseline as requested. It is tagged: a text block in vertical mode, part
%   of the surrounding paragraph in horizontal mode.}
%   Set the body in a vertical box whose lines are justified to the given
%   width, with the lines separated by |\\|.
%   The inter-character glue is given an infinite stretch inside the box,
%   so a line of CJK characters reaches the width even when there is no
%   Latin word space to stretch.
%   The optional argument places the box on the baseline: \texttt{t} for
%   top, \texttt{c} for centered (the default), and \texttt{b} for bottom.
%   A width of zero or less keeps the surrounding line width.
% \begin{variable}[int]
%   {
%     \l_@@_fntef_fill_box,      \l_@@_fntef_fill_width_dim,
%     \l_@@_fntef_fill_half_dim, \l_@@_fntef_fill_position_tl,
%     \l_@@_fntef_fill_tag_tl,   \l_@@_fntef_fill_struct_bool
%   }
% The box being filled, its requested width, the half height used
% for centring, and the requested baseline position.
%    \begin{macrocode}
\box_new:N \l_@@_fntef_fill_box
\dim_new:N \l_@@_fntef_fill_width_dim
\dim_new:N \l_@@_fntef_fill_half_dim
\tl_new:N \l_@@_fntef_fill_position_tl
\tl_new:N \l_@@_fntef_fill_tag_tl
\bool_new:N \l_@@_fntef_fill_struct_bool
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_fill_begin:nn #1#2
  {
    \group_begin:
    \bool_set_false:N \l_@@_fntef_fill_struct_bool
    \cs_if_exist:NT \tag_struct_begin:n
      {
        \mode_if_vertical:TF
          {
            \tag_struct_begin:n { tag = text-block }
            \tl_set:Nn \l_@@_fntef_fill_tag_tl { text-block }
            \bool_set_true:N \l_@@_fntef_fill_struct_bool
          }
          { \tl_clear:N \l_@@_fntef_fill_tag_tl }
        \cs_if_exist:NT \tagpdfparaOff { \tagpdfparaOff }
      }
    \tl_set:Nn \l_@@_fntef_fill_position_tl {#1}
    \dim_set:Nn \l_@@_fntef_fill_width_dim {#2}
    \LuaCJKsetup { CJKglue = 0pt plus 1filll }
    \vbox_set:Nw \l_@@_fntef_fill_box
      \dim_compare:nNnT { \l_@@_fntef_fill_width_dim } > { 0pt }
        { \dim_set:Nn \tex_hsize:D { \l_@@_fntef_fill_width_dim } }
      \cs_if_exist:NT \tag_mc_begin:n
        {
          \tl_if_empty:NTF \l_@@_fntef_fill_tag_tl
            { \tag_mc_begin:n { } }
            { \tag_mc_begin:n { tag = \l_@@_fntef_fill_tag_tl } }
        }
      \tex_noindent:D \tex_ignorespaces:D
  }
\cs_new_protected:Npn \@@_fntef_fill_end:
  {
    \tex_par:D
    \cs_if_exist:NT \tag_mc_end: { \tag_mc_end: }
    \vbox_set_end:
    \str_case:Vn \l_@@_fntef_fill_position_tl
      {
        { t }
        {
          \dim_set:Nn \l_@@_fntef_fill_half_dim
            { \box_ht_plus_dp:N \l_@@_fntef_fill_box }
          \box_set_ht:Nn \l_@@_fntef_fill_box { 0pt }
          \box_set_dp:Nn \l_@@_fntef_fill_box
            { \l_@@_fntef_fill_half_dim }
        }
        { c }
        {
          \dim_set:Nn \l_@@_fntef_fill_half_dim
            { \box_ht_plus_dp:N \l_@@_fntef_fill_box / 2 }
          \box_set_ht:Nn \l_@@_fntef_fill_box
            { \l_@@_fntef_fill_half_dim }
          \box_set_dp:Nn \l_@@_fntef_fill_box
            { \l_@@_fntef_fill_half_dim }
        }
      }
    \box_use_drop:N \l_@@_fntef_fill_box
    \cs_if_exist:NT \tag_struct_end:
      {
        \cs_if_exist:NT \tagpdfparaOn { \tagpdfparaOn }
        \bool_if:NT \l_@@_fntef_fill_struct_bool
          { \tag_struct_end: }
      }
    \group_end:
  }
\NewDocumentEnvironment { CJKfilltwosides } { O{c} m }
  { \@@_fntef_fill_begin:nn {#1} {#2} }
  { \@@_fntef_fill_end:               }
%    \end{macrocode}
% \end{environment}
%
% \begin{environment}{CJKfilltwosides*}
%   The starred form behaves like the plain one;
%   a width of zero or less keeps the surrounding line width in both.
%    \begin{macrocode}
\NewDocumentEnvironment { CJKfilltwosides* } { O{c} m }
  { \@@_fntef_fill_begin:nn {#1} {#2} }
  { \@@_fntef_fill_end:               }
%</fntef>
%    \end{macrocode}
% \end{environment}
%
% \subsection{Listings and ctex}
%
% The block listing environments are patched by making the CJK characters
% active while the character table of a listing is built. The active
% character is defined through the \tn{lccode} of two helper characters: the
% token in the body keeps category code 12, so it can be stored in the token
% list of \pkg{listings} and typeset later. The definitions are made once;
% each listing only sets the category codes again in its own group.
%    \begin{macrocode}
%<*listings>
\RequirePackage { LuaCJK, listings }
\makeatletter
\newif\ifLuaCJK@listings@cjkrun
\newif\ifLuaCJK@listings@defined
\lst@AddToHook{InitVars}{\LuaCJK@listings@cjkrunfalse}
\def\LuaCJK@listings@process#1{%
  \lst@whitespacefalse
  \LuaCJK@listings@setcjkflag
  \advance\lst@length\@ne
  \lst@Append#1}
\def\LuaCJK@listings@setcjkflag{%
  \lst@ifletter
    \lst@Output
  \else
    \ifLuaCJK@listings@cjkrun\else\lst@OutputOther\fi
    \lst@lettertrue
  \fi
  \LuaCJK@listings@cjkruntrue}
\def\LuaCJK@listings@define#1#2{%
  \@tempcnta=#1\relax
  \loop\ifnum\@tempcnta<#2\relax
    \advance\@tempcnta\@ne
    \lccode`\~=\@tempcnta
    \lccode`\/=\@tempcnta
    \lowercase{\gdef~{\LuaCJK@listings@process/}}%
  \repeat}
\def\LuaCJK@listings@catcodes#1#2{%
  \@tempcnta=#1\relax
  \loop\ifnum\@tempcnta<#2\relax
    \advance\@tempcnta\@ne
    \catcode\@tempcnta=13\relax
  \repeat}
\def\LuaCJK@listings@ranges#1{%
  #1{"2E80}{"9FFF}%
  #1{"F900}{"FAFF}%
  #1{"FF00}{"FFEF}%
  #1{"AC00}{"D7AF}}
\def\LuaCJK@listings@activate{%
  \ifLuaCJK@listings@defined\else
    \LuaCJK@listings@ranges\LuaCJK@listings@define
    \global\LuaCJK@listings@definedtrue
  \fi
  \LuaCJK@listings@ranges\LuaCJK@listings@catcodes}
%    \end{macrocode}
%
% \tn{lstinline} reads its argument with changed category codes,
% so the patch is limited to the block listing environments.
%    \begin{macrocode}
\lst@AddToHook{SelectCharTable}{%
  \ifx\lst@inlinechars\@empty
    \LuaCJK@listings@activate
  \fi}
\lst@AddToHook{OutputBox}{%
  \ifx\lst@inlinechars\@empty
    \LuaCJKdisable
  \fi}
\makeatother
%</listings>
%    \end{macrocode}
%
% \pkg{ctex} inputs an engine file named |ctex-engine-|\meta{name}|.def|,
% where \meta{name} is the detected engine unless the |engine| option names
% another. LuaCJK's file is therefore called |ctex-engine-luacjk.def| and is
% selected with |engine = luacjk|. The middle part must differ from |luatex|:
% \pkg{ctex} installs |ctex-engine-luatex.def|, a second file of that name
% would collide on CTAN, and the two files would describe different backends
% under one name.
%
% The file defines the handful of \cs{ctex_}\meta{name} commands that the
% \pkg{ctex} kernel calls, and maps the parts of the \pkg{luatexja}
% interface that \pkg{ctex} and some documents still use.
%    \begin{macrocode}
%<*ctex>
\typeout{LuaCJK~ctex~engine~loaded}
\sys_if_engine_luatex:F
  {
    \msg_new:nnn { LuaCJK } { ctex-engine }
      { The ~ ctex ~ engine ~ file ~ of ~ LuaCJK ~ requires ~ LuaTeX. }
    \msg_critical:nn { LuaCJK } { ctex-engine }
    \tex_endinput:D
  }
%    \end{macrocode}
%
% \pkg{CJKfntef} loads the legacy \pkg{CJK} package, which redefines the font
% family interface LuaCJK owns, so this file refuses it in both orders:
% the run stops when \pkg{CJKfntef} is already loaded, and the
% \texttt{package/CJKfntef/before} hook stops it when it is requested later.
% The message points at \pkg{LuaCJKfntef}, which does the same work through
% \pkg{lua-ul}. \pkg{ctex}'s own \LuaTeX\ backend refuses the package for the
% same reason, and that code does not run when the engine file is ours.
%    \begin{macrocode}
\msg_new:nnnn { LuaCJK } { cjkfntef }
  {
    Package ~ `CJKfntef' ~ is ~ not ~ compatible ~ with ~ the ~ LuaCJK ~
    backend ~ of ~ ctex.
  }
  { Use ~ the ~ `LuaCJKfntef' ~ package ~ instead. }
\cs_if_exist:cT { ver@CJKfntef.sty }
  { \msg_critical:nn { LuaCJK } { cjkfntef } }
\hook_gput_code:nnn { package / CJKfntef / before } { LuaCJK }
  { \msg_critical:nn { LuaCJK } { cjkfntef } }
%    \end{macrocode}
%
% The file loads the package it serves.
%    \begin{macrocode}
\RequirePackage { LuaCJK }
%    \end{macrocode}
%
% The fontset of \pkg{ctex} defines these shortcuts itself and checks
% for an existing definition, so the ones of LuaCJK have to go first.
%    \begin{macrocode}
\clist_map_inline:nn
  { \songti, \heiti, \fangsong, \kaishu, \lishu, \youyuan, \yahei, \pingfang }
  { \cs_undefine:N #1 }
%</ctex>
%    \end{macrocode}
%
% The interface that the \pkg{ctex} kernel and its classes rely on.
%    \begin{macrocode}
%<*ctex>
\cs_new_protected:Npn \ctex_add_to_selectfont:n #1
  { \hook_gput_code:nnn { selectfont } { LuaCJK } {#1} }
\cs_new_eq:NN \ctex_ltj_zero_globaldefs: \prg_do_nothing:
\cs_new_protected:Npn \CTEX@alchar #1 {#1}
\cs_new_eq:NN \CTEX@beginallalchar \prg_do_nothing:
\cs_new_eq:NN \CTEX@endallalchar \prg_do_nothing:
\clist_map_inline:nn { \ccwd, \cht, \cdp, \cwd } { \dim_new:N #1 }
\cs_new_protected:Npn \ctex_update_ccwd:
  { \dim_set:Nn \ccwd { \f@size \p@ } }
\cs_new_protected:Npn \ctex_update_em_unit:
  { \dim_set:Nn \ccwd { \f@size \p@ } }
\cs_new_protected:Npn \ctex_update_kanjisize:
  {
    \dim_set:Nn \cwd { \ccwd }
    \dim_set:Nn \cht { \f@size \p@ }
    \dim_set:Nn \cdp { \c_zero_dim }
  }
%</ctex>
%    \end{macrocode}
%
% \pkg{ctex} keeps its own copy of the CJK glue so that it can tell whether
% the document changed it. The two copies are kept in step here.
%    \begin{macrocode}
%<*ctex>
\skip_new:N \l__ctex_ccglue_skip
\skip_set_eq:NN \l__ctex_ccglue_skip \l_@@_ccglue_skip
\cs_new_protected:Npn \ctex_ltj_set_kanjiskip:N #1
  {
    \skip_set_eq:NN \l_@@_ccglue_skip #1
    \bool_set_true:N \l_@@_ccglue_touched_bool
    \@@_settings_push:
  }
\cs_new_protected:Npn \ctex_ltj_set_xkanjiskip:N #1
  {
    \skip_set_eq:NN \l_@@_ecglue_skip #1
    \bool_set_true:N \l_@@_ecglue_touched_bool
    \@@_settings_push:
  }
\cs_new_protected:Npn \ctex_update_ccglue:
  {
    \skip_set_eq:NN \l_@@_ccglue_skip \l__ctex_ccglue_skip
    \bool_set_true:N \l_@@_ccglue_touched_bool
    \@@_settings_push:
  }
\prg_new_conditional:Npnn \ctex_if_ccglue_touched: { TF }
  {
    \skip_if_eq:nnTF
      { \l__ctex_ccglue_skip } { \l_@@_ccglue_skip }
      { \prg_return_false:   } { \prg_return_true: }
  }
\ctex_at_end:n
  {
    \cs_set_protected:Npn \__ctex_update_stretch_auxii:
      {
        \ctex_if_ccglue_touched:TF
          { \ctex_update_ccwd: } { \__ctex_update_stretch_auxiii: }
      }
  }
%</ctex>
%    \end{macrocode}
%
% The gap between CJK and Latin text has its own default under \pkg{ctex},
% |.25em|, and follows the size in the same way.
%    \begin{macrocode}
%<*ctex>
\skip_set:Nn \l_@@_ecglue_skip { .25em plus 1pt minus 1pt }
\skip_new:N \l__ctex_xkanjiskip_skip
\skip_set_eq:NN \l__ctex_xkanjiskip_skip \l_@@_ecglue_skip
\tl_new:N \l__ctex_xkanjiskip_tl
\tl_set:Nn \l__ctex_xkanjiskip_tl { .25em plus 1pt minus 1pt }
\cs_new_protected:Npn \ctex_update_xkanjiskip:
  {
    \skip_if_eq:nnT
      { \l_@@_ecglue_skip } { \l__ctex_xkanjiskip_skip }
      {
        \skip_set:Nn \l__ctex_xkanjiskip_skip { \l__ctex_xkanjiskip_tl }
        \skip_set_eq:NN
          \l_@@_ecglue_skip \l__ctex_xkanjiskip_skip
        \bool_set_true:N \l_@@_ecglue_touched_bool
        \@@_settings_push:
      }
  }
\clist_map_inline:nn { \ctex_update_xkanjiskip: , \ctex_update_kanjisize: }
  { \ctex_add_to_selectfont:n {#1} }
%</ctex>
%    \end{macrocode}
%
% The \pkg{ctex} option |punct| selects a punctuation style, and |space|
% has no counterpart here.
%    \begin{macrocode}
%<*ctex>
\cs_new_protected:Npn \ctex_set_jfm:n #1
  {
    \tl_set:Nn \l__ctex_jfm_tl {#1}
    \LuaCJKsetup { PunctStyle = {#1} }
  }
\cs_generate_variant:Nn \ctex_set_jfm:n { o }
\tl_new:N \l__ctex_jfm_tl
\ctex_define:n
  {
    space .code:n    =
      { \msg_warning:nn { ctex } { invalid-option } }
  }
\ctex_define:n
  {
    punct .code:n    =
      {
        \tl_set:Ne \l__ctex_punct_tl {#1}
        \ctex_set_jfm:o { \l__ctex_punct_tl }
      },
    punct .default:n = { quanjiao },
  }
\ctex_define:n
  { experiment .meta:nn = { ctex / experiment } {#1} }
\keys_define:nn { ctex / experiment }
  {
    CJKecglue .code:n           =
      {
        \tl_set:Nn \l__ctex_xkanjiskip_tl {#1}
        \skip_set:Nn \l__ctex_xkanjiskip_skip {#1}
        \ctex_ltj_set_xkanjiskip:N \l__ctex_xkanjiskip_skip
      },
    CJKecglue .value_required:n = true
  }
\ctex_set_jfm:o { \l__ctex_punct_tl }
%</ctex>
%    \end{macrocode}
%
% A very small part of the \pkg{luatexja} parameter interface is kept, for
% documents that set the skips directly. Only |kanjiskip| and |xkanjiskip|
% are understood; any other key is silently ignored, because this
% is not a reimplementation of the \pkg{luatexja} parameter system.
%    \begin{macrocode}
%<*ctex>
\keys_define:nn { LuaCJK / ctex / ltj }
  {
    kanjiskip  .code:n = { \@@_set_ccglue:n {#1} },
    xkanjiskip .code:n = { \@@_set_ecglue:n {#1} },
    unknown    .code:n = { },
  }
\NewDocumentCommand \ltjsetparameter { m }
  { \keys_set:nn { LuaCJK / ctex / ltj } {#1} }
\cs_new:Npn \ltjgetparameter #1
  {
    \str_case:nnF {#1}
      {
        { kanjiskip  } { \skip_use:N \l_@@_ccglue_skip }
        { xkanjiskip } { \skip_use:N \l_@@_ecglue_skip }
      } { 0pt }
  }
%</ctex>
%    \end{macrocode}
%
% \end{implementation}
%
% \Finale

% \begin{macro}{\LuaCJKversion}
% \changes{v0.0.1}{2026/11/11}{Provide \cs{LuaCJKversion}, which prints the
%   version of the package.}
% The version of the package.
% \begin{variable}[int]{\c_@@_version_tl}
% The version string, taken from the package metadata.
%    \begin{macrocode}
\tl_const:Nx \c_@@_version_tl { \ExplFileVersion }
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new:Npn \LuaCJKversion { \tl_use:N \c_@@_version_tl }

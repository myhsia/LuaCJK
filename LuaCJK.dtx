% \begin{macro}
%   {\setCJKmainfont, \setCJKsansfont, \setCJKmonofont, \setCJKfamilyfont}
% \changes{v0.0.3}{2026/11/20}{\cs{setCJKfamilyfont} expands the name of the
%   family it declares, so a family can be given as \cs{CJKrmdefault} and
%   friends.}
% The public font commands, all built on
% \cs{@@_set_family_with_options:nnnn}.
% The family of \cs{setCJKmainfont} and its siblings is already the value of
% \cs{CJKrmdefault} and friends; \cs{setCJKfamilyfont} expands its argument so
% that the same name reaches either command.
%    \begin{macrocode}
\NewDocumentCommand \setCJKmainfont { o m o }
  {
    \exp_args:NV \@@_set_family_with_options:nnnn
      \CJKrmdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKsansfont { o m o }
  {
    \exp_args:NV \@@_set_family_with_options:nnnn
      \CJKsfdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKmonofont { o m o }
  {
    \exp_args:NV \@@_set_family_with_options:nnnn
      \CJKttdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKfamilyfont { m o m o }
  {
    \tl_set:Ne \l_@@_tmpa_tl {#1}
    \exp_args:NV \@@_set_family_with_options:nnnn
      \l_@@_tmpa_tl {#2} {#3} {#4}
  }
\NewDocumentCommand \setCJKfallbackfamilyfont { m o m o }
  {
    \tl_set:Ne \l_@@_fallback_key_tl {#1}
    \tl_if_novalue:nTF {#2}
      {
        \tl_if_novalue:nTF {#4}
          { \@@_add_fallback:nn {  } {#3} }
          { \@@_add_fallback:nn {#4} {#3} }
      }
      { \@@_add_fallback:nn {#2} {#3} }
  }
%    \end{macrocode}
% \begin{macro}[int]{\@@_set_family_with_options:nnnn}

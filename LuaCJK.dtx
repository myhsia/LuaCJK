% \section{与 \pkg{xeCJK} 的比较}
%
% \pkg{LuaCJK} 只要两个引擎允许，就沿用 \pkg{xeCJK} 的接口，
% 所以一个已经在用 \pkg{xeCJK} 的文档大多不需要改动。
% 这里只列出不同之处。
%
% \subsection{行为差异}
%
% \begin{itemize}
%   \item \keys{Verb}：\texttt{env+} 的行为与 \texttt{false} 一样，
%   因为两者都保留调整。
%   \item 标点几何。样式把标点的尺寸给成一半，或者一半但句末标点保持全角，
%   或者 0.7 倍，并且墨迹按类别随进距移动：
%   开头的标点移动整个量，中间的标点移动一半，收尾的标点完全不移动。
%   \pkg{xeCJK} 则是测量每个字形的真实侧边距。
%   \item \cs{LuaCJKDeclarePunctStyle} 接受三个键
%   \keys{compress-adjacent}、\keys{adjacent-ratio} 与
%   \keys{keep-open-close}；\pkg{xeCJK} 的三十个几何键描述它的侧边距模型，
%   在这里没有对应物。
%   \item \texttt{CJKfilltwosides*} 不与自然宽度作比较。
%   \item CJK 字体是在文字用当前字体定形之后才应用到字形节点上的，
%   所以 CJK 字体的 OpenType 特性（连字、\texttt{locl}、\texttt{palt}、
%   变体序列）不生效：间距、标点进距与禁则都来自 LuaCJK 自己。
%   \item 在 \pkg{LuaCJKfntef} 里，\keys{format} 接受颜色名而不是代码，
%   而且装饰由 \pkg{lua-ul} 画出，所以 \texttt{ulem} 的选项列表不存在，
%   \tn{underLine} 直接配置。
% \end{itemize}
%
% \subsection{未提供的功能}
%
% \begin{itemize}
%   \item \texttt{NewLineCS}、\texttt{EnvCS}、\texttt{InlineEnv} 与
%   \texttt{PlainEquation}：它们的存在是为了让 \pkg{xeCJK} 在扫描记号时
%   认出 \TeX\ 构造，而一个已经完成的节点列表不需要提示。
%   \item \texttt{PoZheHaoLigature}，理由同上：字体的两字宽破折号连字
%   在 LuaCJK 应用 CJK 字体之前就已经定了。
%   \item \texttt{RubberPunctSkip}：标点的进距是一个 kern，
%   它既不是断行机会，也不参与两端对齐，
%   而正是这一点让固定宽度的样式保持稳定。
%   \item \texttt{CheckFullRight}：它需要标点之后的控制序列，
%   节点列表并不显示这个；请改用 \cs{LuaCJKnobreak}。
% \end{itemize}

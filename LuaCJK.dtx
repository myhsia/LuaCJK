%    \begin{macrocode}
\cs_new_protected:Npn \@@_update_font:
  {
    \bool_if:NF \l_@@_selectfont_bool
      {
        \bool_set_true:N \l_@@_selectfont_bool
        \prop_get:NVNTF \g_@@_family_prop \l_@@_family_tl \l_@@_family_name_tl
          {
            \group_begin:
              \exp_args:NV \fontfamily \l_@@_family_name_tl
              \selectfont
              \int_gset:Nn \g_@@_fontid_int
                { \tex_fontid:D \tex_font:D }
              \@@_push_shift:nn
                { \int_use:N \g_@@_fontid_int } { \l_@@_family_name_tl }
            \group_end:
            \g_@@_font_attr = \g_@@_fontid_int
          }
          {
            \g_@@_font_attr = \c_zero_int
            \tl_clear:N \l_@@_family_name_tl
          }
        \@@_math_font_update:
        \@@_push_fallback:
        \@@_push_block_fonts:
        \tl_if_empty:NTF \l_@@_punct_family_tl
          { \g_@@_punct_font_attr = \c_zero_int }
          {
            \prop_get:NVNTF \g_@@_family_prop \l_@@_punct_family_tl
              \l_@@_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \fontfamily \l_@@_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_@@_punct_fontid_int
                    { \tex_fontid:D \tex_font:D }
                \group_end:
                \g_@@_punct_font_attr = \g_@@_punct_fontid_int
              }
              { \g_@@_punct_font_attr = \c_zero_int }
          }
        \bool_set_false:N \l_@@_selectfont_bool
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_register_math_family:n}
% Give a CJK family a math family number and fill the three style fonts of
% that number from the family at the current size.
% A CJK character in a math list needs a family rather than a box, because the
% family is what selects the font \emph{and} its size for text, script, and
% scriptscript style; a box is built once and keeps the size it was built at.
% The script sizes are seven and five tenths of the text size, which is the
% ratio of the standard \LaTeX\ size tables.  The family is selected inside a
% group, so the caller's font is not disturbed, and the assignments are global
% because a math font belongs to a family, not to a group.
% The series and the shape come from the math version, not from the text
% around the formula: the family is selected at \cs{mddefault} and
% \cs{shapedefault}, and, in the \texttt{bold} math version, at
% \cs{bfdefault} as well when the family declares that shape.  The regular
% face is what loads the shape list the test reads, and a family without a
% bold face keeps its regular one in silence.  A formula therefore follows
% \cs{boldmath}, and a \cs{bfseries} that happens to precede it no longer
% leaks into it.
%    \begin{macrocode}
\msg_new:nnn { LuaCJK } { math-family-exhausted }
  { Too ~ many ~ CJK ~ families ~ for ~ the ~ math ~ families ~ 240--255. }
\cs_new_protected:Npn \@@_math_family:n #1
  {
    \prop_if_in:NnF \g_@@_math_family_prop {#1}
      {
        \int_gincr:N \g_@@_math_family_int
        \int_compare:nNnT \g_@@_math_family_int > \c_@@_math_family_max_int
          { \msg_error:nn { LuaCJK } { math-family-exhausted } }
        \prop_gput:NnV \g_@@_math_family_prop {#1}
          \g_@@_math_family_int
      }
  }
\cs_new_protected:Npn \@@_register_math_family:n #1
  {
    \@@_math_family:n {#1}
    \int_set:Nn \l_@@_tmpa_int
      { \prop_item:Nn \g_@@_math_family_prop {#1} }
    \group_begin:
      \fontfamily {#1}
      \fontseries { \mddefault }
      \fontshape { \shapedefault }
      \fontsize { \use:c { f@size } pt } { \baselineskip }
      \selectfont
      \bool_lazy_and:nnT
        { \str_if_eq_p:ee { \math@version } { bold } }
        {
          \cs_if_exist_p:c
            { \use:c { f@encoding } / #1 / \bfdefault / \shapedefault }
        }
        { \fontseries { \bfdefault } \selectfont }
      \global \textfont \l_@@_tmpa_int = \font
      \fontsize
        { \dim_eval:n { \use:c { f@size } pt * 7 / 10 } }
        { \baselineskip }
      \selectfont
      \global \scriptfont \l_@@_tmpa_int = \font
      \fontsize
        { \dim_eval:n { \use:c { f@size } pt * 5 / 10 } }
        { \baselineskip }
      \selectfont
      \global \scriptscriptfont \l_@@_tmpa_int = \font
    \group_end:
    \g_@@_math_font_attr = \l_@@_tmpa_int
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_math_version_refresh:}
% Register the math family again when the math version changes.
% \LaTeXe\ knows the numbers of its own math families only, so \tn{mathversion}
% cannot reach the fonts of a CJK math family: the version is applied by hand.
% \cs{glb@settings} is where a version change and a text-size change are
% applied, and it runs \tn{every@math@size} afterwards, so that register is
% where the refresh belongs.  It runs there also when the group that changed
% the version ends and the version in force before the group is applied again,
% which is what keeps |{\boldmath $中$}| local.  The guard stops the font
% selections of the registration from running the whole update again.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_math_version_refresh:
  {
    \bool_if:NF \l_@@_selectfont_bool
      {
        \bool_set_true:N \l_@@_selectfont_bool
        \@@_math_font_update:
        \bool_set_false:N \l_@@_selectfont_bool
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_toks_put_right:Nn}
% Append tokens to a token register such as \tn{every@math@size}.
% The register holds tokens rather than a token list variable, and
% \cs{tl_put_right:Nn} would put the name of the register into its own value,
% so the assignment is written out with \tn{the}.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_toks_put_right:Nn #1#2
  { #1 \expandafter { \tex_the:D #1 #2 } }
\exp_args:Nc \@@_toks_put_right:Nn { every@math@size }
  { \@@_math_version_refresh: }
%    \end{macrocode}
% \end{macro}

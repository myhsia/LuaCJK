    LuaCJK.attr_math_font   =  \int_use:N   \c_@@_math_font_attr_int ;
    LuaCJK.attr_punct_font  =  \int_use:N   \c_@@_punct_font_attr_int ;
    LuaCJK.attr_nobreak     =  \int_use:N   \c_@@_nobreak_attr_int ;
    LuaCJK.attr_settings    =  \int_use:N   \c_@@_settings_attr_int ;
    LuaCJK.attr_disabled    =  \int_use:N   \c_@@_disabled_attr_int ;
    LuaCJK.name_ccglue      = "\cs_to_str:N \l_@@_ccglue_skip" ;

% \title{\bfseries The \pkg{LuaCJK} package}
% \author{Mingyu Xia\thanks{\url{https://github.com/myhsia/LuaCJK}}}
% \date{Released \DocFileDate\quad \texttt{\DocFileVersion}}
% \maketitle
%
% \begin{abstract}
%   \pkg{LuaCJK} provides Chinese typesetting for \LuaLaTeX.  It is inspired
%   by \pkg{xeCJK}, but uses \LuaTeX{} node callbacks instead of \XeTeX
%   character classes.  This manual documents the first development release.
% \end{abstract}
%
% \tableofcontents
%
% \begin{documentation}
%
% \section{Introduction}
%
% \pkg{LuaCJK} is a \LuaTeX-only package for Chinese typesetting.  Its public
% interface follows the familiar \pkg{xeCJK} commands:
% \cs{setCJKmainfont}, \cs{setCJKsansfont}, \cs{setCJKmonofont},
% \cs{setCJKfamilyfont}, \cs{CJKfamily}, and \cs{LuaCJKsetup}.
%
% The implementation does not use \XeTeX's inter-character token mechanism.
% Instead, LuaCJK records the current CJK font in a \LuaTeX{} attribute and
% replaces CJK glyph nodes before line breaking and box packing.
%
% \section{Loading}
%
% \begin{quote}
%   \cs{usepackage}\oarg{options}\marg{LuaCJK}
% \end{quote}
%
% LuaCJK requires \LuaLaTeX.  It conflicts with \pkg{luatexja} and
% \pkg{xeCJK}; loading one of these packages before or after LuaCJK raises
% an error.
%
% \section{Font selection}
%
% The main font commands take an optional list of \pkg{fontspec} options.
% Options may be written before or after the font name.
%
% \begin{function}{\setCJKmainfont,\setCJKsansfont,\setCJKmonofont}
%   \begin{syntax}
%     \tn{setCJKmainfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Set the CJK font for the roman, sans serif, and monospaced families.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
{\CJKfamily{zhsong} 中文宋体} \quad
{\CJKfamily{zhhei} 中文黑体} \quad
{\CJKfamily{zhkai} 中文楷体} \quad
{\CJKfamily{zhfs} 中文仿宋}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\setCJKfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfamilyfont} \marg{family} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Define a named CJK family.
% \end{function}
%
% \begin{function}{\CJKfamily}
%   \begin{syntax}
%     \tn{CJKfamily} \marg{family}
%   \end{syntax}
%   Switch to a named CJK family.
% \end{function}
%
% \begin{function}{\newCJKfontfamily}
%   \begin{syntax}
%     \tn{newCJKfontfamily} \oarg{family} \meta{command} \oarg{options} \marg{font}
%   \end{syntax}
%   Define a command that switches to a newly declared family.  The command is
%   local to the current group, like \cs{newfontfamily}.
% \end{function}
%
% \begin{function}{\CJKfontspec}
%   \begin{syntax}
%     \tn{CJKfontspec} \oarg{options} \marg{font}
%   \end{syntax}
%   Select a CJK font for the current group.
% \end{function}
%
% \section{Options}
%
% \begin{function}{\LuaCJKsetup}
%   \begin{syntax}
%     \tn{LuaCJKsetup} \marg{key-value list}
%   \end{syntax}
%   Configure LuaCJK.  The settings are local to the current group.
% \end{function}
%
% The same keys may be given as package options, for example
% |\usepackage[PunctStyle = banjiao]{LuaCJK}|.
%
% \subsection{Spacing}
%
% \begin{keyval}
%   \item[\keys{CJKglue}]\val{glue}: Glue inserted between adjacent CJK
%   characters.  The initial value is
%   \texttt{0pt plus 0.08\cs{baselineskip}}.
%   \item[\keys{CJKecglue}]\val{glue}: Glue inserted between CJK and Latin
%   characters.  The initial value is a normal interword space.
%   \item[\keys{CJKspace}]\val{\TFF}: Whether to keep source spaces between
%   CJK characters.
%   \item[\keys{xCJKecglue}]\val{\TFF}: Whether to replace source spaces
%   between CJK and Latin characters with \texttt{CJKecglue}.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
中文 English 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begingroup
  \LuaCJKsetup{CJKspace = true}
  中 文 中 文
\endgroup
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{Suspending the adjustments}
%
% \begin{function}{\LuaCJKdisable, \LuaCJKenable}
%   \begin{syntax}
%     \tn{LuaCJKdisable} \\
%     \tn{LuaCJKenable}
%   \end{syntax}
%   \tn{LuaCJKdisable} stops the typographic adjustments: no \texttt{CJKglue}
%   or \texttt{CJKecglue} is inserted, punctuation is not compressed, no
%   line-breaking prohibitions are added, punctuation is not hung, and CJK
%   characters in math mode are left alone.  CJK characters are still
%   typeset in the CJK font, so text stays readable.  The switch is local to
%   the current group; \tn{LuaCJKenable} turns the adjustments back on.
% \end{function}
%
% This is the hook verbatim-like environments use, and it is also useful when
% measuring raw node lists.
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begingroup
  \LuaCJKdisable
  中 文
\endgroup
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{CJK in mathematics}
%
% \begin{keyval}
%   \item[\keys{CJKmath}]\val{\TFF}: Whether CJK characters may be typed
%   directly in math mode.  When it is
%   on, such a character is typeset as a box in the CJK math font instead of
%   being looked up in the math font.  Enable it with
%   \cs{LuaCJKsetup}\marg{CJKmath = true} or with the package option
%   |CJKmath = true|.  Without it a CJK character in math mode is looked up
%   in the math font and usually disappears, so LuaCJK issues a one-time
%   warning in that case.
% \end{keyval}
%
% \begin{function}{\setCJKmathfont}
%   \begin{syntax}
%     \tn{setCJKmathfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Select the CJK font used for characters in math mode.  Without this
%   command the CJK main font is used.  This manual enables \texttt{CJKmath}
%   and sets this font in its preamble.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
$ x + 中文 $ and 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{Punctuation}
%
% \begin{keyval}
%   \item[\keys{PunctStyle}]\val{style}: Select a punctuation style.  The
%   implemented styles are
%   \texttt{quanjiao} (the default), \texttt{plain}, \texttt{banjiao},
%   \texttt{kaiming}, \texttt{CCT}, and \texttt{hangmobanjiao}.  An unknown
%   name issues a warning and falls back to \texttt{plain}.
%   \item[\keys{PunctKinsoku}]\val{\TTF}: Whether to apply line-breaking
%   prohibitions for punctuation.  A closing
%   or middle punctuation cannot start a line, an opening punctuation cannot
%   end a line, and a run of long punctuation is kept together.  The
%   prohibitions are independent of \texttt{PunctStyle}, so they stay active
%   with |PunctStyle = plain|.
% \end{keyval}
%
% \begin{function}{\LuaCJKDeclarePunctStyle}
%   \begin{syntax}
%     \tn{LuaCJKDeclarePunctStyle} \marg{name} \marg{key-value list}
%   \end{syntax}
%   Define a punctuation style.  The available keys are
%   \texttt{compress-adjacent}, \texttt{adjacent-ratio}, and
%   \texttt{keep-open-close}.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
字，，字
\end{codemo}
% \iffalse
%</example>
% \fi

% \section{Current limitations}
%
% The first release covers the font and spacing core, the
% \texttt{quanjiao} and \texttt{plain} punctuation styles, and the basic
% line-breaking prohibitions for punctuation, hanging punctuation, and direct
% CJK input in math mode.  Line-end compression, fallback fonts, alternate
% fonts, the decoration layer, and a \pkg{ctex} backend are not yet
% implemented.
%
% \end{documentation}
%
% \StopEventually{\clearpage\PrintIndex}
%
% \begin{implementation}
%
% \section{Implementation}
%
% \begin{macrocode}
%<*package>
%    \end{macrocode}
%
% \begin{macrocode}
%<@@=LuaCJK>
%    \end{macrocode}
%
% \begin{macrocode}
%<package>\GetIdInfo $Id: LuaCJK.dtx 0.1.0 2026-11-02 myhsia<myhsia@outlook.com>$
%<package>  {A LuaTeX CJK typesetting package}
%<package>\ProvidesExplPackage {\ExplFileName}
%<!driver>  {\ExplFileDate} {\ExplFileVersion} {\ExplFileDescription}
%<package>\edef \DocFileDate        {\ExplFileDate}
%<package>\edef \DocFileVersion     {\ExplFileVersion}
%<package>\edef \DocFileDescription {\ExplFileDescription}
%    \end{macrocode}
%
% \begin{macrocode}
\sys_if_engine_luatex:F
  {
    \msg_new:nnn { LuaCJK } { engine }
      { LuaCJK~requires~LuaTeX. }
    \msg_critical:nn { LuaCJK } { engine }
    \tex_endinput:D
  }
\RequirePackage { expl3 }
\RequirePackage { l3keys2e }
\RequirePackage { fontspec }
\RequirePackage { xparse }
%    \end{macrocode}
%
% \begin{macrocode}
\msg_new:nnn { LuaCJK } { luatexja-conflict }
  {
    LuaCJK~and~LuaTeX-ja~must~not~be~loaded~together.\\
    Load~only~one~of~them.
  }
\msg_new:nnn { LuaCJK } { xecjk-conflict }
  {
    LuaCJK~is~for~LuaTeX;~xeCJK~is~for~XeTeX.\\
    Load~only~one~of~them.
  }
\cs_if_exist:cT { ver@luatexja.sty }
  { \msg_critical:nn { LuaCJK } { luatexja-conflict } }
\cs_if_exist:cT { ver@xeCJK.sty }
  { \msg_critical:nn { LuaCJK } { xecjk-conflict } }
\AddToHook { package/luatexja/before }
  { \msg_critical:nn { LuaCJK } { luatexja-conflict } }
\AddToHook { package/xeCJK/before }
  { \msg_critical:nn { LuaCJK } { xecjk-conflict } }
%    \end{macrocode}
%
% \begin{macrocode}
\newattribute \g_LuaCJK_font_attr
\int_const:Nn \c_LuaCJK_font_attr_int { \the \allocationnumber }
\tl_const:Nx \c_LuaCJK_version_tl { \ExplFileVersion }
\cs_new:Npn \LuaCJKversion { \tl_use:N \c_LuaCJK_version_tl }
%    \end{macrocode}
%
% \begin{macrocode}
\skip_new:N \l_LuaCJK_ccglue_skip
\skip_new:N \l_LuaCJK_ecglue_skip
\skip_set:Nn \l_LuaCJK_ccglue_skip { 0pt plus 0.08 \tex_baselineskip:D }
\skip_set:Nn \l_LuaCJK_ecglue_skip
  { 0.3333em plus 0.1667em minus 0.1111em }
\newattribute \g_LuaCJK_cjk_space_attr
\int_const:Nn \c_LuaCJK_cjk_space_attr_int { \the \allocationnumber }
\newattribute \g_LuaCJK_xecglue_attr
\int_const:Nn \c_LuaCJK_xecglue_attr_int { \the \allocationnumber }
\newattribute \g_LuaCJK_inserted_attr
\int_const:Nn \c_LuaCJK_inserted_attr_int { \the \allocationnumber }
\newattribute \g_LuaCJK_math_font_attr
\int_const:Nn \c_LuaCJK_math_font_attr_int { \the \allocationnumber }
\g_LuaCJK_math_font_attr = 0
\g_LuaCJK_cjk_space_attr = 0
\g_LuaCJK_xecglue_attr = 0

\tl_new:N \l_LuaCJK_punct_style_tl
\tl_set:Nn \l_LuaCJK_punct_style_tl { quanjiao }
\tl_new:N \l_LuaCJK_punct_kinsoku_tl
\tl_set:Nn \l_LuaCJK_punct_kinsoku_tl { 1 }
\tl_new:N \l_LuaCJK_cjk_math_tl
\tl_set:Nn \l_LuaCJK_cjk_math_tl { 0 }
\tl_new:N \l_LuaCJK_math_family_tl
\int_new:N \g_LuaCJK_math_fontid_int
\prop_new:N \g_LuaCJK_punct_style_prop
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { quanjiao } { }
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { plain } { }
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { banjiao } { }
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { kaiming } { }
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { CCT } { }
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { hangmobanjiao } { }
\msg_new:nnn { LuaCJK } { punct-style-unknown }
  {
    PunctStyle~`#1'~is~not~implemented.\\
    Using~`plain'~instead.
  }
\cs_new_protected:Npn \LuaCJK_set_punct_style:n #1
  {
    \prop_if_in:NnTF \g_LuaCJK_punct_style_prop {#1}
      { \tl_set:Nn \l_LuaCJK_punct_style_tl {#1} }
      {
        \msg_warning:nnn { LuaCJK } { punct-style-unknown } {#1}
        \tl_set:Nn \l_LuaCJK_punct_style_tl { plain }
      }
  }
\bool_new:N \l_LuaCJK_punct_compress_bool
\fp_new:N \l_LuaCJK_punct_ratio_fp
\bool_new:N \l_LuaCJK_punct_keep_bool
\keys_define:nn { LuaCJK / punct-style }
  {
    compress-adjacent .bool_set:N = \l_LuaCJK_punct_compress_bool,
    adjacent-ratio .fp_set:N = \l_LuaCJK_punct_ratio_fp,
    keep-open-close .bool_set:N = \l_LuaCJK_punct_keep_bool,
  }
\NewDocumentCommand \LuaCJKDeclarePunctStyle { m m }
  {
    \bool_set_true:N \l_LuaCJK_punct_compress_bool
    \fp_set:Nn \l_LuaCJK_punct_ratio_fp { 0.5 }
    \bool_set_true:N \l_LuaCJK_punct_keep_bool
    \keys_set:nn { LuaCJK / punct-style } {#2}
    \prop_gput:Nnn \g_LuaCJK_punct_style_prop {#1} { }
    \lua_now:e
      {
        LuaCJK.define_punct_style(
          "\lua_escape:e {#1}",
          \bool_if:NTF \l_LuaCJK_punct_compress_bool { true } { false },
          \fp_use:N \l_LuaCJK_punct_ratio_fp,
          \bool_if:NTF \l_LuaCJK_punct_keep_bool { true } { false } )
      }
  }
%    \end{macrocode}
%
% \begin{macrocode}
\keys_define:nn { LuaCJK / options }
  {
    CJKglue .code:n =
      {
        \skip_set:Nn \l_LuaCJK_ccglue_skip {#1}
      },
    CJKecglue .code:n =
      {
        \skip_set:Nn \l_LuaCJK_ecglue_skip {#1}
      },
    CJKspace .choice:,
    CJKspace / true  .code:n = { \g_LuaCJK_cjk_space_attr = 1 },
    CJKspace / false .code:n = { \g_LuaCJK_cjk_space_attr = 0 },
    CJKspace .default:n = { true },
    CJKspace .initial:n = { false },
    xCJKecglue .choice:,
    xCJKecglue / true  .code:n = { \g_LuaCJK_xecglue_attr = 1 },
    xCJKecglue / false .code:n = { \g_LuaCJK_xecglue_attr = 0 },
    xCJKecglue .default:n = { true },
    xCJKecglue .initial:n = { false },
    PunctStyle .code:n = { \LuaCJK_set_punct_style:n {#1} },
    PunctStyle .default:n = { quanjiao },
    PunctKinsoku .choice:,
    PunctKinsoku / true  .code:n = { \tl_set:Nn \l_LuaCJK_punct_kinsoku_tl { 1 } },
    PunctKinsoku / false .code:n = { \tl_set:Nn \l_LuaCJK_punct_kinsoku_tl { 0 } },
    PunctKinsoku .default:n = { true },
    CJKmath .choice:,
    CJKmath / true  .code:n = { \tl_set:Nn \l_LuaCJK_cjk_math_tl { 1 } },
    CJKmath / false .code:n = { \tl_set:Nn \l_LuaCJK_cjk_math_tl { 0 } },
    CJKmath .default:n = { true },
    unknown .code:n =
      {
        \msg_warning:nne { LuaCJK } { unknown-option }
          { \l_keys_key_str }
      },
  }
\msg_new:nnn { LuaCJK } { unknown-option }
  { Unknown~option~`#1'~is~being~ignored. }
\NewDocumentCommand \LuaCJKsetup { m }
  { \keys_set:nn { LuaCJK / options } {#1} }
\cs_if_exist:NTF \ProcessKeyOptions
  { \ProcessKeyOptions [ LuaCJK / options ] }
  { \ProcessKeysOptions { LuaCJK / options } }
%    \end{macrocode}
%
% \begin{macrocode}
\tl_new:N \l_LuaCJK_enabled_tl
\tl_set:Nn \l_LuaCJK_enabled_tl { 1 }
\NewDocumentCommand \LuaCJKdisable { }
  { \tl_set:Nn \l_LuaCJK_enabled_tl { 0 } }
\NewDocumentCommand \LuaCJKenable { }
  { \tl_set:Nn \l_LuaCJK_enabled_tl { 1 } }
%    \end{macrocode}
%
% \begin{macrocode}
\prop_new:N \g_LuaCJK_family_prop
\tl_new:N \l_LuaCJK_family_tl
\tl_set:Nn \l_LuaCJK_family_tl { zhsong }
\tl_new:N \l_LuaCJK_tmpa_tl
\tl_new:N \l_LuaCJK_fontspec_tl
\tl_new:N \l_LuaCJK_family_name_tl
\tl_new:N \CJKrmdefault
\tl_new:N \CJKsfdefault
\tl_new:N \CJKttdefault
\tl_new:N \CJKfamilydefault
\tl_set:Nn \CJKrmdefault { zhsong }
\tl_set:Nn \CJKsfdefault { zhhei }
\tl_set:Nn \CJKttdefault { zhfs }
\tl_set:Nn \CJKfamilydefault { zhsong }
%    \end{macrocode}
%
% \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_set_family:nnn #1#2#3
  {
    \group_begin:
      \fontspec_gset_family:Nnn \l_LuaCJK_fontspec_tl {#2} {#3}
      \prop_gput:NnV \g_LuaCJK_family_prop {#1} \l_LuaCJK_fontspec_tl
    \group_end:
    \prop_if_in:NVT \g_LuaCJK_family_prop \l_LuaCJK_family_tl
      { \selectfont }
  }
\cs_new_protected:Npn \LuaCJK_switch_family:n #1
  {
    \prop_if_in:NnTF \g_LuaCJK_family_prop {#1}
      {
        \tl_set:Nn \l_LuaCJK_family_tl {#1}
        \selectfont
      }
      { \msg_warning:nnn { LuaCJK } { family-unknown } {#1} }
  }
\msg_new:nnn { LuaCJK } { family-unknown }
  { Unknown~CJK~family~`#1'~is~being~ignored. }
%    \end{macrocode}
%
% \begin{macrocode}
\bool_new:N \l_LuaCJK_selectfont_bool
\int_new:N \g_LuaCJK_fontid_int
\cs_new_protected:Npn \LuaCJK_update_font:
  {
    \bool_if:NF \l_LuaCJK_selectfont_bool
      {
        \bool_set_true:N \l_LuaCJK_selectfont_bool
        \prop_get:NVNTF \g_LuaCJK_family_prop \l_LuaCJK_family_tl \l_LuaCJK_family_name_tl
          {
            \group_begin:
              \exp_args:NV \fontfamily \l_LuaCJK_family_name_tl
              \selectfont
              \int_gset:Nn \g_LuaCJK_fontid_int
                { \tex_fontid:D \tex_font:D }
            \group_end:
            \g_LuaCJK_font_attr = \g_LuaCJK_fontid_int
          }
          { \g_LuaCJK_font_attr = \c_zero_int }
        \tl_if_empty:NTF \l_LuaCJK_math_family_tl
          { \int_gset:Nn \g_LuaCJK_math_fontid_int { \int_use:N \g_LuaCJK_fontid_int } }
          {
            \prop_get:NVNTF \g_LuaCJK_family_prop \l_LuaCJK_math_family_tl
              \l_LuaCJK_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \fontfamily \l_LuaCJK_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_LuaCJK_math_fontid_int
                    { \tex_fontid:D \tex_font:D }
                \group_end:
              }
              { \int_gzero:N \g_LuaCJK_math_fontid_int }
          }
        \g_LuaCJK_math_font_attr = \g_LuaCJK_math_fontid_int
        \bool_set_false:N \l_LuaCJK_selectfont_bool
      }
  }
\AddToHook { selectfont } { \LuaCJK_update_font: }
%    \end{macrocode}
%
% \begin{macrocode}
\NewDocumentCommand \setCJKmainfont { o m o }
  {
    \exp_args:NV \LuaCJK_set_family_with_options:nnnn
      \CJKrmdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKsansfont { o m o }
  {
    \exp_args:NV \LuaCJK_set_family_with_options:nnnn
      \CJKsfdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKmonofont { o m o }
  {
    \exp_args:NV \LuaCJK_set_family_with_options:nnnn
      \CJKttdefault {#1} {#2} {#3}

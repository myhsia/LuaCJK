% \title{\bfseries The \pkg{LuaCJK} package}
% \author{Mingyu Xia\thanks{\url{https://github.com/myhsia/LuaCJK}}}
% \date{Released \DocFileDate\quad \texttt{\DocFileVersion}}
% \maketitle
%
% \begin{abstract}
%   \pkg{LuaCJK} provides Chinese typesetting for \LuaLaTeX.  It is inspired
%   by \pkg{xeCJK}, but uses \LuaTeX\ node callbacks instead of \XeTeX
%   character classes.  This manual documents the first development release.
% \end{abstract}
%
% \tableofcontents
%
% \begin{documentation}
%
% \section{Introduction}
%
% \pkg{LuaCJK} is a \LuaTeX-only package for Chinese typesetting.  Its public
% interface follows the familiar \pkg{xeCJK} commands:
% \cs{setCJKmainfont}, \cs{setCJKsansfont}, \cs{setCJKmonofont},
% \cs{setCJKfamilyfont}, \cs{CJKfamily}, and \cs{LuaCJKsetup}.
%
% The implementation does not use \XeTeX's inter-character token mechanism.
% Instead, LuaCJK records the current CJK font in a \LuaTeX\ attribute and
% replaces CJK glyph nodes before line breaking and box packing.
%
% \section{Loading}
%
% \begin{quote}
%   \cs{usepackage}\oarg{options}"{LuaCJK}"
% \end{quote}
%
% LuaCJK requires \LuaLaTeX.  It conflicts with \pkg{luatexja}: loading
% either package before or after the other raises an error.
%
% \begin{function}{\LuaCJKversion}
%   Print the version of LuaCJK.
% \end{function}
%
% \section{Font selection}
%
% The main font commands take an optional list of \pkg{fontspec} options.
% Options may be written before or after the font name.
%
% \begin{function}{\setCJKmainfont,\setCJKsansfont,\setCJKmonofont}
%   \begin{syntax}
%     \tn{setCJKmainfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Set the CJK font for the roman, sans serif, and monospaced families.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKfamily{zhsong}中文宋体\quad
\CJKfamily {zhhei}中文黑体\\
\CJKfamily {zhkai}中文楷体\quad
\CJKfamily  {zhfs}中文仿宋
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\setCJKfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfamilyfont} \marg{family} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Define a named CJK family.
% \end{function}
%
% \begin{function}{\CJKfamily}
%   \begin{syntax}
%     \tn{CJKfamily} \marg{family}
%   \end{syntax}
%   Switch to a named CJK family.
% \end{function}
%
% \begin{function}{\newCJKfontfamily}
%   \begin{syntax}
%     \tn{newCJKfontfamily} \oarg{family} \meta{command} \oarg{options} \marg{font}
%   \end{syntax}
%   Define a command that switches to a newly declared family.  The command is
%   local to the current group, like \cs{newfontfamily}.
% \end{function}
%
% \begin{function}{\CJKfontspec}
%   \begin{syntax}
%     \tn{CJKfontspec} \oarg{options} \marg{font}
%   \end{syntax}
%   Select a CJK font for the current group.
% \end{function}
%
% \begin{function}{\songti, \heiti, \fangsong, \kaishu, \lishu, \youyuan}
%   Shortcuts for the families named \texttt{zhsong}, \texttt{zhhei},
%   \texttt{zhfs}, \texttt{zhkai}, \texttt{zhli}, and \texttt{zhyou}.
% \end{function}
%
% \begin{variable}
%   {\CJKrmdefault, \CJKsfdefault, \CJKttdefault, \CJKfamilydefault}
%   The CJK families selected by \tn{rmfamily}, \tn{sffamily}, and
%   \tn{ttfamily}.
% \end{variable}

% \begin{function}{\defaultCJKfontfeatures}
%   \begin{syntax}
%     \tn{defaultCJKfontfeatures} \marg{font features}
%   \end{syntax}
%   Set the features prepended to every CJK family registered afterwards.
%   The initial value is |Script = CJK|.  Families registered before the
%   call keep the features they were given.
% \end{function}
%
% \begin{function}{\addCJKfontfeatures}
%   \begin{syntax}
%     \tn{addCJKfontfeatures} \oarg{ignored} \marg{font features}
%   \end{syntax}
%   Add features to the current CJK family for the rest of the group, for
%   example |\addCJKfontfeatures{Scale = 1.2}|.  A leading \texttt{*} is
%   accepted for compatibility with \pkg{xeCJK}, where it also covers the
%   sub-blocks; LuaCJK has no blocks, so both forms act on the same font.
% \end{function}
%
% \section{Options}
%
% \begin{function}{\LuaCJKsetup}
%   \begin{syntax}
%     \tn{LuaCJKsetup} \marg{key-value list}
%   \end{syntax}
%   Configure LuaCJK.  The settings are local to the current group.
% \end{function}
%
% The same keys may be given as package options:
% \begin{quote}
%   |\usepackage[PunctStyle = banjiao]{LuaCJK}|
% \end{quote}
%
% \section{Spacing}
%
% \begin{keyval}
%   \item[\keys{CJKglue}]\val{glue}: Glue inserted between adjacent CJK
%   characters.  The initial value is
%   \texttt{0pt plus 0.08\cs{baselineskip}}.
%   \item[\keys{CJKecglue}]\val{glue}: Glue inserted between CJK and Latin
%   characters.  The initial value is a normal interword space.
%   \item[\keys{CJKspace}]\val{\TFF}: Whether to keep source spaces between
%   CJK characters.
%   \item[\keys{xCJKecglue}]\val{\TFF}: Whether to replace source spaces
%   between CJK and Latin characters with \texttt{CJKecglue}.
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
中文 English 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begingroup
  \LuaCJKsetup{CJKspace = true}
  中 文 中 文
\endgroup
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\normalspacedchars}
%   \begin{syntax}
%     \tn{normalspacedchars} \marg{character list}
%   \end{syntax}
%   The listed characters get no glue on either side, so that a hyphen or a
%   slash inside Latin text does not pull the surrounding text apart.  The
%   initial list is |/|, |\|, and |-|.  The setting is global.
% \end{function}
%
% \section{Suspending the adjustments}
%
% \begin{function}{\LuaCJKdisable, \LuaCJKenable}
%   \begin{syntax}
%     \tn{LuaCJKdisable} \\
%     \tn{LuaCJKenable}
%   \end{syntax}
%   \tn{LuaCJKdisable} stops the typographic adjustments: no \texttt{CJKglue}
%   or \texttt{CJKecglue} is inserted, punctuation is not compressed, no
%   line-breaking prohibitions are added, punctuation is not hung, and CJK
%   characters in math mode are left alone.  CJK characters are still
%   typeset in the CJK font, so text stays readable.  The switch is local to
%   the current group; \tn{LuaCJKenable} turns the adjustments back on.
% \end{function}
%
% This is the hook verbatim-like environments use, and it is also useful when
% measuring raw node lists.
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begingroup
  \LuaCJKdisable
  中 文
\endgroup
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{keyval}
%   \item[\keys{LocalConfig}]\val{\TTF \textbar{} \meta{name} \textbar{}
%     \texttt{false}}
%   Read local settings from a configuration file.  \texttt{true} loads
%   \file{luacjk.cfg}, \meta{name} loads \file{luacjk-\meta{name}.cfg}, and
%   \texttt{false} (the initial value) loads nothing.  The file is read at
%   the end of the package, so it may use every command LuaCJK defines.  A
%   missing file only warns.
% \end{keyval}
%
% \begin{keyval}
%   \item[\keys{Verb}]\val{\TTF \textbar{} \texttt{env} \textbar{}
%     \texttt{env+}}
%   What to do inside \tn{verb} and the verbatim-like environments
%   (\env{verbatim}, \env{Verbatim}, \env{lstlisting}, and their
%   relatives).  \texttt{true} suspends the adjustments in both;
%   \texttt{env} keeps them inside the environments but not in \tn{verb},
%   which preserves column alignment when the code contains CJK text;
%   \texttt{env+} keeps them everywhere; \texttt{false} leaves verbatim
%   material entirely alone.  Since \texttt{env+} and \texttt{false} both
%   leave the adjustments on, they behave the same in LuaCJK.
% \end{keyval}
%
% \section{CJK in mathematics}
%
% \begin{keyval}
%   \item[\keys{CJKmath}]\val{\TFF}: Whether CJK characters may be typed
%   directly in math mode.  When it is
%   on, such a character is typeset as a box in the CJK math font instead of
%   being looked up in the math font.  Enable it with
%   \cs{LuaCJKsetup}\marg{CJKmath = true} or with the package option
%   |CJKmath = true|.  Without it a CJK character in math mode is looked up
%   in the math font and usually disappears, so LuaCJK issues a one-time
%   warning in that case.
% \end{keyval}
%
% \begin{function}{\setCJKmathfont}
%   \begin{syntax}
%     \tn{setCJKmathfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   Select the CJK font used for characters in math mode.  Without this
%   command the CJK main font is used.  This manual enables \texttt{CJKmath}
%   and sets this font in its preamble.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
$ x + 中文 $ and 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{Punctuation}
%
% \begin{keyval}
%   \item[\keys{PunctStyle}]\val{style}: Select a punctuation style.  The
%   implemented styles are
%   \texttt{quanjiao} (the default), \texttt{plain}, \texttt{banjiao},
%   \texttt{kaiming}, \texttt{CCT}, and \texttt{hangmobanjiao}.  An unknown
%   name issues a warning and falls back to \texttt{plain}.
%   \item[\keys{PunctKinsoku}]\val{\TTF}: Whether to apply line-breaking
%   prohibitions for punctuation.  A closing
%   or middle punctuation cannot start a line, an opening punctuation cannot
%   end a line, and a run of long punctuation is kept together.  The
%   prohibitions are independent of \texttt{PunctStyle}, so they stay active
%   with |PunctStyle = plain|.
% \end{keyval}
%
% \begin{function}{\LuaCJKsetwidth}
%   \begin{syntax}
%     \tn{LuaCJKsetwidth} \marg{punctuation list} \marg{length}
%   \end{syntax}
%   Give the listed punctuation marks a fixed advance, overriding the
%   selected \texttt{PunctStyle}.  A leading \texttt{*} is accepted for
%   compatibility with \pkg{xeCJK}, where it sets the width used at the
%   start or end of a line; that case is not implemented and warns once.
% \end{function}
%
% \begin{function}{\LuaCJKsetkern}
%   \begin{syntax}
%     \tn{LuaCJKsetkern} \marg{before} \marg{after} \marg{length}
%   \end{syntax}
%   Set the gap between two adjacent punctuation marks, overriding the
%   style.  Only the first character of each argument is used.
% \end{function}
%
% \begin{function}{\LuaCJKDeclarePunctStyle}
%   \begin{syntax}
%     \tn{LuaCJKDeclarePunctStyle} \marg{name} \marg{key-value list}
%   \end{syntax}
%   Define a punctuation style.  The available keys are
%   \texttt{compress-adjacent}, \texttt{adjacent-ratio}, and
%   \texttt{keep-open-close}.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
字，，字
\end{codemo}
% \iffalse
%</example>
% \fi

% \section{Font effects}
%
% The companion package \pkg{LuaCJKfntef} provides underlining, emphasis
% dots, and strike-through.  It builds on \pkg{lua-ul}, so the decorated text
% may contain arbitrary commands, CJK and Latin text, and may still be
% hyphenated and broken between lines.
%
% \begin{function}{\CJKunderline}
%   \begin{syntax}
%     \tn{CJKunderline} \oarg{options} \marg{text}
%   \end{syntax}
%   Underline \meta{text}.  The \meta{options} are passed to the \pkg{lua-ul}
%   underline type, so |top| and |bottom| may be used to tune the position.
%   A leading \texttt{*} or \texttt{-} is accepted for compatibility with
%   \pkg{xeCJKfntef} and ignored.
% \end{function}
%
% \begin{function}{\CJKunderdot}
%   \begin{syntax}
%     \tn{CJKunderdot} \marg{text}
%   \end{syntax}
%   Put emphasis dots under \meta{text}.
% \end{function}
%
% \begin{function}{\CJKsout}
%   \begin{syntax}
%     \tn{CJKsout} \oarg{color} \marg{text}
%   \end{syntax}
%   Strike \meta{text} through.  The optional argument is the color of the
%   rule.
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKunderline{中文 test 中文}\\
\CJKunderdot{中文 test 中文}\\
\CJKsout{中文 test 中文}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{Current limitations}
%
% The first release covers the font and spacing core, the
% \texttt{quanjiao} and \texttt{plain} punctuation styles, and the basic
% line-breaking prohibitions for punctuation, hanging punctuation, and direct
% CJK input in math mode, and the font effects of \pkg{LuaCJKfntef}.
% Line-end compression, fallback fonts, alternate fonts, wave and double
% underlines, and a \pkg{ctex} backend are not yet implemented.
%
% \end{documentation}
%
% \StopEventually{\clearpage\PrintIndex}
%
% \begin{implementation}
%
% \section{Implementation}
%
% \begin{macrocode}
%<*package>
%    \end{macrocode}
%
% \begin{macrocode}
%<@@=LuaCJK>
%    \end{macrocode}
%
% \subsection{Engine check and package loading}
%
% LuaCJK only works with \LuaTeX.  The engine test runs before any other
% package is loaded, so that a wrong engine stops with a clear message.
%    \begin{macrocode}
\sys_if_engine_luatex:F
  {
    \msg_new:nnn { LuaCJK } { engine }
      { LuaCJK~requires~LuaTeX. }
    \msg_critical:nn { LuaCJK } { engine }
    \tex_endinput:D
  }
\RequirePackage { l3keys2e }
\RequirePackage { fontspec }
\RequirePackage { xparse }
%    \end{macrocode}
%
% \begin{macro}{\LuaCJKversion}
%   The version of the package.
%   \begin{variable}[internal]{\c_LuaCJK_version_tl}
%     The version string, taken from the package metadata.
%    \begin{macrocode}
\tl_const:Nx \c_LuaCJK_version_tl { \ExplFileVersion }
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\cs_new:Npn \LuaCJKversion { \tl_use:N \c_LuaCJK_version_tl }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Conflicting packages}
%
% \pkg{luatexja} installs its own CJK font and spacing layer and works on the
% same callbacks as LuaCJK, so the two are rejected whatever the loading
% order.  \pkg{xeCJK} needs no check here: it stops by itself on any engine
% other than \XeTeX.
%    \begin{macrocode}
\msg_new:nnn { LuaCJK } { luatexja-conflict }
  {
    LuaCJK~and~LuaTeX-ja~must~not~be~loaded~together.\\
    Load~only~one~of~them.
  }
\cs_if_exist:cT { ver@luatexja.sty }
  { \msg_critical:nn { LuaCJK } { luatexja-conflict } }
\AddToHook { package/luatexja/before }
  { \msg_critical:nn { LuaCJK } { luatexja-conflict } }
%    \end{macrocode}
%
% \subsection{Attributes and registers}
%
% \begin{variable}[internal]
%   {
%     \g_LuaCJK_font_attr, \c_LuaCJK_font_attr_int,
%     \g_LuaCJK_cjk_space_attr, \c_LuaCJK_cjk_space_attr_int,
%     \g_LuaCJK_xecglue_attr, \c_LuaCJK_xecglue_attr_int,
%     \g_LuaCJK_inserted_attr, \c_LuaCJK_inserted_attr_int,
%     \g_LuaCJK_math_font_attr, \c_LuaCJK_math_font_attr_int,
%     \g_LuaCJK_disabled_attr, \c_LuaCJK_disabled_attr_int
%   }
%   The attributes record, per node, the CJK font, the space and glue
%   policies, whether the node was inserted by LuaCJK, the CJK math font,
%   and whether the adjustments are suspended.  The integer constants hold
%   the allocated attribute numbers for the Lua side.
%    \begin{macrocode}
\newattribute \g_LuaCJK_font_attr
\int_const:Nn \c_LuaCJK_font_attr_int { \the \allocationnumber }
\newattribute \g_LuaCJK_cjk_space_attr
\int_const:Nn \c_LuaCJK_cjk_space_attr_int { \the \allocationnumber }
\newattribute \g_LuaCJK_xecglue_attr
\int_const:Nn \c_LuaCJK_xecglue_attr_int { \the \allocationnumber }
\newattribute \g_LuaCJK_inserted_attr
\int_const:Nn \c_LuaCJK_inserted_attr_int { \the \allocationnumber }
\newattribute \g_LuaCJK_math_font_attr
\int_const:Nn \c_LuaCJK_math_font_attr_int { \the \allocationnumber }
\newattribute \g_LuaCJK_disabled_attr
\int_const:Nn \c_LuaCJK_disabled_attr_int { \the \allocationnumber }
\g_LuaCJK_math_font_attr = 0
\g_LuaCJK_cjk_space_attr = 0
\g_LuaCJK_xecglue_attr = 0
%    \end{macrocode}
% \end{variable}
%
% \begin{variable}[internal]{\l_LuaCJK_ccglue_skip, \l_LuaCJK_ecglue_skip}
%   The glue used between CJK characters and between CJK and Latin text.
%    \begin{macrocode}
\skip_new:N \l_LuaCJK_ccglue_skip
\skip_new:N \l_LuaCJK_ecglue_skip
\skip_set:Nn \l_LuaCJK_ccglue_skip { 0pt plus 0.08 \tex_baselineskip:D }
\skip_set:Nn \l_LuaCJK_ecglue_skip
  { 0.3333em plus 0.1667em minus 0.1111em }
%    \end{macrocode}
% \end{variable}
%
% \subsection{Punctuation styles}
%
% \begin{variable}[internal]{\g_LuaCJK_punct_style_prop}
%   The names of the styles LuaCJK knows about, including those defined by
%   \cs{LuaCJKDeclarePunctStyle}.
%    \begin{macrocode}
\prop_new:N \g_LuaCJK_punct_style_prop
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { quanjiao } { }
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { plain } { }
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { banjiao } { }
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { kaiming } { }
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { CCT } { }
\prop_gput:Nnn \g_LuaCJK_punct_style_prop { hangmobanjiao } { }
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[internal]{\LuaCJK_set_punct_style:n}
%   Store the selected style, or warn and fall back to \texttt{plain} when
%   the name is unknown.
%   \begin{variable}[internal]{\l_LuaCJK_punct_style_tl}
%     The style name read by the Lua side.
%    \begin{macrocode}
\tl_new:N \l_LuaCJK_punct_style_tl
\tl_set:Nn \l_LuaCJK_punct_style_tl { quanjiao }
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\msg_new:nnn { LuaCJK } { punct-style-unknown }
  {
    PunctStyle~`#1'~is~not~implemented.\\
    Using~`plain'~instead.
  }
\cs_new_protected:Npn \LuaCJK_set_punct_style:n #1
  {
    \prop_if_in:NnTF \g_LuaCJK_punct_style_prop {#1}
      { \tl_set:Nn \l_LuaCJK_punct_style_tl {#1} }
      {
        \msg_warning:nnn { LuaCJK } { punct-style-unknown } {#1}
        \tl_set:Nn \l_LuaCJK_punct_style_tl { plain }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKsetwidth}
%   Give specific punctuation marks a fixed advance, overriding the
%   selected style.  The star form of \pkg{xeCJK}, which sets the width used
%   at the start or end of a line, has no counterpart yet and only warns.
%   \begin{variable}[internal]{\l_LuaCJK_bound_width_warned_bool}
%     Guards the one-time warning for the star form.
%    \begin{macrocode}
\bool_new:N \l_LuaCJK_bound_width_warned_bool
\msg_new:nnn { LuaCJK } { bound-width-unsupported }
  {
    The~star~form~of~\token_to_str:N \LuaCJKsetwidth,~which~sets~the~width~
    at~the~start~or~end~of~a~line,~is~not~implemented.\\
    The~width~is~applied~to~every~position~instead.
  }
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKsetwidth { s m m }
  {
    \IfBooleanT {#1}
      {
        \bool_if:NF \l_LuaCJK_bound_width_warned_bool
          {
            \bool_set_true:N \l_LuaCJK_bound_width_warned_bool
            \msg_warning:nn { LuaCJK } { bound-width-unsupported }
          }
      }
    \lua_now:e
      {
        LuaCJK.set_punct_width
          ( "\lua_escape:e {#2}" , \dim_to_decimal_in_sp:n {#3} )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKsetkern}
%   Set the gap between two adjacent punctuation marks, overriding the
%   selected style.  Only the first character of each argument is used.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKsetkern { m m m }
  {
    \lua_now:e
      {
        LuaCJK.set_punct_kern
          ( "\lua_escape:e {#1}" , "\lua_escape:e {#2}"
          , \dim_to_decimal_in_sp:n {#3} )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKDeclarePunctStyle}
%   Define a style from a small set of keys and hand the result to Lua.
%   \begin{variable}[internal]
%     {\l_LuaCJK_punct_compress_bool, \l_LuaCJK_punct_ratio_fp,
%      \l_LuaCJK_punct_keep_bool}
%     The values collected from the keys, with the defaults used when a key
%     is not given.
%    \begin{macrocode}
\bool_new:N \l_LuaCJK_punct_compress_bool
\fp_new:N \l_LuaCJK_punct_ratio_fp
\bool_new:N \l_LuaCJK_punct_keep_bool
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\keys_define:nn { LuaCJK / punct-style }
  {
    compress-adjacent .bool_set:N = \l_LuaCJK_punct_compress_bool,
    adjacent-ratio .fp_set:N = \l_LuaCJK_punct_ratio_fp,
    keep-open-close .bool_set:N = \l_LuaCJK_punct_keep_bool,
  }
\NewDocumentCommand \LuaCJKDeclarePunctStyle { m m }
  {
    \bool_set_true:N \l_LuaCJK_punct_compress_bool
    \fp_set:Nn \l_LuaCJK_punct_ratio_fp { 0.5 }
    \bool_set_true:N \l_LuaCJK_punct_keep_bool
    \keys_set:nn { LuaCJK / punct-style } {#2}
    \prop_gput:Nnn \g_LuaCJK_punct_style_prop {#1} { }
    \lua_now:e
      {
        LuaCJK.define_punct_style(
          "\lua_escape:e {#1}",
          \bool_if:NTF \l_LuaCJK_punct_compress_bool { true } { false },
          \fp_use:N \l_LuaCJK_punct_ratio_fp,
          \bool_if:NTF \l_LuaCJK_punct_keep_bool { true } { false } )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Options}
%
% \begin{macro}{\LuaCJKsetup}
%   The same key path serves \cs{LuaCJKsetup} and the package options.
%   \begin{variable}[internal]
%     {\l_LuaCJK_punct_kinsoku_tl, \l_LuaCJK_cjk_math_tl, \l_LuaCJK_verb_mode_tl}
%     The switches read by the Lua side, plus the \texttt{Verb} setting.
%    \begin{macrocode}
\tl_new:N \l_LuaCJK_punct_kinsoku_tl
\tl_set:Nn \l_LuaCJK_punct_kinsoku_tl { 1 }
\tl_new:N \l_LuaCJK_cjk_math_tl
\tl_set:Nn \l_LuaCJK_cjk_math_tl { 0 }
\tl_new:N \l_LuaCJK_verb_mode_tl
\tl_set:Nn \l_LuaCJK_verb_mode_tl { true }
\tl_new:N \l_LuaCJK_local_config_tl
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\keys_define:nn { LuaCJK / options }
  {
    CJKglue .code:n =
      {
        \skip_set:Nn \l_LuaCJK_ccglue_skip {#1}
      },
    CJKecglue .code:n =
      {
        \skip_set:Nn \l_LuaCJK_ecglue_skip {#1}
      },
    CJKspace .choice:,
    CJKspace / true  .code:n = { \g_LuaCJK_cjk_space_attr = 1 },
    CJKspace / false .code:n = { \g_LuaCJK_cjk_space_attr = 0 },
    CJKspace .default:n = { true },
    CJKspace .initial:n = { false },
    xCJKecglue .choice:,
    xCJKecglue / true  .code:n = { \g_LuaCJK_xecglue_attr = 1 },
    xCJKecglue / false .code:n = { \g_LuaCJK_xecglue_attr = 0 },
    xCJKecglue .default:n = { true },
    xCJKecglue .initial:n = { false },
    PunctStyle .code:n = { \LuaCJK_set_punct_style:n {#1} },
    PunctStyle .default:n = { quanjiao },
    PunctKinsoku .choice:,
    PunctKinsoku / true  .code:n = { \tl_set:Nn \l_LuaCJK_punct_kinsoku_tl { 1 } },
    PunctKinsoku / false .code:n = { \tl_set:Nn \l_LuaCJK_punct_kinsoku_tl { 0 } },
    PunctKinsoku .default:n = { true },
    CJKmath .choice:,
    CJKmath / true  .code:n = { \tl_set:Nn \l_LuaCJK_cjk_math_tl { 1 } },
    CJKmath / false .code:n = { \tl_set:Nn \l_LuaCJK_cjk_math_tl { 0 } },
    CJKmath .default:n = { true },
    Verb .choice:,
    Verb / true  .code:n = { \tl_set:Nn \l_LuaCJK_verb_mode_tl { true } },
    Verb / env   .code:n = { \tl_set:Nn \l_LuaCJK_verb_mode_tl { env } },
    Verb / env+  .code:n = { \tl_set:Nn \l_LuaCJK_verb_mode_tl { env+ } },
    Verb / false .code:n = { \tl_set:Nn \l_LuaCJK_verb_mode_tl { false } },
    Verb .default:n = { true },
    LocalConfig .code:n =
      {
        \str_case:nnF {#1}
          {
            { true }  { \tl_set:Nn \l_LuaCJK_local_config_tl { luacjk.cfg } }
            { false } { \tl_clear:N \l_LuaCJK_local_config_tl }
          }
          { \tl_set:Nn \l_LuaCJK_local_config_tl { luacjk-#1.cfg } }
      },
    LocalConfig .default:n = { true },
    unknown .code:n =
      {
        \msg_warning:nne { LuaCJK } { unknown-option }
          { \l_keys_key_str }
      },
  }
\msg_new:nnn { LuaCJK } { unknown-option }
  { Unknown~option~`#1'~is~being~ignored. }
\NewDocumentCommand \LuaCJKsetup { m }
  { \keys_set:nn { LuaCJK / options } {#1} }
\cs_if_exist:NTF \ProcessKeyOptions
  { \ProcessKeyOptions [ LuaCJK / options ] }
  { \ProcessKeysOptions { LuaCJK / options } }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Suspending the adjustments}
%
% \begin{macro}{\LuaCJKdisable, \LuaCJKenable}
%   Set the node attribute that makes the Lua callbacks skip the
%   adjustments.  The attribute follows the \TeX{} grouping.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKdisable { }
  { \g_LuaCJK_disabled_attr = 1 }
\NewDocumentCommand \LuaCJKenable { }
  { \g_LuaCJK_disabled_attr = 0 }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{\LuaCJK_verbatim@font_hook:}
%   Verbatim-like material must usually be left alone.  \tn{verb} opens its
%   own group and selects \tn{verbatim@font} inside it, so extending that
%   command covers \tn{verb} on its own.  The hook consults the current
%   \texttt{Verb} setting, so that \cs{LuaCJKsetup} can change the behaviour
%   after the package is loaded.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_verbatim@font_hook:
  {
    \tl_if_eq:VnTF \l_LuaCJK_verb_mode_tl { true }
      { \LuaCJKdisable }
      {
        \tl_if_eq:VnT \l_LuaCJK_verb_mode_tl { env }
          { \LuaCJKdisable }
      }
  }
\cs_if_exist:NT \verbatim@font
  {
    \cs_gset_protected:Npx \verbatim@font
      {
        \exp_not:o { \verbatim@font }
        \exp_not:N \LuaCJK_verbatim@font_hook:
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{\LuaCJK_verbatim_env_begin:, \LuaCJK_verbatim_env_end:}
%   Environments that do not go through \tn{verbatim@font} need their own
%   hooks.  Only the \texttt{true} setting suspends the adjustments here:
%   \texttt{env} and \texttt{env+} keep them, which is what keeps code
%   columns aligned when CJK text is used inside the code.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_verbatim_env_begin:
  {
    \tl_if_eq:VnT \l_LuaCJK_verb_mode_tl { true }
      { \LuaCJKdisable }
  }
\cs_new_protected:Npn \LuaCJK_verbatim_env_end:
  {
    \tl_if_eq:VnT \l_LuaCJK_verb_mode_tl { true }
      { \LuaCJKenable }
  }
\clist_map_inline:nn
  {
    verbatim , verbatim* , Verbatim , Verbatim* ,
    BVerbatim , LVerbatim , lstlisting
  }
  {
    \AddToHook { env / #1 / begin } { \LuaCJK_verbatim_env_begin: }
    \AddToHook { env / #1 / end }   { \LuaCJK_verbatim_env_end: }
  }
%    \end{macrocode}
% \end{macro}
%
% \subsection{CJK families}
%
% \begin{macro}[internal]{\LuaCJK_set_family:nnn}
%   Define a family through \pkg{fontspec} and remember the resulting
%   family name.  The family is only registered; the switch happens in
%   \cs{LuaCJK_switch_family:n}.
%   \begin{variable}[internal]{\g_LuaCJK_family_prop, \l_LuaCJK_family_tl}
%     The registered families, and the family name currently selected.
%    \begin{macrocode}
\prop_new:N \g_LuaCJK_family_prop
\tl_new:N \l_LuaCJK_family_tl
\tl_set:Nn \l_LuaCJK_family_tl { zhsong }
%    \end{macrocode}
%   \end{variable}
%   \begin{variable}[internal]{\l_LuaCJK_fontspec_tl, \l_LuaCJK_family_name_tl, \l_LuaCJK_tmpa_tl}
%     Scratch variables holding the generated \pkg{fontspec} family name,
%     the family name looked up in the property list, and a temporary
%     value.
%    \begin{macrocode}
\tl_new:N \l_LuaCJK_fontspec_tl
\tl_new:N \l_LuaCJK_family_name_tl
\tl_new:N \l_LuaCJK_tmpa_tl
\tl_new:N \l_LuaCJK_registered_name_tl
%    \end{macrocode}
%   \end{variable}
%   \begin{variable}[internal]
%     {\g_LuaCJK_font_name_prop, \g_LuaCJK_font_feature_prop,
%      \l_LuaCJK_default_feature_tl}
%     The font name and the explicit options of each family, kept so that
%     \cs{addCJKfontfeatures} can register the family again, and the
%     features prepended to every family.
%    \begin{macrocode}
\prop_new:N \g_LuaCJK_font_name_prop
\prop_new:N \g_LuaCJK_font_feature_prop
\tl_new:N \l_LuaCJK_default_feature_tl
\tl_set:Nn \l_LuaCJK_default_feature_tl { Script = CJK }
\tl_new:N \l_LuaCJK_feature_tl
\cs_generate_variant:Nn \fontspec_gset_family:Nnn { NVV }
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_set_family:nnn #1#2#3
  {
    \tl_set:Ne \l_LuaCJK_feature_tl
      {
        \exp_not:V \l_LuaCJK_default_feature_tl
        \tl_if_blank:nF {#2} { , \exp_not:n {#2} }
      }
    \prop_gput:NnV \g_LuaCJK_font_feature_prop {#1} \l_LuaCJK_feature_tl
    \prop_gput:Nnn \g_LuaCJK_font_name_prop {#1} {#3}
    \LuaCJK_register_family:n {#1}
  }
%    \end{macrocode}
%   \begin{macro}[internal]{\LuaCJK_register_family:n}
%     Build the \pkg{fontspec} family from the stored font name and
%     features, and re-select it if it is the current one.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_register_family:n #1
  {
    \prop_get:NnNF \g_LuaCJK_font_name_prop {#1} \l_LuaCJK_registered_name_tl
      { \tl_clear:N \l_LuaCJK_registered_name_tl }
    \prop_get:NnNF \g_LuaCJK_font_feature_prop {#1} \l_LuaCJK_feature_tl
      { \tl_clear:N \l_LuaCJK_feature_tl }
    \group_begin:
      \fontspec_gset_family:NVV \l_LuaCJK_fontspec_tl
        \l_LuaCJK_feature_tl \l_LuaCJK_registered_name_tl
      \prop_gput:NnV \g_LuaCJK_family_prop {#1} \l_LuaCJK_fontspec_tl
    \group_end:
    \prop_if_in:NVT \g_LuaCJK_family_prop \l_LuaCJK_family_tl
      { \selectfont }
  }
%    \end{macrocode}
%   \end{macro}
% \end{macro}
%
% \begin{macro}[internal]{\LuaCJK_switch_family:n}
%   Select a registered family and warn once about an unknown name.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_switch_family:n #1
  {
    \prop_if_in:NnTF \g_LuaCJK_family_prop {#1}
      {
        \tl_set:Nn \l_LuaCJK_family_tl {#1}
        \selectfont
      }
      {
        \seq_if_in:NnF \g_LuaCJK_unknown_family_seq {#1}
          {
            \seq_gput_right:Nn \g_LuaCJK_unknown_family_seq {#1}
            \msg_warning:nnn { LuaCJK } { family-unknown } {#1}
          }
      }
  }
\seq_new:N \g_LuaCJK_unknown_family_seq
\msg_new:nnn { LuaCJK } { family-unknown }
  { Unknown~CJK~family~`#1'~is~being~ignored. }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{\LuaCJK_update_font:}
%   On every \tn{selectfont}, resolve the current family and the math
%   family to font identifiers and store them in the attributes.
%   \begin{variable}[internal]{\l_LuaCJK_selectfont_bool, \g_LuaCJK_fontid_int}
%     A guard against re-entering the update while \tn{selectfont} runs,
%     and the font identifier of the current CJK family.
%    \begin{macrocode}
\bool_new:N \l_LuaCJK_selectfont_bool
\int_new:N \g_LuaCJK_fontid_int
%    \end{macrocode}
%   \end{variable}
%   \begin{variable}[internal]{\l_LuaCJK_math_family_tl, \g_LuaCJK_math_fontid_int}
%     The math family registered by \cs{setCJKmathfont}, and the font
%     identifier resolved from it.
%    \begin{macrocode}
\tl_new:N \l_LuaCJK_math_family_tl
\int_new:N \g_LuaCJK_math_fontid_int
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_update_font:
  {
    \bool_if:NF \l_LuaCJK_selectfont_bool
      {
        \bool_set_true:N \l_LuaCJK_selectfont_bool
        \prop_get:NVNTF \g_LuaCJK_family_prop \l_LuaCJK_family_tl \l_LuaCJK_family_name_tl
          {
            \group_begin:
              \exp_args:NV \fontfamily \l_LuaCJK_family_name_tl
              \selectfont
              \int_gset:Nn \g_LuaCJK_fontid_int
                { \tex_fontid:D \tex_font:D }
            \group_end:
            \g_LuaCJK_font_attr = \g_LuaCJK_fontid_int
          }
          { \g_LuaCJK_font_attr = \c_zero_int }
        \tl_if_empty:NTF \l_LuaCJK_math_family_tl
          { \int_gset:Nn \g_LuaCJK_math_fontid_int { \int_use:N \g_LuaCJK_fontid_int } }
          {
            \prop_get:NVNTF \g_LuaCJK_family_prop \l_LuaCJK_math_family_tl
              \l_LuaCJK_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \fontfamily \l_LuaCJK_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_LuaCJK_math_fontid_int
                    { \tex_fontid:D \tex_font:D }
                \group_end:
              }
              { \int_gzero:N \g_LuaCJK_math_fontid_int }
          }
        \g_LuaCJK_math_font_attr = \g_LuaCJK_math_fontid_int
        \bool_set_false:N \l_LuaCJK_selectfont_bool
      }
  }
\AddToHook { selectfont } { \LuaCJK_update_font: }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Font selection commands}
%
% \begin{variable}
%   {\CJKrmdefault, \CJKsfdefault, \CJKttdefault, \CJKfamilydefault}
%   The CJK families used by the standard font commands.  The family
%   hooks below re-select the CJK family whenever \tn{rmfamily} and its
%   siblings run.
%    \begin{macrocode}
\tl_new:N \CJKrmdefault
\tl_new:N \CJKsfdefault
\tl_new:N \CJKttdefault
\tl_new:N \CJKfamilydefault
\tl_set:Nn \CJKrmdefault { zhsong }
\tl_set:Nn \CJKsfdefault { zhhei }
\tl_set:Nn \CJKttdefault { zhfs }
\tl_set:Nn \CJKfamilydefault { zhsong }
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\defaultCJKfontfeatures}
%   Set the features prepended to every CJK family, replacing the initial
%   \texttt{Script = CJK}.  Families registered earlier keep the value they
%   were given; call \cs{setCJKmainfont} again to apply a new default.
%    \begin{macrocode}
\NewDocumentCommand \defaultCJKfontfeatures { m }
  { \tl_set:Nn \l_LuaCJK_default_feature_tl {#1} }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\addCJKfontfeatures}
%   Add features to the current family for the rest of the group.  The star
%   form is accepted for compatibility; LuaCJK has no concept of blocks, so
%   both forms act on the same font.
%    \begin{macrocode}
\NewDocumentCommand \addCJKfontfeatures { s o m }
  {
    \exp_args:NV \LuaCJK_add_family_features:n
      \l_LuaCJK_family_tl {#3}
  }
%    \end{macrocode}
%   \begin{macro}[internal]{\LuaCJK_add_family_features:n}
%     Append features to the stored ones of a family and register it again.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_add_family_features:n #1#2
  {
    \prop_get:NnNTF \g_LuaCJK_font_feature_prop {#1} \l_LuaCJK_feature_tl
      {
        \tl_set:Ne \l_LuaCJK_feature_tl
          {
            \exp_not:V \l_LuaCJK_feature_tl
            \tl_if_blank:nF {#2} { , \exp_not:n {#2} }
          }
        \prop_get:NnNF \g_LuaCJK_font_name_prop {#1} \l_LuaCJK_registered_name_tl
          { \tl_clear:N \l_LuaCJK_registered_name_tl }
        \group_begin:
          \fontspec_gset_family:NVV \l_LuaCJK_fontspec_tl

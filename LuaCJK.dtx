% \begin{macro}[int]{\@@_set_autofake:nn}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{AutoFakeBold},
%   \keys{AutoFakeSlant}, \keys{EmboldenFactor}, and \keys{SlantFactor}; a
%   family that sets \keys{BoldFont} or \keys{ItalicFont} is not emboldened or
%   slanted.}
% Turn fake bold or slant on or off. A number both enables the feature
% and sets the factor, as in \pkg{xeCJK}.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_set_autofake:nn #1#2
  {
    \str_case:nnF {#2}
      {
        { true  }
        {
          \str_if_eq:nnTF {#1} { bold }
            {
              \tl_gset_eq:NN \g_@@_autofake_bold_tl
                \g_@@_embolden_factor_tl
            }
            {
              \tl_gset_eq:NN \g_@@_autofake_slant_tl
                \g_@@_slant_factor_tl
            }
        }
        { false }
        {
          \str_if_eq:nnTF {#1} { bold }
            { \tl_gclear:N \g_@@_autofake_bold_tl  }
            { \tl_gclear:N \g_@@_autofake_slant_tl }
        }
      }
      {
        \str_if_eq:nnTF {#1} { bold }
          {
            \tl_gset:Nn \g_@@_embolden_factor_tl {#2}
            \tl_gset:Nn \g_@@_autofake_bold_tl   {#2}
          }
          {
            \tl_gset:Nn \g_@@_slant_factor_tl    {#2}
            \tl_gset:Nn \g_@@_autofake_slant_tl  {#2}
          }
      }
  }
%    \end{macrocode}
% \end{macro}

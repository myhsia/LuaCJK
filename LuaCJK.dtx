% \begin{macro}{\addCJKfontfeatures}
% Add features to the current family for the rest of the group.
% The star form is accepted for compatibility;
% LuaCJK has no concept of blocks, so both forms act on the same font.
%    \begin{macrocode}
\NewDocumentCommand \addCJKfontfeatures { s o m }
  {
    \exp_args:NV \@@_add_family_features:n
      \l_@@_family_tl {#3}
  }
%    \end{macrocode}
% \begin{macro}[int]{\@@_add_family_features:n}
% Append features to the stored ones of a family and register it again.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_add_family_features:n #1#2
  {
    \prop_get:NnNTF \g_@@_font_feature_prop {#1} \l_@@_feature_tl
      {
        \tl_set:Ne \l_@@_feature_tl
          {
            \exp_not:V \l_@@_feature_tl
            \tl_if_blank:nF {#2} { , \exp_not:n {#2} }
          }
        \prop_get:NnNF \g_@@_font_name_prop {#1} \l_@@_registered_name_tl
          { \tl_clear:N \l_@@_registered_name_tl }
        \group_begin:
          \fontspec_gset_family:NVV \l_@@_fontspec_tl
            \l_@@_feature_tl \l_@@_registered_name_tl
        \group_end:
        \prop_put:NnV \g_@@_family_prop       {#1}
          \l_@@_fontspec_tl
        \prop_put:NnV \g_@@_font_feature_prop {#1}
          \l_@@_feature_tl
        \selectfont
      }
      { \msg_warning:nnn { LuaCJK } { family-unknown } {#1} }
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}

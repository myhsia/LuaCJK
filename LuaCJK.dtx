% \begin{macro}{\CJKunderdot}
%   Emphasise with dots below the glyphs.  The optional argument takes
%   \texttt{subtract} and \texttt{skip}, like the other decorations.
%    \begin{macrocode}
\NewDocumentCommand \CJKunderdot { s t- o +m }
  {
    \group_begin:
      \LuaCJKfntef_decoration_setup:n {#3}
      \LuaCJKfntef_underdot:n { \LuaCJKfntef_hide:n {#4} }
    \group_end:
  }
%    \end{macrocode}
%   \begin{macro}[internal]{\LuaCJKfntef_underdot:n}
%     Apply the dot pattern inside a group.
%     \begin{variable}[internal]
%       {\l_LuaCJKfntef_dot_dim, \l_LuaCJKfntef_dot_gap_dim,
%        \l_LuaCJKfntef_dot_raise_dim, \l_LuaCJKfntef_dots_box}
%       The size of one dot, the space on both sides of it, the amount it is
%       lowered, and the box holding one repeating unit of the pattern.
%      \begin{macrocode}
\dim_new:N \l_LuaCJKfntef_dot_dim
\dim_set:Nn \l_LuaCJKfntef_dot_dim { .06em }
\dim_new:N \l_LuaCJKfntef_dot_gap_dim
\dim_set:Nn \l_LuaCJKfntef_dot_gap_dim { .12em }
\dim_new:N \l_LuaCJKfntef_dot_raise_dim
\dim_set:Nn \l_LuaCJKfntef_dot_raise_dim { -.40em }
\box_new:N \l_LuaCJKfntef_dots_box
\hbox_set:Nn \l_LuaCJKfntef_dots_box
  {
    \skip_horizontal:n { \l_LuaCJKfntef_dot_gap_dim }
    \raise \l_LuaCJKfntef_dot_raise_dim \tex_hbox:D
      {
        \vrule width \l_LuaCJKfntef_dot_dim
               height \l_LuaCJKfntef_dot_dim
               depth \c_zero_dim
      }
    \skip_horizontal:n { \l_LuaCJKfntef_dot_gap_dim }
  }
%    \end{macrocode}
%     \end{variable}
%     \begin{macro}[internal]{\LuaCJKfntef_dots}
%       The underline type that repeats the dot box.
%      \begin{macrocode}
\newunderlinetype \LuaCJKfntef_dots
  { \leaders \box_use_drop:N \l_LuaCJKfntef_dots_box }
%    \end{macrocode}
%     \end{macro}
%     \begin{macrocode}
\cs_new_protected:Npn \LuaCJKfntef_underdot:n #1
  {
    \group_begin:
      \LuaCJKfntef_dots
      #1
    \group_end:
  }
%    \end{macrocode}
%   \end{macro}
% \end{macro}

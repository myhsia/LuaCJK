% \begin{macro}{\CJKunderanyline}
% \changes{v0.0.1}{2026/11/11}{Provide \cs{CJKunderanyline} and
%   \cs{CJKunderanysymbol} for arbitrary rules and repeated symbols;
%   \cs{CJKunderanysymbol} puts one symbol per em, centered in the cell, its
%   depth measured from the baseline to the top of the symbol.}

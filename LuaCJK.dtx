% \begin{macro}[int]{\@@_update_font:}
% \changes{v0.0.1}{2026/11/11}{Provide \keys{PunctFamily}, which sets a
%   separate CJK family for the punctuation marks.}
% On every \tn{selectfont}, resolve the current family, its fallback
% families, and the math family to font identifiers and store them in the
% attributes.
% \begin{variable}[int]{\l_@@_selectfont_bool, \g_@@_fontid_int}
% A guard against re-entering the update while \tn{selectfont} runs,
% and the font identifier of the current CJK family.
%    \begin{macrocode}
\bool_new:N \l_@@_selectfont_bool
\int_new:N \g_@@_fontid_int
%    \end{macrocode}
% \end{variable}
% \begin{variable}[int]
%   {
%     \l_@@_math_family_tl, \l_@@_punct_family_tl,
%     \g_@@_punct_fontid_int
%   }
% The math family registered by \cs{setCJKmathfont}, the family chosen by
% \keys{PunctFamily}, and the font identifier resolved for the latter.
%    \begin{macrocode}
\tl_new:N \l_@@_math_family_tl
\tl_new:N \l_@@_punct_family_tl
\int_new:N \g_@@_punct_fontid_int
%    \end{macrocode}
% \end{variable}
% \begin{variable}[int]
%   {
%     \g_@@_math_family_int, \g_@@_math_family_prop,
%     \c_@@_math_family_max_int

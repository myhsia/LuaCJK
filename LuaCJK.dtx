%
% The Lua module reads the attribute numbers and installs its callbacks.
% The current font is resolved once the document starts.
%    \begin{macrocode}
\lua_load_module:n { LuaCJK }
\lua_now:e
  {
    LuaCJK.attr_font = \int_use:N \c_LuaCJK_font_attr_int ;
    LuaCJK.attr_cjk_space = \int_use:N \c_LuaCJK_cjk_space_attr_int ;
    LuaCJK.attr_xecglue = \int_use:N \c_LuaCJK_xecglue_attr_int ;
    LuaCJK.attr_inserted = \int_use:N \c_LuaCJK_inserted_attr_int ;
    LuaCJK.attr_math_font = \int_use:N \c_LuaCJK_math_font_attr_int ;
    LuaCJK.attr_punct_font = \int_use:N \c_LuaCJK_punct_font_attr_int ;
    LuaCJK.attr_nobreak = \int_use:N \c_LuaCJK_nobreak_attr_int ;
    LuaCJK.attr_disabled = \int_use:N \c_LuaCJK_disabled_attr_int ;
    LuaCJK.auto_fallback = \bool_if:NTF \g_LuaCJK_auto_fallback_bool
      { true } { false }
  }
\bool_gset_true:N \g_LuaCJK_lua_loaded_bool
\LuaCJK_set_normal_spaced_chars:
\AtBeginDocument
  {
    \bool_if:NT \g_LuaCJK_load_fandol_bool
      {

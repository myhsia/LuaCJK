%
% \begin{function}{\CJKunderanyline}
%   \begin{syntax}
%     \tn{CJKunderanyline} \marg{depth} \marg{object} \marg{text}
%   \end{syntax}
%   把 \meta{object} 放在 \meta{text} 下面，并用 \tn{leaders} 重复。
%   \meta{object} 的底部放在基线之下 \meta{depth} 处，
%   所以对于一个（本身没有深度的）\cs{rule} 来说，
%   横线从基线之下 \meta{depth} 处向上占据。
%   要覆盖一个 CJK 字形，就用字体的 em 盒：\meta{depth} 取
%   \cs{LuaCJKemdescent}，对象高度取 \texttt{1em}，正如下例所做的那样。
%   对象填满的是 em 盒，也就是 PDF 阅读器划出的选区：
%   横向是字身宽度，纵向是 em 盒的高度，
%   字体墨迹比 em 盒窄时，四周会各露出一条边距。
%   类型会被缓存，所以相同的参数复用一个下划线类型。
% \end{function}
%
% \begin{function}{\CJKunderanysymbol}
%   \begin{syntax}
%   \tn{CJKunderanysymbol}\oarg{options}\marg{depth}\marg{symbol}\marg{text}
%   \end{syntax}
%   用法相同，只是每字宽放一个 \meta{symbol}：
%   符号在一个和一个 CJK 字符一样宽的格子里居中，
%   所以一排符号与它们上方的字符对齐。
%   \meta{depth} 是符号顶部到\emph{em 盒底部}的距离，
%   所以 |0pt| 留下的间隙正与字符两侧的边距相同；
%   字体没有 OpenType 度量时按 |.12em| 计算。
%   为了兼容，接受选项 \keys{sep}，但它没有作用，
%   因为格子固定为一个字宽。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderanyline{\LuaCJKemdescent}
  {\color{yellow}\rule{1pt}{1em}}{有涯}\\
\CJKunderanysymbol{0pt}{\tiny$\triangle$}{有涯}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKunderdot}
%   \begin{syntax}
%     \tn{CJKunderdot} \oarg{options} \marg{text}
%   \end{syntax}
%   在 \meta{text} 下面加着重号。
%   每个 CJK 字符下面一个点，点在字符的一字宽方格内居中，
%   顶部在 em 盒底部之下 \texttt{0.2em} 处；
%   拉丁字母、数字和空格下面没有点，
%   一段文字断行以后，每一行的字符各有自己的点，
%   粘连伸长时点随字符移动。
%   用 |symbol = |\meta{symbol} 时，一个符号取代着重号，
%   放置方式与 \cs{CJKunderanysymbol} 的符号相同：
%   每字宽一个，居中，符号顶部在 em 盒底部之下 \texttt{0.3em} 处。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderline{虚室生白，\CJKunderdot{吉祥}止止，
  虚室生白}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKsout}
%   \begin{syntax}
%     \tn{CJKsout} \oarg{options} \marg{text}
%   \end{syntax}
%   给 \meta{text} 加删除线，键见上面的键列表。
%   删除线中心在基线上方，穿过一个 CJK 字形的中部，
%   比拉丁字母 x 高度的中部要高；
%   对于完全是拉丁文的文字，可以用 |height = 0.5ex|。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKsout[thickness = 2pt, format = red]
  {吾生也有涯}\\
\CJKsout[height = .5ex]{吾生也有涯}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKunderline   {吾生也有涯}\\
\CJKunderdblline{吾生也有涯}\\
\CJKunderwave   {吾生也有涯}\\
\CJKunderdot    {吾生也有涯}\\
\CJKsout        {吾生也有涯}\\
\CJKxout        {吾生也有涯}
\end{codemo}
% \iffalse
%</example>
% \fi

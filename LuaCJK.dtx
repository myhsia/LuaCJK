% \begin{macro}[int]{\@@_fntef_use_double:}
% Build the two underline types of the double rule, one for each line,
% keyed by the geometry so that repeated calls reuse them.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_use_double:
  {
    \tl_set:Ne \l_@@_fntef_cache_key_tl
      {
        double-top |
        \dim_use:N \l_@@_fntef_depth_dim |
        \dim_use:N \l_@@_fntef_thickness_dim
      }
    \tl_set:Ne \l_@@_fntef_any_code_tl
      {
        \exp_not:N \tex_leaders:D \exp_not:N \tex_vrule:D
          height \dim_eval:n { -\l_@@_fntef_depth_dim }
          depth \dim_eval:n
            { \l_@@_fntef_depth_dim + \l_@@_fntef_thickness_dim }
      }
    \exp_args:NV \@@_fntef_use_leader_type:nn
      \l_@@_fntef_cache_key_tl \l_@@_fntef_any_code_tl
    \tl_set:Ne \l_@@_fntef_cache_key_tl
      {
        double-bottom |
        \dim_use:N \l_@@_fntef_depth_dim |
        \dim_use:N \l_@@_fntef_thickness_dim |
        \dim_use:N \l_@@_fntef_gap_dim
      }
    \tl_set:Ne \l_@@_fntef_any_code_tl
      {
        \exp_not:N \tex_leaders:D \exp_not:N \tex_vrule:D
          height \dim_eval:n
            {
              -\l_@@_fntef_depth_dim
              - \l_@@_fntef_thickness_dim
              - \l_@@_fntef_gap_dim
            }
          depth \dim_eval:n
            {

%
%    \begin{macrocode}
%</package>
%    \end{macrocode}
%
% \subsection{The Lua entry point}
%
% The package ships two Lua modules.  \file{LuaCJK.lua} only loads the core
% module; all node processing lives in \file{LuaCJK-core.lua}.
% \begin{variable}[internal]{LuaCJK}
%   The table shared by the two modules.  The core module adds its functions
%   and constants to it.
%    \begin{macrocode}
%<*lua>
-- LuaCJK.lua
-- Copyright (C) 2026 by Mingyu Xia <myhsia@outlook.com>
-- This work may be distributed and/or modified under the conditions of the
-- LaTeX Project Public License, version 1.3c or later.
-- Entry point: load the core module.

LuaCJK = LuaCJK or {}

require("LuaCJK-core")
%</lua>
%    \end{macrocode}
% \end{variable}
%
% \subsection{Module state and node types}
%
% The core module starts by creating the shared table and caching the node
% identifiers.  The callbacks run on every list, so these lookups happen
% once.
%    \begin{macrocode}
%<*lua-core>
-- LuaCJK-core.lua
-- Copyright (C) 2026 by Mingyu Xia <myhsia@outlook.com>
-- This work may be distributed and/or modified under the conditions of the
-- LaTeX Project Public License, version 1.3c or later.
-- Core node processing.

LuaCJK = LuaCJK or {}

%    \end{macrocode}
%
% \begin{variable}[internal]
%   {M, GLYPH, GLUE, HLIST, VLIST, KERN, PENALTY, MATH, DISC, WHATSIT,
%    LOCAL_PAR, SPACESKIP, new_node, free_node, has_attribute, set_attribute}
%   Short names for the module table, the node types, and the node
%   functions.
%    \begin{macrocode}
local M = LuaCJK
local GLYPH = node.id("glyph")
local GLUE = node.id("glue")
local HLIST = node.id("hlist")
local VLIST = node.id("vlist")
local KERN = node.id("kern")
local PENALTY = node.id("penalty")
local MATH = node.id("math")
local DISC = node.id("disc")
local WHATSIT = node.id("whatsit")
local LOCAL_PAR = node.id("local_par")
local SPACESKIP = node.subtype("spaceskip") or 13
local new_node = node.new
local free_node = node.free
local has_attribute = node.has_attribute
local set_attribute = node.set_attribute

%    \end{macrocode}
% \end{variable}
%
% \begin{variable}[internal]
%   {LuaCJK.attr_font, LuaCJK.attr_cjk_space, LuaCJK.attr_xecglue,
%    LuaCJK.attr_inserted, LuaCJK.attr_math_font}
%   The attribute numbers.  The \TeX{} side fills them in after loading the
%   module.
%    \begin{macrocode}
M.attr_font = M.attr_font or nil
M.attr_cjk_space = M.attr_cjk_space or nil
M.attr_xecglue = M.attr_xecglue or nil
M.attr_inserted = M.attr_inserted or nil
M.attr_math_font = M.attr_math_font or nil
M.attr_punct_font = M.attr_punct_font or nil
M.attr_nobreak = M.attr_nobreak or nil

%    \end{macrocode}
% \end{variable}
%
% \subsection{Character classes}
%
% \begin{macro}[internal]{LuaCJK.is_cjk}
%   Test whether a character is treated as CJK.  The ranges cover CJK
%   ideographs, compatibility and presentation forms, kana, Hangul, and the
%   punctuation LuaCJK compresses or hangs.
%    \begin{macrocode}
M.class_override = {}
M.punct_override = {}

-- Punctuation shared with Latin scripts.  With LatinPunct on, these use the
-- Latin font and are not compressed; U+2014 is not in the list, because the
-- dash stays CJK.
local LATIN_PUNCT = {
  [0x00B7] = true, [0x2018] = true, [0x2019] = true,
  [0x201C] = true, [0x201D] = true, [0x2025] = true,
  [0x2026] = true, [0x2027] = true,
}

local function is_cjk (c)
  local override = M.class_override[c]
  if override ~= nil then
    return override
  end
  if M.latin_punct and LATIN_PUNCT[c] then
    return false
  end
  return (c >= 0x2E80 and c <= 0x9FFF)
      or (c >= 0xF900 and c <= 0xFAFF)
      or (c >= 0xFE30 and c <= 0xFE4F)
      or (c >= 0xFF00 and c <= 0xFFEF)
      or (c >= 0x20000 and c <= 0x3FFFF)
      or (c >= 0x3040 and c <= 0x30FF)
      or (c >= 0xAC00 and c <= 0xD7AF)
      or (c >= 0x1100 and c <= 0x11FF)
      or c == 0x2014 or c == 0x2018 or c == 0x2019
      or c == 0x201C or c == 0x201D or c == 0x2026
end

M.is_cjk = is_cjk

M.latin_punct = false

local function read_latin_punct ()
  M.latin_punct = token.get_macro("l_LuaCJK_latin_punct_tl") == "1"
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{Punctuation data}
%
% \begin{variable}[internal]{PUNCT_CLASS}
%   The punctuation LuaCJK knows about, grouped as opening, closing, middle,
%   dash, and ellipsis.  The group decides compression, line-breaking
%   prohibitions, and hanging.
%    \begin{macrocode}
local PUNCT_CLASS = {
  [0x2018] = "open",  [0x201C] = "open",
  [0x3008] = "open",  [0x300A] = "open",
  [0x300C] = "open",  [0x300E] = "open",
  [0x3010] = "open",  [0x3014] = "open",
  [0x3016] = "open",  [0x3018] = "open",
  [0x301A] = "open",  [0xFF08] = "open",
  [0xFF3B] = "open",  [0xFF5B] = "open",
  [0x2019] = "close", [0x201D] = "close",
  [0x3001] = "close", [0x3002] = "close",
  [0x3009] = "close", [0x300B] = "close",
  [0x300D] = "close", [0x300F] = "close",
  [0x3011] = "close", [0x3015] = "close",
  [0x3017] = "close", [0x3019] = "close",
  [0x301B] = "close", [0xFF01] = "close",
  [0xFF09] = "close", [0xFF0C] = "close",
  [0xFF0E] = "close", [0xFF1A] = "close",
  [0xFF1B] = "close", [0xFF1F] = "close",
  [0xFF3D] = "close", [0xFF5D] = "close",
  [0x00B7] = "middle", [0x2027] = "middle",
  [0x30FB] = "middle",
  [0x2013] = "dash",  [0x2014] = "dash",
  [0x2015] = "dash",  [0xFF0D] = "dash",
  [0x2026] = "ellipsis", [0x22EF] = "ellipsis",
}

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[internal]{punct_class}
%   Look up the group of a character.
%    \begin{macrocode}
local function punct_class (c)
  local override = M.punct_override[c]
  if override ~= nil then
    return override or nil
  end
  if M.latin_punct and LATIN_PUNCT[c] then
    return nil
  end
  if M.charsets.middle[c] then
    return "middle"
  end
  return PUNCT_CLASS[c]
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{LuaCJK.declare_ranges}
%   Fill a table with \meta{value} over a list of code-point ranges, each
%   given as \texttt{\{first, last\}}.
%    \begin{macrocode}
local function fill_ranges (target, value, ranges)
  for _, range in ipairs(ranges) do
    local first = range[1]
    local last = range[2] or first
    for code = first, last do
      target[code] = value
    end
  end
end

function M.declare_class (ranges, cjk)
  fill_ranges(M.class_override, cjk, ranges)
end

function M.declare_punct (ranges, group)
  fill_ranges(M.punct_override, group, ranges)
end

function M.reset_classes ()
  M.class_override = {}
  M.punct_override = {}
  M.normal_spaced = {}
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[internal]{KAIMING_FULL}
%   Characters that keep a full em width in the \texttt{kaiming} style.
%    \begin{macrocode}
-- The character sets that the punctuation options can replace.
M.charsets = {
  kaiming = {
    [0xFF0E] = true,  -- ．
    [0x3002] = true,  -- 。
    [0xFF1F] = true,  -- ？
    [0xFF01] = true,  -- ！
  },
  middle = {},
  long = {},
  nobreak = {},
}

for code, group in pairs(PUNCT_CLASS) do
  if group == "middle" then
    M.charsets.middle[code] = true
    PUNCT_CLASS[code] = nil
  elseif group == "dash" or group == "ellipsis" then
    M.charsets.long[code] = true
  end
end

for code in pairs(M.charsets.long) do
  M.charsets.nobreak[code] = true
end

-- Replace, add to, or remove from one of the sets above.  Ranges arrive as
-- a list of {first, last} pairs.
function M.set_charset (kind, mode, ranges)
  local target = M.charsets[kind]
  if not target then
    return
  end
  if mode == "set" then
    target = {}
    M.charsets[kind] = target
  end
  for _, range in ipairs(ranges) do
    local first = range[1]
    local last = range[2] or first
    for code = first, last do
      if mode == "remove" then
        target[code] = nil
      else
        target[code] = true
      end
    end
  end
end

%    \end{macrocode}
% \end{variable}
%
% \begin{variable}[internal]{LuaCJK.punct_styles}
%   The built-in styles.  Each entry holds the compression switch, the
%   compression ratio, the opening and closing exemption, and optional fixed
%   width or hanging parameters.
%    \begin{macrocode}
M.punct_class = function (c)
  return punct_class(c)
end

M.punct_styles = {
  quanjiao = { compress_adjacent = true,  ratio = 0.5, keep_open_close = true },
  plain    = { compress_adjacent = false, ratio = 0.0, keep_open_close = true },
  banjiao  = { compress_adjacent = false, ratio = 0.0, keep_open_close = true,
               fixed_ratio = 0.5 },
  kaiming  = { compress_adjacent = false, ratio = 0.0, keep_open_close = true,
               fixed_ratio = 0.5, fixed_full = true },
  CCT      = { compress_adjacent = false, ratio = 0.0, keep_open_close = true,
               fixed_ratio = 0.7 },
  hangmobanjiao = { compress_adjacent = false, ratio = 0.0,
                    keep_open_close = true, hanging = true },
}

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[internal]{LuaCJK.define_punct_style}
%   Register a style declared by \cs{LuaCJKDeclarePunctStyle}.
%    \begin{macrocode}
function M.define_punct_style (name, compress, ratio, keep)
  M.punct_styles[name] = {
    compress_adjacent = compress,
    ratio = ratio,
    keep_open_close = keep,
  }
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{punct_style}
%   Read the style name from the \TeX{} token list and return the matching
%   table, falling back to \texttt{plain}.
%    \begin{macrocode}
M.punct_width = {}
M.punct_kern = {}

local function first_code (s)
  for _, code in utf8.codes(s) do
    return code
  end
end

M.global_punct_width = nil

function M.set_punct_width_all (sp)
  M.global_punct_width = sp
end

function M.set_punct_width (chars, sp)
  for _, code in utf8.codes(chars) do
    M.punct_width[code] = sp
  end
end

function M.add_normal_spaced (ranges)
  for _, range in ipairs(ranges) do
    local first = range[1]
    local last = range[2] or first
    for code = first, last do
      M.normal_spaced[code] = true
    end
  end
end

function M.set_punct_kern (before, after, sp)
  local a, b = first_code(before), first_code(after)
  if a and b then
    M.punct_kern[a] = M.punct_kern[a] or {}
    M.punct_kern[a][b] = sp
  end
end

local function user_width (char)
  return M.punct_width[char]
end

local function user_kern (before, after)
  local row = M.punct_kern[before]
  return row and row[after]
end

function M.edit_punct_style (name, compress, ratio, keep)
  local style = M.punct_styles[name]
  if not style then
    return
  end
  if compress ~= nil then
    style.compress_adjacent = compress
  end
  if ratio ~= nil then
    style.ratio = ratio
  end
  if keep ~= nil then
    style.keep_open_close = keep
  end
end

local function punct_style ()
  local name = token.get_macro("l_LuaCJK_punct_style_tl")
  return M.punct_styles[name] or M.punct_styles.plain
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{kinsoku_enabled}
%   Read the line-breaking switch.
%    \begin{macrocode}
local function kinsoku_enabled ()
  return token.get_macro("l_LuaCJK_punct_kinsoku_tl") == "1"
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{Suspension}
%
% \begin{variable}[internal]{LuaCJK.attr_disabled}
%   The attribute number of the suspension switch.
%    \begin{macrocode}
M.attr_disabled = M.attr_disabled or nil
M.allow_break_between_puncts = M.allow_break_between_puncts or false

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[internal]{disabled}
%   Test the suspension attribute on a node.
%    \begin{macrocode}
local function disabled (n)
  if not (M.attr_disabled and n) then
    return false
  end
  local v = has_attribute(n, M.attr_disabled)
  return v ~= nil and v ~= 0
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{Font rewriting}
%
% \begin{macro}[internal]{rewrite_fonts}
%   Replace CJK glyphs by a copy in the font recorded in the attribute.
%   \begin{macro}[internal]{copy_glyph}
%     Copy a glyph node, changing only its font.
%    \begin{macrocode}
M.blocks = {}
M.block_order = {}
M.block_fonts = {}

function M.declare_block (name, ranges)
  if not M.blocks[name] then
    table.insert(M.block_order, name)
  end
  M.blocks[name] = { ranges = ranges, enabled = true }
end

function M.set_block_enabled (name, flag)
  local block = M.blocks[name]
  if block then
    block.enabled = flag
  end
end

function M.set_block_font (main, name, fid)
  local row = M.block_fonts[main]
  if not row then
    row = {}
    M.block_fonts[main] = row
  end
  if fid and fid > 0 then
    row[name] = fid
  else
    row[name] = nil
  end
end

local function block_font (main, char)
  local row = M.block_fonts[main]
  if not row then
    return nil
  end
  for _, name in ipairs(M.block_order) do
    local block = M.blocks[name]
    if block and block.enabled and row[name] then
      for _, range in ipairs(block.ranges) do
        if char >= range[1] and char <= (range[2] or range[1]) then
          return row[name]
        end
      end
    end
  end
  return nil
end

M.fallback = {}
M.auto_fallback = M.auto_fallback or false

function M.set_fallback (main, list)
  M.fallback[main] = list
end

local has_char_cache = {}

local function has_char (fid, char)
  local key = fid * 0x200000 + char
  local cached = has_char_cache[key]
  if cached ~= nil then
    return cached
  end
  local f = font.getfont(fid)
  local ok = f and f.characters and f.characters[char] ~= nil
  has_char_cache[key] = ok
  return ok
end

-- Pick the first fallback font that has the character.
local function fallback_font (fid, char)
  if not M.auto_fallback then
    return nil
  end
  local list = M.fallback[fid]
  if not list then
    return nil
  end
  for _, candidate in ipairs(list) do
    if has_char(candidate, char) then
      return candidate
    end
  end
end

local function copy_glyph (n, fid)
  local g = new_node("glyph")
  g.font = fid
  g.char = n.char
  g.attr = n.attr
  g.lang = n.lang
  g.left = n.left
  g.right = n.right
  g.uchyph = n.uchyph
  g.xoffset = n.xoffset
  g.yoffset = n.yoffset
  g.expansion_factor = n.expansion_factor
  g.data = n.data
  g.subtype = n.subtype
  return g
end

%    \end{macrocode}
%   \end{macro}
%    \begin{macrocode}
local function rewrite_fonts (head)
  local prev = nil
  local cur = head
  while cur do
    local nxt = cur.next
    if cur.id == GLYPH and is_cjk(cur.char) and M.attr_font then
      local target = has_attribute(cur, M.attr_font)
      if target and target > 0 then
        local block = block_font(target, cur.char)
        if block then
          target = block
        end
      end
      if target and M.attr_punct_font and punct_class(cur.char) then
        local punct = has_attribute(cur, M.attr_punct_font)
        if punct and punct > 0 then
          target = punct
        end
      end
      if target and target > 0 and not has_char(target, cur.char) then
        target = fallback_font(target, cur.char) or target
      end
      if target and target > 0 and target ~= cur.font then
        -- A font without the character leaves a placeholder glyph behind:
        -- luaotfload uses either the private-use range or a .notdef glyph
        -- with character 0.  Once the CJK glyph is replaced, that
        -- placeholder is no longer needed and would add a spurious advance.
        if nxt and nxt.id == GLYPH and nxt.font == cur.font
           and (nxt.char == 0
             or (nxt.char >= 0xF0000 and nxt.char <= 0x10FFFD)) then
          local after = nxt.next
          free_node(nxt)
          nxt = after
        end
        local g = copy_glyph(cur, target)
        g.next = nxt
        if prev then
          prev.next = g
        else
          head = g
        end
        free_node(cur)
        cur = g
      end
    end
    prev = cur
    cur = nxt
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{Node classes}
%
% \begin{macro}[internal]{class_of_char}
%   Map a character to \texttt{CJK} or \texttt{LATIN}.
%    \begin{macrocode}
local function class_of_char (c)
  if is_cjk(c) then
    return "CJK"
  end
  return "LATIN"
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{class_of_node}
%   Return the class at both edges of a node.  Boxes are inspected by
%   looking at their contents, and formulas count as Latin.
%   \begin{macro}[internal]{first_visible_class}
%     The class of the first visible character of a list.
%    \begin{macrocode}
local function first_visible_class (list)
  local n = list
  while n do
    if n.id == GLYPH then
      return class_of_char(n.char)
    elseif n.id == HLIST or n.id == VLIST then
      local c = first_visible_class(n.head)
      if c then
        return c
      end
    elseif n.id == MATH then
      return "LATIN"
    end
    n = n.next
  end
  return nil
end

%    \end{macrocode}
%   \end{macro}
%   \begin{macro}[internal]{last_visible_class}
%     The class of the last visible character of a list.
%    \begin{macrocode}
local function last_visible_class (list)
  local n = list
  local last = nil
  while n do
    if n.id == GLYPH then
      last = class_of_char(n.char)
    elseif n.id == HLIST or n.id == VLIST then
      local c = last_visible_class(n.head)
      if c then
        last = c
      end
    elseif n.id == MATH then
      last = "LATIN"
    end
    n = n.next
  end
  return last
end

%    \end{macrocode}
%   \end{macro}
%    \begin{macrocode}
local function class_of_node (n)
  if n.id == GLYPH then
    local c = class_of_char(n.char)
    return c, c
  elseif n.id == HLIST or n.id == VLIST then
    local first = first_visible_class(n.head)
    local last = last_visible_class(n.head)
    if first and last then
      return first, last
    end
  elseif n.id == MATH then
    return "LATIN", "LATIN"
  end
  return nil, nil
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{Glue and kern helpers}
%
% \begin{macro}[internal]{is_inserted}
%   Test whether a node was inserted by LuaCJK.
%    \begin{macrocode}
local function is_inserted (n)
  return M.attr_inserted
    and has_attribute(n, M.attr_inserted) ~= nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{get_glue}
%   Read a skip register by name.
%    \begin{macrocode}
local function get_glue (name)
  local s = tex.skip[name]
  if not s then
    return nil
  end
  return s
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{inherit_attributes}
%   Give a new node the attribute list of the node it is spliced next to.
%   LuaCJK creates glue, kerns, and penalties after \TeX{} has attached the
%   surrounding attributes to the text, so a package that marks spans with
%   attributes, such as \pkg{lua-ul}, would otherwise read the new node as
%   the end of its span and start a new one.  Assigning to the
%   \meta{attr} field is reference counted, and later per-attribute changes
%   are copy-on-write, so the source node is never modified.
%    \begin{macrocode}
local function inherit_attributes (new, source)
  if source and source.attr then
    new.attr = source.attr
  end
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{make_glue}
%   Create a glue node from a skip register, inherit the attributes of
%   \meta{source}, and mark the node as inserted.
%    \begin{macrocode}
local function make_glue (name, source)
  local s = get_glue(name)
  if not s then
    return nil
  end
  local g = new_node("glue")
  inherit_attributes(g, source)
  g.width = s.width
  g.stretch = s.stretch
  g.shrink = s.shrink
  g.stretch_order = 0
  g.shrink_order = 0
  if M.attr_inserted then
    set_attribute(g, M.attr_inserted, 1)
  end
  return g
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{set_glue}
%   Give an existing glue node the dimensions of a skip register.
%    \begin{macrocode}
local function set_glue (g, name)
  local s = get_glue(name)
  if not s then
    return false
  end
  g.width = s.width
  g.stretch = s.stretch
  g.shrink = s.shrink
  if M.attr_inserted then
    set_attribute(g, M.attr_inserted, 1)
  end
  return true
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{make_kern}
%   Create a kern node, inherit the attributes of \meta{source}, and mark
%   the node as inserted.
%    \begin{macrocode}
local function make_kern (width, source)
  local k = new_node("kern")
  inherit_attributes(k, source)
  k.kern = width
  if M.attr_inserted then
    set_attribute(k, M.attr_inserted, 1)
  end
  return k
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{Spacing}
%
% \begin{macro}[internal]{spacing}
%   Walk a list and insert the glue between CJK and Latin material.  The
%   walk tracks the last visible node and the class at its end, so that a
%   formula is treated as one Latin atom.
%   \begin{macro}[internal]{handle_boundary}
%     Decide what to do at the boundary between two visible nodes.  Only
%     source-generated glue is a candidate for replacement; other glue and
%     penalties are left alone.
%     \begin{macro}[internal]{insert_boundary_glue}
%       Insert the CJK--CJK or CJK--Latin glue, or the compression kern for
%       two adjacent punctuation marks.
%      \begin{macrocode}
M.normal_spaced = {}

function M.set_normal_spaced_chars (chars)
  local set = {}
  for _, code in utf8.codes(chars) do
    set[code] = true
  end
  M.normal_spaced = set
end

local function normal_spaced (n)
  return n and n.id == GLYPH and M.normal_spaced[n.char] == true
end

local function insert_boundary_glue (head, prev, prev_end, cur, cur_start)
  local name = nil
  if prev_end == "CJK" and cur_start == "CJK" then
    name = "l_LuaCJK_ccglue_skip"
  elseif prev_end ~= cur_start
     and not normal_spaced(prev) and not normal_spaced(cur) then
    name = "l_LuaCJK_ecglue_skip"
  end

  local style = punct_style()
  local prev_punct = prev and prev.id == GLYPH and punct_class(prev.char)
  local cur_punct = cur.id == GLYPH and punct_class(cur.char)
  if prev_punct and cur_punct then
    local explicit = user_kern(prev.char, cur.char)
    if explicit then
      local k = make_kern(explicit, prev)
      k.next = cur
      if prev then
        prev.next = k
      else
        head = k
      end
      return head
    end
  end
  if prev_punct and cur_punct and style.compress_adjacent then
    local exempt = (style.keep_open_close
        and prev_punct == "open" and cur_punct == "close")
      or (M.charsets.long[prev.char] and M.charsets.long[cur.char])
    if not exempt and prev.width and prev.width > 0 then
      local k = make_kern(-math.floor(style.ratio * prev.width + 0.5), prev)
      local g = name and make_glue(name, prev) or nil
      k.next = g or cur
      if g then
        g.next = cur
      end
      if prev then
        prev.next = k
      else
        head = k
      end
      return head
    end
  end

  if not name then
    return head
  end
  local g = make_glue(name, prev or cur)
  if not g then
    return head
  end
  g.next = cur
  if prev then
    prev.next = g
  else
    head = g
  end
  return head
end

%    \end{macrocode}
%     \end{macro}
%     \begin{macro}[internal]{handle_source_space}
%       Remove or retime a space typed in the source.
%      \begin{macrocode}
local function handle_source_space (head, glue, before, prev_end, cur, cur_start)
  -- Only source-generated spaces are candidates.  Explicit \hskip, \hfill
  -- and similar glue have a different subtype and must be preserved.
  if glue.subtype ~= SPACESKIP then
    return head
  end
  local prev_cjk = prev_end == "CJK"
  local cur_cjk = cur_start == "CJK"
  if prev_cjk and cur_cjk then
    local cjk_space = M.attr_cjk_space
      and (has_attribute(glue, M.attr_cjk_space) or 0) ~= 0
    if not cjk_space then
      if before then
        before.next = cur
      else
        head = cur
      end
      free_node(glue)
    end
  elseif prev_cjk or cur_cjk then
    local xecglue = M.attr_xecglue
      and (has_attribute(glue, M.attr_xecglue) or 0) ~= 0
    if xecglue then
      set_glue(glue, "l_LuaCJK_ecglue_skip")
    end
  end
  return head
end

%    \end{macrocode}
%     \end{macro}
%    \begin{macrocode}
local function handle_boundary (head, prev, before, prev_visible,
                                prev_end, cur, start_class)
  if not prev_visible then
    return head
  end
  if disabled(prev_visible) or disabled(cur) then
    return head
  end
  if prev and prev.id == GLUE then
    if not is_inserted(prev) then
      return handle_source_space(head, prev, before, prev_end, cur, start_class)
    end
  elseif prev and prev.id == PENALTY then
    -- A penalty is an explicit barrier: do not bridge it.
  elseif prev and prev.id == DISC then
    -- Discretionaries are opaque in this first boundary version.
  else
    return insert_boundary_glue(head, prev, prev_end, cur, start_class)
  end
  return head
end

%    \end{macrocode}
%   \end{macro}
%    \begin{macrocode}
local function spacing (head)
  local prev = nil
  local before = nil
  local prev_visible = nil
  local prev_end = nil
  local math_level = 0
  local cur = head
  while cur do
    local nxt = cur.next
    if cur.id == MATH then
      if cur.subtype == 0 then
        if math_level == 0 then
          -- The formula behaves like a Latin atom at its left edge.
          head = handle_boundary(
            head, prev, before, prev_visible, prev_end, cur, "LATIN")
        end
        math_level = math_level + 1
        prev_visible = nil
        prev_end = nil
      else
        if math_level > 0 then
          math_level = math_level - 1
        end
        if math_level == 0 then
          prev_visible = cur
          prev_end = "LATIN"
        end
      end
    elseif math_level > 0 then
      -- Inside a formula the boundary rules do not apply.
    else
      local start_class, end_class = class_of_node(cur)
      if start_class then
        head = handle_boundary(
          head, prev, before, prev_visible, prev_end, cur, start_class)
        prev_visible = cur
        prev_end = end_class
      elseif cur.id == PENALTY or cur.id == DISC then
        prev_visible = nil
        prev_end = nil
      end
    end
    before = prev
    prev = cur
    cur = nxt
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{Line-breaking prohibitions}
%
% \TeX{} may break at glue and at kern.  Both are places where LuaCJK inserts
% its own nodes, so after building the list a second pass puts a penalty
% 10000 in front of every break opportunity that must not be used.
%
% \begin{macro}[internal]{apply_kinsoku}
%   Add the prohibitions.
%    \begin{macrocode}
-- Line-breaking prohibitions (kinsoku).
--
-- TeX may break at glue and at kern.  Both are the places we insert our own
-- spacing nodes, so after building the list we walk it once more and put a
-- penalty 10000 in front of every break opportunity that must not be used.
%    \end{macrocode}
%   \begin{macro}[internal]{class_char}
%     The character of a glyph, or nothing for any other node.
%    \begin{macrocode}
local function no_break_mark (n)
  if not (M.attr_nobreak and n) then
    return false
  end
  local value = has_attribute(n, M.attr_nobreak)
  return value ~= nil and value ~= 0
end

local function class_char (n)
  if n and n.id == GLYPH then
    return n.char
  end
  return nil
end

%    \end{macrocode}
%   \end{macro}
%   \begin{macro}[internal]{next_visible}
%     The next visible glyph, stopping at an explicit break barrier.
%    \begin{macrocode}
local function next_visible (n)
  while n do
    if n.id == GLYPH then
      return n
    elseif n.id == HLIST or n.id == VLIST then
      if first_visible_class(n.head) then
        return nil
      end
    elseif n.id == PENALTY or n.id == DISC then
      return nil
    end
    n = n.next
  end
  return nil
end

%    \end{macrocode}
%   \end{macro}
%   \begin{macro}[internal]{forbids_break}
%     The rules: closing and middle punctuation must not start a line,
%     opening punctuation must not end one, and a run of dashes or ellipses
%     stays together.
%    \begin{macrocode}
local function no_break_mark (n)
  if not (M.attr_nobreak and n) then
    return false
  end
  local value = has_attribute(n, M.attr_nobreak)
  return value ~= nil and value ~= 0
end

local function class_char (n)
  if n and n.id == GLYPH then
    return n.char
  end
  return nil
end

local function forbids_break (prev_char, next_char)
  local prev_punct = prev_char and punct_class(prev_char)
  local next_punct = next_char and punct_class(next_char)
  if M.allow_break_between_puncts and prev_punct and next_punct then
    return false
  end
  -- A closing or middle punctuation must not start a line.
  if next_punct == "close" or next_punct == "middle" then
    return true
  end
  -- An opening punctuation must not end a line.
  if prev_punct == "open" then
    return true
  end
  -- Long punctuation is one unit: no break inside a run.
  if M.charsets.nobreak[prev_char] and M.charsets.nobreak[next_char] then
    return true
  end
  return false
end

%    \end{macrocode}
%   \end{macro}
%   \begin{macro}[internal]{is_break_point}
%     Glue and kerns are break opportunities; only the ones LuaCJK inserted
%     and the source spaces are considered.
%    \begin{macrocode}
local function is_break_point (n)
  if n.id == GLUE then
    return is_inserted(n) or n.subtype == SPACESKIP
  elseif n.id == KERN then
    return is_inserted(n)
  end
  return false
end

%    \end{macrocode}
%   \end{macro}
%    \begin{macrocode}
local function apply_kinsoku (head)
  if not kinsoku_enabled() then
    return head
  end
  local prev = nil
  local last_visible = nil
  local cur = head
  while cur do
    if cur.id == GLYPH then
      last_visible = cur
    elseif is_break_point(cur) and last_visible then
      local nxt = next_visible(cur.next)
      if nxt and (no_break_mark(last_visible) or no_break_mark(nxt)
         or (not disabled(last_visible) and not disabled(nxt)
             and forbids_break(class_char(last_visible), class_char(nxt))))
      then
        if not (prev and prev.id == PENALTY and prev.penalty >= 10000) then
          local p = new_node("penalty")
          inherit_attributes(p, last_visible)
          p.penalty = 10000
          if M.attr_inserted then
            set_attribute(p, M.attr_inserted, 1)
          end
          p.next = cur
          if prev then
            prev.next = p
          else
            head = p
          end
          cur = p
        end
      end
    end
    prev = cur
    cur = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{apply_fixed_widths}
%   Styles such as \texttt{banjiao} give every punctuation mark a fixed
%   advance.  The glyph advance cannot be changed, so a compensating kern
%   goes right after the glyph.  A penalty in front of that kern keeps \TeX{}
%   from treating it as an extra break opportunity.
%    \begin{macrocode}
-- Fixed punctuation width.
--
-- Styles such as banjiao give every punctuation mark a fixed advance.  The
-- glyph advance cannot be changed, so a compensating kern goes right after
-- the glyph.  A penalty in front of that kern keeps TeX from treating it as
-- an extra break opportunity.
local function apply_fixed_widths (head)
  local style = punct_style()
  local ratio = style.fixed_ratio
  local full = style.fixed_full and M.charsets.kaiming
  local cur = head
  while cur do
    if cur.id == GLYPH and punct_class(cur.char) and not disabled(cur) then
      local target = user_width(cur.char) or M.global_punct_width
      if not target and ratio then
        local f = font.getfont(cur.font)
        local size = f and f.size or 0
        if size > 0 and not (full and full[cur.char]) then
          target = math.floor(ratio * size + 0.5)
        end
      end
      if target then
        local delta = target - cur.width
        if delta ~= 0 then
          local p = new_node("penalty")
          inherit_attributes(p, cur)
          p.penalty = 10000
          local k = make_kern(delta, cur)
          p.next = k
          k.next = cur.next
          cur.next = p
        end
      end
    end
    cur = cur.next
  end
  return head
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{CJK in mathematics}
%
% A CJK character in math mode reaches the math list as a \texttt{math_char}
% noad.  Its family points at the math font, which usually has no CJK glyph,
% so LuaCJK replaces the nucleus by a \texttt{sub_box} holding the character
% in the CJK font.
%
% \begin{variable}[internal]{MATH_CHAR, MATH_TEXT_CHAR}
%   The node types of the two kinds of math character noad.
%    \begin{macrocode}
-- CJK in math mode.
--
-- A CJK character in math mode reaches the math list as a `math_char` noad.
-- Its family points at the math font, which usually has no CJK glyph.  We
-- replace the nucleus by a `sub_box` holding the character in the CJK font.
local MATH_CHAR = node.id("math_char")
local MATH_TEXT_CHAR = node.id("math_text_char")

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[internal]{math_font_id}
%   Read the font identifier chosen by \TeX.
%    \begin{macrocode}
local function math_font_id ()
  local fid = tex.count["g_LuaCJK_math_fontid_int"]
  if fid and fid > 0 then
    return fid
  end
  return nil
end

%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{cjk_math_enabled}
%   Read the switch set by the \texttt{CJKmath} option.
%    \begin{macrocode}
local function cjk_math_enabled ()
  return token.get_macro("l_LuaCJK_cjk_math_tl") == "1"
end

%    \end{macrocode}
% \end{macro}
%
% \begin{variable}[internal]{SUB_MLIST}
%   The node type of a nested math list.
%    \begin{macrocode}
local SUB_MLIST = node.id("sub_mlist")

%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[internal]{rewrite_math}
%   Rewrite the CJK noads of a math list, or warn once when the feature is
%   off.
%   \begin{macro}[internal]{rewrite_math_list}
%     Walk a math list.  The declaration is split from the definition
%     because the walk recurses into sub lists.
%    \begin{macrocode}
-- Recurse into sub lists (fractions, braces, scripts) so that nested CJK
-- characters are rewritten too.
local rewrite_math_list

%    \end{macrocode}
%     \begin{macro}[internal]{cjk_noad}
%       Build a noad whose nucleus is a box with the character in the CJK
%       font.
%      \begin{macrocode}
local function cjk_noad (char, fid)
  local g = new_node("glyph")
  g.font = fid
  g.char = char
  local b = new_node("hlist")
  b.head = g
  b.width = g.width
  b.height = g.height
  b.depth = g.depth
  local sb = new_node("sub_box")
  sb.head = b
  local n = new_node("noad")
  n.nucleus = sb
  return n
end

%    \end{macrocode}
%     \end{macro}
%     \begin{macro}[internal]{rewrite_noad}
%       Replace the nucleus of one noad and recurse into the sub lists of its
%       numerator, denominator, superscript, and subscript.
%      \begin{macrocode}
local function rewrite_noad (noad, fid)
  if disabled(noad) then
    return
  end
  local nuc = noad.nucleus
  if nuc then
    if nuc.id == MATH_CHAR or nuc.id == MATH_TEXT_CHAR then
      if is_cjk(nuc.char) then
        if M.attr_math_font then
          local a = has_attribute(nuc, M.attr_math_font)
          if a and a > 0 then
            fid = a
          end
        end
        noad.nucleus = cjk_noad(nuc.char, fid).nucleus
      end
    elseif nuc.id == SUB_MLIST then
      rewrite_math_list(nuc.head, fid)
    end
  end
  for _, field in ipairs({ "num", "denom", "sup", "sub" }) do
    local s = noad[field]
    if s and s.id == SUB_MLIST then
      rewrite_math_list(s.head, fid)
    end
  end
end

%    \end{macrocode}
%     \end{macro}
%    \begin{macrocode}
rewrite_math_list = function (head, fid)
  local cur = head
  while cur do
    rewrite_noad(cur, fid)
    cur = cur.next
  end
  return head
end

%    \end{macrocode}
%   \end{macro}
%
%   \begin{variable}[internal]{LuaCJK.warned_cjk_math}
%     Whether the one-time warning has been shown.
%    \begin{macrocode}
M.warned_cjk_math = M.warned_cjk_math or false

%    \end{macrocode}
%   \end{variable}
%
%   \begin{macro}[internal]{warn_disabled_cjk_math}
%     Warn once when a CJK character appears in math mode while the feature
%     is off.
%     \begin{macro}[internal]{find_cjk_math}
%       Search a math list, including its sub lists, for a CJK character.
%      \begin{macrocode}
local function find_cjk_math (head)
  local cur = head
  while cur do
    local nuc = cur.nucleus
    if nuc then
      if (nuc.id == MATH_CHAR or nuc.id == MATH_TEXT_CHAR)
         and is_cjk(nuc.char) then
        return true
      elseif nuc.id == SUB_MLIST and find_cjk_math(nuc.head) then
        return true
      end
    end
    for _, field in ipairs({ "num", "denom", "sup", "sub" }) do
      local sub = cur[field]
      if sub and sub.id == SUB_MLIST and find_cjk_math(sub.head) then
        return true
      end
    end
    cur = cur.next
  end
  return false
end

%    \end{macrocode}
%     \end{macro}
%    \begin{macrocode}
local function warn_disabled_cjk_math (head)
  if M.warned_cjk_math then
    return
  end
  if find_cjk_math(head) then
    M.warned_cjk_math = true
    texio.write_nl("term and log",
      "Package LuaCJK Warning: CJK character in math mode, but CJKmath is not enabled.")
    texio.write_nl("term and log",
      "(LuaCJK)                Use \\LuaCJKsetup{CJKmath=true} " ..
      "to typeset it with the CJK font.")
  end
end

%    \end{macrocode}
%   \end{macro}
%    \begin{macrocode}
local function rewrite_math (head)
  if not cjk_math_enabled() then
    warn_disabled_cjk_math(head)
    return head
  end
  local fid = math_font_id()
  if not fid then
    return head
  end
  return rewrite_math_list(head, fid)
end

%    \end{macrocode}
% \end{macro}
%
% \subsection{Hanging punctuation}
%
% The glyph advance stays inside the line, so shifting the ink sideways lets
% a line-final closing punctuation hang into the margin without changing the
% line width.  Line-initial opening punctuation is shifted the other way.
%
% \begin{macro}[internal]{hang_punctuation}
%   Apply the hanging shift to every line.
%   \begin{macro}[internal]{hang_line}
%     Shift the first and last punctuation glyph of one line.
%    \begin{macrocode}
-- Hanging punctuation (hangmobanjiao).
--
-- The glyph advance stays inside the line, so shifting the ink sideways lets
-- a line-final closing punctuation hang into the margin without changing the
-- line width.  Line-initial opening punctuation is shifted the other way.
%    \end{macrocode}
%     \begin{macro}[internal]{find_first_last_glyph}
%       The first and last glyph nodes of a list.
%      \begin{macrocode}
local function find_first_last_glyph (list)
  local first, last
  local n = list
  while n do
    if n.id == GLYPH then
      if not first then first = n end
      last = n
    end
    n = n.next
  end
  return first, last
end

%    \end{macrocode}
%     \end{macro}
%     \begin{macro}[internal]{shift_glyph}
%       Move the ink of a glyph by a horizontal offset.
%      \begin{macrocode}
local function shift_glyph (g, delta)
  if delta == 0 then return end
  g.xoffset = g.xoffset + delta
end

%    \end{macrocode}
%     \end{macro}
%    \begin{macrocode}
-- When a mark ends a line, only the bound width should stay inside it; the
-- rest of the ink hangs into the margin.  Shifting the ink does not change
-- any width, so justification is untouched.  Without the bound width the
-- shift is half an em, as before.
local function bound_width ()
  local value = tex.dimen["l_LuaCJK_punct_bound_width_dim"]
  if value and value > 0 then
    return value
  end
  return nil
end

local function hang_line (line, style)
  if line.id ~= HLIST then
    return
  end
  local bound = bound_width()
  if not (style.hanging or bound) then
    return
  end
  local first, last = find_first_last_glyph(line.head)
  if last and disabled(last) then
    last = nil
  end
  if first and disabled(first) then
    first = nil
  end
  if last and punct_class(last.char) then
    local cls = punct_class(last.char)
    if cls == "close" or cls == "middle" then
      if bound then
        shift_glyph(last, last.width - bound)
      elseif style.hanging then
        local f = font.getfont(last.font)
        local size = f and f.size or 0
        shift_glyph(last, math.floor(0.5 * size + 0.5))
      end
    end
  end
  if style.hanging and first and punct_class(first.char) then
    local cls = punct_class(first.char)
    if cls == "open" then
      local f = font.getfont(first.font)
      local size = f and f.size or 0
      shift_glyph(first, -math.floor(0.5 * size + 0.5))
    end
  end
end

%    \end{macrocode}
%   \end{macro}
%    \begin{macrocode}
local function process_lines (list, style)
  local n = list
  while n do
    if n.id == HLIST then
      hang_line(n, style)
      process_lines(n.head, style)
    end
    n = n.next
  end
end

local function hang_punctuation (head)
  process_lines(head, punct_style())
  return head
end


%      \l_LuaCJK_verb_mode_tl, \l_LuaCJK_local_config_tl,
%      \l_LuaCJK_check_single_tl, \l_LuaCJK_widow_penalty_int,
%      \l_LuaCJK_punct_bound_width_dim,
%      \l_LuaCJK_break_between_puncts_bool,
%      \g_LuaCJK_autofake_bold_tl, \g_LuaCJK_autofake_slant_tl,
%      \g_LuaCJK_embolden_factor_tl, \g_LuaCJK_slant_factor_tl,
%      \g_LuaCJK_fallback_prop, \g_LuaCJK_auto_fallback_bool,
%      \g_LuaCJK_load_fandol_bool,
%      \l_LuaCJK_fallback_family_tl, \l_LuaCJK_fallback_ids_tl,
%      \l_LuaCJK_main_fontid_int}
%     The switches read by the Lua side, the \texttt{Verb} setting, the
%     configuration file name, the fake bold and slant parameters, and the
%     fallback fonts.
%    \begin{macrocode}
\tl_new:N \l_LuaCJK_punct_kinsoku_tl
\tl_set:Nn \l_LuaCJK_punct_kinsoku_tl { 1 }
\tl_new:N \l_LuaCJK_cjk_math_tl
\tl_set:Nn \l_LuaCJK_cjk_math_tl { 0 }
\tl_new:N \l_LuaCJK_latin_punct_tl
\tl_set:Nn \l_LuaCJK_latin_punct_tl { 0 }
\tl_new:N \l_LuaCJK_verb_mode_tl
\tl_set:Nn \l_LuaCJK_verb_mode_tl { true }
\bool_new:N \l_LuaCJK_break_between_puncts_bool
\dim_new:N \l_LuaCJK_punct_bound_width_dim
\dim_set:Nn \l_LuaCJK_punct_bound_width_dim { 0pt }
\tl_new:N \l_LuaCJK_check_single_tl
\tl_set:Nn \l_LuaCJK_check_single_tl { 0 }
\int_new:N \l_LuaCJK_widow_penalty_int
\int_set:Nn \l_LuaCJK_widow_penalty_int { 10000 }
\tl_new:N \l_LuaCJK_local_config_tl
\tl_new:N \g_LuaCJK_autofake_bold_tl
\tl_new:N \g_LuaCJK_autofake_slant_tl
\tl_new:N \g_LuaCJK_embolden_factor_tl
\tl_gset:Nn \g_LuaCJK_embolden_factor_tl { 4 }
\tl_new:N \g_LuaCJK_slant_factor_tl

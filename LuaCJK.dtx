% \begin{macro}{\CJKunderwave}
% A wave drawn with \pkg{l3draw}, one period per half em, repeated
% by \tn{leaders}. The drawing is kept as code rather than as a box,
% so the |em| units are resolved when the decoration is used
% and the pattern follows the current font size.
%
% The period is forced to exactly half an em by \tn{hbox}| to .5em|.
% \pkg{l3draw} sizes its box by the bounding box of the stroked path,
% which is a full stroke width wider than the path; repeating that box would
% leave a gap of one stroke width between two periods.
% The two \tn{hss} absorb the excess symmetrically, so the ink fills
% the period exactly and no overfull box is reported. The stroke
% is set to |.04em|, which is \texttt{0.4pt} at 10pt, so the pattern keeps
% its look from the previous release while it scales with the font size.
%   \begin{variable}[int]{\l_@@_fntef_pattern_box}
% \changes{v0.0.1}{2026/11/05}{Close the gap between two periods of
%   \cs{CJKunderwave}: the drawing box now has exactly the period width, and
%   the two \cs{hss} absorb the stroke width, so the wave is continuous and no
%   overfull box is reported.}
% \changes{v0.0.1}{2026/11/05}{\cs{CJKunderwave}, \cs{CJKunderdot}, and
%   \cs{CJKxout} now build their pattern at use time, so the wave period, the
%   dots, and the slash scale with the font size instead of keeping the size
%   of the font current when the package was loaded.}
% \changes{v0.0.1}{2026/11/05}{The drawn patterns of \cs{CJKunderwave},
%   \cs{CJKunderdot}, and \cs{CJKxout} are built in a box whose height and
%   depth are zero, so a decoration no longer opens up the line it sits on.
%   The wave and the dots used to add about \texttt{0.25em} of depth. The
%   \keys{boxdepth} key, which only existed to limit that growth, is removed;
%   it also erased the rule of a \cs{vrule}-based decoration when used there.}
%   A scratch box for the drawn patterns.
%   Each pattern is built here and then has its height and depth set to zero:
%   the ink is a PDF literal, so only the reported dimensions change,
%   and a decoration never opens up the line it sits on.
%    \begin{macrocode}
\box_new:N \l_@@_fntef_pattern_box
\dim_new:N \l_@@_fntef_symbol_kern_dim
\dim_new:N \l_@@_fntef_symbol_raise_dim
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\newunderlinetype \@@_fntef_wave
  {
    \tex_leaders:D \hbox_to_wd:nn { .5em }
      {
        \tex_hss:D
        \hbox_set:Nn \l_@@_fntef_pattern_box
          {
            \box_move_up:nn { -.42em }
              {
                \hbox:n
                  {
                    \draw_begin:
                      \draw_set_linewidth:n { .04em }
                      \draw_path_moveto:n { 0em , 0em }
                      \draw_path_curveto:nnn { .0625em , .16em }
                        { .1875em , .16em } { .25em , 0em }
                      \draw_path_curveto:nnn { .3125em , -.16em }
                        { .4375em , -.16em } { .5em , 0em }
                      \draw_path_use_clear:n { stroke }
                    \draw_end:
                  }
              }
          }
        \box_set_ht:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
        \box_set_dp:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
        \box_use_drop:N \l_@@_fntef_pattern_box
        \tex_hss:D
      }
  }
\cs_new_protected:Npn \@@_fntef_use_symbol:n #1
  {
    \dim_set:Nn \l_@@_fntef_any_depth_dim {#1}
    \tl_set:Ne \l_@@_fntef_any_code_tl
      {
        \exp_not:N \tex_leaders:D \exp_not:N \hbox:n
          {
            \exp_not:N \hbox_set:Nn \exp_not:N \l_@@_fntef_pattern_box
              { \exp_not:V \l_@@_fntef_symbol_tl }
            \exp_not:N \dim_set:Nn \exp_not:N \l_@@_fntef_symbol_kern_dim
              {
                \exp_not:N \dim_eval:n
                  {
                    ( 1em
                      - \exp_not:N \box_wd:N \l_@@_fntef_pattern_box ) / 2
                  }
              }
            \exp_not:N \dim_set:Nn \exp_not:N \l_@@_fntef_symbol_raise_dim
              {
                \exp_not:N \dim_eval:n
                  {
                    - \exp_not:N \l_@@_fntef_any_depth_dim
                    - \exp_not:N \box_ht:N \l_@@_fntef_pattern_box
                  }
              }
            \exp_not:N \box_set_ht:Nn \exp_not:N \l_@@_fntef_pattern_box
              { \exp_not:N \c_zero_dim }
            \exp_not:N \box_set_dp:Nn \exp_not:N \l_@@_fntef_pattern_box
              { \exp_not:N \c_zero_dim }
            \exp_not:N \skip_horizontal:n
              { \exp_not:N \l_@@_fntef_symbol_kern_dim }
            \exp_not:N \box_move_up:nn
              { \exp_not:N \l_@@_fntef_symbol_raise_dim }
              { \exp_not:N \box_use_drop:N \l_@@_fntef_pattern_box }
            \exp_not:N \skip_horizontal:n
              { \exp_not:N \l_@@_fntef_symbol_kern_dim }
          }
      }
    \tl_set:Ne \l_@@_fntef_cache_key_tl
      {
        symbol |
        \dim_use:N \l_@@_fntef_any_depth_dim |
        \tl_to_str:V \l_@@_fntef_symbol_tl
      }
    \exp_args:NV \@@_fntef_use_leader_type:nn
      \l_@@_fntef_cache_key_tl \l_@@_fntef_any_code_tl
  }
\NewDocumentCommand \CJKunderwave { s t- o +m }
  {
    \group_begin:
      \@@_fntef_decoration_setup:n {#3}
      \tl_if_empty:NTF \l_@@_fntef_symbol_tl
        { \@@_fntef_wave }
        { \@@_fntef_use_symbol:n { .42em } }
      \@@_fntef_hide:n {#4}
    \group_end:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\CJKxout}
% \changes{v0.0.1}{2026/11/05}{The slash of \cs{CJKxout} now runs from
%   \texttt{-0.15em} to \texttt{0.8em}, so it crosses the whole body of a CJK
%   glyph instead of stopping in its upper half. \pkg{l3draw} lifts a drawing
%   by the part of its bounding box that lies below the baseline, which used
%   to put the bottom of the slash on the baseline; the slash is lowered again
%   by that amount.}
% A repeated slash, as in \pkg{ulem}'s \tn{xout}.
% The drawing is kept as code so that it scales with the font size,
% and the stroke width is |.04em| like the wave.
% The slash runs from |-.15em| to |.8em|, so it crosses the whole body
% of a CJK glyph instead of stopping in its upper half.
%
% \pkg{l3draw} moves a drawing so that the bottom of its bounding box sits
% on the baseline of the box, which shifts a path that goes below the
% baseline upwards. The \tn{raise} of |-.17em| takes the slash back down
% by the part that lies below the baseline (|.15em|) plus half the stroke,
% so the ink lands where the path says.
%    \begin{macrocode}
\newunderlinetype \@@_fntef_slash
  {
    \tex_leaders:D \hbox:n
      {
        \hbox_set:Nn \l_@@_fntef_pattern_box
          {
            \box_move_up:nn { -.17em }
              {
                \hbox:n
                  {
                    \draw_begin:
                      \draw_set_linewidth:n { .04em }
                      \draw_path_moveto:n { 0em , -.15em }
                      \draw_path_lineto:n { .42em , .8em }
                      \draw_path_use_clear:n { stroke }
                    \draw_end:
                  }
              }
          }
        \box_set_ht:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
        \box_set_dp:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
        \box_use_drop:N \l_@@_fntef_pattern_box
      }
  }
\NewDocumentCommand \CJKxout { s t- o +m }
  {
    \group_begin:
      \@@_fntef_decoration_setup:n {#3}
      \@@_fntef_slash
      \@@_fntef_hide:n {#4}
    \group_end:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\CJKunderanyline}
% \changes{v0.0.1}{2026/11/05}{Add \cs{CJKunderanyline} and
%   \cs{CJKunderanysymbol} for arbitrary rules and repeated symbols; the
%   underline type is cached by the arguments.}
% Underline with an arbitrary object: the object is put in a box,
% lowered by \meta{depth}, and repeated by \tn{leaders}.
% The underline type is cached by the object and the depth,
% so repeating a command with the same arguments costs nothing.
% \begin{variable}[int]{\l_@@_fntef_any_code_tl}
% The leader code being built.
%    \begin{macrocode}
\tl_new:N \l_@@_fntef_any_code_tl
\dim_new:N \l_@@_fntef_any_depth_dim
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_use_leader_type:nn #1#2
  {
    \prop_get:NnNF \g_@@_fntef_format_prop {#1}
      \l_@@_fntef_cache_name_tl
      {
        \int_gincr:N \g_@@_fntef_format_int
        \tl_set:Ne \l_@@_fntef_cache_name_tl
          { LuaCJKfntef / ul / \int_use:N \g_@@_fntef_format_int }
        \exp_args:Nc \newunderlinetype { \l_@@_fntef_cache_name_tl }
          [ \int_use:N \g_@@_fntef_format_int ] {#2}
        \prop_gput:NnV \g_@@_fntef_format_prop {#1}
          \l_@@_fntef_cache_name_tl
      }
    \use:c { \l_@@_fntef_cache_name_tl }
  }
\NewDocumentCommand \CJKunderanyline { m m +m }
  {
    \group_begin:
      \@@_fntef_decoration_setup:n { }
      \dim_set:Nn \l_@@_fntef_any_depth_dim { -#1 }
      \tl_set:Ne \l_@@_fntef_any_code_tl
        {
          \exp_not:N \tex_leaders:D \exp_not:N \hbox:n
            {
              \exp_not:N \box_move_up:nn
                { \dim_use:N \l_@@_fntef_any_depth_dim }
                { \exp_not:N \hbox:n { \exp_not:n {#2} } }
            }
        }
      \tl_set:Ne \l_@@_fntef_cache_key_tl
        { anyline | #1 | \tl_to_str:n {#2} }
      \exp_args:NV \@@_fntef_use_leader_type:nn
        \l_@@_fntef_cache_key_tl \l_@@_fntef_any_code_tl
      #3
    \group_end:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\CJKunderanysymbol}
% \changes{v0.0.1}{2026/11/05}{\cs{CJKunderanysymbol} now puts one symbol per
%   em, centered in the cell, so a row of symbols lines up with the characters
%   above them. Its depth argument is the distance from the baseline to the
%   top of the symbol, so \texttt{0pt} sets the symbol right under the
%   characters; \keys{sep} no longer applies, because the cell is fixed at one
%   em. The symbol of \cs{CJKunderdot}|[symbol = ...]| and
%   \cs{CJKunderwave}|[symbol = ...]| follows the same placement.}
% One symbol per em, which is what one wants for a repeated mark:
% the cell is as wide as a CJK character, so a row of symbols lines up with
% the characters above, and the symbol is centered in its cell.
% The depth is handed to \cs{LuaCJKfntef_use_symbol:n},
% which puts the top of the symbol that far below the baseline.
%    \begin{macrocode}
\NewDocumentCommand \CJKunderanysymbol { O{} m m +m }
  {
    \group_begin:
      \@@_fntef_decoration_setup:n {#1}
      \tl_set:Nn \l_@@_fntef_symbol_tl {#3}
      \@@_fntef_use_symbol:n {#2}
      #4
    \group_end:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\CJKunderdot}
% Emphasise with dots below the glyphs. The optional argument takes
% \keys{subtract} and \keys{skip}, like the other decorations.
%    \begin{macrocode}
\NewDocumentCommand \CJKunderdot { s t- o +m }
  {
    \group_begin:
      \@@_fntef_decoration_setup:n {#3}
      \tl_if_empty:NTF \l_@@_fntef_symbol_tl
        { \@@_fntef_underdot:n { \@@_fntef_hide:n {#4} } }
        {
          \@@_fntef_use_symbol:n { .3em }
          \@@_fntef_hide:n {#4}
        }
    \group_end:
  }
%    \end{macrocode}
% \begin{macro}[int]{\@@_fntef_underdot:n}
% Apply the dot pattern inside a group. One repeating unit is a dot of
% \texttt{.06em} with \texttt{.12em} on each side, lowered by \texttt{.4em}.
% The unit is written with |em| units so that it scales with the font size.
% \begin{macro}[int]{\@@_fntef_dots}
% The underline type that repeats one dot of the pattern.
%    \begin{macrocode}
\newunderlinetype \@@_fntef_dots
  {
    \tex_leaders:D \hbox:n
      {
        \hbox_set:Nn \l_@@_fntef_pattern_box
          {
            \skip_horizontal:n { .12em }
            \box_move_up:nn { -.4em }
              {
                \hbox:n
                  {
                    \tex_vrule:D width .06em height .06em
                      depth \c_zero_dim
                  }
              }
            \skip_horizontal:n { .12em }
          }
        \box_set_ht:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
        \box_set_dp:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
        \box_use_drop:N \l_@@_fntef_pattern_box
      }
  }
%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_underdot:n #1
  {
    \group_begin:
      \@@_fntef_dots
      #1
    \group_end:
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}

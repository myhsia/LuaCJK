    LuaCJK.attr_settings    =  \int_use:N   \c_@@_settings_attr_int ;
    LuaCJK.attr_disabled    =  \int_use:N   \c_@@_disabled_attr_int ;
    LuaCJK.name_ccglue      = "\cs_to_str:N \l_@@_ccglue_skip" ;
    LuaCJK.name_ecglue      = "\cs_to_str:N \l_@@_ecglue_skip" ;
    LuaCJK.name_math_fontid = "\cs_to_str:N \g_@@_math_fontid_int"
  }
\bool_gset_true:N \g_@@_lua_loaded_bool
\@@_settings_push:

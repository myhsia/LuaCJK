% \begin{macro}[internal]{LuaCJK.pre_linebreak}
%   The line-breaking callback.
%    \begin{macrocode}
function M.pre_linebreak (head, groupcode)
  return process(head)
end

%    \end{macrocode}
% \end{macro}

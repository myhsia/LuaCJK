% \begin{macro}{\CJKunderwave}
% \changes{v0.0.3}{2026/11/20}{The wave takes \keys{format} like the other
%   decorations: the pattern is stroked in that color, in the color of its text
%   when the key is absent, and neither color reaches the text outside it.}
% \changes{v0.0.3}{2026/11/20}{The wave is a smooth arch of one period per em,
%   a quarter em above and below the underline; a decoration is divided into
%   whole patterns once its final width is known and the pattern is drawn at
%   that width, so the periods meet without a gap, the wave reaches the last
%   character, and its period follows the stretch of the line.}
% \changes{v0.0.4}{2026/11/20}{The wave is written one period at a time, so it
%   covers the start and the end of a span that is not a whole number of
%   periods, on a stretched line as well as on the last line of a paragraph.}
% A wave drawn with \pkg{l3draw}, one period per em. The drawing is kept as
% code rather than as a box,
% so the |em| units are resolved when the decoration is used
% and the pattern follows the current font size.
%
% The drawing goes through \cs{@@_fntef_use_drawn_type:nn} rather than
% \cs{@@_fntef_use_leader_type:nn}, because its ink is stroked and not a rule
% that \pkg{luacolor} could color by attribute; the color travels into the
% drawing itself, so the pattern is built once per font size and color.
%
% The pattern is a pair of arches, each of them the quadratic that runs from
% one zero crossing to the next one through its apex, written as the cubic that
% is the same curve: its control points sit at a third and two thirds of the
% half period, two thirds of the amplitude high, so the curve leaves and meets
% the zero line at the same slope on both sides of a crossing and the wave has
% no cusp. The amplitude is a quarter em, so the wave is half an em high from
% crest to trough, half as high as its period is wide, which is the proportion
% the reference implementation gives it.
%
% The period is forced to exactly one em by \tn{hbox}| to 1em|.
% \pkg{l3draw} sizes its box by the bounding box of the stroked path,
% which is a full stroke width wider than the path; repeating that box would
% leave a gap of one stroke width between two periods. The two \tn{hss}
% absorb the excess symmetrically, so no overfull box is reported. The stroke
% is set to |.04em|, which is \texttt{0.4pt} at 10pt, so the pattern keeps
% its look from the previous release while it scales with the font size.
%
% The period is the width of a CJK character, so a span of whole characters
% that justification has not stretched, which is the last line of a paragraph,
% is an exact number of periods: its wave starts at the first character's edge,
% ends at the last one's, and puts a crest at the same place in every character.
%
% A span that justification has stretched is another matter: \TeX\ repeats only
% whole copies of a leader box, so the remainder of such a span is the stretch
% the piece carries, which at one em is up to a character. \tn{leaders} would
% leave all of it empty at the right end and \tn{cleaders} half of it at each
% end, where the wave stops before the last character. \tn{xleaders} divides it
% between the copies, but that glue separates two butt caps: a cap ends where
% its path ends, so every gap is a hole in the stroke, and at a tenth of a
% point it is already visible at the crossings. The piece is therefore divided
% into whole patterns instead, by \texttt{tile} (see the decoration pass): it
% has the final width and the nearest whole number of periods, and it writes one
% copy of the leader box per period at that width. The wave then reaches the
% last character, no glue falls between two periods, and the period follows the
% line: on a paragraph set ten centimetres wide it is \texttt{9.92pt} on a line
% that was shrunk by a per cent and \texttt{10pt} on the last line, which was
% not stretched at all.
%
% The width the piece is divided into is not the period of the drawing, so the
% ink of the copy is painted inside a scope that scales it horizontally to that
% width. Without it the drawing keeps its own period and two copies are a
% hundredth of a point out of phase, which is a hairline gap or a thin doubling
% at every crossing; with it one copy's path ends exactly where the next one's
% begins. The glue the piece is made of has no shrink of its own, so its final
% width is read from the line's own \texttt{glue\_set} and \texttt{glue\_sign},
% the latter saying whether the line was stretched or shrunk.
% A box that never reaches a vertical list, such as \tn{hbox}| to|, keeps the
% plain \tn{leaders} behaviour: it stops after its last whole pattern, without
% breaking the stroke.
% \begin{variable}[int]{\l_@@_fntef_pattern_box}
% A scratch box for the drawn patterns.
% Each pattern is built here and then has its height and depth set to zero:
% the ink is a PDF literal, so only the reported dimensions change,
% and a decoration never opens up the line it sits on.
%    \begin{macrocode}
\box_new:N \l_@@_fntef_pattern_box
\dim_new:N \l_@@_fntef_symbol_kern_dim
\dim_new:N \l_@@_fntef_symbol_raise_dim
\dim_new:N \l_@@_fntef_em_descent_dim
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_wave:
  {
    \tl_set:Nn \l_@@_fntef_any_code_tl
      {
        \tex_leaders:D \hbox_to_wd:nn { 1em }
          {
            \tex_hss:D
            \hbox_set:Nn \l_@@_fntef_pattern_box
              {
                \box_move_up:nn { -.42em }
                  {
                    \hbox:n
                      {
                        \draw_begin:
                          \@@_fntef_pattern_color:
                          \draw_set_linewidth:n { .04em }
                          \draw_path_moveto:n { 0em , 0em }
                          \draw_path_curveto:nnn { .1667em , .1667em }
                            { .3333em , .1667em } { .5em , 0em }
                          \draw_path_curveto:nnn { .6667em , -.1667em }
                            { .8333em , -.1667em } { 1em , 0em }
                          \draw_path_use_clear:n { stroke }
                        \draw_end:
                      }
                  }
              }
            \box_set_ht:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
            \box_set_dp:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
            \box_use_drop:N \l_@@_fntef_pattern_box
            \tex_hss:D
          }
      }
    \tl_set:Nn \l_@@_fntef_cache_key_tl { wave }
    \exp_args:NV \@@_fntef_use_drawn_type:nn
      \l_@@_fntef_cache_key_tl \l_@@_fntef_any_code_tl
  }

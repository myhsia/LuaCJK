% \begin{macro}{\CJKunderwave}
%   A wave drawn with \pkg{l3draw}, one period per half em, repeated by
%   \tn{leaders}.  The box is built once at load time.
%    \begin{macrocode}
\box_new:N \l_LuaCJKfntef_wave_box
\hbox_set:Nn \l_LuaCJKfntef_wave_box
  {
    \raise -.42em \hbox:n
      {
        \draw_begin:
          \draw_path_moveto:n { 0em , 0em }
          \draw_path_curveto:nnn { .0625em , .16em } { .1875em , .16em }
            { .25em , 0em }
          \draw_path_curveto:nnn { .3125em , -.16em } { .4375em , -.16em }
            { .5em , 0em }
          \draw_path_use_clear:n { stroke }
        \draw_end:
      }
  }
\newunderlinetype \LuaCJKfntef_wave
  { \leaders \box_use_drop:N \l_LuaCJKfntef_wave_box }
\NewDocumentCommand \CJKunderwave { s t- o +m }
  {
    \group_begin:
      \LuaCJKfntef_decoration_setup:n {#3}
      \LuaCJKfntef_wave
      \LuaCJKfntef_hide:n {#4}
    \group_end:
  }
%    \end{macrocode}
% \end{macro}

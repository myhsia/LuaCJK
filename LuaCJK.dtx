%<*lua>
-- LuaCJK.lua
-- Copyright (C) 2026 by Mingyu Xia <myhsia@outlook.com>
-- This work may be distributed and/or modified under the conditions of the
-- LaTeX Project Public License, version 1.3c or later.
-- LuaCJK node processing.

LuaCJK = LuaCJK or {}

local M = LuaCJK
local GLYPH = node.id("glyph")
local GLUE = node.id("glue")
local HLIST = node.id("hlist")
local VLIST = node.id("vlist")
local KERN = node.id("kern")
local PENALTY = node.id("penalty")
local MATH = node.id("math")
local DISC = node.id("disc")
local WHATSIT = node.id("whatsit")
local LOCAL_PAR = node.id("local_par")
local SPACESKIP = node.subtype("spaceskip") or 13
local new_node = node.new
local free_node = node.free
local has_attribute = node.has_attribute
local set_attribute = node.set_attribute

M.attr_font = M.attr_font or nil
M.attr_cjk_space = M.attr_cjk_space or nil
M.attr_xecglue = M.attr_xecglue or nil
M.attr_inserted = M.attr_inserted or nil

local function is_cjk (c)
  return (c >= 0x2E80 and c <= 0x9FFF)
      or (c >= 0xF900 and c <= 0xFAFF)
      or (c >= 0xFE30 and c <= 0xFE4F)
      or (c >= 0xFF00 and c <= 0xFFEF)
      or (c >= 0x20000 and c <= 0x3FFFF)
      or (c >= 0x3040 and c <= 0x30FF)
      or (c >= 0xAC00 and c <= 0xD7AF)
      or (c >= 0x1100 and c <= 0x11FF)
      or c == 0x2014 or c == 0x2018 or c == 0x2019
      or c == 0x201C or c == 0x201D or c == 0x2026
end

M.is_cjk = is_cjk

local function copy_glyph (n, fid)
  local g = new_node("glyph")
  g.font = fid
  g.char = n.char
  g.attr = n.attr
  g.lang = n.lang
  g.left = n.left
  g.right = n.right
  g.uchyph = n.uchyph
  g.xoffset = n.xoffset
  g.yoffset = n.yoffset
  g.expansion_factor = n.expansion_factor
  g.data = n.data
  g.subtype = n.subtype
  return g
end

local function rewrite_fonts (head)
  local prev = nil
  local cur = head
  while cur do
    local nxt = cur.next
    if cur.id == GLYPH and is_cjk(cur.char) and M.attr_font then
      local target = has_attribute(cur, M.attr_font)
      if target and target > 0 and target ~= cur.font then
        -- luaotfload inserts a private-use placeholder for a missing
        -- character.  Once the CJK glyph is replaced, that placeholder is
        -- no longer needed and would contribute a spurious advance width.
        if nxt and nxt.id == GLYPH and nxt.char == 0xF0000 then
          local after = nxt.next
          free_node(nxt)
          nxt = after
        end
        local g = copy_glyph(cur, target)
        g.next = nxt
        if prev then
          prev.next = g
        else
          head = g
        end
        free_node(cur)
        cur = g
      end
    end
    prev = cur
    cur = nxt
  end
  return head
end

local function class_of_char (c)
  if is_cjk(c) then
    return "CJK"
  end
  return "LATIN"
end

local function first_visible_class (list)
  local n = list
  while n do
    if n.id == GLYPH then
      return class_of_char(n.char)
    elseif n.id == HLIST or n.id == VLIST then
      local c = first_visible_class(n.head)
      if c then
        return c
      end
    elseif n.id == MATH then
      return "LATIN"
    end
    n = n.next
  end
  return nil
end

local function last_visible_class (list)
  local n = list
  local last = nil
  while n do
    if n.id == GLYPH then
      last = class_of_char(n.char)
    elseif n.id == HLIST or n.id == VLIST then
      local c = last_visible_class(n.head)
      if c then
        last = c
      end
    elseif n.id == MATH then
      last = "LATIN"
    end
    n = n.next
  end
  return last
end

local function class_of_node (n)
  if n.id == GLYPH then
    local c = class_of_char(n.char)
    return c, c
  elseif n.id == HLIST or n.id == VLIST then
    local first = first_visible_class(n.head)
    local last = last_visible_class(n.head)
    if first and last then
      return first, last
    end
  elseif n.id == MATH then
    return "LATIN", "LATIN"
  end
  return nil, nil
end

local function is_inserted (n)
  return M.attr_inserted
    and has_attribute(n, M.attr_inserted) ~= nil
end

local function get_glue (name)
  local s = tex.skip[name]
  if not s then
    return nil
  end
  return s
end

local function make_glue (name)
  local s = get_glue(name)
  if not s then
    return nil
  end
  local g = new_node("glue")
  g.width = s.width
  g.stretch = s.stretch
  g.shrink = s.shrink
  g.stretch_order = 0
  g.shrink_order = 0
  if M.attr_inserted then
    set_attribute(g, M.attr_inserted, 1)
  end
  return g
end

local function set_glue (g, name)
  local s = get_glue(name)
  if not s then
    return false
  end
  g.width = s.width
  g.stretch = s.stretch
  g.shrink = s.shrink
  if M.attr_inserted then
    set_attribute(g, M.attr_inserted, 1)
  end
  return true
end

local function insert_boundary_glue (head, prev, prev_end, cur, cur_start)
  local name = nil
  if prev_end == "CJK" and cur_start == "CJK" then
    name = "l_LuaCJK_ccglue_skip"
  elseif prev_end ~= cur_start then
    name = "l_LuaCJK_ecglue_skip"
  end
  if not name then
    return head
  end
  local g = make_glue(name)
  if not g then
    return head
  end
  g.next = cur
  if prev then
    prev.next = g
  else
    head = g
  end
  return head
end

local function handle_source_space (head, glue, before, prev_end, cur, cur_start)
  -- Only source-generated spaces are candidates.  Explicit \hskip, \hfill
  -- and similar glue have a different subtype and must be preserved.
  if glue.subtype ~= SPACESKIP then
    return head
  end
  local prev_cjk = prev_end == "CJK"
  local cur_cjk = cur_start == "CJK"
  if prev_cjk and cur_cjk then
    local cjk_space = M.attr_cjk_space
      and (has_attribute(glue, M.attr_cjk_space) or 0) ~= 0
    if not cjk_space then
      if before then
        before.next = cur
      else
        head = cur
      end
      free_node(glue)
    end
  elseif prev_cjk or cur_cjk then
    local xecglue = M.attr_xecglue
      and (has_attribute(glue, M.attr_xecglue) or 0) ~= 0
    if xecglue then
      set_glue(glue, "l_LuaCJK_ecglue_skip")
    end
  end
  return head
end

local function spacing (head)
  local prev = nil
  local before = nil
  local prev_visible = nil
  local prev_end = nil
  local cur = head
  while cur do
    local nxt = cur.next
    local start_class, end_class = class_of_node(cur)
    if start_class then
      if prev_visible then
        if prev and prev.id == GLUE then
          if not is_inserted(prev) then
            head = handle_source_space(
              head, prev, before, prev_end, cur, start_class)
          end
        elseif prev and prev.id == PENALTY then
          -- A penalty is an explicit barrier: do not bridge it.
        elseif prev and prev.id == DISC then
          -- Discretionaries are opaque in this first boundary version.
        else
          head = insert_boundary_glue(
            head, prev, prev_end, cur, start_class)
        end
      end
      prev_visible = cur
      prev_end = end_class
    elseif cur.id == PENALTY or cur.id == DISC then
      prev_visible = nil
      prev_end = nil
    end
    before = prev
    prev = cur
    cur = nxt
  end
  return head
end

local function process (head)
  head = rewrite_fonts(head)
  head = spacing(head)
  return head
end

M.process = process

function M.pre_linebreak (head, groupcode)
  return process(head)
end

function M.hpack (head, groupcode, size, packtype, direction, attributelist)
  return process(head)
end

luatexbase.add_to_callback("pre_linebreak_filter", M.pre_linebreak, "LuaCJK.spacing")
luatexbase.add_to_callback("hpack_filter", M.hpack, "LuaCJK.spacing")

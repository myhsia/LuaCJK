% \begin{macro}[int]{\@@_fntef_push_settings:}
% Hand the decoration settings to Lua, or clear the attribute when they are
% all at their defaults.
% The dots are settings of their own: when \cs{CJKunderdot} gives no
% \keys{symbol}, the pass puts one dot under each CJK character rather than
% repeating a pattern, so the entry carries the side of a dot, the distance
% from the baseline to its top, and the color attribute of \keys{format}.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_push_settings:
  {
    \bool_lazy_and:nnTF
      { \l_@@_fntef_dots_bool }
      { \tl_if_empty_p:N \l_@@_fntef_symbol_tl }
      {
        \tl_set:Nn \l_@@_fntef_dots_js_tl { true }
        \dim_set:Nn \l_@@_fntef_dots_size_dim { .06em }
        \dim_set:Nn \l_@@_fntef_dots_top_dim
          { \LuaCJKemdescent + \l_@@_fntef_depth_dim }
        \tl_if_empty:NF \l_@@_fntef_format_tl
          {
            \group_begin:
              \luaul_set_color:n { \l_@@_fntef_format_tl }
              \luaul_apply_color:
              \int_gset:Nn \g_@@_fntef_dots_color_int
                { \tex_the:D \use:c { LuaCol@Attribute } }
            \group_end:
          }
      }
      { \tl_set:Nn \l_@@_fntef_dots_js_tl { false } }
    \bool_lazy_all:nTF
      {
        { \dim_compare_p:nNn { \l_@@_fntef_subtract_dim } = { 0pt } }
        { \str_if_eq_p:Vn \l_@@_fntef_skip_tl { 0 } }
        { \bool_not_p:n { \l_@@_fntef_hidden_bool } }
        { \str_if_eq_p:Vn \l_@@_fntef_dots_js_tl { false } }
      }
      {
        \lua_now:e
          {
            tex.setattribute
              ( \int_use:N \c_@@_fntef_settings_attr_int, 0 )
          }
      }
      {
        \str_if_eq:VnTF \l_@@_fntef_skip_tl { 1 }
          { \tl_set:Nn \l_@@_fntef_skip_js_tl { true  } }
          { \tl_set:Nn \l_@@_fntef_skip_js_tl { false } }
        \bool_if:NTF \l_@@_fntef_hidden_bool
          { \tl_set:Nn \l_@@_fntef_hidden_js_tl { true  } }
          { \tl_set:Nn \l_@@_fntef_hidden_js_tl { false } }
        \lua_now:e
          {
            LuaCJKfntef.new_settings
              ( \dim_to_decimal_in_sp:n { \l_@@_fntef_subtract_dim } ,
                \l_@@_fntef_skip_js_tl ,
                \l_@@_fntef_hidden_js_tl ,
                \l_@@_fntef_dots_js_tl ,
                \dim_to_decimal_in_sp:n { \l_@@_fntef_dots_size_dim } ,
                \dim_to_decimal_in_sp:n { \l_@@_fntef_dots_top_dim } ,
                \int_use:N \g_@@_fntef_dots_color_int )
          }
      }
  }
\cs_new_protected:Npn \@@_fntef_prepare_underline:n #1
  {
    \@@_fntef_options:n {#1}

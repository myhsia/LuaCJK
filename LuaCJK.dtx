% \begin{macro}[int]{\@@_setup_format_chars:}
% \changes{v0.0.1}{2026/11/11}{Ignore the zero-width format characters
%   (U+200B, U+200C, U+200D, U+2060, U+180E) and the variation selectors at
%   the input, so that they neither take glue nor separate two CJK characters.}
% \changes{v0.0.3}{2026/11/20}{The joiners (U+200C, U+200D) and the variation
%   selectors are no longer removed at the input: they reach the font, so an
%   emoji sequence is not split and a CJK variation sequence selects its
%   glyph, and what the font leaves of them is dropped before the spacing
%   pass, so two CJK characters still take no glue around them.}
% A character that only controls the text and has no advance of its own needs
% care: the font loader replaces one that the font does not have by a space
% glyph and a negative kern, and the spacing pass then sees a Latin atom and
% surrounds it with \keys{CJKecglue} on both sides.
% There are two kinds.
% U+180E, U+200B, U+2060, and U+FEFF carry no information a font can use, so
% they are given category 9 and removed before the font loader runs.
% U+200C, U+200D, and the variation selectors are the ones a font shapes
% with: they are left alone here, and the pass that runs before shaping lets
% them follow the font of the character in front of them, so that what the
% font leaves of them can be dropped afterwards.
% A character produced by \tn{char} bypasses the category codes and is left
% alone: \tn{char} asks for the glyph itself, not for the character's
% typographic role.
% Without \texttt{pre\_shaping\_filter} there is no pass to tell the two
% kinds apart, so every character of the set is removed, which is what the
% package did before the shaping change.
%    \begin{macrocode}
\clist_const:Nn \c_@@_removed_chars_clist
  { "180E , "200B , "2060 , "FEFF }
\clist_const:Nn \c_@@_attached_chars_clist
  { "200C , "200D }
\cs_new_protected:Npn \@@_setup_format_chars:
  {
    \clist_map_inline:Nn \c_@@_removed_chars_clist
      { \char_set_catcode_ignore:n {##1} }
    \bool_if:NF \g_@@_shaping_bool
      {
        \clist_map_inline:Nn \c_@@_attached_chars_clist
          { \char_set_catcode_ignore:n {##1} }
        \int_step_inline:nnn { "FE00 } { "FE0F }
          { \char_set_catcode_ignore:n {##1} }
        \int_step_inline:nnn { "E0100 } { "E01EF }
          { \char_set_catcode_ignore:n {##1} }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_load_cj:}
% Read the \texttt{CJ} set from \file{LineBreak.txt} once.
% The key \keys{CJLineBreak} calls this when it selects \texttt{strict};
% a second call is cheap because the Lua side remembers that it has read
% the file.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_load_cj:
  { \lua_now:e { LuaCJK.load_cj() } }
%    \end{macrocode}
% \end{macro}

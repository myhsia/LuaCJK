%
% \subsection{数学模式中的汉字}
%
% \begin{keyval}
%   \item[\keys{CJKmath}]\val{\TFF}: 是否允许在数学模式里直接输入汉字。
%   打开时，这样的字符用它自己的一个数学字族的 CJK 字体排出，
%   而不是到数学字体里去找，
%   所以上标或分数里的字符会取那个数学样式的尺寸。
%   可以用 |\LuaCJKsetup{CJKmath = true}| 打开它，也可以用宏包选项
%   |CJKmath = true|。
%   此时字符取数学版本（见 \tn{mathversion}）的字体：
%   在 \texttt{bold} 版本里用字族的粗体，字族没有粗体时保持正体；
%   字形取字族的正体，不随周围的正文。
%   不打开它时，数学模式里的汉字会到数学字体里去找，通常就此消失，
%   所以这种情况下 LuaCJK 给出一次性的警告。
% \end{keyval}
%
% \begin{function}{\setCJKmathfont}
%   \begin{syntax}
%     \tn{setCJKmathfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   选择数学模式里的字符所用的 CJK 字体。
%   不用这个命令时，使用 CJK 主字体。
%   本手册在前导区打开 \keys{CJKmath} 并设置了这个字体。
%   与其他的字体命令一样，这个选择只作用于当前分组：
%   分组里的公式使用该分组里选择的字族。
% \end{function}
%
% 数学模式里出现的每一个 CJK 字族都被注册成一个独立的数学字族，
% 这样 \TeX\ 就能取它的文本、脚本或脚脚本尺寸。
% 字族按数学版本选字体：\texttt{bold} 版本用 \cs{bfdefault}，其余版本用
% \cs{mddefault}，字形的形状取 \cs{shapedefault}。
% 所以 \cs{boldmath} 会把公式里的汉字换成粗体，而且只作用于当前分组；
% 字族没有粗体时保持正体，也不报警告。
% 字族号取自 240--255 这一段，是 \LuaTeX\ 允许的 256 个字族里的最后十六个，
% 正常文档不会用到那里；一个文档如果在数学里用到十六个以上的 CJK 字族，
% 就会报错停止。
% 脚本尺寸是当前正文尺寸的百分之七十五，
% 也就是标准尺寸表里的比例。
% 数学参数不取自 CJK 字体，因为它没有
% \texttt{MathConstants} 表：这些参数仍然是文档数学字体的，
% 这就是为什么两个汉字组成的分数用的是周围数学的横线与间距。
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
$ x + 中文 $ and 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{文本排版}
%
% \subsection{间距}
%
% \begin{keyval}
%   \item[\keys{CJKglue}]\val{glue}: 插入相邻 CJK 字符之间的胶。
%   初始值是 \texttt{0pt plus 0.08\cs{baselineskip}}，在每次选择字体时重新计算，
%   所以它跟随字号；文档给出的值按原样使用，不随字号变化，
%   连同它的伸缩阶（例如 |plus 1filll|）一起保留。
%   \item[\keys{CJKecglue}]\val{glue}: 插入 CJK 与拉丁字符之间的胶。
%   标点两侧的胶没有宽度：标点的进距本身就带有间距。
%   初始值是 \texttt{0.3333em plus 0.1667em minus 0.1111em}，
%   它同样跟随字号。
%   \item[\keys{CJKspace}]\val{\TFF}: 是否保留源文件中 CJK 字符之间的空格。
%   不保留时，空格换成字符之间的胶，断行与伸缩都随之保留。
%   \item[\keys{xCJKecglue}]\val{\TFF}: 是否把源文件中 CJK 与拉丁字符之间的
%   空格替换为 \texttt{CJKecglue}。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
中文 English 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{CJKspace = true}中 文 中 文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\normalspacedchars}
%   \begin{syntax}
%     \tn{normalspacedchars} \marg{character list}
%   \end{syntax}
%   列出的字符两侧都不加胶，
%   这样拉丁文字中的连字符或斜线不会把周围的文字拉开。
%   初始列表是 |/|、|\| 与 |-|。这个设置是全局的。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
中x中\par
\normalspacedchars{x}中x中
\end{codemo}
\normalspacedchars{/,\,,-}
\endgroup
% \iffalse
%</example>
% \fi
%
% 只用于控制文字、本身没有进距的字符
% （U+200B、U+200C、U+200D、U+2060、U+180E、U+FEFF 以及各个变体选择符）
% 在输入时就已删除。因此它们既不占胶，也不把两个 CJK 字符分开：
% 零宽空格不会加上本来会在它两侧出现的两个 \keys{CJKecglue}，
% 而它想提供的断行机会在周围的胶上本来就存在。
% 用 \tn{char} 请求的字符不会被删除，因为 \tn{char} 要的就是字形本身。
%
% \begin{environment}{CJKfilltwosides}
%   \begin{syntax}
%   \tn{begin}\{CJKfilltwosides\}\oarg{position}\marg{width}
%   \   \meta{lines} \\
%   \tn{end}\{CJKfilltwosides\}
%   \end{syntax}
%   把各行排进一个竖直盒子里，
%   盒中的行两端对齐到 \meta{width}，各行之间用 |\\| 分开。
%   它的 \meta{position} 参数决定盒子在基线上的位置：
%   \texttt{t} 表示顶部，\texttt{c} 表示居中（默认），\texttt{b} 表示底部。
%   宽度为零或为负时沿用周围的行宽。
%   带星号的形式行为相同；它不与内容的自然宽度作比较。
% \end{environment}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begin{CJKfilltwosides}{6em}
  瞻彼阕者，\\虚室生白
\end{CJKfilltwosides}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begin{CJKfilltwosides*}{0pt}
  瞻彼阕者，\\虚室生白
\end{CJKfilltwosides*}
\end{codemo}
% \iffalse
%</example>
% \fi

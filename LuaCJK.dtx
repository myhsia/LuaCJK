% \iffalse
%</example>
% \fi
%
% \subsection{断行}
%
% 一串破折号或省略号（U+2013、U+2014、U+2015、U+FF0D、U+2026
% 与 U+22EF）是一个整体：这些标点之间不加胶，所以两端对齐不会把一个
% 两字宽的破折号拆开，它们之间也不提供断行机会。
% 键 \keys{LongPunct} 替换这个集合。
%
% \begin{keyval}
%   \item[\keys{CheckSingle}]\val{\TFF}
%   打开时，末字符是 CJK 的段落的最后两个断行点被设为不可断开，
%   这样单个字符就不会孤零零地落在最后一行上。初始值是 \meta{false}。
%   \item[\keys{WidowPenalty}]\val{penalty}: \texttt{CheckSingle} 使用的惩罚值。
%   初始值是 \texttt{10000}；
%   较小的值在值得这个代价时允许断开。
%   \item[\keys{CJLineBreak}]\val{normal, strict}: 在 \texttt{strict}
%   模式下，Unicode 的 \texttt{Line\_Break} 属性为
%   \texttt{CJ} 的字符（小假名之类）不能出现在行首。
%   这个模式只增加禁则，不取消任何禁则。
%   初始值是 \texttt{normal}，它把这些字符当作其他 CJK 字符。
%   这个集合从 \pkg{unicode-data} 宏包集的 \file{LineBreak.txt} 读取，
%   所以严格模式需要这个宏包集。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\parbox{4em}{字字字字字字\par}\par
\LuaCJKsetup{CheckSingle = true}
\parbox{4em}{字字字字字字\par}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKnobreak}
%   \begin{syntax}
%     \tn{LuaCJKnobreak} \marg{text}
%   \end{syntax}
%   把 \meta{text} 保持在一行之内。参数的节点被打上标记，
%   断行的处理不在它们的任何边界处断开。标记随当前分组结束。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\parbox{5em}{字字字字字字}\quad
\parbox{5em}{字字字字\LuaCJKnobreak{字字}}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi

% \subsection{Callbacks}
%
% \begin{macro}[internal]{LuaCJK.process}
%   Run the font, spacing, fixed-width, and kinsoku passes over a list.
%    \begin{macrocode}
-- Widow control for a single CJK character on the last line.
--
-- TeX can break at the glue that LuaCJK inserts between CJK characters.  At
-- the end of a paragraph we raise the penalty of the last two such break
-- points, so at least three CJK characters travel to the last line together.
local function check_single_enabled ()
  return token.get_macro("l_LuaCJK_check_single_tl") == "1"
end

local function widow_penalty ()
  return tex.count["l_LuaCJK_widow_penalty_int"] or 10000
end

local function apply_check_single (head)
  if not check_single_enabled() then
    return head
  end
  local trail = {}
  local node = head
  while node do
    trail[#trail + 1] = node
    node = node.next
  end
  local last
  for i = #trail, 1, -1 do
    local item = trail[i]
    if item.id == GLYPH then
      if is_cjk(item.char) then
        last = i
      end
      break
    elseif item.id == HLIST or item.id == VLIST then
      break
    end
  end
  if not last then
    return head
  end
  local penalty = widow_penalty()
  local inserted = 0
  local i = last
  while i > 1 and inserted < 2 do
    local j = i - 1
    while j >= 1 and (trail[j].id == GLUE or trail[j].id == PENALTY) do
      j = j - 1
    end
    if j < 1 then
      break
    end
    local glyph = trail[j]
    if glyph.id ~= GLYPH or not is_cjk(glyph.char) then
      break
    end
    local target = trail[j + 1]
    if target and target.id == GLUE then
      local p = new_node("penalty")
      inherit_attributes(p, glyph)
      p.penalty = penalty
      p.next = target
      glyph.next = p
    end
    inserted = inserted + 1
    i = j
  end
  return head
end

local function process (head)
  read_latin_punct()
  head = rewrite_fonts(head)
  head = spacing(head)
  head = apply_fixed_widths(head)
  head = apply_kinsoku(head)
  head = apply_check_single(head)
  return head
end

M.process = process

%    \end{macrocode}

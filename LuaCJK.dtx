% The switches read by the Lua side, the \keys{Verb} setting,
% the configuration file name, the fake bold and slant parameters,
% and the fallback fonts.
%    \begin{macrocode}
\tl_new:N  \l_@@_punct_kinsoku_tl
\tl_set:Nn \l_@@_punct_kinsoku_tl { 1 }
\tl_new:N  \l_@@_cj_strict_tl
\tl_set:Nn \l_@@_cj_strict_tl { 0 }
\tl_new:N  \l_@@_cjk_math_tl
\tl_set:Nn \l_@@_cjk_math_tl { 0 }
\tl_new:N  \l_@@_latin_punct_tl
\tl_set:Nn \l_@@_latin_punct_tl { 0 }
\tl_new:N  \l_@@_verb_mode_tl
\tl_set:Nn \l_@@_verb_mode_tl { true }
\bool_new:N \l_@@_break_between_puncts_bool
\dim_new:N  \l_@@_punct_width_dim
\dim_set:Nn \l_@@_punct_width_dim { 0pt }
\dim_new:N  \l_@@_punct_bound_width_dim
\dim_set:Nn \l_@@_punct_bound_width_dim { 0pt }
\tl_new:N \l_@@_check_single_tl
\tl_set:Nn \l_@@_check_single_tl { 0 }
\int_new:N \l_@@_widow_penalty_int
\int_set:Nn \l_@@_widow_penalty_int { 10000 }
\tl_new:N  \l_@@_local_config_tl
\tl_new:N  \g_@@_autofake_bold_tl
\tl_new:N  \g_@@_autofake_slant_tl
\tl_new:N  \g_@@_embolden_factor_tl
\tl_gset:Nn \g_@@_embolden_factor_tl { 4 }
\tl_new:N  \g_@@_slant_factor_tl
\tl_gset:Nn \g_@@_slant_factor_tl { 0.167 }
\prop_new:N \g_@@_fallback_prop
\bool_new:N \l_@@_auto_fallback_bool
\bool_new:N \g_@@_load_fandol_bool
\tl_new:N \l_@@_fallback_family_tl
\tl_new:N \l_@@_fallback_key_tl
\cs_generate_variant:Nn \prop_get:NnNF { NVNF }
\cs_generate_variant:Nn \prop_gput:Nnn { NVV  }
\tl_new:N \l_@@_fallback_ids_tl
\int_new:N \l_@@_main_fontid_int
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\keys_define:nn { LuaCJK / options }
  {
    CJKglue             .code:n      = { \@@_set_ccglue:n {#1} },
    CJKecglue           .code:n      = { \@@_set_ecglue:n {#1} },
    CJKspace            .choice:,
    CJKspace / true     .code:n      = { \g_@@_cjk_space_attr = 1 },
    CJKspace / false    .code:n      = { \g_@@_cjk_space_attr = 0 },
    CJKspace            .default:n   = { true  },
    CJKspace            .initial:n   = { false },
    xCJKecglue          .choice:,
    xCJKecglue / true   .code:n      = { \g_@@_xecglue_attr = 1 },
    xCJKecglue / false  .code:n      = { \g_@@_xecglue_attr = 0 },
    xCJKecglue          .default:n   = { true  },
    xCJKecglue          .initial:n   = { false },
    PunctStyle          .code:n      = { \@@_set_punct_style:n {#1} },
    PunctStyle          .default:n   = { quanjiao },
    PunctKinsoku        .choice:,
    PunctKinsoku / true .code:n      =
      { \tl_set:Nn \l_@@_punct_kinsoku_tl { 1 } },
    PunctKinsoku / false.code:n      =
      { \tl_set:Nn \l_@@_punct_kinsoku_tl { 0 } },
    PunctKinsoku        .default:n   = { true  },
    CJLineBreak         .choice:,
    CJLineBreak / normal .code:n     =
      { \tl_set:Nn \l_@@_cj_strict_tl { 0 } },
    CJLineBreak / strict .code:n     =
      {
        \tl_set:Nn \l_@@_cj_strict_tl { 1 }
        \@@_load_cj:
      },
    CJLineBreak         .default:n   = { strict },
    CJKmath             .choice:,
    CJKmath / true      .code:n      = { \tl_set:Nn \l_@@_cjk_math_tl { 1 } },
    CJKmath / false     .code:n      = { \tl_set:Nn \l_@@_cjk_math_tl { 0 } },
    CJKmath             .default:n   = { true  },
    Verb                .choice:,
    Verb / true         .code:n      =
      { \tl_set:Nn \l_@@_verb_mode_tl { true  } },
    Verb / env          .code:n      =
      { \tl_set:Nn \l_@@_verb_mode_tl { env   } },
    Verb / env+         .code:n      =
      { \tl_set:Nn \l_@@_verb_mode_tl { env+  } },
    Verb / false        .code:n      =
      { \tl_set:Nn \l_@@_verb_mode_tl { false } },
    Verb                .default:n   = { true },
    KaiMingPunct        .code:n      =
      { \@@_set_charset:nnn { kaiming } { set    } {#1} },
    KaiMingPunct+       .code:n      =
      { \@@_set_charset:nnn { kaiming } { add    } {#1} },
    KaiMingPunct-       .code:n      =
      { \@@_set_charset:nnn { kaiming } { remove } {#1} },
    MiddlePunct         .code:n      =
      { \@@_set_charset:nnn { middle  } { set    } {#1} },
    MiddlePunct+        .code:n      =
      { \@@_set_charset:nnn { middle  } { add    } {#1} },
    MiddlePunct-        .code:n      =
      { \@@_set_charset:nnn { middle  } { remove } {#1} },
    LongPunct           .code:n      =
      { \@@_set_charset:nnn { long    } { set    } {#1} },
    LongPunct+          .code:n      =
      { \@@_set_charset:nnn { long    } { add    } {#1} },
    LongPunct-          .code:n      =
      { \@@_set_charset:nnn { long    } { remove } {#1} },
    NoBreakLongPunct    .code:n      =
      { \@@_set_charset:nnn { nobreak } { set    } {#1} },
    NoBreakLongPunct+   .code:n      =
      { \@@_set_charset:nnn { nobreak } { add    } {#1} },
    NoBreakLongPunct-   .code:n      =
      { \@@_set_charset:nnn { nobreak } { remove } {#1} },
    PunctWidth          .code:n      =
      {
        \str_if_eq:nnTF {#1} { false }
          { \dim_zero:N \l_@@_punct_width_dim      }
          { \dim_set:Nn \l_@@_punct_width_dim {#1} }
      },
    PunctWidth          .default:n   = { false },
    PunctFamily         .code:n      =
      {
        \str_if_eq:nnTF {#1} { false }
          { \tl_clear:N \l_@@_punct_family_tl }
          { \tl_set:Nn \l_@@_punct_family_tl {#1} }
        \@@_update_font:
      },
    PunctFamily         .default:n   = { false },
    PunctBoundWidth     .code:n      =
      {
        \str_if_eq:nnTF {#1} { false }
          { \dim_zero:N \l_@@_punct_bound_width_dim }
          { \dim_set:Nn \l_@@_punct_bound_width_dim {#1} }
      },
    PunctBoundWidth     .default:n   = { false },
    LatinPunct          .choice:,
    LatinPunct / true   .code:n      =
      { \tl_set:Nn \l_@@_latin_punct_tl { 1 } },
    LatinPunct / false  .code:n      =
      { \tl_set:Nn \l_@@_latin_punct_tl { 0 } },
    LatinPunct          .default:n   = { true  },
    LatinPunct          .initial:n   = { false },
    AllowBreakBetweenPuncts
                        .choice:,
    AllowBreakBetweenPuncts / true
                        .code:n      =
      { \bool_set_true:N \l_@@_break_between_puncts_bool },
    AllowBreakBetweenPuncts / false
                        .code:n      =
      { \bool_set_false:N \l_@@_break_between_puncts_bool },
    AllowBreakBetweenPuncts
                        .default:n   = { true  },
    CheckSingle         .choice:,
    CheckSingle / true  .code:n      =
      { \tl_set:Nn \l_@@_check_single_tl { 1 } },
    CheckSingle / false .code:n      =
      { \tl_set:Nn \l_@@_check_single_tl { 0 } },
    CheckSingle         .default:n   = { true },
    WidowPenalty        .code:n      =
      { \int_set:Nn \l_@@_widow_penalty_int {#1} },
    LocalConfig         .code:n      =
      {
        \str_case:nnF {#1}
          {
            { true  } { \tl_set:Nn \l_@@_local_config_tl { luacjk.cfg } }
            { false } { \tl_clear:N \l_@@_local_config_tl           }
          } { \tl_set:Nn \l_@@_local_config_tl { luacjk-#1.cfg } }
      },
    LocalConfig         .default:n   = { true  },
    AutoFakeBold        .code:n      = { \@@_set_autofake:nn { bold } {#1} },
    AutoFakeBold        .default:n   = { true  },
    AutoFakeBold        .initial:n   = { false },
    AutoFakeSlant       .code:n      = { \@@_set_autofake:nn { slant } {#1} },
    AutoFakeSlant       .default:n   = { true  },
    AutoFakeSlant       .initial:n   = { false },
    EmboldenFactor      .code:n      =
      {
        \tl_gset:Nn \g_@@_embolden_factor_tl {#1}
        \tl_if_empty:NF \g_@@_autofake_bold_tl
          { \tl_gset:Nn \g_@@_autofake_bold_tl {#1} }
      },
    AutoFallBack        .choice:,
    AutoFallBack / true .code:n      =
      {
        \bool_set_true:N \l_@@_auto_fallback_bool
        \@@_recall_all_fallbacks:
      },
    AutoFallBack / false.code:n      =
      { \bool_set_false:N \l_@@_auto_fallback_bool },
    AutoFallBack        .default:n   = { true  },
    LoadFandol          .choice:,
    LoadFandol / true   .code:n      =
      { \bool_gset_true:N \g_@@_load_fandol_bool },
    LoadFandol / false  .code:n      =
      { \bool_gset_false:N \g_@@_load_fandol_bool },
    LoadFandol          .default:n   = { true  },
    SlantFactor         .code:n      =
      {
        \tl_gset:Nn \g_@@_slant_factor_tl {#1}
        \tl_if_empty:NF \g_@@_autofake_slant_tl
          { \tl_gset:Nn \g_@@_autofake_slant_tl {#1} }
      },
    unknown             .code:n      =
      {
        \msg_warning:nne { LuaCJK } { unknown-option }
          { \l_keys_key_str }
      },
  }
\msg_new:nnn { LuaCJK } { unknown-option }
  { Unknown~option~`#1'~is~being~ignored. }

% \begin{macro}{\LuaCJKVerbAddon, \LuaCJKOffVerbAddon}
% \changes{v0.0.1}{2026/11/05}{Add \cs{LuaCJKVerbAddon} and
%   \cs{LuaCJKOffVerbAddon}, which make one CJK character as wide as two
%   spaces of the current monospaced font and forbid breaks between CJK
%   characters, so columns in code listings stay aligned.}
% Align CJK text in a monospaced context: one CJK character plus the glue
% that follows it should take the width of two spaces.
% The gap therefore is twice the space of the current font minus
% the width of one CJK character. The width of the character
% is measured after switching to the CJK family in a group,
% because the current font is the monospaced one. A proportional font
% has no fixed space to align to, so the command adds nothing there.
% \begin{variable}[int]
%   {
%     \l_@@_verb_space_dim, \l_@@_verb_cjk_dim,
%     \l_@@_verb_gap_dim,   \l_@@_verb_saved_ccglue_skip,
%     \l_@@_verb_saved_ecglue_skip,
%     \l_@@_verb_saved_ccglue_touched_bool,
%     \l_@@_verb_saved_ecglue_touched_bool,
%     \l_@@_verb_addon_bool, \l_@@_verb_box
%   }
% The width of two spaces, the width of one CJK character,
% the gap between them, the saved glues, whether the addon is on,
% and the box used to measure the character.
%    \begin{macrocode}
\dim_new:N \l_@@_verb_space_dim
\dim_new:N \l_@@_verb_cjk_dim
\dim_new:N \l_@@_verb_gap_dim
\skip_new:N \l_@@_verb_saved_ccglue_skip
\skip_new:N \l_@@_verb_saved_ecglue_skip
\bool_new:N \l_@@_verb_saved_ccglue_touched_bool
\bool_new:N \l_@@_verb_saved_ecglue_touched_bool
\bool_new:N \l_@@_verb_addon_bool
\box_new:N \l_@@_verb_box
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\msg_new:nnn { LuaCJK } { verb-addon-narrow }
  {
    The~monospaced~font~is~too~narrow~for~one~CJK~character.\\
    `\token_to_str:N \LuaCJKVerbAddon'~adds~no~space.
  }
\cs_new_protected:Npn \@@_verb_addon_compute:
  {
    \dim_set:Nn \l_@@_verb_space_dim
      { 2 \tex_fontdimen:D 2 \tex_font:D }
    \dim_compare:nNnTF
      { \tex_fontdimen:D 2 \tex_font:D }
      = { \tex_fontcharwd:D \tex_font:D 77 }
      {
        \dim_set_eq:NN \l_@@_verb_cjk_dim \l_@@_verb_space_dim
        \group_begin:
          \prop_get:NVNT \g_@@_family_prop \l_@@_family_tl \l_@@_tmpa_tl
            {
              \exp_args:NV \fontfamily \l_@@_tmpa_tl
              \selectfont
              \hbox_set:Nn \l_@@_verb_box { 一 }
              \dim_gset:Nn \l_@@_verb_cjk_dim
                { \box_wd:N \l_@@_verb_box }
            }
        \group_end:
        \dim_set:Nn \l_@@_verb_gap_dim
          { \l_@@_verb_space_dim - \l_@@_verb_cjk_dim }
        \dim_compare:nNnTF { \l_@@_verb_gap_dim } < { 0pt }
          {
            \msg_warning:nn { LuaCJK } { verb-addon-narrow }
            \LuaCJKsetup { CJKglue = 0pt, CJKecglue = 0pt }
          }
          {
            \LuaCJKsetup
              {
                CJKglue   = \dim_use:N \l_@@_verb_gap_dim ,
                CJKecglue = \dim_eval:n { \l_@@_verb_gap_dim / 2 }
              }
          }
      }
      { \LuaCJKsetup { CJKglue = 0pt, CJKecglue = 0pt } }
  }
\NewDocumentCommand \LuaCJKVerbAddon { }
  {
    \int_compare:nNnF \tex_currentgrouplevel:D = \c_zero_int
      {
        \skip_set_eq:NN \l_@@_verb_saved_ccglue_skip
          \l_@@_ccglue_skip
        \skip_set_eq:NN \l_@@_verb_saved_ecglue_skip
          \l_@@_ecglue_skip
        \bool_set_eq:NN \l_@@_verb_saved_ccglue_touched_bool
          \l_@@_ccglue_touched_bool
        \bool_set_eq:NN \l_@@_verb_saved_ecglue_touched_bool
          \l_@@_ecglue_touched_bool
        \@@_verb_addon_compute:
        \g_@@_nobreak_attr = 1
        \bool_set_true:N \l_@@_verb_addon_bool
      }
  }
\NewDocumentCommand \LuaCJKOffVerbAddon { }
  {
    \bool_if:NT \l_@@_verb_addon_bool
      {
        \skip_set_eq:NN \l_@@_ccglue_skip
          \l_@@_verb_saved_ccglue_skip
        \skip_set_eq:NN \l_@@_ecglue_skip
          \l_@@_verb_saved_ecglue_skip
        \bool_set_eq:NN \l_@@_ccglue_touched_bool
          \l_@@_verb_saved_ccglue_touched_bool
        \bool_set_eq:NN \l_@@_ecglue_touched_bool
          \l_@@_verb_saved_ecglue_touched_bool
        \@@_settings_push:
        \g_@@_nobreak_attr = 0
        \bool_set_false:N \l_@@_verb_addon_bool
      }
  }
%    \end{macrocode}
% \end{macro}

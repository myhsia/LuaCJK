% \begin{function}{\LuaCJKShipoutHook}
%   \begin{syntax}
%     \tn{LuaCJKShipoutHook} \marg{code}
%   \end{syntax}
%   在每一页输出之前运行 \meta{code}。代码被加入
%   \texttt{shipout/before} 钩子，所以它遵守通常的钩子顺序。
% \end{function}
%
% \subsection{抄录与 \pkg{listings}}
%
% \begin{function}{\LuaCJKVerbAddon, \LuaCJKOffVerbAddon}
%   让一个 CJK 字符和当前等宽字体的两个空格一样宽，
%   这样代码列表里含有 CJK 文字时各列仍然对齐。
%   空隙以 \keys{CJKglue} 的形式加入，所以 CJK 字体本身并没有被缩放；
%   负的空隙只给出警告，什么也不加。
%   CJK 字符之间的断行被禁止，直到分组结束，与拉丁文的抄录文字一样。
%
%   这条命令在最外层的分组里不起作用，
%   所以它应当在需要它的环境内部使用，
%   例如 \pkg{fancyvrb} 的 \texttt{formatcom} 选项里。
%   \tn{LuaCJKOffVerbAddon} 在同一个分组里再次取消它。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\ttfamily 中中\\
\ttfamily\LuaCJKVerbAddon 中中
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{keyval}
%   \item[\keys{Verb}]\val{\TTF, env, env+}
%   \tn{verb} 与抄录类环境（\env{verbatim}、\env{Verbatim}、\env{lstlisting}
%   以及它们的近亲）里做什么。\texttt{true} 在两者中都暂停调整；
%   \texttt{env} 在环境里保留调整，但在 \tn{verb} 里不保留，
%   这样代码里含有 CJK 文字时各列仍然对齐；
%   \texttt{env+} 在所有地方都保留调整；\texttt{false} 完全不碰抄录材料。
%   既然 \texttt{env+} 与 \texttt{false} 都保留调整，
%   它们在 LuaCJK 里行为相同。
%   暂停只去掉间距：紧挨着被暂停材料的一个标点，
%   仍然保留它后面的断行机会。
% \end{keyval}
%
% \pkg{listings} 一次处理一个字符，并且在读到字符的那一刻就把
% 字符表之外的字符排出来。CJK 字符在它那张表之外，
% 于是会跑到周围拉丁文字的前面。配套的 \pkg{LuaCJK-listings} 修正了这一点：
% 它把 CJK 字符加入 \pkg{listings} 的字符表，所以它们留在原处，
% 把每个字符算作两列，并在列表内部关掉间距调整。
% 使用 \pkg{listings} 时 LuaCJK 自动加载它，所以不需要额外的命令。
%
% \tn{lstinline} 以改变了的类别码读取参数；
% 补丁会破坏那个扫描器，所以行内代码保持不动，按通常的方式处理。
%
% \subsection{装饰}
%
% 配套的 \pkg{LuaCJKfntef} 提供下划线、着重号与删除线。
% 它建立在 \pkg{lua-ul} 之上，
% 所以被装饰的文字可以包含任意命令、CJK 与拉丁文字，
% 也仍然可以被断字并跨行断开。
%
% \begin{function}{\CJKunderline}
%   \begin{syntax}
%     \tn{CJKunderline} \oarg{options} \marg{text}
%   \end{syntax}
%   给 \meta{text} 加下划线。初始几何是 \texttt{depth = 0.2em}
%   与 \texttt{thickness = 0.4pt}。
%   开头的一个 \texttt{*} 或 \texttt{-} 可以接受，并且被忽略。
% \end{function}
%
% 所有装饰命令共用下面这组键：与某个命令无关的键照样接受，只是不起作用。
% 只给一个颜色名而不写键名，等价于 \texttt{format = }\meta{color}。
% 键 \texttt{top} 与 \texttt{bottom} 被传给 \pkg{lua-ul}，
% 因此只对 \cs{CJKunderline} 有效，并覆盖计算出来的几何。
% 画出的图案从不改变被装饰行的高度或深度，所以行距不会变大。
%
% \begin{keyval}
%   \item[\keys{thickness}]\val{length}: 横线的粗细，初始 \texttt{0.4pt}。
%   \item[\keys{depth}]\val{length}:从基线到横线顶部的距离，
%   初始 \texttt{0.2em}。
%   \item[\keys{textformat}]\val{code}: 作用于文字的代码，例如
%   |textformat = \bfseries|。
%   \item[\keys{format}]\val{color name}: 横线的颜色，例如
%   |format = red|；它只影响横线，不影响文字。
%   \item[\keys{color}]\val{color name}: \texttt{format} 的另一个名字。
%   \item[\keys{subtract}]\val{length}:在横线两端各去掉的长度，
%   初始关闭；\texttt{true} 表示半字宽，
%   这样相邻的两个命令不会连在一起。
%   \item[\keys{skip}]\val{\TFF}: 把标点排除在横线之外。
%   \item[\keys{hidden}]\val{\TFF}:隐藏文字而保留横线，
%   横线取隐藏文字的宽度、高度与深度。
%   \item[\keys{gap}]\val{length}: 双线两条横线之间的距离，
%   初始 \texttt{1.1pt}。
%   \item[\keys{height}]\val{length}: 删除线中心到基线的距离，
%   初始 \texttt{0.3em}。
%   \item[\keys{symbol}]\val{code}: 替代波浪或圆点的符号。
%   \item[\keys{selectable}]\val{\TFF}: 装饰符号是否保留为文字，
%   初始 \texttt{false}；\texttt{true} 时 PDF 阅读器可以复制与选择它。
% \end{keyval}
%
% 不给 \keys{format} 时，横线使用它所装饰的文字的颜色，
% 例如 \cs{textcolor} 设定的颜色。
%
% \keys{sep} 为了兼容而接受，但没有作用。
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderline[thickness = 1pt]{中}\\
\CJKunderline[format = red]{中}\\
\CJKunderline[textformat = \bfseries]{中}\\
\CJKunderline[hidden]{中}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
今天是 \CJKunderline{\hspace*{3em}} 年\\
第 \CJKunderline{\hspace*{2em}} 题
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderline{中文}\CJKunderline{中文}\\
\CJKunderline[subtract]{中文}\\
\CJKunderline[skip]{中，文}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKunderdblline}
%   \begin{syntax}
%     \tn{CJKunderdblline} \oarg{options} \marg{text}
%   \end{syntax}
%   在 \meta{text} 下面画两条平行的横线，键见上面的键列表。
%   两条横线都使用 \keys{thickness}，上面那条从 \keys{depth} 开始，
%   \keys{gap} 是两条横线之间的距离。
%   开头的一个 \texttt{*} 或 \texttt{-} 可以接受，并且被忽略。
% \end{function}
%
% \begin{function}{\CJKunderwave}
%   \begin{syntax}
%     \tn{CJKunderwave} \oarg{options} \marg{text}
%   \end{syntax}
%   在 \meta{text} 下面画一条波浪线。
%   波浪线用 \pkg{l3draw} 画出，并用 \tn{leaders} 重复，
%   所以在一行的各部分之间相位相同。一个周期是半字宽，
%   整个图案随字号缩放；与其他画出的图案一样，
%   它不改变行的高度与深度。
%   \keys{symbol} 用来把波浪线换成别的符号：
%   每字宽一个符号，居中，符号顶部在基线之下半字宽处。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderwave{中文}\quad
\CJKunderwave[symbol = \textbullet]{中文}\\
\CJKunderdot {中文}\quad
\CJKunderdot [symbol = \textbullet]{中文}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKxout}
%   \begin{syntax}
%     \tn{CJKxout} \oarg{options} \marg{text}
%   \end{syntax}
%   用重复的斜线划掉 \meta{text}，像 \pkg{ulem} 的 \tn{xout} 那样。
%   斜线从基线之上 \texttt{0.8em} 延伸到基线之下 \texttt{-0.15em}，
%   所以它穿过一个 CJK 字形的整个字身。
% \end{function}
%
% \begin{function}{\LuaCJKemdescent}
%   当前字体 em 盒的深度，可以当作长度使用。
%   CJK 的 em 盒是一个 em 的正方形，所以把高度为 \texttt{1em} 的对象
%   放在这个深度上，就正好覆盖一个汉字所占的区域；
%   字体没有 OpenType 度量时退回 \texttt{.12em}。
% \end{function}
%
% \begin{function}{\CJKunderanyline}
%   \begin{syntax}
%     \tn{CJKunderanyline} \marg{depth} \marg{object} \marg{text}
%   \end{syntax}
%   把 \meta{object} 放在 \meta{text} 下面，并用 \tn{leaders} 重复。
%   \meta{object} 的底部放在基线之下 \meta{depth} 处，
%   所以对于一个（本身没有深度的）\cs{rule} 来说，
%   横线从基线之下 \meta{depth} 处向上占据。
%   要覆盖一个 CJK 字形，就用字体的 em 盒：\meta{depth} 取
%   \cs{LuaCJKemdescent}，对象高度取 \texttt{1em}，正如下例所做的那样。
%   对象填满的是 em 盒，也就是 PDF 阅读器划出的选区：
%   横向是字身宽度，纵向是 em 盒的高度，
%   字体墨迹比 em 盒窄时，四周会各露出一条边距。
%   类型会被缓存，所以相同的参数复用一个下划线类型。
% \end{function}
%
% \begin{function}{\CJKunderanysymbol}
%   \begin{syntax}
%   \tn{CJKunderanysymbol}\oarg{options}\marg{depth}\marg{symbol}\marg{text}
%   \end{syntax}
%   用法相同，只是每字宽放一个 \meta{symbol}：
%   符号在一个和一个 CJK 字符一样宽的格子里居中，
%   所以一排符号与它们上方的字符对齐。
%   \meta{depth} 是符号顶部到\emph{em 盒底部}的距离，
%   所以 |0pt| 留下的间隙正与字符两侧的边距相同；
%   字体没有 OpenType 度量时按 |.12em| 计算。
%   为了兼容，接受选项 \keys{sep}，但它没有作用，
%   因为格子固定为一个字宽。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\CJKunderanyline{\LuaCJKemdescent}
  {\color{yellow}\rule{1pt}{1em}}{中}\\
\CJKunderanysymbol{0pt}{\tiny$\triangle$}{中}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\CJKunderdot}
%   \begin{syntax}
%     \tn{CJKunderdot} \oarg{options} \marg{text}
%   \end{syntax}

% \subsection{标点}
%
% \begin{keyval}
%   \item[\keys{PunctStyle}]\val{style}: 选择一种标点样式。
%   已经实现的样式有 \texttt{quanjiao}（默认）、
%   \texttt{plain}、\texttt{banjiao}、\texttt{kaiming}、\texttt{CCT}
%   与 \texttt{hangmobanjiao}。
%   未知的名字给出警告并回退到 \texttt{plain}。
%   \item[\keys{PunctWidth}]\val{length, false}: 不管样式怎么说，
%   给每个标点同样的进距。
%   用 \cs{LuaCJKsetwidth} 为某个标点设置的宽度仍然优先。
%   \item[\keys{PunctBoundWidth}]\val{length, false}: 标点出现在行尾或行首时，
%   它的进距中有多少留在行内；
%   其余的墨迹悬挂到页边，或者悬挂到段落开头的缩进里。
%   默认悬挂标点自带的空白，所以它的墨迹正好落在版心边上；
%   断行时这一份悬挂已经算进去，行尾的标点因此能随它所在的行一起放下。
%   \texttt{false} 恢复这个默认值。
%   \item[\keys{LatinPunct}]\val{\TFF}: 把引号
%   （U+2018、U+2019、U+201C、U+201D）、间隔号（U+00B7）
%   与省略号（U+2026、U+2027、U+22EF）当作拉丁标点：
%   它们留在当前的拉丁字体里，也不被压缩。
%   这样英文单词里的撇号就不会变成一个全角形式。破折号不受影响。
%   \item[\keys{PunctFamily}]\val{family, false}: 为标点使用
%   另一个 CJK 字族。
%   该字族必须用 \cs{setCJKfamilyfont} 声明；\texttt{false}
%   （初始值）让标点重新跟随文字。
%   \item[\keys{AllowBreakBetweenPuncts}]\val{\TFF}: 两个相邻的标点是否可以
%   被断行分开。
%   破折号与省略号不在此列，一串连续的破折号或省略号由
%   \texttt{NoBreakLongPunct} 控制。
%   收尾的或中间的标点不能出现在行首、开头的标点不能出现在行尾，
%   这两条禁则不由本选项放开，所以一个收尾的引号不会被单独排在行首。
%   标点仍然会被压缩。
%   \item[\keys{PunctKinsoku}]\val{\TTF}: 是否对标点施加断行禁则。
%   收尾的或中间的标点不能出现在行首，开头的标点不能出现在行尾，
%   两个相邻的标点不会被分开，一串连续的破折号或省略号保持在一起。
%   盒子边缘的标点同样参与判断。
%   这些禁则与 \texttt{PunctStyle} 无关，
%   所以 |PunctStyle = plain| 时它们仍然有效。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
字，字\\
\LuaCJKsetup{PunctFamily = zhkai}字，字
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{LatinPunct = false}%
a’a\quad 字！字\\
\LuaCJKsetup{LatinPunct, PunctWidth = .8em}
a’a\quad 字！字
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
字字。\\
\LuaCJKsetup{PunctBoundWidth = .5em}字字。\\
（字字
\end{codemo}
\endgroup

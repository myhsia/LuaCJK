%     \l_@@_check_single_tl,    \l_@@_widow_penalty_int,
%     \l_@@_punct_width_dim,    \l_@@_punct_bound_width_dim,
%     \l_@@_break_between_puncts_bool,
%     \g_@@_autofake_bold_tl,   \g_@@_autofake_slant_tl,
%     \g_@@_embolden_factor_tl, \g_@@_slant_factor_tl,

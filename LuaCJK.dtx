% \subsection{暂停与钩子}
%
% \begin{function}{\LuaCJKdisable, \LuaCJKenable}
%   \tn{LuaCJKdisable} 停止排版调整：不再插入 \keys{CJKglue}
%   或 \keys{CJKecglue}，标点不再压缩，
%   不再添加断行禁则，标点不再悬挂，
%   数学模式里的 CJK 字符也不再处理。
%   CJK 字符仍然用 CJK 字体排出，所以文字依然可读。
%   这个开关只作用于当前分组；\tn{LuaCJKenable} 重新打开这些调整。
% \end{function}
%
% 这就是抄录类环境使用的钩子，
% 在测量原始节点列表时也用得上。
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
中 文\\
\LuaCJKdisable 中 文
\end{codemo}
\endgroup

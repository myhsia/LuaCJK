% \begin{macro}[int]{\@@_update_font:}
% \changes{v0.0.1}{2026/11/05}{Add \keys{PunctFamily}, which sets a separate
%   CJK family for the punctuation marks.}
% On every \tn{selectfont}, resolve the current family and the math
% family to font identifiers and store them in the attributes.
% \begin{variable}[int]{\l_@@_selectfont_bool, \g_@@_fontid_int}
% A guard against re-entering the update while \tn{selectfont} runs,
% and the font identifier of the current CJK family.
%    \begin{macrocode}
\bool_new:N \l_@@_selectfont_bool
\int_new:N \g_@@_fontid_int
%    \end{macrocode}
% \end{variable}
% \begin{variable}[int]
%   {
%     \l_@@_math_family_tl, \g_@@_math_fontid_int,
%     \l_@@_punct_family_tl
%   }
% The math family registered by \cs{setCJKmathfont}, the font identifier
% resolved from it, and the family chosen by \keys{PunctFamily}.
%    \begin{macrocode}
\tl_new:N \l_@@_math_family_tl
\tl_new:N \l_@@_punct_family_tl
\int_new:N \g_@@_punct_fontid_int
\int_new:N \g_@@_math_fontid_int
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_update_font:
  {
    \bool_if:NF \l_@@_selectfont_bool
      {
        \bool_set_true:N \l_@@_selectfont_bool
        \prop_get:NVNTF \g_@@_family_prop \l_@@_family_tl \l_@@_family_name_tl
          {
            \group_begin:
              \exp_args:NV \fontfamily \l_@@_family_name_tl
              \selectfont
              \int_gset:Nn \g_@@_fontid_int
                { \tex_fontid:D \tex_font:D }
            \group_end:
            \g_@@_font_attr = \g_@@_fontid_int
          }
          { \g_@@_font_attr = \c_zero_int }
        \tl_if_empty:NTF \l_@@_math_family_tl
          {
            \int_gset:Nn \g_@@_math_fontid_int
              { \int_use:N \g_@@_fontid_int }
          }
          {
            \prop_get:NVNTF \g_@@_family_prop \l_@@_math_family_tl
              \l_@@_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \fontfamily \l_@@_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_@@_math_fontid_int
                    { \tex_fontid:D \tex_font:D }
                \group_end:
              }
              { \int_gzero:N \g_@@_math_fontid_int }
          }
        \@@_push_block_fonts:
        \g_@@_math_font_attr = \g_@@_math_fontid_int
        \tl_if_empty:NTF \l_@@_punct_family_tl
          { \g_@@_punct_font_attr = \c_zero_int }
          {
            \prop_get:NVNTF \g_@@_family_prop \l_@@_punct_family_tl
              \l_@@_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \fontfamily \l_@@_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_@@_punct_fontid_int
                    { \tex_fontid:D \tex_font:D }
                \group_end:
                \g_@@_punct_font_attr = \g_@@_punct_fontid_int
              }
              { \g_@@_punct_font_attr = \c_zero_int }
          }
        \bool_set_false:N \l_@@_selectfont_bool
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_push_block_fonts:}
% Resolve the block fonts of the current family at the current size
% and hand them to Lua, keyed by the font identifier of the family.
% Font identifiers depend on the size,
% so this runs again whenever a font is selected.
%    \begin{macrocode}
\int_new:N \g_@@_block_fontid_int
\cs_new_protected:Npn \@@_push_block_fonts:
  {
    \int_compare:nNnT { \g_@@_fontid_int } > { 0 }
      {
        \clist_map_inline:Nn \g_@@_block_names_clist
          {
            \tl_set:Ne \l_@@_block_key_tl { \l_@@_family_tl | ##1 }
            \int_gzero:N \g_@@_block_fontid_int
            \prop_get:NVNT \g_@@_family_block_prop
              \l_@@_block_key_tl \l_@@_tmpa_tl
              {
                \group_begin:
                  \exp_args:NV \fontfamily \l_@@_tmpa_tl
                  \selectfont
                  \int_gset:Nn \g_@@_block_fontid_int
                    { \tex_fontid:D \tex_font:D }
                \group_end:
              }
            \lua_now:e
              {
                LuaCJK.set_block_font
                  ( \int_use:N \g_@@_fontid_int ,
                    "\lua_escape:e {##1}" ,
                    \int_use:N \g_@@_block_fontid_int )
              }
          }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% The glues and the settings belong to the size that is being selected,
% but \cs{baselineskip} has not changed yet when the \texttt{selectfont}
% hook runs, so they are refreshed after the font selection.
% The guard keeps the temporary font selections inside \cs{@@_update_font:}
% from doing the same twice.
%    \begin{macrocode}
\hook_gput_code:nnn { selectfont } { LuaCJK } { \@@_update_font: }
\hook_gput_code:nnn { cmd / selectfont / after } { LuaCJK }
  {
    \bool_if:NF \l_@@_selectfont_bool
      {
        \@@_refresh_glues:
        \@@_settings_push:
      }
  }
%    \end{macrocode}

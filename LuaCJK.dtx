%
% \begin{macro}[int]{\@@_settings_push:}
% \changes{v0.0.1}{2026/11/05}{Every setting now travels with the characters:
%   a snapshot of the options is stored once and recorded on the glyphs, so a
%   group that ends before the paragraph does still decides how its own text
%   is set. This covers \keys{CJKglue}, \keys{CJKecglue}, \keys{PunctStyle},
%   \keys{PunctKinsoku}, \keys{LatinPunct}, \keys{CJKmath}, \keys{PunctWidth},
%   \keys{PunctBoundWidth}, \keys{CheckSingle}, \keys{WidowPenalty}, and
%   \keys{AllowBreakBetweenPuncts}.}
% \changes{v0.0.1}{2026/11/05}{\keys{AutoFallBack} and the canceled sub-blocks
%   follow the group now. Both are part of the settings snapshot, so
%   |{\LuaCJKsetup{AutoFallBack=true} ...}| and
%   |{\LuaCJKCancelSubCJKBlock{...} ...}| end with their group.}
% Hand the current options to Lua,
% which stores them once and selects the stored copy with an attribute.
% Called after \cs{LuaCJKsetup} and after every font selection,
% because the default glues and the size-dependent distances have
% to be recomputed for the new size. The attribute is what makes a group
% that ends before the paragraph still decide how its own text is set.
%    \begin{macrocode}
\cs_new:Npn \@@_bool_js:N #1
  { \str_if_eq:VnTF #1 { 1 } { true } { false } }
\cs_new_protected:Npn \@@_settings_push:
  {
    \bool_if:NT \g_@@_lua_loaded_bool
      {
        \lua_now:e
          {
            LuaCJK.new_settings
              (
                "\lua_escape:e { \l_@@_punct_style_tl }" ,
                \@@_bool_js:N \l_@@_punct_kinsoku_tl ,
                \@@_bool_js:N \l_@@_cj_strict_tl ,
                \@@_bool_js:N \l_@@_latin_punct_tl ,
                \@@_bool_js:N \l_@@_cjk_math_tl ,
                \dim_to_decimal_in_sp:n { \l_@@_punct_width_dim } ,
                \dim_to_decimal_in_sp:n { \l_@@_punct_bound_width_dim } ,
                \@@_bool_js:N \l_@@_check_single_tl ,
                \int_use:N \l_@@_widow_penalty_int ,
                \bool_if:NTF \l_@@_break_between_puncts_bool
                  { true } { false } ,
                \bool_if:NTF \l_@@_auto_fallback_bool
                  { true } { false } ,
                "\lua_escape:e { \l_@@_blocks_off_clist }"
              )
          }
      }
  }
%    \end{macrocode}

% \begin{macro}{\CJKunderanyline}
% \changes{v0.0.1}{2026/11/11}{Provide \cs{CJKunderanyline} and
%   \cs{CJKunderanysymbol} for arbitrary rules and repeated symbols;
%   \cs{CJKunderanysymbol} puts one symbol per em, centered in the cell, its
%   depth measured from the baseline to the top of the symbol.}
% Underline with an arbitrary object: the object is put in a box,
% lowered by \meta{depth}, and repeated by \tn{leaders}.
% The underline type is cached by the object, the depth, and the color,
% so repeating a command with the same arguments costs nothing.
% \begin{variable}[int]{\l_@@_fntef_any_code_tl, \l_@@_fntef_any_depth_dim}
% The leader code being built and its depth.
%    \begin{macrocode}
\tl_new:N \l_@@_fntef_any_code_tl
\dim_new:N \l_@@_fntef_any_depth_dim
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\NewDocumentCommand \CJKunderanyline { m m +m }
  {
    \group_begin:
      \@@_fntef_decoration_setup:n { }

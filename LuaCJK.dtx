% \begin{macro}
%   {\setCJKmainfont, \setCJKsansfont, \setCJKmonofont, \setCJKfamilyfont}
% \changes{v0.0.1}{2026/11/05}{Provide the CJK font family interface
%   (\cs{setCJKmainfont}, \cs{setCJKsansfont}, \cs{setCJKmonofont},
%   \cs{setCJKfamilyfont}, \cs{CJKfamily}, \cs{newCJKfontfamily},
%   \cs{CJKfontspec}).}
% The public font commands, all built on
% \cs{@@_set_family_with_options:nnnn}.
%    \begin{macrocode}
\NewDocumentCommand \setCJKmainfont { o m o }
  {
    \exp_args:NV \@@_set_family_with_options:nnnn
      \CJKrmdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKsansfont { o m o }
  {
    \exp_args:NV \@@_set_family_with_options:nnnn
      \CJKsfdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKmonofont { o m o }
  {
    \exp_args:NV \@@_set_family_with_options:nnnn
      \CJKttdefault {#1} {#2} {#3}
  }
\NewDocumentCommand \setCJKfamilyfont { m o m o }
  { \@@_set_family_with_options:nnnn {#1} {#2} {#3} {#4} }
\NewDocumentCommand \setCJKfallbackfamilyfont { m o m o }
  {
    \tl_set:Ne \l_@@_fallback_key_tl {#1}
    \tl_if_novalue:nTF {#2}
      {
        \tl_if_novalue:nTF {#4}
          { \@@_add_fallback:nn { } {#3} }
          { \@@_add_fallback:nn {#4} {#3} }
      }
      { \@@_add_fallback:nn {#2} {#3} }
  }
%    \end{macrocode}
% \begin{macro}[int]{\@@_set_family_with_options:nnnn}
% Accept the options before or after the font name.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_set_family_with_options:nnnn #1#2#3#4
  {
    \tl_if_novalue:nTF {#2}
      {
        \tl_if_novalue:nTF {#4}
          { \@@_set_family_with_options_aux:nnn {#1} { } {#3} }
          { \@@_set_family_with_options_aux:nnn {#1} {#4} {#3} }
      }
      { \@@_set_family_with_options_aux:nnn {#1} {#2} {#3} }
  }
\cs_generate_variant:Nn \@@_set_family:nnn { nVn }
\cs_new_protected:Npn \@@_set_family_with_options_aux:nnn #1#2#3
  {
    \@@_extract_blocks:nn {#1} {#2}
    \@@_set_family:nVn {#1} \l_@@_features_tl {#3}
  }
%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{\@@_add_fallback:nn}
% \changes{v0.0.1}{2026/11/05}{Add \cs{setCJKfallbackfamilyfont} and
%   \keys{AutoFallBack} for characters that the selected CJK font does not
%   have.}
% Register one fallback font for a CJK family,
% keeping the order in which the fonts were declared.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_add_fallback:nn #1#2
  {
    \group_begin:
      \fontspec_gset_family:Nnn \l_@@_fallback_family_tl {#1} {#2}
      \prop_get:NVNF \g_@@_fallback_prop

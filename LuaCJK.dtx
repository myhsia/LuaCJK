% \begin{macro}{\normalspacedchars}
% \changes{v0.0.1}{2026/11/05}{Add \cs{normalspacedchars} so that slashes,
%   backslashes, and hyphens take no glue on either side.}
% The characters in the list get no glue on either side, which is what
% one wants for slashes, backslashes, and hyphens inside Latin text.
% The list is kept on the Lua side as a set of code points,
% so the setting is global: a group does not restore the previous list.
% \begin{variable}[int]{\g_@@_normal_spaced_chars_tl}
% The list, initially \texttt{/}, \texttt{\c_backslash_str},
% and \texttt{-}.
%    \begin{macrocode}
\tl_new:N \g_@@_normal_spaced_chars_tl
\tl_gset:Nn \g_@@_normal_spaced_chars_tl
  { / , \c_backslash_str , - }
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_set_normal_spaced_chars:
  {
    \lua_now:e
      {
        LuaCJK.set_normal_spaced_chars
          ( "\lua_escape:e { \g_@@_normal_spaced_chars_tl } " )
      }
  }
\NewDocumentCommand \normalspacedchars { m }
  {
    \tl_gset:Nn \g_@@_normal_spaced_chars_tl {#1}
    \@@_set_normal_spaced_chars:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_ignore_format_chars:}
% \changes{v0.0.1}{2026/11/05}{Ignore the zero-width format characters
%   (U+200B, U+200C, U+200D, U+2060, U+180E) and the variation selectors at
%   the input, so that they neither take glue nor separate two CJK characters.}
% These characters have no advance of their own, but the font loader replaces
% one that the font does not have by a space glyph and a negative kern.
% The spacing pass then sees a Latin atom and surrounds it with
% \keys{CJKecglue} on both sides, so a zero-width space would widen the line
% by two \keys{CJKecglue} and remove the break opportunity it was meant to
% create.
% Giving the characters category 9 removes them before the font loader runs.
% A character produced by \tn{char} bypasses the category codes and is left
% alone: \tn{char} asks for the glyph itself, not for the character's
% typographic role.
%    \begin{macrocode}
\clist_const:Nn \c_@@_ignored_chars_clist
  { "180E , "200B , "200C , "200D , "2060 , "FEFF }
\cs_new_protected:Npn \@@_ignore_format_chars:
  {
    \clist_map_inline:Nn \c_@@_ignored_chars_clist
      { \char_set_catcode_ignore:n {##1} }
    \int_step_inline:nnn { "FE00 } { "FE0F }
      { \char_set_catcode_ignore:n {##1} }
    \int_step_inline:nnn { "E0100 } { "E01EF }
      { \char_set_catcode_ignore:n {##1} }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_load_cj:}
% Read the \texttt{CJ} set from \file{LineBreak.txt} once.
% The key \keys{CJLineBreak} calls this when it selects \texttt{strict};
% a second call is cheap because the Lua side remembers that it has read
% the file.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_load_cj:
  { \lua_now:e { LuaCJK.load_cj() } }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_load_local_config:}
% \changes{v0.0.1}{2026/11/05}{Add the \keys{LocalConfig} option, which reads
%   \file{luacjk.cfg} or \file{luacjk-<name>.cfg} at the end of the package.}
% Load the file chosen by the \keys{LocalConfig} option.
% The key is read while the package is being loaded, but the file is only input
% at the end, so that it can use everything LuaCJK defines.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_load_local_config:
  {
    \tl_if_empty:NF \l_@@_local_config_tl
      {
        \exp_args:NV \@@_load_config_file:n \l_@@_local_config_tl
      }
  }
\cs_new_protected:Npn \@@_load_config_file:n #1
  {
    \file_if_exist:nTF {#1}
      { \file_input:n {#1} }
      { \msg_warning:nnn { LuaCJK } { config-missing } {#1} }
  }
\msg_new:nnn { LuaCJK } { config-missing }
  { The~configuration~file~`#1'~was~not~found. }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_load_fandol:}
% \changes{v0.0.1}{2026/11/05}{Add the \keys{LoadFandol} option, which supplies
%   Fandol fonts when the document declares none.}
% When the \keys{LoadFandol} option is on and the document
% did not declare any CJK font, fall back to the four Fandol faces.
% This runs at \tn{begin}\{document\} so that a family declared anywhere
% in the preamble still wins.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_load_fandol:
  {
    \setCJKmainfont{FandolSong-Regular.otf}
      [ BoldFont = FandolSong-Bold.otf ]
    \setCJKsansfont{FandolHei-Regular.otf}
      [ BoldFont = FandolHei-Bold.otf ]
    \setCJKmonofont{FandolFang-Regular.otf}
    \setCJKfamilyfont{zhsong}{FandolSong-Regular.otf}
      [ BoldFont = FandolSong-Bold.otf ]
    \setCJKfamilyfont{zhhei}{FandolHei-Regular.otf}
      [ BoldFont = FandolHei-Bold.otf ]
    \setCJKfamilyfont{zhkai}{FandolKai-Regular.otf}
    \setCJKfamilyfont{zhfs}{FandolFang-Regular.otf}
  }
%    \end{macrocode}
% \end{macro}
%
% \pkg{ctex} picks its own engine file by name, so LuaCJK cannot install
% a file of that name without colliding with \pkg{ctex} itself. The
% redirect therefore lives in a \file{ctexopts.cfg} that \pkg{ctex} inputs
% after it has fixed the engine file name and before it inputs that file.
%
% \begin{macro}{\LuaCJKwriteCtexConfig}
% \changes{v0.0.1}{2026/11/05}{Add \cs{LuaCJKwriteCtexConfig}, which writes a
%   \file{ctexopts.cfg} redirect into the document directory. \pkg{ctex}
%   inputs that file after it has fixed the engine file name and before it
%   loads the engine file, so the redirect takes effect in the same run;
%   \file{ctexbackend.cfg} is read too early and \file{ctex.cfg} too late.}
% Write such a file. Without a star an existing file is left alone,
% so that a hand-written configuration is not lost; the star overwrites it.
% The optional argument is a directory to write into.
%
% The file is written in plain \LaTeXe\ without any comment character,
% so that it works whatever the category codes
% and the state of \pkg{expl3} are when \pkg{ctex} inputs it.
% The existence check names the directory explicitly, because a plain
% name would also match the file that \pkg{ctex} installs.
% \begin{variable}[int]
%   {
%     \l_@@_ctex_config_iow, \l_@@_ctex_config_path_tl,
%     \c_@@_ctex_engine_file_tl
%   }
% The stream, the target path, and the name of the engine file.
%    \begin{macrocode}
\iow_new:N \l_@@_ctex_config_iow
\tl_new:N \l_@@_ctex_config_path_tl
\tl_const:Nn \c_@@_ctex_engine_file_tl { ctex-engine-luacjk.def }
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\msg_new:nnn { LuaCJK } { ctex-config-exists }
  {
    `ctexopts.cfg'~already~exists~and~is~left~alone.\\
    Use~\token_to_str:N \LuaCJKwriteCtexConfig*~to~overwrite~it.
  }
\cs_new_protected:Npn \@@_ctex_config_copy:
  {
    \iow_open:NV \l_@@_ctex_config_iow
      \l_@@_ctex_config_path_tl
    \iow_now:Nx \l_@@_ctex_config_iow
      {
        \token_to_str:N \ProvidesFile { ctexopts.cfg }
        [ \ExplFileDate \c_space_tl v \ExplFileVersion \c_space_tl
          Redirect~ctex~to~the~LuaTeX~backend~of~LuaCJK ]
      }
    \iow_now:Nx \l_@@_ctex_config_iow
      { \token_to_str:N \makeatletter }
    \iow_now:Nx \l_@@_ctex_config_iow
      {
        \token_to_str:N \@ifundefined { directlua } { }
          {
            \token_to_str:N \@ifundefined { c__ctex_engine_file_str } { }
              {
                \token_to_str:N \expandafter
                \token_to_str:N \def
                \token_to_str:N \cs:w \c_space_tl c__ctex_engine_file_str
                \token_to_str:N \cs_end:
                { \exp_not:V \c_@@_ctex_engine_file_tl }
              }
          }
      }
    \iow_now:Nx \l_@@_ctex_config_iow
      { \token_to_str:N \makeatother }
    \iow_close:N \l_@@_ctex_config_iow
    \iow_term:x
      { LuaCJK:~wrote~\l_@@_ctex_config_path_tl }
  }
\NewDocumentCommand \LuaCJKwriteCtexConfig { s O{.} }
  {
    \tl_set:Nx \l_@@_ctex_config_path_tl { #2 / ctexopts.cfg }
    \file_if_exist:nTF { \l_@@_ctex_config_path_tl }
      {
        \IfBooleanTF {#1}
          { \@@_ctex_config_copy: }
          { \msg_warning:nn { LuaCJK } { ctex-config-exists } }
      }
      { \@@_ctex_config_copy: }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_check_ctex_redirect:}
% When LuaCJK was reached through its own engine file, the redirect must
% already have been read; otherwise \pkg{ctex} could only have found the
% file because something else put it in the search path. Say so once,
% so that a stale or missing \file{ctexopts.cfg} does not stay silent.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_check_ctex_redirect:
  {
    \cs_if_exist:NT \@@_from_ctex_engine:
      {
        \file_if_exist:nF { ./ ctexopts.cfg }
          { \msg_note:nn { LuaCJK } { ctex-config-missing } }
      }
  }
\msg_new:nnn { LuaCJK } { ctex-config-missing }
  {
    LuaCJK~was~reached~through~its~ctex~engine~file,~but~no~
    `ctexopts.cfg'~was~found~in~the~current~directory.\\
    Keep~that~file~next~to~the~document,~or~create~it~with~
    \token_to_str:N \LuaCJKwriteCtexConfig.
  }
%    \end{macrocode}
% \end{macro}
%
% \subsection{The Lua module}
%
% The Lua module reads the attribute numbers and installs its callbacks.
% The current font is resolved once the document starts.
% \changes{v0.0.1}{2026/11/05}{Use the public LaTeX3 Lua interfaces
%   (\cs{lua_now:e}, \cs{lua_escape:e}, \cs{lua_load_module:n}) instead of
%   \cs{directlua} and \texttt{kpse.findfile}.}
%    \begin{macrocode}
\lua_load_module:n { LuaCJK }
\lua_now:e
  {
    LuaCJK.attr_font        =  \int_use:N   \c_@@_font_attr_int ;
    LuaCJK.attr_cjk_space   =  \int_use:N   \c_@@_cjk_space_attr_int ;
    LuaCJK.attr_xecglue     =  \int_use:N   \c_@@_xecglue_attr_int ;
    LuaCJK.attr_inserted    =  \int_use:N   \c_@@_inserted_attr_int ;
    LuaCJK.attr_math_font   =  \int_use:N   \c_@@_math_font_attr_int ;
    LuaCJK.attr_punct_font  =  \int_use:N   \c_@@_punct_font_attr_int ;

% \begin{macro}[int]{\@@_fntef_formatted_underline:}
% \changes{v0.0.1}{2026/11/05}{The underline geometry now uses
%   \texttt{depth=0.2em} and \texttt{thickness=0.4pt} on every path, so
%   \keys{format} works without also giving \keys{thickness} or \keys{depth}.
%   \keys{top} and \keys{bottom} still override the computed values.}
% A colored rule needs its own underline type: \pkg{luacolor} colors
% by attribute, while \tn{color} would emit whatsits in front
% of \tn{leaders}. The type is cached by color and geometry,
% so a document builds one type per distinct combination.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_formatted_underline:
  {
    \tl_set:Ne \l_@@_fntef_cache_key_tl
      {
        \l_@@_fntef_format_tl
        | \dim_use:N \l_@@_fntef_rule_height_dim
        | \dim_use:N \l_@@_fntef_rule_depth_dim
      }
    \luaul_set_color:n { \l_@@_fntef_format_tl }
    \prop_get:NVNF \g_@@_fntef_format_prop
      \l_@@_fntef_cache_key_tl \l_@@_fntef_cache_name_tl
      {
        \int_gincr:N \g_@@_fntef_format_int
        \tl_set:Ne \l_@@_fntef_cache_name_tl
          { LuaCJKfntef / ul / \int_use:N \g_@@_fntef_format_int }
        \exp_args:Nc \newunderlinetype { \l_@@_fntef_cache_name_tl }
          [ \dim_to_decimal_in_sp:n { 1ex } @ \luaul_context_color: ]
          {
            \luaul_apply_color:
            \tex_leaders:D \tex_vrule:D
              height \l_@@_fntef_rule_height_dim
              depth \l_@@_fntef_rule_depth_dim
          }
        \prop_gput:NVV \g_@@_fntef_format_prop
          \l_@@_fntef_cache_key_tl \l_@@_fntef_cache_name_tl
      }
    \use:c { \l_@@_fntef_cache_name_tl }
  }
%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_underLine:nn #1#2
  { \underLine [ #1 ] { #2 } }
\NewDocumentCommand \CJKunderline { s t- o +m }
  {
    \group_begin:
      \@@_fntef_prepare_underline:n {#3}
      \l_@@_fntef_textformat_tl

        {
          \exp_args:NV \@@_fntef_underLine:nn
            \l_@@_fntef_pass_tl { \@@_fntef_hide:n {#4} }
        }
        { \@@_fntef_formatted_underline: { \@@_fntef_hide:n {#4} } }
    \group_end:
  }
%    \end{macrocode}
% \end{macro}

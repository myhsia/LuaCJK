% \subsection{Font effects}
%
% The \pkg*{LuaCJKfntef} package is a thin layer over \pkg{lua-ul}, which
% provides the underlining engine.  It is generated from this file and may be
% loaded on its own; it loads LuaCJK first.
%    \begin{macrocode}
%<*fntef>
\sys_if_engine_luatex:F
  {
    \msg_new:nnn { LuaCJKfntef } { engine }
      { LuaCJKfntef~requires~LuaTeX. }
    \msg_critical:nn { LuaCJKfntef } { engine }
    \tex_endinput:D
  }
\RequirePackage { LuaCJK }
\RequirePackage { lua-ul }
%    \end{macrocode}
%
% \begin{macro}{\CJKunderline}
%   Underline the argument; the optional argument is passed to
%   \pkg{lua-ul}.
%    \begin{macrocode}
\NewDocumentCommand \CJKunderline { s t- o +m }
  {
    \IfValueTF {#3}
      { \underLine [ #3 ] { #4 } }
      { \underLine { #4 } }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\CJKsout}
%   Strike through the argument.
%    \begin{macrocode}
\NewDocumentCommand \CJKsout { s t- o +m }
  {
    \IfValueTF {#3}
      { \strikeThrough [ #3 ] { #4 } }
      { \strikeThrough { #4 } }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\CJKunderdot}
%   Emphasise with dots below the glyphs.  The optional argument of
%   \pkg{xeCJK} is not implemented, so it only raises a warning.
%    \begin{macrocode}
\NewDocumentCommand \CJKunderdot { s t- o +m }
  {
    \IfValueT {#3}
      {
        \msg_warning:nn { LuaCJKfntef } { no-options }
      }
    \LuaCJKfntef_underdot:n { #4 }
  }
\msg_new:nnn { LuaCJKfntef } { no-options }
  { The~optional~argument~of~`\token_to_str:N \CJKunderdot'~is~ignored. }
%    \end{macrocode}
%   \begin{macro}[internal]{\LuaCJKfntef_underdot:n}
%     Apply the dot pattern inside a group.
%     \begin{variable}[internal]
%       {\l_LuaCJKfntef_dot_dim, \l_LuaCJKfntef_dot_gap_dim,
%        \l_LuaCJKfntef_dot_raise_dim, \l_LuaCJKfntef_dots_box}
%       The size of one dot, the space on both sides of it, the amount it is
%       lowered, and the box holding one repeating unit of the pattern.
%      \begin{macrocode}
\dim_new:N \l_LuaCJKfntef_dot_dim
\dim_set:Nn \l_LuaCJKfntef_dot_dim { .06em }
\dim_new:N \l_LuaCJKfntef_dot_gap_dim
\dim_set:Nn \l_LuaCJKfntef_dot_gap_dim { .12em }
\dim_new:N \l_LuaCJKfntef_dot_raise_dim
\dim_set:Nn \l_LuaCJKfntef_dot_raise_dim { -.40em }
\box_new:N \l_LuaCJKfntef_dots_box
\hbox_set:Nn \l_LuaCJKfntef_dots_box
  {
    \skip_horizontal:n { \l_LuaCJKfntef_dot_gap_dim }
    \raise \l_LuaCJKfntef_dot_raise_dim \tex_hbox:D
      {
        \vrule width \l_LuaCJKfntef_dot_dim
               height \l_LuaCJKfntef_dot_dim
               depth \c_zero_dim
      }
    \skip_horizontal:n { \l_LuaCJKfntef_dot_gap_dim }
  }
%    \end{macrocode}
%     \end{variable}
%     \begin{macro}[internal]{\LuaCJKfntef_dots}
%       The underline type that repeats the dot box.
%      \begin{macrocode}
\newunderlinetype \LuaCJKfntef_dots
  { \leaders \box_use_drop:N \l_LuaCJKfntef_dots_box }
%    \end{macrocode}
%     \end{macro}
%     \begin{macrocode}
\cs_new_protected:Npn \LuaCJKfntef_underdot:n #1
  {
    \group_begin:
      \LuaCJKfntef_dots
      #1
    \group_end:
  }
%</fntef>
%    \end{macrocode}
%   \end{macro}
% \end{macro}

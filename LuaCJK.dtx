% upwards, so the numbers start at 240; a document with more than sixteen CJK
% families is out of luck and gets an error.
%    \begin{macrocode}
\int_new:N \g_@@_math_family_int
\int_gset:Nn \g_@@_math_family_int { 239 }
\int_const:Nn \c_@@_math_family_max_int { 255 }
\prop_new:N \g_@@_math_family_prop

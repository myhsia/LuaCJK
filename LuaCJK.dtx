%   font selection; the state is recorded per node.}
% Set the node attribute that makes the Lua callbacks skip
% the adjustments. The attribute follows the \TeX\ grouping.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKdisable { }
  { \g_@@_disabled_attr = 1 }
\NewDocumentCommand \LuaCJKenable { }
  { \g_@@_disabled_attr = 0 }

% \begin{macro}{\CJKunderwave}
% A wave drawn with \pkg{l3draw}, one period per half em, repeated
% by \tn{leaders}. The drawing is kept as code rather than as a box,
% so the |em| units are resolved when the decoration is used
% and the pattern follows the current font size.
%
% The period is forced to exactly half an em by \tn{hbox}| to .5em|.
% \pkg{l3draw} sizes its box by the bounding box of the stroked path,
% which is a full stroke width wider than the path; repeating that box would
% leave a gap of one stroke width between two periods.
% The two \tn{hss} absorb the excess symmetrically, so the ink fills
% the period exactly and no overfull box is reported. The stroke
% is set to |.04em|, which is \texttt{0.4pt} at 10pt, so the pattern keeps
% its look from the previous release while it scales with the font size.
% \begin{variable}[int]{\l_@@_fntef_pattern_box}
% A scratch box for the drawn patterns.
% Each pattern is built here and then has its height and depth set to zero:
% the ink is a PDF literal, so only the reported dimensions change,
% and a decoration never opens up the line it sits on.
%    \begin{macrocode}
\box_new:N \l_@@_fntef_pattern_box
\dim_new:N \l_@@_fntef_symbol_kern_dim
\dim_new:N \l_@@_fntef_symbol_raise_dim
\dim_new:N \l_@@_fntef_em_descent_dim
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\newunderlinetype \@@_fntef_wave
  {
    \tex_leaders:D \hbox_to_wd:nn { .5em }
      {
        \tex_hss:D
        \hbox_set:Nn \l_@@_fntef_pattern_box
          {
            \box_move_up:nn { -.42em }
              {
                \hbox:n
                  {
                    \draw_begin:
                      \draw_set_linewidth:n { .04em }
                      \draw_path_moveto:n { 0em , 0em }
                      \draw_path_curveto:nnn { .0625em , .16em }
                        { .1875em , .16em } { .25em , 0em }
                      \draw_path_curveto:nnn { .3125em , -.16em }
                        { .4375em , -.16em } { .5em , 0em }
                      \draw_path_use_clear:n { stroke }
                    \draw_end:
                  }
              }
          }
        \box_set_ht:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
        \box_set_dp:Nn  \l_@@_fntef_pattern_box { \c_zero_dim }
        \box_use_drop:N \l_@@_fntef_pattern_box
        \tex_hss:D
      }
  }
\cs_new_protected:Npn \@@_fntef_silent_begin:
  {
    \bool_if:NT \l_@@_fntef_silent_bool
      {
        \tex_pdfextension:D literal direct
          { /Span <</ActualText <FEFF200B>>> BDC }
      }
  }
\cs_new_protected:Npn \@@_fntef_silent_end:
  {
    \bool_if:NT \l_@@_fntef_silent_bool
      { \tex_pdfextension:D literal direct { EMC } }
  }
\cs_new_protected:Npn \@@_fntef_use_symbol:n #1
  {
    \dim_set:Nn \l_@@_fntef_any_depth_dim {#1}
    \dim_set:Nn \l_@@_fntef_em_descent_dim
      {
        \lua_now:e
          {
            tex.print(LuaCJKfntef.em_descent
              ( \int_use:N \tex_attribute:D \c_@@_font_attr_int ))
          }
        sp
      }
    \tl_set:Ne \l_@@_fntef_any_code_tl
      {
        \exp_not:N \tex_leaders:D \exp_not:N \hbox:n
          {
            \exp_not:N \hbox_set:Nn \exp_not:N \l_@@_fntef_pattern_box
              { \exp_not:V \l_@@_fntef_symbol_tl }
            \exp_not:N \dim_set:Nn \exp_not:N \l_@@_fntef_symbol_kern_dim
              {
                \exp_not:N \dim_eval:n
                  {
                    ( 1em
                      - \exp_not:N \box_wd:N \l_@@_fntef_pattern_box ) / 2
                  }
              }
            \exp_not:N \dim_set:Nn \exp_not:N \l_@@_fntef_symbol_raise_dim
              {
                \exp_not:N \dim_eval:n
                  {
                    - \dim_use:N \l_@@_fntef_em_descent_dim
                    - \exp_not:N \l_@@_fntef_any_depth_dim
                    - \exp_not:N \box_ht:N \l_@@_fntef_pattern_box
                  }
              }
            \exp_not:N \box_set_ht:Nn \exp_not:N \l_@@_fntef_pattern_box
              { \exp_not:N \c_zero_dim }
            \exp_not:N \box_set_dp:Nn \exp_not:N \l_@@_fntef_pattern_box
              { \exp_not:N \c_zero_dim }
            \exp_not:N \skip_horizontal:n
              { \exp_not:N \l_@@_fntef_symbol_kern_dim }
            \exp_not:N \@@_fntef_silent_begin:
            \exp_not:N \box_move_up:nn
              { \exp_not:N \l_@@_fntef_symbol_raise_dim }
              { \exp_not:N \box_use_drop:N \l_@@_fntef_pattern_box }
            \exp_not:N \@@_fntef_silent_end:
            \exp_not:N \skip_horizontal:n
              { \exp_not:N \l_@@_fntef_symbol_kern_dim }
          }
      }
    \tl_set:Ne \l_@@_fntef_cache_key_tl
      {
        symbol |
        \dim_use:N \l_@@_fntef_em_descent_dim |
        \dim_use:N \l_@@_fntef_any_depth_dim |
        \bool_if:NTF \l_@@_fntef_silent_bool { silent } { text } |
        \tl_to_str:V \l_@@_fntef_symbol_tl
      }
    \exp_args:NV \@@_fntef_use_leader_type:nn
      \l_@@_fntef_cache_key_tl \l_@@_fntef_any_code_tl
  }
\NewDocumentCommand \CJKunderwave { s t- o +m }
  {
    \group_begin:
      \@@_fntef_decoration_setup:n {#3}
      \tl_if_empty:NTF \l_@@_fntef_symbol_tl
        { \@@_fntef_wave } { \@@_fntef_use_symbol:n { .42em } }
      \@@_fntef_body:n {#4}
    \group_end:
  }
%    \end{macrocode}
% \end{macro}

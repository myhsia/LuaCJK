% \begin{macro}[int]{\@@_verbatim@font_hook:}
% \changes{v0.0.1}{2026/11/05}{Add the \keys{Verb} option (\texttt{true},
%   \texttt{env}, \texttt{env+}, \texttt{false}) to control what happens
%   inside \cs{verb} and the verbatim-like environments.}
% Verbatim-like material must usually be left alone.
% \tn{verb} opens its own group and selects \tn{verbatim@font} inside
% it, so extending that command covers \tn{verb} on its own.
% The hook consults the current \keys{Verb} setting, so that
% \cs{LuaCJKsetup} can change the behavior after the package is loaded.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_verbatim@font_hook:
  {
    \tl_if_eq:VnTF \l_@@_verb_mode_tl { true }
      { \LuaCJKdisable }
      {
        \tl_if_eq:VnT \l_@@_verb_mode_tl { env }
          { \LuaCJKdisable }
      }
  }
\cs_if_exist:NT \verbatim@font
  {
    \cs_gset_protected:Npx \verbatim@font
      {
        \exp_not:o { \verbatim@font }
        \exp_not:N \@@_verbatim@font_hook:
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_verbatim_env_begin:, \@@_verbatim_env_end:}
% \changes{v0.0.1}{2026/11/05}{Suspend the adjustments automatically in
%   \cs{verb}, \env{verbatim}, \pkg{fancyvrb} and \pkg{listings} environments;
%   \cs{LuaCJKdisable} now records its state per node.}
% Environments that do not go through \tn{verbatim@font} need their own
% hooks. Only the \texttt{true} setting suspends the adjustments here:
% \texttt{env} and \texttt{env+} keep them, which is what keeps code
% columns aligned when CJK text is used inside the code.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_verbatim_env_begin:
  {
    \tl_if_eq:VnT \l_@@_verb_mode_tl { true }
      { \LuaCJKdisable }
  }
\cs_new_protected:Npn \@@_verbatim_env_end:
  {
    \tl_if_eq:VnT \l_@@_verb_mode_tl { true }
      { \LuaCJKenable }
  }
\clist_map_inline:nn
  {
    verbatim , verbatim* , Verbatim , Verbatim* ,
    BVerbatim , LVerbatim , lstlisting
  }
  {
    \hook_gput_code:nnn { env / #1 / begin } { LuaCJK }
      { \@@_verbatim_env_begin: }
    \hook_gput_code:nnn { env / #1 / end   } { LuaCJK }
      { \@@_verbatim_env_end: }
  }
%    \end{macrocode}
% \end{macro}

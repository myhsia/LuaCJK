% \begin{macro}[int]{\@@_ignore_format_chars:}
% \changes{v0.0.1}{2026/11/11}{Ignore the zero-width format characters
%   (U+200B, U+200C, U+200D, U+2060, U+180E) and the variation selectors at
%   the input, so that they neither take glue nor separate two CJK characters.}
% These characters have no advance of their own, but the font loader replaces
% one that the font does not have by a space glyph and a negative kern.
% The spacing pass then sees a Latin atom and surrounds it with
% \keys{CJKecglue} on both sides, so a zero-width space would widen the line
% by two \keys{CJKecglue} and remove the break opportunity it was meant to
% create.
% Giving the characters category 9 removes them before the font loader runs.
% A character produced by \tn{char} bypasses the category codes and is left
% alone: \tn{char} asks for the glyph itself, not for the character's
% typographic role.
%    \begin{macrocode}
\clist_const:Nn \c_@@_ignored_chars_clist
  { "180E , "200B , "200C , "200D , "2060 , "FEFF }
\cs_new_protected:Npn \@@_ignore_format_chars:
  {
    \clist_map_inline:Nn \c_@@_ignored_chars_clist
      { \char_set_catcode_ignore:n {##1} }
    \int_step_inline:nnn { "FE00 } { "FE0F }
      { \char_set_catcode_ignore:n {##1} }
    \int_step_inline:nnn { "E0100 } { "E01EF }
      { \char_set_catcode_ignore:n {##1} }
  }
%    \end{macrocode}
% \end{macro}

% \begin{macro}[int]{\@@_fntef_use_leader_type:nn}
% Build the underline type of a decoration that is made of \tn{leaders},
% which repeats one rule or one symbol along the decorated text, and use it.
% A type is built once per leader code and color and then reused, so a
% document pays for each combination of geometry and color only once.
%
% The type keeps the color that was in force when it was built:
% \pkg{luacolor} colors a rule by attribute, and \pkg{lua-ul} puts the
% attributes of the built box on every leader it inserts.
% A type cached by the geometry alone would therefore keep the color of the
% first call, so the color is part of the key: \keys{format} when it is
% given, and otherwise the value of \pkg{luacolor}'s attribute, which is the
% color of the surrounding text. A requested color is also applied inside
% the box, so that it holds wherever the leader is placed.
%
% The name of the type already carries a counter, so the context that
% \pkg{lua-ul} puts in the name of the type it defines is a constant: one
% that expands again when the type is used would rebuild the type with
% whatever color happened to be current then.
%
% A drawn pattern takes its color another way.
% Its ink comes from \pkg{l3draw}, which strokes with the color that
% \pkg{l3color} holds, so \pkg{luacolor}'s attribute never reaches it;
% an attribute on a leader box that holds a drawing only leaks, because
% \pkg{luacolor} writes the color in front of the repeated box and finds no
% node after it to restore the previous one.
% The color operations are therefore read from \tn{current@color}, the
% resolved command that \pkg{luacolor} itself would write, and the drawing
% emits them inside its own graphics scope.
% A \keys{format} is resolved in a group of its own, so the attribute it sets
% ends with that group and no text outside the pattern takes its color.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_use_leader_type:nn #1#2
  { \@@_fntef_use_type:nnn {#1} {#2} { attribute } }
\cs_new_protected:Npn \@@_fntef_use_drawn_type:nn #1#2
  { \@@_fntef_use_type:nnn {#1} {#2} { drawn } }
\cs_new_protected:Npn \@@_fntef_use_type:nnn #1#2#3
  {
    \tl_if_empty:NTF \l_@@_fntef_format_tl
      {
        \tl_set:Ne \l_@@_fntef_color_key_tl
          { ambient | \tex_the:D \use:c { LuaCol@Attribute } }
      }
      {
        \luaul_set_color:n { \l_@@_fntef_format_tl }
        \tl_set:Nn \l_@@_fntef_color_key_tl
          { format | \l_@@_fntef_format_tl }
      }
    \str_if_eq:nnT {#3} { drawn } { \@@_fntef_capture_color: }
    \tl_set:Ne \l_@@_fntef_cache_key_tl
      {
        \exp_not:n {#1}
        | \dim_to_decimal_in_sp:n { 1em }
        | \l_@@_fntef_color_key_tl
      }
    \prop_get:NVNF \g_@@_fntef_format_prop
      \l_@@_fntef_cache_key_tl \l_@@_fntef_cache_name_tl
      {
        \int_gincr:N \g_@@_fntef_format_int
        \tl_set:Ne \l_@@_fntef_cache_name_tl
          { LuaCJKfntef / ul / \int_use:N \g_@@_fntef_format_int }
        \str_if_eq:nnTF {#3} { drawn }
          {
            \exp_args:Nc \newunderlinetype
              { \l_@@_fntef_cache_name_tl } [ LuaCJKfntef ] {#2}
          }
          {
            \tl_if_empty:NTF \l_@@_fntef_format_tl
              {
                \exp_args:Nc \newunderlinetype
                  { \l_@@_fntef_cache_name_tl } [ LuaCJKfntef ] {#2}
              }
              {
                \exp_args:Nc \newunderlinetype
                  { \l_@@_fntef_cache_name_tl } [ LuaCJKfntef ]
                  { \luaul_apply_color: #2 }
              }
          }
        \prop_gput:NVV \g_@@_fntef_format_prop
          \l_@@_fntef_cache_key_tl \l_@@_fntef_cache_name_tl
      }
    \use:c { \l_@@_fntef_cache_name_tl }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]
%   {\@@_fntef_capture_color:, \@@_fntef_pattern_color:,
%     \@@_fntef_literal_direct:n}
% Read the color operations of the pattern.
% Without \keys{format} they are the ones of the text the pattern decorates,
% which \tn{current@color} already holds; with it, the color is resolved the
% way \pkg{luacolor} resolves it and read from the same place, in a group that
% keeps the attribute to itself.
% The drawing then writes them, expanded, so that the literal keeps the color
% of the call that built it: a literal whose payload still held the variable
% would expand it at shipout, with whatever color is current then.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_capture_color:
  {
    \tl_if_empty:NTF \l_@@_fntef_format_tl
      { \tl_set_eq:Nc \l_@@_fntef_color_ops_tl { current@color } }
      {
        \group_begin:
          \luaul_apply_color:
          \tl_gset_eq:Nc \g_@@_fntef_color_ops_tl { current@color }
        \group_end:
        \tl_set_eq:NN \l_@@_fntef_color_ops_tl \g_@@_fntef_color_ops_tl
      }
  }
\cs_new_protected:Npn \@@_fntef_pattern_color:
  {
    \tl_if_empty:NF \l_@@_fntef_color_ops_tl
      {
        \exp_args:NV \@@_fntef_literal_direct:n
          \l_@@_fntef_color_ops_tl
      }
  }
\cs_new_protected:Npn \@@_fntef_literal_direct:n #1
  {
    \tex_expanded:D
      { \exp_not:N \tex_pdfextension:D literal direct {#1} }
  }
%    \end{macrocode}
% \end{macro}

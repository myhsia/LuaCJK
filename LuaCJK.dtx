% \begin{macro}{\LuaCJKShipoutHook}
% \changes{v0.0.1}{2026/11/05}{Add \cs{LuaCJKShipoutHook}, which runs code
%   through the standard \texttt{shipout/before} hook.}
% Run code just before every page is shipped out. This is the place
% for work that must see the finished page; \pkg{xeCJK} calls a macro
% at the same moment, so the name is kept, but the code goes into
% the \texttt{shipout/before} hook and therefore follows its rules.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKShipoutHook { m }
  { \hook_gput_code:nnn { shipout / before } { LuaCJK } {#1} }

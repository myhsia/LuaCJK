\tl_new:N \l_@@_shift_family_tl
\cs_generate_variant:Nn \prop_get:NnNF { NVNF }
\cs_generate_variant:Nn \prop_gput:Nnn { NVV , NnV }
\tl_new:N \l_@@_fallback_ids_tl
\tl_new:N \l_@@_fontid_tl

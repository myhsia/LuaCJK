% \maketitle
%
% \begin{abstract}
%   \pkg{LuaCJK} 为 \LuaTeX\ 提供中文排版。
%   它把当前的 CJK 字体记录在一个 \LuaTeX\ 属性里，
%   并在文字定形之前把每个 CJK 字形放进该字体。
%   \setlength \parindent {1.5em}\par
%   \pkg{LuaCJK} provides Chinese typesetting for \LuaTeX.
%   It records the current CJK font in a \LuaTeX\ attribute
%   and sets each CJK glyph in that font before the text is shaped.
% \end{abstract}
%
% \tableofcontents
%
% \LuaCJKdoclang{zh}
% \clearpage
%
% \begin{documentation}
%
% \section{简介}
%
% \pkg{LuaCJK} 是一个只用于 \LuaTeX\ 的中文排版宏包。它的主要接口是
% \cs{setCJKmainfont}、\cs{setCJKsansfont}、\cs{setCJKmonofont}、
% \cs{setCJKfamilyfont}、\cs{CJKfamily} 与 \cs{LuaCJKsetup}。
%
% 当前的 CJK 字体记录在一个 \LuaTeX\ 属性里，
% 每个 CJK 字形在文字定形之前就放进该字体。
%
% \section{加载}
%
% \begin{quote}
%   \cs{usepackage}\oarg{options}"{LuaCJK}"
% \end{quote}
%
% \pkg{LuaCJK} 需要 \LuaTeX\ 引擎。它与 \pkg{luatexja} 冲突：
% 无论先后加载哪一个，都会报错。
%
% \begin{function}{\LuaCJKversion}
%   打印 \pkg{LuaCJK} 的版本。
% \end{function}
%
% \begin{function}{\LuaCJKsetup}
%   \begin{syntax}
%     \tn{LuaCJKsetup} \marg{key-value list}
%   \end{syntax}
%   配置 \pkg{LuaCJK}。
%   这些键就是随后各节中记录的那些键。
% \end{function}
%
% 这些键分为两组。
%
% 描述文字如何排版的设置只作用于当前分组，
% 并且记录在字符本身上，
% 所以分组中的文字即使在该分组已经结束之后才断行，也仍然保留它的设置：
% \begin{quote}
%   |\vbox{\begingroup\LuaCJKsetup{CJKglue = 10pt}中中\endgroup\par}|
% \end{quote}
% 用的就是 10pt 的胶，尽管分组在 |\par| 之前已经关闭。
% 这一组包含
% \begin{itemize}
%   \item \keys{CJKglue, CJKecglue, CJKspace} 与 \keys{xCJKecglue}；
%   \item \keys{PunctStyle, PunctKinsoku, AllowBreakBetweenPuncts, PunctWidth}
%   与 \keys{PunctBoundWidth}；
%   \item \keys{LatinPunct} 与 \keys{CJKmath}；
%   \item \keys{CheckSingle, WidowPenalty} 与 \keys{CJLineBreak}；
%   \item \keys{AutoFallBack} 与 \keys{Verb}；
%   \item 两个命令 \cs{LuaCJKCancelSubCJKBlock} 与
%   \cs{LuaCJKRestoreSubCJKBlock}。
% \end{itemize}
%
% 其余的键是全局的，或者在加载宏包时起作用：
% \begin{itemize}
%   \item \keys{KaiMingPunct, MiddlePunct, LongPunct}
%   与 \keys{NoBreakLongPunct} 修改字符集合；
%   \item \keys{AutoFakeBold, AutoFakeSlant, EmboldenFactor}
%   与 \keys{SlantFactor} 在注册字族时起作用；
%   \item \keys{LocalConfig} 在加载宏包时起作用，
%   \keys{LoadFandol} 在 |\begin{document}| 处起作用。
% \end{itemize}
% 声明 \cs{LuaCJKDeclareCharClass}、\cs{LuaCJKDeclarePunctClass}、
% \cs{LuaCJKDeclareSubCJKBlock}、\cs{LuaCJKsetwidth} 与 \cs{LuaCJKsetkern}
% 同样是全局的，这一点在各自的说明里都提到了。
%
% 同样的键也可以作为宏包选项给出：
% \begin{quote}
%   |\usepackage[PunctStyle = banjiao]{LuaCJK}|
% \end{quote}
%
% \begin{keyval}
%   \item[\keys{LocalConfig}]\val{\TTF, name}
%   从配置文件读取本地设置。
%   \texttt{true} 加载 \file{luacjk.cfg}，
%   \meta{name} 加载 \file{luacjk-}\meta{name}\file{.cfg}，
%   而 \texttt{false}（初始值）什么都不加载。
%   文件在宏包末尾读取，所以它可以使用 \pkg{LuaCJK} 定义的每一个命令。
%   文件不存在时只给出警告。
% \end{keyval}
%
% 要在 \pkg{ctex} 中使用 \pkg{LuaCJK}，把它的 \keys{engine} 选项设为
% \val{luacjk}：
% \begin{quote}
%   |\documentclass[engine = luacjk]{ctexart}|
% \end{quote}
% \pkg{ctex} 于是载入 \pkg{LuaCJK} 的 |ctex-engine-luacjk.def| 而不是它自己的
% \LuaTeX\ 后端，这个文件同时载入宏包，\pkg{LuaCJK} 不必再单独载入。
%
% \pkg{LuaCJK} 与 \LaTeX\ 的标记 PDF（tagged PDF）项目协同工作。
% 文档开头声明
% \begin{quote}
%   |\DocumentMetadata{tagging = on}|
% \end{quote}
% 时，装饰的墨迹标记为 \texttt{artifact}，装饰符号不会出现在复制和选择
% 的文本中；\keys{selectable = true} 保留符号的文字。
% 在 \cls{l3doc} 文档中还要载入 \pkg{latex-lab-testphase-l3doc}，
% 本手册就是这样生成的。
% 选区的高度由 PDF 阅读器按字体的 \texttt{hhea} 上伸部和下伸部决定，
% 对 \texttt{Noto Serif CJK SC} 是 1.437em，所以选区比 1em 的方块更高；
% 这不是 \pkg{LuaCJK} 能改变的，也不影响字形本身。
%
% \section{字体}
%
% 主要的字体命令接受一个可选的 \pkg{fontspec} 选项列表。
% 选项既可以写在字体名之前，也可以写在字体名之后。
% 无论西文使用哪一种编码，CJK 字体都在 Unicode 编码下选取，
% 所以用 \pkg{fontenc} 把西文设为 \texttt{T1} 之类的旧编码不会影响中文。
%
% \begin{function}{\setCJKmainfont,\setCJKsansfont,\setCJKmonofont}
%   \begin{syntax}
%     \tn{setCJKmainfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   为罗马、无衬线与等宽字族设置 CJK 字体。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\setCJKmainfont[Scale = 1.2]
  {FandolSong-Regular.otf}
English 中文字体\\
\setCJKsansfont[Scale = 1.2]
  {FandolKai-Regular.otf}
\sffamily English 中文字体
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\setCJKfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfamilyfont}\marg{family}\oarg{options}\marg{font}\oarg{options}
%   \end{syntax}
%   定义一个具名的 CJK 字族。字族可以用 \cs{CJKrmdefault} 之类的名字给出。
% \end{function}
%
% \begin{function}{\CJKfamily}
%   \begin{syntax}
%     \tn{CJKfamily} \marg{family}
%   \end{syntax}
%   切换到具名的 CJK 字族。字族可以用 \cs{CJKrmdefault} 之类的名字给出。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKfamily{zhsong}English 中文字体\\
\CJKfamily{zhhei}English 中文字体\\
\CJKfamily{zhkai}English 中文字体\\
\CJKfamily{zhfs}English 中文字体
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\newCJKfontfamily}
%   \begin{syntax}
%     \tn{newCJKfontfamily}\oarg{family}\meta{command}
%     \                    \oarg{options}\marg{font}\oarg{options}
%   \end{syntax}
%   定义一个切换到新声明字族的命令。
%   与 \cs{newfontfamily} 一样，该命令只作用于当前分组。
%   选项可以写在字体名之前，也可以写在之后。
% \end{function}
%
% \begin{function}{\CJKfontspec}
%   \begin{syntax}
%     \tn{CJKfontspec} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   为当前分组选择一个 CJK 字体。
%   选项可以写在字体名之前，也可以写在之后。
% \end{function}
%
% \begin{function}{\songti, \heiti, \fangsong, \kaishu, \lishu, \youyuan}
%   名为 \texttt{zhsong}、\texttt{zhhei}、\texttt{zhfs}、\texttt{zhkai}、
%   \texttt{zhli} 与 \texttt{zhyou} 的字族的快捷方式。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\newCJKfontfamily[kai]\mykai
  {FandolKai-Regular.otf}
\mykai English 中文字体\\
\songti English 中文字体
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{variable}
%   {\CJKrmdefault, \CJKsfdefault, \CJKttdefault,
%   \CJKfamilydefault} 由 \tn{rmfamily}、\tn{sffamily} 与 \tn{ttfamily}
%   选择的 CJK 字族，以及由 \tn{normalfont} 选择的字族。
%   \cs{CJKfamilydefault} 默认跟随 \cs{CJKrmdefault}。
%   它在文档开始时选取，所以在导言区重定义它，正文第一行就用新的字族。
% \end{variable}
%
% \subsection{子区块}
%
% 一种 CJK 字体很少覆盖 \textsc{Unicode} 的每一个区块。
% 子区块让一个范围之内的字符在一个字族里拥有自己的字体；
% 这个区块随后成为字体命令的一个选项。
%
% \begin{function}{\LuaCJKDeclareSubCJKBlock}
%   \begin{syntax}
%     \tn{LuaCJKDeclareSubCJKBlock} \marg{block} \marg{range list}
%   \end{syntax}
%   用给定的范围声明 \meta{block}，写法与 \cs{LuaCJKDeclareCharClass} 相同。
%   这个名字随后成为一个字体选项，正如下例所示：
%   设置了它的字族对该区块的字符使用第二个字体，
%   没有设置它的字族则把这些字符留在主字体里。
%   重叠的区块按声明顺序解决。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKDeclareSubCJKBlock{Kana}{3040 -> 30FF}
\setCJKmainfont[Kana = FandolKai-Regular.otf]
  {FandolSong-Regular.otf}
汉字 かんじ
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKCancelSubCJKBlock, \LuaCJKRestoreSubCJKBlock}
%   \begin{syntax}
%     \tn{LuaCJKCancelSubCJKBlock}  \marg{block list} \\
%     \tn{LuaCJKRestoreSubCJKBlock} \marg{block list}
%   \end{syntax}
%   在当前分组的剩余部分关闭或重新打开列出的区块。
%   因为字体的选择是按字体标识符记录的，
%   所以提供同一字体的两个字族共享同一个设置：
%   最后选择该字体的字族说了算。
% \end{function}
%
% \subsection{后备字体}
%
% 一种 CJK 字体很少覆盖需要的每一个字符。
% 当所选的 CJK 字体没有某个字符的字形时，后备字体按声明的顺序依次尝试。
%
% \begin{function}{\setCJKfallbackfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfallbackfamilyfont} \marg{family} \oarg{options} \\
%        \                          \marg{font}   \oarg{options}
%   \end{syntax}
%   把 \meta{font} 加入 \meta{family} 的后备列表。字族可以用
%   \cs{CJKrmdefault} 之类的名字给出。多次调用该命令可以建立一条链；
%   第一个拥有该字符的字体胜出。
%   这条链按文字的字重、字形与字号解析，
%   所以粗体里的字符取自后备字体的粗体字面，
%   放大后的字符取自对应字号的字面。
%   打开 \keys{CJKmath} 时，排在数学模式里的汉字也走同一条链：
%   列表取自负则这个数学字体的 CJK 字族，字号取数学样式的字号。
% \end{function}
%
% \begin{keyval}
%   \item[\keys{AutoFallBack}]\val{\TFF}
%   是否使用声明过的后备字体。这个开关像间距的那些键一样跟随文字，
%   所以可以只在一个分组里打开它。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\setCJKmainfont{FandolSong-Regular.otf}
\setCJKfallbackfamilyfont{\CJKrmdefault}
  {FandolKai-Regular.otf}
\LuaCJKsetup{AutoFallBack = true}中あ
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{基线调整}
%
% 两种 CJK 字体很少是为彼此设计的：
% 混排在同一行里，一种字体的字总显得偏高或偏低。
% 一种字体可以带一个 \keys{Baseline} 值，
% 把它的字整体向上或向下移动，
% 使两种字体立在同一条基线上。
% 这个值属于字体而不属于文字，
% 所以它是声明这个字体的那条命令的一个选项。
%
% \begin{keyval}
%   \item[\keys{Baseline}]\meta{dimension}
%   把这个字体的字向上移动 \meta{dimension}，负值则向下移动。
%   它和其他字体选项一样可以写在后备字体的声明里，
%   这也是它最常见的用处：让后备字体贴住主字体的基线。
%   单位可以用任何 \TeX\ 长度单位，|em| 随字号一起变化。
%   两条声明给出同一个字体时，共享后一条声明的值，
%   因为字的位置是按字体记录的。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\setCJKfamilyfont{high}[Baseline = .3em]
  {FandolKai-Regular.otf}
\songti 基线\quad\CJKfamily{high}基线
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{加载 Fandol}
%
% \begin{keyval}
%   \item[\keys{LoadFandol}]\val{\TTF}
%   默认打开。当文档没有声明任何 CJK 字体时，在 |\begin{document}| 处加载
%   四款 Fandol 字体：宋体作为主字体，
%   黑体作为无衬线字体，仿宋作为等宽字体，
%   并且把宋、黑、楷、仿宋全部注册为具名字族。
%   宋体一族以楷体作为斜体，所以 \tn{emph} 与 \tn{itshape} 会把汉字改成楷体。
%   已经声明了字体的文档保留自己的字体，所以 Fandol 不会混进来；
%   但若它恰好没有声明 \cs{CJKfamilydefault} 所用的那一族，
%   正文就会用 \cs{CJKrmdefault} 那一族，若也没有则用最先声明的一族，
%   并且给出警告。
%   什么字体都没声明又关掉这个键时，同样会给出警告。
% \end{keyval}
%
% \subsection{伪粗体与伪斜体}
%
% 一种 CJK 字族常常没有粗体或斜体。下面这些键让 \pkg{LuaCJK} 请求
% \pkg{fontspec} 加粗或倾斜常规字体，而不去使用粗体或斜体。
% 它们作用于此后注册的字族，并且在字族自己设置了 \texttt{BoldFont} 或
% \texttt{ItalicFont} 时不生效。它们是全局的：
% 分组不会改变一个已经注册的字族所用的设置。
% 一个既没有设置 \texttt{ItalicFont} 也没有打开 \keys{AutoFakeSlant} 的字族
% 没有斜体形状：强调的文字保持正体，\pkg{fontspec} 会报告缺少这个形状。
%
% \begin{keyval}
%   \item[\keys{AutoFakeBold}]\val{\TFF, number}
%   在请求粗体形状时加粗常规字体。
%   给出一个数字时同时设置 \texttt{EmboldenFactor}。
%   \item[\keys{AutoFakeSlant}]\val{\TFF, number}
%   在请求斜体形状时倾斜常规字体。
%   给出一个数字时同时设置 \texttt{SlantFactor}。
%   \item[\keys{EmboldenFactor}]\val{number}: 加粗的量。
%   初始值是 \texttt{4}。
%   \item[\keys{SlantFactor}]\val{number}: 倾斜的量，介于
%   $-0.999$ 与 $0.999$ 之间。初始值是 \texttt{0.167}。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{AutoFakeBold = true}
\setCJKmainfont{FandolSong-Regular.otf}
\textbf{English 中文字体}\\
English 中文字体
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\defaultCJKfontfeatures}
%   \begin{syntax}
%     \tn{defaultCJKfontfeatures} \marg{font features}
%   \end{syntax}
%   设置前置到此后注册的每一个 CJK 字族的特性。
%   初始值是 |Script = CJK|。
%   在调用之前注册的字族保留它们当时得到的特性。
% \end{function}
%
% \begin{function}{\addCJKfontfeatures}
%   \begin{syntax}
%     \tn{addCJKfontfeatures} \oarg{ignored} \marg{font features}
%   \end{syntax}
%   为当前 CJK 字族添加特性，直到分组结束，
%   例如 |\addCJKfontfeatures{Scale = 1.2}|。
%   开头的一个 \texttt{*} 也可以接受；两种形式作用于同一个字体。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\defaultCJKfontfeatures{Scale = 1.5}
\setCJKfamilyfont{big}
  {FandolSong-Regular.otf}
\CJKfamily{big}中文字体\\
\CJKfamily{zhsong}中文字体\\
\addCJKfontfeatures{Scale = 1.2}
\CJKfamily{zhsong}中文字体
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{数学模式中的汉字}
%
% \begin{keyval}
%   \item[\keys{CJKmath}]\val{\TFF}: 是否允许在数学模式里直接输入汉字。
%   打开时，这样的字符用它自己的一个数学字族的 CJK 字体排出，
%   而不是到数学字体里去找，
%   所以上标或分数里的字符会取那个数学样式的尺寸。
%   可以用 |\LuaCJKsetup{CJKmath = true}| 打开它，也可以用宏包选项
%   |CJKmath = true|。
%   此时字符取数学版本（见 \tn{mathversion}）的字体：
%   在 \texttt{bold} 版本里用字族的粗体，字族没有粗体时保持正体；
%   字形取字族的正体，不随周围的正文。
%   不打开它时，数学模式里的汉字会到数学字体里去找，通常就此消失，
%   所以这种情况下 \pkg{LuaCJK} 给出一次性的警告。
% \end{keyval}
%
% \begin{function}{\setCJKmathfont}
%   \begin{syntax}
%     \tn{setCJKmathfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   选择数学模式里的字符所用的 CJK 字体。
%   不用这个命令时，使用 CJK 主字体。
%   本手册在前导区打开 \keys{CJKmath} 并设置了这个字体。
%   与其他的字体命令一样，这个选择只作用于当前分组：
%   分组里的公式使用该分组里选择的字族。
% \end{function}
%
% 数学模式里出现的每一个 CJK 字族都被注册成一个独立的数学字族，
% 这样 \TeX\ 就能取它的文本、脚本或脚脚本尺寸。
% 字族按数学版本选字体：\texttt{bold} 版本用 \cs{bfdefault}，其余版本用
% \cs{mddefault}，字形的形状取 \cs{shapedefault}。
% 所以 \cs{boldmath} 会把公式里的汉字换成粗体，而且只作用于当前分组；
% 字族没有粗体时保持正体，也不报警告。
% 字族号取自 240--255 这一段，是 \LuaTeX\ 允许的 256 个字族里的最后十六个，
% 正常文档不会用到那里；数学里用到的每一个后备字体也各占一个号，
% 声明了它的字族共用这个号，一个文档如果需要十六个以上的号就会报错停止。
% 脚本尺寸是当前正文尺寸的百分之七十五，
% 也就是标准尺寸表里的比例。
% 这个正文尺寸是公式周围文字的尺寸，而不是公式里 \tn{text} 临时切换到的尺寸，
% 所以含有 \tn{text} 的公式与不含它的公式一样大。
% 数学参数不取自 CJK 字体，因为它没有
% \texttt{MathConstants} 表：这些参数仍然是文档数学字体的，
% 这就是为什么两个汉字组成的分数用的是周围数学的横线与间距。
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
$ 天地玄黄 $ and 天地玄黄
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \section{文本排版}
%
% \subsection{间距}
%
% \begin{keyval}
%   \item[\keys{CJKglue}]\val{glue}: 插入相邻 CJK 字符之间的胶。
%   初始值是 \texttt{0pt plus 0.08\cs{baselineskip}}，在每次选择字体时重新计算，
%   所以它跟随字号；文档给出的值按原样使用，不随字号变化，
%   连同它的伸缩阶（例如 |plus 1filll|）一起保留。
%   \item[\keys{CJKecglue}]\val{glue}: 插入 CJK 与拉丁字符之间的胶。
%   标点两侧的胶没有宽度：标点的进距本身就带有间距。
%   半角的 ASCII 括号只留下开头括号之前的这一份胶，
%   括号内侧不加，于是成对的括号贴住它括起来的文字。
%   初始值是 \texttt{0.3333em plus 0.1667em minus 0.1111em}，
%   它同样跟随字号。
%   \item[\keys{CJKspace}]\val{\TFF}: 是否保留源文件中 CJK 字符之间的空格。
%   不保留时，空格换成字符之间的胶，断行与伸缩都随之保留。
%   用 |\ | 或 \tn{nobreakspace} 写出的空格不是源文件中的空格，
%   它的宽度就是一个空格的宽度。
%   \item[\keys{xCJKecglue}]\val{\TFF}: 是否把源文件中 CJK 与拉丁字符之间的
%   空格替换为 \texttt{CJKecglue}。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
中文 English 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{CJKspace = true}天 地 玄 黄 宇 宙
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\normalspacedchars}
%   \begin{syntax}
%     \tn{normalspacedchars} \marg{character list}
%   \end{syntax}
%   列出的字符两侧都不加胶，
%   这样拉丁文字中的连字符或斜线不会把周围的文字拉开。
%   初始列表是 |/|、|\| 与 |-|。这个设置是全局的。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
中x中\par
\normalspacedchars{x}中x中
\end{codemo}
\normalspacedchars{/,\,,-}
\endgroup
% \iffalse
%</example>
% \fi
%
% 只用于控制文字、本身没有进距的字符分两类。
% U+200B、U+2060、U+180E 与 U+FEFF 不含字体能用的信息，
% 在输入时就已删除，因此它们既不占胶，也不把两个 CJK 字符分开。
% 连接符（U+200C、U+200D）与各个变体选择符留给字体：
% 它们跟随前一个字符的字体，所以一个 emoji 序列不会被拆成两个图形，
% 一个变体序列也能选到它的字形；
% 字体用不到它们时留下的占位字形在断行之前就去掉，
% 因此它们既不占进距，也不在两个 CJK 字符之间加上 \keys{CJKecglue}。
% 用 \tn{char} 请求的字符不会被删除，因为 \tn{char} 要的就是字形本身。
% 盒子同样按它占的进距计：不占进距的盒子不把两侧的文字分开，
% 所以 |\rlap|、|\llap| 与 |\clap| 覆盖在文字上的内容仍属于同一串。
%
% \begin{environment}{CJKfilltwosides}
%   把各行排进一个竖直盒子里，
%   盒中的行两端对齐到 \meta{width}，各行之间用 |\\| 分开。
%   它的 \meta{position} 参数像 \cs{parbox} 一样决定盒子落在基线上的方式：
%   \texttt{t} 让第一行的基线与周围的行齐平，
%   \texttt{c} 表示居中（默认），
%   \texttt{b} 让最后一行的基线与周围的行齐平。
%   宽度为零或为负时沿用周围的行宽。
%   带星号的形式行为相同；它不与内容的自然宽度作比较。
%   \begin{syntax}
%   \tn{begin}\{CJKfilltwosides\}\oarg{position}\marg{width}
%   \   \meta{lines} \\
%   \tn{end}\{CJKfilltwosides\}
%   \end{syntax}
% \end{environment}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begin{CJKfilltwosides}{6em}
  瞻彼阕者，\\虚室生白
\end{CJKfilltwosides}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\begin{CJKfilltwosides*}{0pt}
  瞻彼阕者，\\虚室生白
\end{CJKfilltwosides*}
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \subsection{标点}
%
% \begin{keyval}
%   \item[\keys{PunctStyle}]\val{style}: 选择一种标点样式。
%   已经实现的样式有 \texttt{quanjiao}（默认）、
%   \texttt{plain}、\texttt{banjiao}、\texttt{kaiming}、\texttt{CCT}
%   与 \texttt{hangmobanjiao}。
%   未知的名字给出警告并回退到 \texttt{plain}。
%   \item[\keys{PunctWidth}]\val{length, false}: 不管样式怎么说，
%   给每个标点同样的进距。
%   \texttt{0pt} 也是一个进距，标点因此不占任何进距；
%   \texttt{false}（初始值）让标点回到样式给出的宽度。
%   用 \cs{LuaCJKsetwidth} 为某个标点设置的宽度仍然优先。
%   \item[\keys{PunctBoundWidth}]\val{length, false}: 标点出现在行尾或行首时，
%   它的进距中有多少留在行内；
%   其余的墨迹悬挂到页边，或者悬挂到段落开头或列表项开头的缩进里。
%   默认悬挂标点自带的空白，所以它的墨迹正好落在版心边上；
%   断行时这一份悬挂已经算进去，行尾的标点因此能随它所在的行一起放下。
%   \texttt{0pt} 把整个进距都悬挂出去，\texttt{false} 恢复这个默认值。
%   \item[\keys{LatinPunct}]\val{\TFF}: 把引号
%   （U+2018、U+2019、U+201C、U+201D）、间隔号（U+00B7）
%   与省略号（U+2026、U+2027、U+22EF）当作拉丁标点：
%   它们留在当前的拉丁字体里，也不被压缩。
%   这样英文单词里的撇号就不会变成一个全角形式。破折号不受影响。
%   \item[\keys{PunctFamily}]\val{family, false}: 为标点使用
%   另一个 CJK 字族。
%   该字族必须用 \cs{setCJKfamilyfont} 声明；\texttt{false}
%   （初始值）让标点重新跟随文字。
%   该字族的 \texttt{Baseline} 同样移动它排出的标点。
%   \item[\keys{AllowBreakBetweenPuncts}]\val{\TFF}: 两个相邻的标点是否可以
%   被断行分开。
%   破折号与省略号不在此列，一串连续的破折号或省略号由
%   \texttt{NoBreakLongPunct} 控制。
%   收尾的、中间的标点与破折号、省略号不能出现在行首，
%   开头的标点不能出现在行尾，
%   这两条禁则不由本选项放开，所以一个收尾的引号不会被单独排在行首。
%   标点仍然会被压缩。
%   \item[\keys{PunctKinsoku}]\val{\TTF}: 是否对标点施加断行禁则。
%   收尾的、中间的标点与破折号、省略号不能出现在行首，
%   开头的标点不能出现在行尾，
%   半角的 ASCII 括号同样如此：开头的不能出现在行尾，
%   收尾的不能出现在行首；
%   两个相邻的标点不会被分开，一串连续的破折号或省略号保持在一起。
%   盒子边缘的标点同样参与判断。
%   这些禁则与 \texttt{PunctStyle} 无关，
%   所以 |PunctStyle = plain| 时它们仍然有效。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
不亦说乎，不亦乐乎\\
\LuaCJKsetup{PunctFamily = zhkai}
不亦说乎，不亦乐乎
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{LatinPunct = false}%
a’a\quad 不亦说乎！\\
\LuaCJKsetup{LatinPunct, PunctWidth = .8em}
a’a\quad 不亦说乎！
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\fbox{甲，乙}\\
\LuaCJKsetup{PunctWidth = 0pt}%
\fbox{甲，乙}
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
列位看官。\\
\LuaCJKsetup{PunctBoundWidth = .5em}
列位看官。\\
（列位看官
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% 接下来是标点代码所用的字符集合。每个集合的键都有三种形式：
% 不带符号的形式替换整个集合，带 \texttt{+} 的形式添加字符，
% 带 \texttt{-} 的形式去掉字符。范围的写法与 \cs{LuaCJKDeclareCharClass} 相同。
% 这些集合是全局的：分组不会把先前的成员带回来。
%
% \begin{keyval}
%   \item[\keys{KaiMingPunct<+->}]\val{char list}:
%   在 \texttt{kaiming} 样式里保持全角宽度的标点。
%   初始为 \texttt{。}、\texttt{．}、\texttt{？}、\texttt{！}。
%   \item[\keys{MiddlePunct<+->}]\val{char list}:
%   居中的标点，放在自己盒子的两半之间。居中的标点不能出现在行首。
%   \item[\keys{LongPunct<+->}]\val{char list}:
%   彼此之间从不压缩的标点，例如破折号与省略号。
%   \item[\keys{NoBreakLongPunct<+->}]\val{char list}:
%   不能被断行分开的长标点。初始与 \texttt{LongPunct} 相同。
% \end{keyval}
%
% \begin{function}{\LuaCJKDeclareCharClass}
%   \begin{syntax}
%     \tn{LuaCJKDeclareCharClass} \marg{class} \marg{range list}
%   \end{syntax}
%   改写一段码位的类别。
%   范围用十六进制书写，前导的 |"| 可以省略，
%   |"START -> "END| 表示一段范围；
%   列表用逗号分隔。
%   类别有：\texttt{CJK} 与 \texttt{Default} 让这段范围表现得像 CJK 或拉丁文字；
%   \texttt{FullLeft} 与 \texttt{HalfLeft} 把它当作开头的标点，
%   \texttt{FullRight} 与 \texttt{HalfRight} 把它当作收尾的标点，
%   于是断行禁则适用；
%   前者是全角标点，照样压缩与悬挂，后者只能是 ASCII 括号：
%   它不压缩、不悬挂，只在成对时贴住括号内的文字。
%   \texttt{NormalSpace} 把这段范围移出 CJK/拉丁胶，
%   就像 \cs{normalspacedchars} 那样；
%   \texttt{CJStarter}、\texttt{CM} 与 \texttt{Boundary} 当作 \texttt{CJK} 处理，
%   因为 \LuaTeX\ 没有组合标记或文字段边界的模型。
% \end{function}
%
% \begin{function}{\LuaCJKDeclarePunctClass}
%   \begin{syntax}
%     \tn{LuaCJKDeclarePunctClass} \marg{group} \marg{range list}
%   \end{syntax}
%   改写一段范围的标点组。组有 \texttt{open}、\texttt{close}、
%   \texttt{middle}、\texttt{dash} 与 \texttt{ellipsis}，
%   以及半角括号的两组 \texttt{half-open} 与 \texttt{half-close}；
%   \texttt{none} 去掉标点处理，于是这些字符不再被压缩或悬挂。
% \end{function}
%
% \begin{function}{\LuaCJKResetCharClass}
%   丢弃迄今声明的每一个类别与标点改写，
%   并把正常间距集合恢复为 \cs{normalspacedchars} 的字符。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
中ABC中\par
\LuaCJKDeclareCharClass{CJK}{0041 -> 005A}
中ABC中\par
\LuaCJKDeclarePunctClass{none}{FF0C}%
字，，字\par
\LuaCJKResetCharClass 中ABC中
\end{codemo}
\endgroup

% \begin{documentation}
%
% \section{简介}
%
% \pkg{LuaCJK} 是一个只用于 \LuaTeX\ 的中文排版宏包。它的主要接口是
% \cs{setCJKmainfont}、\cs{setCJKsansfont}、\cs{setCJKmonofont}、
% \cs{setCJKfamilyfont}、\cs{CJKfamily} 与 \cs{LuaCJKsetup}。
%
% 当前的 CJK 字体记录在一个 \LuaTeX\ 属性里，
% 并在断行与盒子打包之前替换 CJK 字形节点。
%
% \section{加载}
%
% \begin{quote}
%   \cs{usepackage}\oarg{options}"{LuaCJK}"
% \end{quote}
%
% LuaCJK 需要 \LuaTeX\ 引擎。它与 \pkg{luatexja} 冲突：
% 无论先后加载哪一个，都会报错。
%
% \begin{function}{\LuaCJKversion}
%   打印 LuaCJK 的版本。
% \end{function}
%
% \begin{function}{\LuaCJKsetup}
%   \begin{syntax}
%     \tn{LuaCJKsetup} \marg{key-value list}
%   \end{syntax}
%   配置 LuaCJK。
%   这些键就是随后各节中记录的那些键。
% \end{function}
%
% 这些键分为两组。
%
% 描述文字如何排版的设置只作用于当前分组，
% 并且记录在字符本身上，
% 所以分组中的文字即使在该分组已经结束之后才断行，也仍然保留它的设置：
% \begin{quote}
%   |\vbox{\begingroup\LuaCJKsetup{CJKglue = 10pt}中中\endgroup\par}|
% \end{quote}
% 用的就是 10pt 的胶，尽管分组在 |\par| 之前已经关闭。
% 这一组包含
% \begin{itemize}
%   \item \keys{CJKglue, CJKecglue, CJKspace} 与 \keys{xCJKecglue}；
%   \item \keys{PunctStyle, PunctKinsoku, AllowBreakBetweenPuncts, PunctWidth}
%   与 \keys{PunctBoundWidth}；
%   \item \keys{LatinPunct} 与 \keys{CJKmath}；
%   \item \keys{CheckSingle, WidowPenalty} 与 \keys{CJLineBreak}；
%   \item \keys{AutoFallBack} 与 \keys{Verb}；
%   \item 两个命令 \cs{LuaCJKCancelSubCJKBlock} 与
%   \cs{LuaCJKRestoreSubCJKBlock}。
% \end{itemize}
%
% 其余的键是全局的，或者在加载宏包时起作用：
% \begin{itemize}
%   \item \keys{KaiMingPunct, MiddlePunct, LongPunct}
%   与 \keys{NoBreakLongPunct} 修改字符集合；
%   \item \keys{AutoFakeBold, AutoFakeSlant, EmboldenFactor}
%   与 \keys{SlantFactor} 在注册字族时起作用；
%   \item \keys{LoadFandol} 与 \keys{LocalConfig} 在加载宏包时起作用。
% \end{itemize}
% 声明 \cs{LuaCJKDeclareCharClass}、\cs{LuaCJKDeclarePunctClass}、
% \cs{LuaCJKDeclareSubCJKBlock}、\cs{LuaCJKsetwidth} 与 \cs{LuaCJKsetkern}
% 同样是全局的，这一点在各自的说明里都提到了。
%
% 同样的键也可以作为宏包选项给出：
% \begin{quote}
%   |\usepackage[PunctStyle = banjiao]{LuaCJK}|
% \end{quote}
%
% \begin{keyval}
%   \item[\keys{LocalConfig}]\val{\TTF, name}
%   从配置文件读取本地设置。
%   \texttt{true} 加载 \file{luacjk.cfg}，
%   \meta{name} 加载 \file{luacjk-}\meta{name}\file{.cfg}，
%   而 \texttt{false}（初始值）什么都不加载。
%   文件在宏包末尾读取，所以它可以使用 LuaCJK 定义的每一个命令。
%   文件不存在时只给出警告。
% \end{keyval}
%
% 要在 \pkg{ctex} 中使用 LuaCJK，把它的 \keys{engine} 选项设为
% \val{luacjk}：
% \begin{quote}
%   |\documentclass[engine = luacjk]{ctexart}|
% \end{quote}
% \pkg{ctex} 于是载入 LuaCJK 的 |ctex-engine-luacjk.def| 而不是它自己的
% \LuaTeX\ 后端，这个文件同时载入宏包，LuaCJK 不必再单独载入。
%
% LuaCJK 与 \LaTeX\ 的标记 PDF（tagged PDF）项目协同工作。
% 文档开头声明
% \begin{quote}
%   |\DocumentMetadata{tagging = on}|
% \end{quote}
% 时，装饰的墨迹标记为 \texttt{artifact}，装饰符号不会出现在复制和选择
% 的文本中；\keys{selectable = true} 保留符号的文字。
% 在 \cls{l3doc} 文档中还要载入 \pkg{latex-lab-testphase-l3doc}，
% 本手册就是这样生成的。
% 选区的高度由 PDF 阅读器按字体的 \texttt{hhea} 上伸部和下伸部决定，
% 对 \texttt{Noto Serif CJK SC} 是 1.437em，所以选区比 1em 的方块更高；
% 这不是 LuaCJK 能改变的，也不影响字形本身。
%
% \section{字体}
%
% 主要的字体命令接受一个可选的 \pkg{fontspec} 选项列表。
% 选项既可以写在字体名之前，也可以写在字体名之后。
%
% \begin{function}{\setCJKmainfont,\setCJKsansfont,\setCJKmonofont}
%   \begin{syntax}
%     \tn{setCJKmainfont} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   为罗马、无衬线与等宽字族设置 CJK 字体。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\setCJKmainfont[Scale = 1.2]
  {FandolSong-Regular.otf}中文\\
\setCJKsansfont[Scale = 1.2]
  {FandolKai-Regular.otf}\sffamily 中文
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\setCJKfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfamilyfont}\marg{family}\oarg{options}\marg{font}\oarg{options}
%   \end{syntax}
%   定义一个具名的 CJK 字族。
% \end{function}
%
% \begin{function}{\CJKfamily}
%   \begin{syntax}
%     \tn{CJKfamily} \marg{family}
%   \end{syntax}
%   切换到具名的 CJK 字族。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begin{codemo}
\CJKfamily{zhsong}中文宋体\quad
\CJKfamily{zhhei}中文黑体\\
\CJKfamily{zhkai}中文楷体\quad
\CJKfamily{zhfs}中文仿宋
\end{codemo}
% \iffalse
%</example>
% \fi
%
% \begin{function}{\newCJKfontfamily}
%   \begin{syntax}
%     \tn{newCJKfontfamily}\oarg{family}\meta{command}
%     \                    \oarg{options}\marg{font}\oarg{options}
%   \end{syntax}
%   定义一个切换到新声明字族的命令。
%   与 \cs{newfontfamily} 一样，该命令只作用于当前分组。
%   选项可以写在字体名之前，也可以写在之后。
% \end{function}
%
% \begin{function}{\CJKfontspec}
%   \begin{syntax}
%     \tn{CJKfontspec} \oarg{options} \marg{font} \oarg{options}
%   \end{syntax}
%   为当前分组选择一个 CJK 字体。
%   选项可以写在字体名之前，也可以写在之后。
% \end{function}
%
% \begin{function}{\songti, \heiti, \fangsong, \kaishu, \lishu, \youyuan}
%   名为 \texttt{zhsong}、\texttt{zhhei}、\texttt{zhfs}、\texttt{zhkai}、
%   \texttt{zhli} 与 \texttt{zhyou} 的字族的快捷方式。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\newCJKfontfamily[kai]\mykai{FandolKai-Regular.otf}
  \mykai 中文\quad \songti 中文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{variable}
%   {\CJKrmdefault, \CJKsfdefault, \CJKttdefault,
%   \CJKfamilydefault} 由 \tn{rmfamily}、\tn{sffamily} 与 \tn{ttfamily}
%   选择的 CJK 字族，以及由 \tn{normalfont} 选择的字族。
%   \cs{CJKfamilydefault} 默认跟随 \cs{CJKrmdefault}。
% \end{variable}
%
% \subsection{子区块}
%
% 一种 CJK 字体很少覆盖 \textsc{Unicode} 的每一个区块。
% 子区块让一个范围之内的字符在一个字族里拥有自己的字体；
% 这个区块随后成为字体命令的一个选项。
%
% \begin{function}{\LuaCJKDeclareSubCJKBlock}
%   \begin{syntax}
%     \tn{LuaCJKDeclareSubCJKBlock} \marg{block} \marg{range list}
%   \end{syntax}
%   用给定的范围声明 \meta{block}，写法与 \cs{LuaCJKDeclareCharClass} 相同。
%   这个名字随后成为一个字体选项，正如下例所示：
%   设置了它的字族对该区块的字符使用第二个字体，
%   没有设置它的字族则把这些字符留在主字体里。
%   重叠的区块按声明顺序解决。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKDeclareSubCJKBlock{Kana}{3040 -> 30FF}
\setCJKmainfont[Kana = FandolKai-Regular.otf]
  {FandolSong-Regular.otf}中 あ
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\LuaCJKCancelSubCJKBlock, \LuaCJKRestoreSubCJKBlock}
%   \begin{syntax}
%     \tn{LuaCJKCancelSubCJKBlock}  \marg{block list} \\
%     \tn{LuaCJKRestoreSubCJKBlock} \marg{block list}
%   \end{syntax}
%   在当前分组的剩余部分关闭或重新打开列出的区块。
%   因为字体的选择是按字体标识符记录的，
%   所以提供同一字体的两个字族共享同一个设置：
%   最后选择该字体的字族说了算。
% \end{function}
%
% \subsection{后备字体}
%
% 一种 CJK 字体很少覆盖需要的每一个字符。
% 当所选的 CJK 字体没有某个字符的字形时，后备字体按声明的顺序依次尝试。
%
% \begin{function}{\setCJKfallbackfamilyfont}
%   \begin{syntax}
%     \tn{setCJKfallbackfamilyfont} \marg{family} \oarg{options} \\
%        \                          \marg{font}   \oarg{options}
%   \end{syntax}
%   把 \meta{font} 加入 \meta{family} 的后备列表。字族可以用
%   \cs{CJKrmdefault} 之类的名字给出。多次调用该命令可以建立一条链；
%   第一个拥有该字符的字体胜出。
%   这条链按文字的字重、字形与字号解析，
%   所以粗体里的字符取自后备字体的粗体字面，
%   放大后的字符取自对应字号的字面。
% \end{function}
%
% \begin{keyval}
%   \item[\keys{AutoFallBack}]\val{\TFF}
%   是否使用声明过的后备字体。这个开关像间距的那些键一样跟随文字，
%   所以可以只在一个分组里打开它。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\setCJKmainfont{FandolSong-Regular.otf}
\setCJKfallbackfamilyfont{\CJKrmdefault}
  {FandolKai-Regular.otf}
\LuaCJKsetup{AutoFallBack = true}中あ
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{基线调整}
%
% 两种 CJK 字体很少是为彼此设计的：
% 混排在同一行里，一种字体的字总显得偏高或偏低。
% 一种字体可以带一个 \keys{Baseline} 值，
% 把它的字整体向上或向下移动，
% 使两种字体立在同一条基线上。
% 这个值属于字体而不属于文字，
% 所以它是声明这个字体的那条命令的一个选项。
%
% \begin{keyval}
%   \item[\keys{Baseline}]\meta{dimension}
%   把这个字体的字向上移动 \meta{dimension}，负值则向下移动。
%   它和其他字体选项一样可以写在后备字体的声明里，
%   这也是它最常见的用处：让后备字体贴住主字体的基线。
%   单位可以用任何 \TeX\ 长度单位，|em| 随字号一起变化。
%   两条声明给出同一个字体时，共享后一条声明的值，
%   因为字的位置是按字体记录的。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\setCJKfamilyfont{high}[Baseline = .3em]
  {FandolKai-Regular.otf}
\songti 基线\quad\CJKfamily{high}基线
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \subsection{加载 Fandol}
%
% \begin{keyval}
%   \item[\keys{LoadFandol}]\val{\TTF}
%   当文档没有声明任何 CJK 字体时，在 |\begin{document}| 处加载
%   四款 Fandol 字体：宋体作为主字体，
%   黑体作为无衬线字体，仿宋作为等宽字体，
%   并且把宋、黑、楷、仿宋全部注册为具名字族。
% \end{keyval}
%
% \subsection{伪粗体与伪斜体}
%
% 一种 CJK 字族常常没有粗体或斜体。下面这些键让 LuaCJK 请求
% \pkg{fontspec} 加粗或倾斜常规字体，而不去使用粗体或斜体。
% 它们作用于此后注册的字族，并且在字族自己设置了 \texttt{BoldFont} 或
% \texttt{ItalicFont} 时不生效。它们是全局的：
% 分组不会改变一个已经注册的字族所用的设置。
%
% \begin{keyval}
%   \item[\keys{AutoFakeBold}]\val{\TFF, number}
%   在请求粗体形状时加粗常规字体。
%   给出一个数字时同时设置 \texttt{EmboldenFactor}。
%   \item[\keys{AutoFakeSlant}]\val{\TFF, number}
%   在请求斜体形状时倾斜常规字体。
%   给出一个数字时同时设置 \texttt{SlantFactor}。
%   \item[\keys{EmboldenFactor}]\val{number}: 加粗的量。
%   初始值是 \texttt{4}。
%   \item[\keys{SlantFactor}]\val{number}: 倾斜的量，介于
%   $-0.999$ 与 $0.999$ 之间。初始值是 \texttt{0.167}。
% \end{keyval}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\LuaCJKsetup{AutoFakeBold = true}
\setCJKmainfont{FandolSong-Regular.otf}
\textbf{中文} and 中文
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
%
% \begin{function}{\defaultCJKfontfeatures}
%   \begin{syntax}
%     \tn{defaultCJKfontfeatures} \marg{font features}
%   \end{syntax}
%   设置前置到此后注册的每一个 CJK 字族的特性。
%   初始值是 |Script = CJK|。
%   在调用之前注册的字族保留它们当时得到的特性。
% \end{function}
%
% \begin{function}{\addCJKfontfeatures}
%   \begin{syntax}
%     \tn{addCJKfontfeatures} \oarg{ignored} \marg{font features}
%   \end{syntax}
%   为当前 CJK 字族添加特性，直到分组结束，
%   例如 |\addCJKfontfeatures{Scale = 1.2}|。
%   开头的一个 \texttt{*} 也可以接受；两种形式作用于同一个字体。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
\defaultCJKfontfeatures{Scale = 1.5}
\setCJKfamilyfont{big}{FandolSong-Regular.otf}
\CJKfamily{big}中文\quad%
\CJKfamily{zhsong}中文\quad%
\addCJKfontfeatures{Scale = 1.2}中文
\end{codemo}
\endgroup

%
% \begin{macro}{\CJKunderline}
% \changes{v0.0.1}{2026/11/05}{Add \pkg{LuaCJKfntef}, a \pkg{lua-ul} based
%   companion package providing \cs{CJKunderline}, \cs{CJKunderdot}, and
%   \cs{CJKsout}.}
% \changes{v0.0.1}{2026/11/05}{\cs{CJKunderline} now takes \keys{thickness},
%   \keys{depth}, and \keys{textformat}, and passes any other key on to
%   \pkg{lua-ul}.}
% \changes{v0.0.1}{2026/11/05}{\cs{CJKunderline} accepts \keys{format} for the
%   color of the rule; it takes a color name rather than code.}
% Underline the argument. The optional argument takes

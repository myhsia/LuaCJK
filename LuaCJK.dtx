% \subsection{Adjusting the decoration boxes}
%
% \pkg{lua-ul} draws each decoration as a pair of nodes: a leaders glue of
% width $w$ and a glue of width $-w$ that gives the space back, so the text
% does not move.  Changing those numbers is enough to inset the decoration
% and to leave out the punctuation, which is why LuaCJK adjusts the box
% instead of drawing the decoration itself.
%
% \begin{variable}[internal]
%   {LuaCJKfntef.attr, LuaCJKfntef.settings}
%   The attribute that carries the number of a settings entry, and the entry
%   itself: the inset at both ends and whether punctuation is skipped.  A
%   separate entry per call keeps two decorations in one paragraph apart.
%    \begin{macrocode}
%<*lua-fntef>
-- LuaCJKfntef.lua
-- Copyright (C) 2026 by Mingyu Xia <myhsia@outlook.com>
-- This work may be distributed and/or modified under the conditions of the
-- LaTeX Project Public License, version 1.3c or later.

LuaCJKfntef = LuaCJKfntef or {}

local M = LuaCJKfntef
local GLYPH = node.id("glyph")
local GLUE = node.id("glue")
-- TeX numbers the glue subtypes: 100 is \leaders, which both lua-ul and the
-- decorations of this package use.
local LEADERS = 100
local KERN = node.id("kern")

-- The per-call settings live in a Lua table; the number of the entry is
-- stored in an attribute on the decorated text, so two decorations in the
-- same paragraph keep their own settings.  Attribute 0 means no adjustment.
M.attr = M.attr or nil
M.settings = M.settings or {}
M.next_id = M.next_id or 1

function M.new_settings (subtract, skip, boxdepth)
  local id = M.next_id
  M.next_id = id + 1
  M.settings[id] = { subtract = subtract, skip = skip, boxdepth = boxdepth }
  if M.attr then
    tex.setattribute(M.attr, id)
  end
end

local function kind (c)
  local class = LuaCJK.punct_class
  if class then
    return class(c)
  end
  return nil
end

-- The intervals of the span where a decoration may be drawn.
local function segments (w, start, inset, skip_punct)
  local cuts = {}
  if skip_punct then
    local x = 0
    local g = start
    while g and x < w do
      local width = g.width or 0
      if g.id == GLYPH and kind(g.char) then
        cuts[#cuts + 1] = { x, math.min(x + width, w) }
      end
      x = x + width
      g = g.next
    end
  end
  local result = {}
  local low = math.min(inset, w)
  local high = math.max(w - inset, low)
  for _, cut in ipairs(cuts) do
    if cut[1] > low then
      result[#result + 1] = { low, math.min(cut[1], high) }
    end
    low = math.max(low, cut[2])
  end
  if low < high then
    result[#result + 1] = { low, high }
  end
  return result
end

-- The settings of a decoration, read from the attribute of the first node it
-- covers.  The leaders pair sits immediately before that node.
local function settings_at (node_)
  if not node_ or not M.attr then
    return nil
  end
  local id = node.has_attribute(node_, M.attr)
  if not id or id == 0 then
    return nil
  end
  return M.settings[id]
end

-- Replace the leaders glue of one decoration: the pieces are kerns and
-- shorter leaders, and their total width stays $w$, so the text does not
-- move.  The negative glue that follows is kept and becomes the tail.
local function replace_pair (head, prev, leaders, settings)
  local w = leaders.width
  local neg = leaders.next
  local parts = segments(w, neg.next, settings.subtract, settings.skip)
  local first, last
  local cursor = 0
  local function append (node_)
    if last then
      last.next = node_
    else
      first = node_
    end
    last = node_
  end
  for _, part in ipairs(parts) do
    if part[1] > cursor then
      local k = node.new("kern")
      k.kern = part[1] - cursor
      append(k)
    end
    local copy = node.copy(leaders)
    copy.width = part[2] - part[1]
    copy.stretch = 0
    copy.shrink = 0
    copy.next = nil
    -- A limited box depth only changes what the line reports; the ink of the
    -- pattern is unchanged, so the dots still show.
    if settings.boxdepth and settings.boxdepth >= 0 and copy.leader then
      local leader = node.copy(copy.leader)
      if leader.depth > settings.boxdepth then
        leader.depth = settings.boxdepth
      end
      copy.leader = leader
    end
    append(copy)
    cursor = part[2]
  end
  if cursor < w then
    local k = node.new("kern")
    k.kern = w - cursor
    append(k)
  end
  if first then
    if prev then
      prev.next = first
    else
      head = first
    end
    last.next = neg
  end
  return head
end

local function adjust (head)
  if not M.attr then
    return head
  end
  local prev = nil
  local n = head
  while n do
    local nxt = n.next
    if n.id == GLUE and n.subtype == LEADERS and n.next
       and n.next.id == GLUE and n.next.width == -n.width then
      local neg = n.next
      local settings = settings_at(neg.next)
      if settings then
        head = replace_pair(head, prev, n, settings)
        n = neg
        nxt = neg.next
      end
    end
    prev = n
    n = nxt
  end
  return head
end

function M.hpack (head)
  return adjust(head)
end

luatexbase.add_to_callback("hpack_filter", M.hpack, "LuaCJKfntef.adjust")
luatexbase.add_to_callback("pre_append_to_vlist_filter",
  function (box)
    if box.id == node.id("hlist") then
      box.head = adjust(box.head)
    end
    return box
  end, "LuaCJKfntef.adjust")
%</lua-fntef>
%    \end{macrocode}

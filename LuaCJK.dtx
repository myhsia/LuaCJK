% \subsection{Fonts}
%
% \begin{macro}[int]{\@@_set_family:nnn}
% Define a family through \pkg{fontspec} and remember the resulting
% family name. The family is only registered;
% the switch happens in \cs{@@_switch_family:n}.
% \begin{variable}[int]{\g_@@_family_prop, \l_@@_family_tl}
% The registered families, and the family name currently selected.
%    \begin{macrocode}
\prop_new:N \g_@@_family_prop
\tl_new:N \l_@@_family_tl
\tl_set:Nn \l_@@_family_tl { zhsong }
%    \end{macrocode}
% \end{variable}
% \begin{variable}[int]{\l_@@_fontspec_tl, \l_@@_family_name_tl, \l_@@_tmpa_tl}
% Scratch variables holding the generated \pkg{fontspec} family name,
% the family name looked up in the property list,
% and a temporary value.
%    \begin{macrocode}
\tl_new:N \l_@@_fontspec_tl
\tl_new:N \l_@@_family_name_tl
\tl_new:N \l_@@_tmpa_tl
\tl_new:N \l_@@_registered_name_tl
%    \end{macrocode}
% \end{variable}
% \begin{variable}[int]
%   {
%     \g_@@_font_name_prop,
%     \g_@@_font_feature_prop,
%     \l_@@_default_feature_tl
%   }
% The font name and the explicit options of each family,
% kept so that \cs{addCJKfontfeatures} can register the family again,
% and the features prepended to every family.
% \begin{variable}[int]
%   {
%     \l_@@_autofake_bold_given_bool,
%     \l_@@_autofake_slant_given_bool,
%     \l_@@_bold_font_given_bool,
%     \l_@@_italic_font_given_bool
%   }
% Whether one family's options already mention \keys{AutoFakeBold},
% \keys{AutoFakeSlant}, \texttt{BoldFont}, or \texttt{ItalicFont}.
%    \begin{macrocode}
\bool_new:N \l_@@_autofake_bold_given_bool
\bool_new:N \l_@@_autofake_slant_given_bool
\bool_new:N \l_@@_bold_font_given_bool
\bool_new:N \l_@@_italic_font_given_bool
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\prop_new:N \g_@@_font_name_prop
\prop_new:N \g_@@_font_feature_prop
\tl_new:N  \l_@@_default_feature_tl
\tl_set:Nn \l_@@_default_feature_tl { Script = CJK }
\tl_new:N  \l_@@_feature_tl
\cs_generate_variant:Nn \fontspec_gset_family:Nnn { NVV }
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_set_family:nnn #1#2#3
  {
    \@@_build_features:n {#2}
    \prop_gput:NnV \g_@@_font_feature_prop {#1} \l_@@_feature_tl
    \prop_gput:Nnn \g_@@_font_name_prop {#1} {#3}
    \@@_register_family:n {#1}
  }
%    \end{macrocode}
% \begin{macro}[int]{\@@_build_features:n}
% Combine the default features, the options given for this family,
% and the automatic fake bold and slant,
% unless the family sets them itself.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_note_feature_key:nn #1#2
  { \@@_note_feature_key:n {#1} }
\cs_new_protected:Npn \@@_note_feature_key:n #1
  {
    \str_case:en { \tl_trim_spaces:n {#1} }
      {
        { AutoFakeBold  } { \bool_set_true:N \l_@@_autofake_bold_given_bool }
        { AutoFakeSlant } { \bool_set_true:N \l_@@_autofake_slant_given_bool }
        { BoldFont      } { \bool_set_true:N \l_@@_bold_font_given_bool }
        { ItalicFont    } { \bool_set_true:N \l_@@_italic_font_given_bool }
      }
  }
\cs_new_protected:Npn \@@_build_features:n #1
  {
    \bool_set_false:N \l_@@_autofake_bold_given_bool
    \bool_set_false:N \l_@@_autofake_slant_given_bool
    \bool_set_false:N \l_@@_bold_font_given_bool
    \bool_set_false:N \l_@@_italic_font_given_bool
    \keyval_parse:NNn
      \@@_note_feature_key:n \@@_note_feature_key:nn {#1}
    \tl_set_eq:NN \l_@@_feature_tl \l_@@_default_feature_tl
    \tl_if_blank:nF {#1}
      { \tl_put_right:Nn \l_@@_feature_tl { , ~ #1 } }
    \tl_if_empty:NF \g_@@_autofake_bold_tl
      {
        \bool_lazy_or:nnF
          { \l_@@_autofake_bold_given_bool }
          { \l_@@_bold_font_given_bool     }
          {
            \tl_put_right:Nx \l_@@_feature_tl
              { , ~ AutoFakeBold = \exp_not:V \g_@@_autofake_bold_tl }
          }
      }
    \tl_if_empty:NF \g_@@_autofake_slant_tl
      {
        \bool_lazy_or:nnF
          { \l_@@_autofake_slant_given_bool }
          { \l_@@_italic_font_given_bool    }
          {
            \tl_put_right:Nx \l_@@_feature_tl
              { , ~ AutoFakeSlant = \exp_not:V \g_@@_autofake_slant_tl }
          }
      }
  }
%    \end{macrocode}
% \end{macro}
% \begin{macro}[int]{\@@_register_family:n}
% Build the \pkg{fontspec} family from the stored font name
% and features, and re-select it if it is the current one.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_register_family:n #1
  {
    \prop_get:NnNF \g_@@_font_name_prop {#1} \l_@@_registered_name_tl
      { \tl_clear:N \l_@@_registered_name_tl }
    \prop_get:NnNF \g_@@_font_feature_prop {#1} \l_@@_feature_tl
      { \tl_clear:N \l_@@_feature_tl }
    \group_begin:
      \fontspec_gset_family:NVV \l_@@_fontspec_tl
        \l_@@_feature_tl \l_@@_registered_name_tl
      \prop_gput:NnV \g_@@_family_prop {#1} \l_@@_fontspec_tl
    \group_end:
    \@@_recall_fallback:n {#1}
    \prop_if_in:NVT \g_@@_family_prop \l_@@_family_tl
      { \selectfont }
  }
%    \end{macrocode}
%
% \begin{macro}[int]{\@@_recall_fallback:n}
% Resolve the fallback families of one CJK family to font identifiers
% at the current size, and hand the list to Lua together with the
% identifier of the family itself. Font identifiers depend on the size,
% so this runs again whenever a family is registered.
% The variables used here are declared with the other options above.
% \begin{variable}[int]{\g_@@_lua_loaded_bool}
%    \begin{macrocode}
\bool_new:N \g_@@_lua_loaded_bool
\cs_new_protected:Npn \@@_recall_all_fallbacks:
  {
    \prop_map_inline:Nn \g_@@_family_prop
      { \@@_recall_fallback:n {##1} }
  }
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_recall_fallback:n #1
  {
    \prop_if_in:NnT \g_@@_fallback_prop {#1}
      {
        \prop_get:NnNF \g_@@_fallback_prop {#1} \l_@@_tmpa_tl
          { \tl_clear:N \l_@@_tmpa_tl }
        \group_begin:
          \tl_clear:N \l_@@_fallback_ids_tl
          \prop_get:NnNF \g_@@_family_prop {#1}
            \l_@@_family_name_tl
            { \tl_clear:N \l_@@_family_name_tl }
          \exp_args:NV \fontfamily \l_@@_family_name_tl
          \selectfont
          \int_set:Nn \l_@@_main_fontid_int
            { \tex_fontid:D \tex_font:D }
          \clist_map_inline:Nn \l_@@_tmpa_tl
            {
              \fontfamily {##1} \selectfont
              \tl_put_right:Nx \l_@@_fallback_ids_tl
                { \int_eval:n { \tex_fontid:D \tex_font:D } , }
            }
          \bool_if:NT \g_@@_lua_loaded_bool
            {
              \tl_if_empty:NF \l_@@_fallback_ids_tl
                {
                  \lua_now:e
                    {
                      LuaCJK.set_fallback
                        ( \int_use:N \l_@@_main_fontid_int ,
                          { \l_@@_fallback_ids_tl } )
                    }
                }
            }
        \group_end:
      }
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}

% \begin{macro}{\LuaCJKnobreak}
% \changes{v0.0.1}{2026/11/11}{Provide \cs{LuaCJKnobreak} and the
%   \keys{PunctWidth} option; neither this prohibition nor that of
%   \cs{LuaCJKVerbAddon} depends on \keys{PunctKinsoku}, which controls only
%   the punctuation rules.}
% \changes{v0.0.2}{2026/11/15}{\cs{LuaCJKnobreak} also forbids the break at a
%   \texttt{discretionary}, so an explicit hyphen or an automatic hyphenation
%   point inside the argument no longer breaks the line.}
% Keep the argument on one line. The nodes of the argument are marked,
% and the line-breaking pass forbids every break opportunity that involves a
% marked node, whether it is a glue, a kern, or a discretionary.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKnobreak { +m }
  {
    \group_begin:
      \g_@@_nobreak_attr = 1
      #1
    \group_end:
  }

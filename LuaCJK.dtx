% \begin{macro}{\CJKsout}
% \changes{v0.0.1}{2026/11/05}{\cs{CJKsout} now takes the same key list as the
%   other decorations, including \keys{format} and \keys{subtract}; a bare color
%   name is still accepted.}
% \changes{v0.0.1}{2026/11/05}{\cs{CJKsout} now strikes at
%   \texttt{height=0.3em} by default, which passes through the middle of a CJK
%   glyph; \texttt{height=0.5ex} restores the Latin position.}
% Strike through the argument.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_fntef_use_sout:
  {
    \tl_set:Ne \l_@@_fntef_cache_key_tl
      {
        sout |
        \dim_use:N \l_@@_fntef_height_dim |
        \dim_use:N \l_@@_fntef_thickness_dim |
        \l_@@_fntef_format_tl
      }
    \tl_if_empty:NF \l_@@_fntef_format_tl
      { \luaul_set_color:n { \l_@@_fntef_format_tl } }
    \prop_get:NVNF \g_@@_fntef_format_prop
      \l_@@_fntef_cache_key_tl \l_@@_fntef_cache_name_tl
      {
        \int_gincr:N \g_@@_fntef_format_int
        \tl_set:Ne \l_@@_fntef_cache_name_tl
          { LuaCJKfntef / st / \int_use:N \g_@@_fntef_format_int }
        \tl_if_empty:NTF \l_@@_fntef_format_tl
          {
            \exp_args:Nc \newunderlinetype
              { \l_@@_fntef_cache_name_tl }
              {
                \tex_leaders:D \tex_vrule:D
                  height \dim_eval:n
                    {
                      \l_@@_fntef_height_dim
                      + \l_@@_fntef_thickness_dim / 2
                    }
                  depth \dim_eval:n
                    {
                      -\l_@@_fntef_height_dim
                      + \l_@@_fntef_thickness_dim / 2
                    }
              }
          }
          {
            \exp_args:Nc \newunderlinetype
              { \l_@@_fntef_cache_name_tl }
              [ \dim_to_decimal_in_sp:n { 1ex } @ \luaul_context_color: ]
              {
                \luaul_apply_color:
                \tex_leaders:D \tex_vrule:D
                  height \dim_eval:n
                    {
                      \l_@@_fntef_height_dim
                      + \l_@@_fntef_thickness_dim / 2
                    }
                  depth \dim_eval:n
                    {
                      -\l_@@_fntef_height_dim
                      + \l_@@_fntef_thickness_dim / 2
                    }
              }
          }
        \prop_gput:NVV \g_@@_fntef_format_prop
          \l_@@_fntef_cache_key_tl \l_@@_fntef_cache_name_tl
      }
    \use:c { \l_@@_fntef_cache_name_tl }
  }
\NewDocumentCommand \CJKsout { s t- o +m }
  {
    \group_begin:
      \tl_if_novalue:nTF {#3}
        { \@@_fntef_decoration_setup:n { } }
        {
          \tl_if_in:nnTF {#3} { = }
            { \@@_fntef_decoration_setup:n {#3} }
            { \@@_fntef_decoration_setup:n { format = #3 } }
        }
      \@@_fntef_use_sout:
      \@@_fntef_hide:n {#4}
    \group_end:
  }
%    \end{macrocode}
% \end{macro}

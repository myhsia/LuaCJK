% \begin{macro}{\CJKunderdblline}
%   Two parallel rules.  They are two underline types applied in the same
%   group, so \pkg{lua-ul} draws both along one span.
%    \begin{macrocode}
\newunderlinetype \LuaCJKfntef_double_top
  { \leaders \vrule height -.20em depth .24em }
\newunderlinetype \LuaCJKfntef_double_bottom
  { \leaders \vrule height -.32em depth .36em }
% \begin{macro}[internal]{\LuaCJKfntef_decoration_setup:n}
%   The settings that the decoration pass reads.  They are pushed on every
%   call, so a command without options starts from the defaults instead of
%   inheriting the previous call.
%    \begin{macrocode}
\keys_define:nn { LuaCJKfntef / decoration }
  {
    subtract .code:n =
      {
        \str_if_eq:nnTF {#1} { true }
          { \dim_set:Nn \l_LuaCJKfntef_subtract_dim { .5em } }
          {
            \str_if_eq:nnTF {#1} { false }
              { \dim_zero:N \l_LuaCJKfntef_subtract_dim }
              { \dim_set:Nn \l_LuaCJKfntef_subtract_dim {#1} }
          }
      },
    subtract .default:n = { true },
    skip .code:n =
      {
        \str_if_eq:nnTF {#1} { true }
          { \tl_set:Nn \l_LuaCJKfntef_skip_tl { 1 } }
          { \tl_set:Nn \l_LuaCJKfntef_skip_tl { 0 } }
      },
    skip .default:n = { true },
    hidden .bool_set:N = \l_LuaCJKfntef_hidden_bool,
    hidden .default:n = { true },
    boxdepth .code:n =
      {
        \dim_set:Nn \l_LuaCJKfntef_boxdepth_dim {#1}
        \bool_set_true:N \l_LuaCJKfntef_boxdepth_given_bool
      },
    unknown .code:n = { },
  }
\cs_new_protected:Npn \LuaCJKfntef_decoration_setup:n #1
  {
    \dim_zero:N \l_LuaCJKfntef_subtract_dim
    \tl_set:Nn \l_LuaCJKfntef_skip_tl { 0 }
    \bool_set_false:N \l_LuaCJKfntef_hidden_bool
    \bool_set_false:N \l_LuaCJKfntef_boxdepth_given_bool
    \tl_if_novalue:nF {#1}
      { \keys_set:nn { LuaCJKfntef / decoration } {#1} }
    \LuaCJKfntef_push_settings:
  }
%    \end{macrocode}
% \end{macro}

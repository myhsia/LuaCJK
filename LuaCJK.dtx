\msg_new:nnn { LuaCJK } { punct-style-unknown }
  {
    PunctStyle~`#1'~is~not~implemented.\\
    Using~`plain'~instead.
  }
\cs_new_protected:Npn \LuaCJK_set_punct_style:n #1
  {
    \prop_if_in:NnTF \g_LuaCJK_punct_style_prop {#1}
      { \tl_set:Nn \l_LuaCJK_punct_style_tl {#1} }
      {
        \msg_warning:nnn { LuaCJK } { punct-style-unknown } {#1}
        \tl_set:Nn \l_LuaCJK_punct_style_tl { plain }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKEditPunctStyle}
%   Change the parameters of an existing style.  A key that is not given
%   keeps its current value, which is why the three ``given'' switches are
%   tracked here instead of starting from the defaults.
%   \begin{variable}[internal]
%     {\l_LuaCJK_punct_compress_given_bool, \l_LuaCJK_punct_ratio_given_bool,
%      \l_LuaCJK_punct_keep_given_bool}
%     Whether the corresponding key was part of the edit.
%    \begin{macrocode}
\bool_new:N \l_LuaCJK_punct_compress_given_bool
\bool_new:N \l_LuaCJK_punct_ratio_given_bool
\bool_new:N \l_LuaCJK_punct_keep_given_bool
\tl_new:N \l_LuaCJK_punct_compress_value_tl
\tl_new:N \l_LuaCJK_punct_keep_value_tl
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\keys_define:nn { LuaCJK / punct-edit }
  {
    compress-adjacent .code:n =
      {
        \bool_set_true:N \l_LuaCJK_punct_compress_given_bool
        \tl_set:Nn \l_LuaCJK_punct_compress_value_tl {#1}
      },
    adjacent-ratio .code:n =
      {
        \bool_set_true:N \l_LuaCJK_punct_ratio_given_bool
        \fp_set:Nn \l_LuaCJK_punct_ratio_fp {#1}
      },
    keep-open-close .code:n =
      {
        \bool_set_true:N \l_LuaCJK_punct_keep_given_bool
        \tl_set:Nn \l_LuaCJK_punct_keep_value_tl {#1}
      },
  }
\NewDocumentCommand \LuaCJKEditPunctStyle { m m }
  {
    \bool_set_false:N \l_LuaCJK_punct_compress_given_bool
    \bool_set_false:N \l_LuaCJK_punct_ratio_given_bool
    \bool_set_false:N \l_LuaCJK_punct_keep_given_bool
    \keys_set:nn { LuaCJK / punct-edit } {#2}
    \lua_now:e
      {
        LuaCJK.edit_punct_style
          ( "\lua_escape:e {#1}" ,
            \bool_if:NTF \l_LuaCJK_punct_compress_given_bool
              { \l_LuaCJK_punct_compress_value_tl }
              { nil } ,
            \bool_if:NTF \l_LuaCJK_punct_ratio_given_bool
              { \fp_use:N \l_LuaCJK_punct_ratio_fp }
              { nil } ,
            \bool_if:NTF \l_LuaCJK_punct_keep_given_bool
              { \l_LuaCJK_punct_keep_value_tl }
              { nil } )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKsetwidth}
%   Give specific punctuation marks a fixed advance, overriding the
%   selected style.  The star form of \pkg{xeCJK}, which sets the width used
%   at the start or end of a line, has no counterpart yet and only warns.
%   \begin{variable}[internal]{\l_LuaCJK_bound_width_warned_bool}
%     Guards the one-time warning for the star form.
%    \begin{macrocode}
\bool_new:N \l_LuaCJK_bound_width_warned_bool
\msg_new:nnn { LuaCJK } { bound-width-unsupported }
  {
    The~star~form~of~\token_to_str:N \LuaCJKsetwidth,~which~sets~the~width~
    at~the~start~or~end~of~a~line,~is~not~implemented.\\
    The~width~is~applied~to~every~position~instead.
  }
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKsetwidth { s m m }
  {
    \IfBooleanT {#1}
      {
        \bool_if:NF \l_LuaCJK_bound_width_warned_bool
          {
            \bool_set_true:N \l_LuaCJK_bound_width_warned_bool
            \msg_warning:nn { LuaCJK } { bound-width-unsupported }
          }
      }
    \lua_now:e
      {
        LuaCJK.set_punct_width
          ( "\lua_escape:e {#2}" , \dim_to_decimal_in_sp:n {#3} )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKsetkern}
%   Set the gap between two adjacent punctuation marks, overriding the
%   selected style.  Only the first character of each argument is used.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKsetkern { m m m }
  {
    \lua_now:e
      {
        LuaCJK.set_punct_kern
          ( "\lua_escape:e {#1}" , "\lua_escape:e {#2}"
          , \dim_to_decimal_in_sp:n {#3} )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Sub-blocks}
%
% A single CJK font rarely covers every block of \textsc{Unicode}.  A
% sub-block gives a range of characters its own font inside a family, named
% by an option of the font commands.
%
% \begin{macro}{\LuaCJKDeclareSubCJKBlock}
%    \begin{variable}[internal]
%      {\g_LuaCJK_block_prop, \g_LuaCJK_block_names_clist}
%      The ranges of each block, and the declaration order that decides
%      which block wins when the ranges overlap.
%     \begin{macrocode}
\prop_new:N \g_LuaCJK_block_prop
\clist_new:N \g_LuaCJK_block_names_clist
\NewDocumentCommand \LuaCJKDeclareSubCJKBlock { m m }
  {
    \LuaCJK_build_ranges:n {#2}
    \prop_gput:NnV \g_LuaCJK_block_prop {#1} \l_LuaCJK_ranges_tl
    \clist_if_in:NnF \g_LuaCJK_block_names_clist {#1}
      { \clist_gput_right:Nn \g_LuaCJK_block_names_clist {#1} }
    \lua_now:e
      {
        LuaCJK.declare_block
          ( "\lua_escape:e {#1}" , { \l_LuaCJK_ranges_tl } )
      }
  }
%     \end{macrocode}
%    \end{variable}
% \end{macro}
%
% \begin{macro}{\LuaCJKCancelSubCJKBlock, \LuaCJKRestoreSubCJKBlock}
%    Turn a block off or on again, and refresh the fonts of the current
%    family so the change takes effect at once.
%     \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_set_block_enabled:nn #1#2
  {
    \clist_map_inline:nn {#1}
      {
        \lua_now:e
          {
            LuaCJK.set_block_enabled
              ( "\lua_escape:e {##1}" , #2 )
          }
      }
    \LuaCJK_update_font:
  }
\NewDocumentCommand \LuaCJKCancelSubCJKBlock { m }
  { \LuaCJK_set_block_enabled:nn {#1} { false } }
\NewDocumentCommand \LuaCJKRestoreSubCJKBlock { m }
  { \LuaCJK_set_block_enabled:nn {#1} { true } }
%     \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{\LuaCJK_extract_blocks:nn}
%    Pull the block options out of a family's option list and register one
%    \pkg{fontspec} family per block font.  The remaining options go into
%    \cs{l_LuaCJK_features_tl}.
%    \begin{variable}[internal]
%      {\g_LuaCJK_family_block_prop, \g_LuaCJK_pending_block_prop,
%       \l_LuaCJK_features_tl, \l_LuaCJK_block_key_tl,
%       \l_LuaCJK_option_key_tl, \l_LuaCJK_option_seq}
%      The block font of each family and block, the blocks found in the
%      option list being processed, the filtered options, and scratch
%      variables for splitting one option at the equals sign.
%     \begin{macrocode}
\prop_new:N \g_LuaCJK_family_block_prop
\prop_new:N \g_LuaCJK_pending_block_prop
\tl_new:N \l_LuaCJK_features_tl
\tl_new:N \l_LuaCJK_block_key_tl
\tl_new:N \l_LuaCJK_option_key_tl
\seq_new:N \l_LuaCJK_option_seq
\bool_new:N \l_LuaCJK_is_block_bool
\cs_new_protected:Npn \LuaCJK_block_option:nn #1#2
  {
    \tl_set:Nn \l_LuaCJK_option_key_tl {#1}
    \tl_trim_spaces:N \l_LuaCJK_option_key_tl
    \bool_set_false:N \l_LuaCJK_is_block_bool
    \clist_map_inline:Nn \g_LuaCJK_block_names_clist
      {
        \str_if_eq:eeT {##1} { \l_LuaCJK_option_key_tl }
          { \bool_set_true:N \l_LuaCJK_is_block_bool }
      }
    \bool_if:NTF \l_LuaCJK_is_block_bool
      { \prop_gput:NVn \g_LuaCJK_pending_block_prop
          \l_LuaCJK_option_key_tl {#2} }
      { \tl_put_right:Nn \l_LuaCJK_features_tl { , ~ #1 = {#2} } }
  }
\cs_new_protected:Npn \LuaCJK_block_option:n #1
  { \tl_put_right:Nn \l_LuaCJK_features_tl { , ~ #1 } }
\cs_new_protected:Npn \LuaCJK_extract_blocks:nn #1#2
  {
    \clist_if_empty:NTF \g_LuaCJK_block_names_clist
      { \tl_set:Nn \l_LuaCJK_features_tl {#2} }
      {
        \tl_clear:N \l_LuaCJK_features_tl
        \prop_gclear:N \g_LuaCJK_pending_block_prop
        \keyval_parse:NNn
          \LuaCJK_block_option:n \LuaCJK_block_option:nn {#2}
        \LuaCJK_register_block_fonts:n {#1}
      }
  }
\cs_new_protected:Npn \LuaCJK_register_block_fonts:n #1
  {
    \prop_map_inline:Nn \g_LuaCJK_pending_block_prop
      {
        \group_begin:
          \fontspec_gset_family:Nnn \l_LuaCJK_tmpa_tl { } {##2}
          \tl_set:Ne \l_LuaCJK_block_key_tl { #1 | ##1 }
          \prop_gput:NVV \g_LuaCJK_family_block_prop
            \l_LuaCJK_block_key_tl \l_LuaCJK_tmpa_tl
        \group_end:
      }
  }
%     \end{macrocode}
%    \end{variable}
% \end{macro}
%
% \begin{macro}{\LuaCJKDeclareCharClass}
%   Override the class of a code-point range.  The range list uses the
%   \pkg{xeCJK} spelling: hexadecimal numbers with a leading |"|, and
%   |"START -> "END| for a range.
%   \begin{variable}[internal]
%     {\l_LuaCJK_ranges_tl, \l_LuaCJK_range_seq, \l_LuaCJK_range_pair_tl,
%      \l_LuaCJK_hex_tl, \l_LuaCJK_hex_int_tl}
%     The Lua table being built, the two halves of one range, and the
%     current hexadecimal number and its value.
%    \begin{macrocode}
\tl_new:N \l_LuaCJK_ranges_tl
\seq_new:N \l_LuaCJK_range_seq
\tl_new:N \l_LuaCJK_range_pair_tl
\tl_new:N \l_LuaCJK_hex_tl
\tl_new:N \l_LuaCJK_hex_int_tl
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_hex_store:n #1
  {
    \tl_set:Nn \l_LuaCJK_hex_tl {#1}
    \tl_replace_all:Nnn \l_LuaCJK_hex_tl { " } { }
    \tl_trim_spaces:N \l_LuaCJK_hex_tl
    \tl_set:Ne \l_LuaCJK_hex_int_tl
      { \exp_args:NV \int_from_hex:n \l_LuaCJK_hex_tl }
  }
\cs_new_protected:Npn \LuaCJK_range_entry:n #1
  {
    \seq_set_split:Nnn \l_LuaCJK_range_seq { -> } {#1}
    \tl_clear:N \l_LuaCJK_range_pair_tl
    \seq_map_inline:Nn \l_LuaCJK_range_seq
      {
        \LuaCJK_hex_store:n {##1}
        \tl_put_right:Nx \l_LuaCJK_range_pair_tl
          { \exp_not:V \l_LuaCJK_hex_int_tl , }
      }
    \tl_put_right:Nx \l_LuaCJK_ranges_tl
      { { \exp_not:V \l_LuaCJK_range_pair_tl } , }
  }
\cs_new_protected:Npn \LuaCJK_build_ranges:n #1
  {
    \tl_clear:N \l_LuaCJK_ranges_tl
    \clist_map_inline:nn {#1} { \LuaCJK_range_entry:n {##1} }
  }
\msg_new:nnn { LuaCJK } { unknown-char-class }
  { Unknown~character~class~`#1'~is~being~ignored. }
\msg_new:nnn { LuaCJK } { unknown-punct-class }
  { Unknown~punctuation~class~`#1'~is~being~ignored. }
\NewDocumentCommand \LuaCJKDeclareCharClass { m m }
  {
    \str_case:nnF {#1}
      {
        { CJK }         { \LuaCJK_push_class:nn { true } {#2} }
        { Default }     { \LuaCJK_push_class:nn { false } {#2} }
        { FullLeft }    { \LuaCJK_push_punct:nn { "open" } {#2} }
        { HalfLeft }    { \LuaCJK_push_punct:nn { "open" } {#2} }
        { FullRight }   { \LuaCJK_push_punct:nn { "close" } {#2} }
        { HalfRight }   { \LuaCJK_push_punct:nn { "close" } {#2} }
        { NormalSpace } { \LuaCJK_push_normal_space:n {#2} }
        { CJStarter }   { \LuaCJK_push_class:nn { true } {#2} }
        { CM }          { \LuaCJK_push_class:nn { true } {#2} }
        { Boundary }    { \LuaCJK_push_class:nn { true } {#2} }
      }
      { \msg_warning:nnn { LuaCJK } { unknown-char-class } {#1} }
  }
\cs_new_protected:Npn \LuaCJK_push_normal_space:n #1
  {
    \LuaCJK_build_ranges:n {#1}
    \lua_now:e
      { LuaCJK.add_normal_spaced ( { \l_LuaCJK_ranges_tl } ) }
  }
\cs_new_protected:Npn \LuaCJK_push_class:nn #1#2
  {
    \LuaCJK_build_ranges:n {#2}
    \lua_now:e
      { LuaCJK.declare_class ( { \l_LuaCJK_ranges_tl } , #1 ) }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKDeclarePunctClass}
%   Override the punctuation group of a range, or with \texttt{none} remove
%   the punctuation treatment from it.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKDeclarePunctClass { m m }
  {
    \str_case:nnF {#1}
      {
        { open }     { \LuaCJK_push_punct:nn { "open" } {#2} }
        { close }    { \LuaCJK_push_punct:nn { "close" } {#2} }
        { middle }   { \LuaCJK_push_punct:nn { "middle" } {#2} }
        { dash }     { \LuaCJK_push_punct:nn { "dash" } {#2} }
        { ellipsis } { \LuaCJK_push_punct:nn { "ellipsis" } {#2} }
        { none }     { \LuaCJK_push_punct:nn { false } {#2} }
      }
      { \msg_warning:nnn { LuaCJK } { unknown-punct-class } {#1} }
  }
\cs_new_protected:Npn \LuaCJK_push_punct:nn #1#2
  {
    \LuaCJK_build_ranges:n {#2}
    \lua_now:e
      { LuaCJK.declare_punct ( { \l_LuaCJK_ranges_tl } , #1 ) }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKResetCharClass}
%   Drop every override declared so far.
%    \begin{macrocode}
% \begin{macro}[internal]{\LuaCJK_set_charset:nnn}
%   Replace, extend, or reduce one of the punctuation character sets.  The
%   ranges are converted the same way as for \cs{LuaCJKDeclareCharClass}.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_set_charset:nnn #1#2#3
  {
    \LuaCJK_build_ranges:n {#3}
    \lua_now:e
      {
        LuaCJK.set_charset
          ( "#1" , "#2" , { \l_LuaCJK_ranges_tl } )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKResetCharClass}
%   Drop every class and punctuation override declared so far, and put the
%   normal-spaced set back to the characters of
%   \texttt{\textbackslash normalspacedchars}.
%    \begin{macrocode}
\NewDocumentCommand \LuaCJKResetCharClass { }
  {
    \lua_now:n { LuaCJK.reset_classes() }
    \LuaCJK_set_normal_spaced_chars:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\LuaCJKDeclarePunctStyle}
%   Define a style from a small set of keys and hand the result to Lua.
%   \begin{variable}[internal]
%     {\l_LuaCJK_punct_compress_bool, \l_LuaCJK_punct_ratio_fp,
%      \l_LuaCJK_punct_keep_bool}
%     The values collected from the keys, with the defaults used when a key
%     is not given.
%    \begin{macrocode}
\bool_new:N \l_LuaCJK_punct_compress_bool
\fp_new:N \l_LuaCJK_punct_ratio_fp
\bool_new:N \l_LuaCJK_punct_keep_bool
%    \end{macrocode}
%   \end{variable}
%    \begin{macrocode}
\keys_define:nn { LuaCJK / punct-style }
  {
    compress-adjacent .bool_set:N = \l_LuaCJK_punct_compress_bool,
    adjacent-ratio .fp_set:N = \l_LuaCJK_punct_ratio_fp,
    keep-open-close .bool_set:N = \l_LuaCJK_punct_keep_bool,
  }
\NewDocumentCommand \LuaCJKDeclarePunctStyle { m m }
  {
    \bool_set_true:N \l_LuaCJK_punct_compress_bool
    \fp_set:Nn \l_LuaCJK_punct_ratio_fp { 0.5 }
    \bool_set_true:N \l_LuaCJK_punct_keep_bool
    \keys_set:nn { LuaCJK / punct-style } {#2}
    \prop_gput:Nnn \g_LuaCJK_punct_style_prop {#1} { }
    \lua_now:e
      {
        LuaCJK.define_punct_style(
          "\lua_escape:e {#1}",
          \bool_if:NTF \l_LuaCJK_punct_compress_bool { true } { false },
          \fp_use:N \l_LuaCJK_punct_ratio_fp,
          \bool_if:NTF \l_LuaCJK_punct_keep_bool { true } { false } )
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[internal]{\LuaCJK_set_autofake:nn}
%   Turn fake bold or slant on or off.  A number both enables the feature
%   and sets the factor, as in \pkg{xeCJK}.
%    \begin{macrocode}
\cs_new_protected:Npn \LuaCJK_set_autofake:nn #1#2
  {
    \str_case:nnF {#2}
      {
        { true }
          {
            \str_if_eq:nnTF {#1} { bold }
              { \tl_gset_eq:NN \g_LuaCJK_autofake_bold_tl
                  \g_LuaCJK_embolden_factor_tl }
              { \tl_gset_eq:NN \g_LuaCJK_autofake_slant_tl
                  \g_LuaCJK_slant_factor_tl }
          }
        { false }
          {
            \str_if_eq:nnTF {#1} { bold }
              { \tl_gclear:N \g_LuaCJK_autofake_bold_tl }
              { \tl_gclear:N \g_LuaCJK_autofake_slant_tl }
          }
      }
      {
        \str_if_eq:nnTF {#1} { bold }
          {
            \tl_gset:Nn \g_LuaCJK_embolden_factor_tl {#2}
            \tl_gset:Nn \g_LuaCJK_autofake_bold_tl {#2}
          }
          {
            \tl_gset:Nn \g_LuaCJK_slant_factor_tl {#2}
            \tl_gset:Nn \g_LuaCJK_autofake_slant_tl {#2}
          }
      }
  }
%    \end{macrocode}
% \end{macro}

%</example>
% \fi
%
% 接下来是标点代码所用的字符集合。每个集合的键都有三种形式：
% 不带符号的形式替换整个集合，带 \texttt{+} 的形式添加字符，
% 带 \texttt{-} 的形式去掉字符。范围的写法与 \cs{LuaCJKDeclareCharClass} 相同。
% 这些集合是全局的：分组不会把先前的成员带回来。
%
% \begin{keyval}
%   \item[\keys{KaiMingPunct<+->}]\val{char list}:
%   在 \texttt{kaiming} 样式里保持全角宽度的标点。
%   初始为 \texttt{。}、\texttt{．}、\texttt{？}、\texttt{！}。
%   \item[\keys{MiddlePunct<+->}]\val{char list}:
%   居中的标点，放在自己盒子的两半之间。居中的标点不能出现在行首。
%   \item[\keys{LongPunct<+->}]\val{char list}:
%   彼此之间从不压缩的标点，例如破折号与省略号。
%   \item[\keys{NoBreakLongPunct<+->}]\val{char list}:
%   不能被断行分开的长标点。初始与 \texttt{LongPunct} 相同。
% \end{keyval}
%
% \begin{function}{\LuaCJKDeclareCharClass}
%   \begin{syntax}
%     \tn{LuaCJKDeclareCharClass} \marg{class} \marg{range list}
%   \end{syntax}
%   改写一段码位的类别。
%   范围用十六进制书写，前导的 |"| 可以省略，
%   |"START -> "END| 表示一段范围；
%   列表用逗号分隔。
%   类别有：\texttt{CJK} 与 \texttt{Default} 让这段范围表现得像 CJK 或拉丁文字；
%   \texttt{FullLeft} 与 \texttt{HalfLeft} 把它当作开头的标点，
%   \texttt{FullRight} 与 \texttt{HalfRight} 把它当作收尾的标点，
%   于是断行禁则适用；
%   \texttt{NormalSpace} 把这段范围移出 CJK/拉丁胶，
%   就像 \cs{normalspacedchars} 那样；
%   \texttt{CJStarter}、\texttt{CM} 与 \texttt{Boundary} 当作 \texttt{CJK} 处理，
%   因为 \LuaTeX\ 没有组合标记或文字段边界的模型。
% \end{function}
%
% \begin{function}{\LuaCJKDeclarePunctClass}
%   \begin{syntax}
%     \tn{LuaCJKDeclarePunctClass} \marg{group} \marg{range list}
%   \end{syntax}
%   改写一段范围的标点组。组有 \texttt{open}、\texttt{close}、
%   \texttt{middle}、\texttt{dash} 与 \texttt{ellipsis}；
%   \texttt{none} 去掉标点处理，于是这些字符不再被压缩或悬挂。
% \end{function}
%
% \begin{function}{\LuaCJKResetCharClass}
%   丢弃迄今声明的每一个类别与标点改写，
%   并把正常间距集合恢复为 \cs{normalspacedchars} 的字符。
% \end{function}
%
% \iffalse
%<*example>
% \fi
\begingroup
\begin{codemo}
中ABC中\par
\LuaCJKDeclareCharClass{CJK}{0041 -> 005A}
中ABC中\par
\LuaCJKDeclarePunctClass{none}{FF0C}%
字，，字\par
\LuaCJKResetCharClass 中ABC中
\end{codemo}
\endgroup
% \iffalse
%</example>
% \fi
